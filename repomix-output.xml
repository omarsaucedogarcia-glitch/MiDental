        .empty-state span.material-symbols-outlined { font-size: 2.6rem; color: #94a3b8; display: block; margin-bottom: 6px; }
        .empty-state p { margin: 3px 0; font-size: 0.9rem; }
        .empty-state .empty-sub { font-size: 0.78rem; color: #94a3b8; }

        .bottom-nav { background: white; border-top: none; }

        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .spin { animation: spin 1.2s linear infinite; display: inline-block; }

        /* RESPONSIVE */
        @media (max-width: 600px) {
            .financial-grid { grid-template-columns: 1fr; }
            .finance-card { min-height: auto; flex-direction: row; align-items: center; gap: 14px; }
            .finance-card .finance-icon { width: 42px; height: 42px; }
            .finance-card > div.finance-body { display: flex; flex-direction: column; flex: 1; }
            .finance-card .finance-amount { font-size: 1.4rem; }
            .docs-container { padding: 14px; }
        }
    </style>
</head>
<body>

    <header style="padding: 20px; background: white; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 100; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.02);">
