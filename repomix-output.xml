        async function cargarDocumentosPaciente() {
            const contenedor = document.getElementById('contenedorDocumentosPaciente');
            if (!contenedor) return;

            // 1. Forzamos los estilos de grilla directamente en el contenedor padre
            contenedor.style.display = "grid";
            contenedor.style.gridTemplateColumns = "repeat(auto-fill, minmax(130px, 1fr))";
            contenedor.style.gap = "15px";
            contenedor.style.maxHeight = "250px";
            contenedor.style.overflowY = "auto";
            contenedor.style.padding = "10px";

            if (isLocal) {
                contenedor.innerHTML = '<p style="color: #f59e0b; font-size: 0.85rem; grid-column: 1/-1; text-align: center; margin-top:10px;"><b>Atención:</b> La carga de archivos no está disponible para Fichas Locales.</p>';
                const btnSubir = document.getElementById('labelBtnSubidaDoc');
                if (btnSubir) btnSubir.style.display = 'none';
                return;
            }
            
            try {
                const { data: docs, error } = await window.midental.from('documentos_pacientes').select('*').eq('paciente_id', pacienteIdURL).order('created_at', { ascending: false });
                if (error) throw error;
                
                contenedor.innerHTML = "";

                if (!docs || docs.length === 0) {
                    contenedor.innerHTML = '<p style="color: #94a3b8; font-size: 0.9rem; text-align: center; grid-column: 1/-1; margin: 10px 0;">El paciente no ha subido archivos aún.</p>';
                    return;
                }

                for (const doc of docs) {
                    let urlSegura = '';
                    const archivoRef = doc.archivo_url || doc.file_url || doc.url || '';
                    if (!archivoRef) continue;

                    if (archivoRef.startsWith('http')) {
                        urlSegura = archivoRef;
                    } else {
                        const { data: signedData } = await window.midental.storage.from('documentos_clinicos').createSignedUrl(archivoRef, 3600);
                        urlSegura = signedData?.signedUrl || '#';
                    }

                    // Lógica para definir el ícono y color de la tarjeta
                    const esImagen = archivoRef.match(/\.(jpeg|jpg|gif|png)$/i) != null;
                    const nombreMinuscula = (doc.nombre_archivo || '').toLowerCase();
                    
                    let iconSymbol = 'description'; // Icono genérico (PDF)
                    let bgIcon = 'rgba(2, 132, 199, 0.1)'; // Fondo celeste suave
                    let colorIcon = 'var(--pixar-cyan)'; // Icono celeste

                    if (nombreMinuscula.includes('presupuesto')) {
                        iconSymbol = 'request_quote';
                        bgIcon = 'var(--pixar-cyan)';
                        colorIcon = 'white';
                    } else if (nombreMinuscula.includes('consentimiento')) {
                        iconSymbol = 'gavel';
                        bgIcon = '#8b5cf6'; // Morado legal
                        colorIcon = 'white';
                    } else if (esImagen) {
                        iconSymbol = 'image';
                    } else if (nombreMinuscula.includes('receta')) {
                        iconSymbol = 'prescriptions';
                    }

                    // Inyección limpia y estructurada de la tarjeta
                    contenedor.innerHTML += `
                        <div style="background: white; padding: 15px 10px; border-radius: 12px; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.04); border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: space-between; transition: transform 0.2s;">
                            <div style="width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; background: ${bgIcon}; color: ${colorIcon};">
                                <span class="material-symbols-outlined" style="font-size: 1.6rem;">${iconSymbol}</span>
                            </div>
                            <p style="font-size: 0.75rem; margin: 0 0 12px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; color: #334155; font-weight: 700;" title="${doc.nombre_archivo}">
                                ${doc.nombre_archivo || 'Documento'}
                            </p>
                            <a href="${urlSegura}" target="_blank" style="font-size: 0.75rem; color: white; background: var(--pixar-orange); padding: 8px 10px; border-radius: 8px; text-decoration: none; font-weight: bold; width: 100%; box-sizing: border-box; display: block; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.2);">Abrir</a>
                        </div>
                    `;
                }
            } catch (err) {
                contenedor.innerHTML = '<p style="color: #ef4444; font-size: 0.85rem; grid-column: 1/-1; text-align: center;">Error al cargar archivos.</p>';
            }
        }

        async function procesarSubidaDocumentoDentista(event) {
            const file = event.target.files[0];
            if (!file) return;

            const dentistaId = localStorage.getItem('midental_user_id');
            const labelBtn = document.getElementById('labelBtnSubidaDoc');

            if (file.size > 5 * 1024 * 1024) {
                alert("El archivo es muy pesado. Máximo 5MB.");
                event.target.value = "";
                return;
            }

            labelBtn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Subiendo...';

            try {
                const fileExt = file.name.split('.').pop();
                const fileName = `Dr_${dentistaId}_${Date.now()}.${fileExt}`;

                const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(fileName, file);
                if (uploadError) throw uploadError;

                const { error: dbError } = await window.midental.from('documentos_pacientes').insert([{
                    paciente_id: pacienteIdURL, dentista_id: dentistaId, nombre_archivo: file.name, tipo: file.type.includes('pdf') ? 'pdf' : 'imagen', archivo_url: fileName 
                }]);

                if (dbError) throw dbError;

                alert("✅ Documento subido de forma privada a la ficha del paciente.");
                cargarDocumentosPaciente();

            } catch (err) {
                alert("Error al subir el archivo: " + err.message);
            } finally {
                labelBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">cloud_upload</span> Subir <input type="file" accept="image/*,.pdf" style="display: none;" onchange="procesarSubidaDocumentoDentista(event)">';
            }
        }

