                        </div>
                        
                        <div class="input-group">
                            <label>Correo Electrónico</label>
                            <input type="email" id="pInputEmail" class="apple-input" placeholder="correo@ejemplo.com">
                        </div>
                        <div class="input-group">
                            <label>Teléfono (WhatsApp)</label>
                            <input type="tel" id="pInputTel" class="apple-input" placeholder="+56 9 XXXX XXXX" oninput="if(typeof formatearTelefonoInput === 'function') formatearTelefonoInput(this)">
                        </div>
                    </div>
                </form>
            </div>

            <div class="profile-card">
                <h3 class="section-title"><span class="material-symbols-outlined">medical_information</span> Información Médica (Anamnesis)</h3>
                <div style="background: #fff5f5; border-left: 4px solid #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
                    <p style="margin:0; font-size:0.85rem; color:#b91c1c; line-height:1.4;">
                        <strong>Importante:</strong> Esta información es estrictamente confidencial. Solo será compartida con los especialistas tratantes para garantizar una atención segura y evitar riesgos de salud.
                    </p>
                </div>

                <div class="input-group">
                    <label>Enfermedades Crónicas / Diagnósticos Previos</label>
                    <textarea id="pInputEnfermedades" class="apple-input" placeholder="Ej: Hipertensión, Diabetes, Asma... (Si no tienes, escribe 'Ninguna')"></textarea>
                </div>
                
                <div class="input-group">
                    <label>Medicamentos de Consumo Actual</label>
                    <textarea id="pInputMedicamentos" class="apple-input" placeholder="Ej: Losartán 50mg, Eutirox... (Si no consumes, escribe 'Ninguno')"></textarea>
                </div>

                <div class="input-group">
                    <label>Alergias (Medicamentos, Alimentos, Materiales)</label>
                    <textarea id="pInputAlergias" class="apple-input" placeholder="Ej: Alergia a la Penicilina, al Látex... (Si no tienes, escribe 'Ninguna')"></textarea>
                </div>
            </div>

            <button type="button" class="btn-save" id="btnGuardar" onclick="guardarCambiosPacienteReal()">
                <span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Guardar Toda mi Información
            </button>
        </div>

    </div>

    <nav class="bottom-nav">
        <a href="dashboard-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">home</span>Inicio</a>
        <a href="mapa-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">search</span>Buscar</a>
        <a href="ofertas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">description</span>Documentos</a>
        <a href="perfil-paciente.html" class="nav-item-bottom active"><span class="material-symbols-outlined">person</span>Perfil</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            cargarDatosPaciente();
        });

        async function cargarDatosPaciente() {
            const userId = localStorage.getItem('midental_user_id');
            const userTipo = localStorage.getItem('midental_user_tipo');
            const rutActual = localStorage.getItem('midental_paciente_rut'); // NUEVO: Extraemos el RUT

            if (!userId || userTipo !== 'paciente') {
                alert("Debes iniciar sesión como paciente.");
                window.location.href = 'index.html';
                return;
            }

            try {
                // CAMBIO CLAVE: Ahora buscamos usando el RUT para identificar al familiar correcto
                const { data, error } = await window.midental
                    .from('perfiles_pacientes')
                    .select('*')
                    .eq('user_id', userId)
                    .eq('rut', rutActual) // FILTRO EXACTO
                    .maybeSingle();

                if (error) throw error;

                if (data) {
                    // Llenar Formulario Personal
                    if(document.getElementById('pInputNombre')) document.getElementById('pInputNombre').value = data.nombre_completo || '';
                    if(document.getElementById('pInputRut')) document.getElementById('pInputRut').value = data.rut || '';
                    if(document.getElementById('pInputEmail')) document.getElementById('pInputEmail').value = data.email || '';
                    if(document.getElementById('pInputTel')) document.getElementById('pInputTel').value = data.telefono || '';

                    // Manejo blindado de Fecha y Edad
                    if (data.fecha_nacimiento) {
                        const inputNac = document.getElementById('pInputNacimiento');
                        if(inputNac) inputNac.value = data.fecha_nacimiento;
                        calcularYMostrarEdad(data.fecha_nacimiento, 'labelEdad');
                    }

                    // Llenar Formulario Médico
                    if(document.getElementById('pInputEnfermedades')) document.getElementById('pInputEnfermedades').value = data.enfermedades_cronicas || '';
                    if(document.getElementById('pInputMedicamentos')) document.getElementById('pInputMedicamentos').value = data.medicamentos || '';
                    if(document.getElementById('pInputAlergias')) document.getElementById('pInputAlergias').value = data.alergias || '';

                    // Actualizar Sidebar
                    const nombreMostrar = data.nombre_completo || 'Paciente';
                    document.getElementById('patientNameDisplay').innerText = nombreMostrar;
                    
                    if (data.reputacion && document.getElementById('patientScore')) {
                        document.getElementById('patientScore').innerText = data.reputacion.toFixed(1);
                    }

                    // Manejo de Avatar
                    const imgEl = document.getElementById('patientAvatarImg');
                    const txtEl = document.getElementById('patientAvatarText');
                    
                    if (data.avatar_url && imgEl && txtEl) {
                        imgEl.src = data.avatar_url;
                        imgEl.style.display = 'block';
                        txtEl.style.display = 'none';
                    } else if (imgEl && txtEl) {
                        imgEl.style.display = 'none';
                        txtEl.style.display = 'flex';
                        txtEl.innerText = nombreMostrar.charAt(0).toUpperCase();
                    }
                } else {
                    // SI EL PACIENTE ES NUEVO Y NO TIENE DATOS (Previene el congelamiento)
                    document.getElementById('patientNameDisplay').innerText = "Completar Perfil";
                    document.getElementById('patientAvatarText').innerText = "P";
                }
            } catch (err) {
                console.error("Error al cargar perfil:", err);
                // Si ocurre cualquier otro error, quitamos el "Cargando..."
                document.getElementById('patientNameDisplay').innerText = "Error de Conexión";
            }
        }

        function calcularYMostrarEdad(fechaString, labelId) {
            if (!fechaString) return;
            const label = document.getElementById(labelId);
            if (!label) return; // Si no existe la etiqueta HTML, abortamos suavemente sin romper la página
            
            const hoy = new Date();
            const nacimiento = new Date(fechaString);
            let edad = hoy.getFullYear() - nacimiento.getFullYear();
            const mes = hoy.getMonth() - nacimiento.getMonth();
            if (mes < 0 || (mes === 0 && hoy.getDate() < nacimiento.getDate())) edad--;
            
            label.innerText = `(${edad} años)`;
        }

        async function guardarCambiosPacienteReal() {
            const userId = localStorage.getItem('midental_user_id');
            const btn = document.getElementById('btnGuardar');
            
            // Datos Personales
            const nombre = document.getElementById('pInputNombre').value.trim();
            const email = document.getElementById('pInputEmail').value.trim();
            const telBruto = document.getElementById('pInputTel').value.trim();
            const nacimiento = document.getElementById('pInputNacimiento').value.trim();

            // Datos Médicos
            const enfermedades = document.getElementById('pInputEnfermedades').value.trim();
            const medicamentos = document.getElementById('pInputMedicamentos').value.trim();
            const alergias = document.getElementById('pInputAlergias').value.trim();

            if (!nombre || !telBruto) {
                return alert("El nombre y teléfono son obligatorios para mantener tu perfil activo.");
            }

            // CORRECCIÓN: Limpiar el teléfono para la Base de Datos
            const telLimpio = telBruto.replace(/[^0-9]/g, '');

            btn.innerHTML = `<span class="material-symbols-outlined" style="animation: spin 1s linear infinite; vertical-align: middle;">sync</span> Guardando...`;
            btn.disabled = true;

            try {
                // Actualizamos todos los campos en un solo envío
                const { error } = await window.midental
                    .from('perfiles_pacientes')
                    .update({
                        nombre_completo: nombre,
                        email: email,
                        telefono: telLimpio, // Se envía limpio
                        fecha_nacimiento: nacimiento || null,
                        enfermedades_cronicas: enfermedades,
                        medicamentos: medicamentos,
                        alergias: alergias
                    })
                    .eq('user_id', userId);

                if (error) throw error;

                // Actualizar UI inmediatamente
                document.getElementById('patientNameDisplay').innerText = nombre;
                const imgEl = document.getElementById('patientAvatarImg');
                if (imgEl.style.display === 'none') {
                    document.getElementById('patientAvatarText').innerText = nombre.charAt(0).toUpperCase();
                }

                btn.style.background = "var(--green-success)";
                btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">check_circle</span> Información Guardada Correctamente`;
                
                setTimeout(() => {
                    btn.style.background = "var(--pixar-cyan)";
                    btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Guardar Toda mi Información`;
                    btn.disabled = false;
                }, 2500);

            } catch (err) {
                alert("Error al actualizar: " + err.message);
                btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Guardar Toda mi Información`;
                btn.disabled = false;
            }
        }

        async function subirFotoPaciente(input) {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId || !input.files || input.files.length === 0) return;

            const file = input.files[0];
            const fileExt = file.name.split('.').pop();
            const fileName = `paciente_${userId}_${Date.now()}.${fileExt}`;

            try {
                const txtEl = document.getElementById('patientAvatarText');
                const imgEl = document.getElementById('patientAvatarImg');
                
                imgEl.style.display = 'none';
                txtEl.style.display = 'flex';
                txtEl.innerHTML = `<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span>`;

                // CORRECCIÓN 1: El nombre del bucket debe ir en estricta minúscula
                const { error: uploadError } = await window.midental.storage
                    .from('avatars') 
                    .upload(fileName, file);

                if (uploadError) throw uploadError;

                // Extraemos la URL pública (asegurándonos de usar el bucket en minúscula)
                const { data: urlData } = window.midental.storage.from('avatars').getPublicUrl(fileName);
                const publicUrl = urlData.publicUrl;

                // CORRECCIÓN 2: Actualizamos apuntando a 'user_id', no a 'id'
                const { error: dbError } = await window.midental.from('perfiles_pacientes')
                    .update({ avatar_url: publicUrl })
                    .eq('user_id', userId); 

                if (dbError) throw dbError;

                txtEl.style.display = 'none';
                imgEl.src = publicUrl;
                imgEl.style.display = 'block';

            } catch (err) {
                alert("Error al subir foto: " + err.message);
                cargarDatosPaciente(); // Recargamos para revertir la UI en caso de fallo
            }
        }

        function cerrarSesionLocal() {
            localStorage.removeItem('midental_user_id');
            localStorage.removeItem('midental_user_tipo');
            localStorage.removeItem('midental_user_name');
            window.location.href = 'index.html';
        }
        
    function calcularYMostrarEdad(fechaString, labelId) {
            if (!fechaString) return;
            const label = document.getElementById(labelId);
            if (!label) return; // Si no existe la etiqueta HTML, abortamos suavemente sin romper la página
            
            const hoy = new Date();
            const nacimiento = new Date(fechaString);
            let edad = hoy.getFullYear() - nacimiento.getFullYear();
            const mes = hoy.getMonth() - nacimiento.getMonth();
            if (mes < 0 || (mes === 0 && hoy.getDate() < nacimiento.getDate())) edad--;
            
            label.innerText = `(${edad} años)`;
        }
    </script>
</body>
</html>
</file>

<file path="mis-pacientes.html">
<!DOCTYPE html>
<html lang="es">
<head>
