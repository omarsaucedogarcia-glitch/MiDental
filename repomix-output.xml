                <input type="text" id="filtroComuna" placeholder="Buscar por comuna, especialidad o nombre...">
            </div>
            <p id="contadorResultados" style="font-size: 0.85rem; color: #64748b; margin-top: 15px; margin-bottom: 0; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Buscando especialistas...</p>
        </div>
    </div>

    <div class="directorio-container">
        <div id="cargandoDirectorio" style="text-align:center; padding:40px; color:#94a3b8;">
            <span class="material-symbols-outlined" style="font-size: 3rem; animation: spin 2s linear infinite;">sync</span>
            <p>Cargando red de profesionales...</p>
        </div>

        <div class="split-layout" id="panelColumnasBase" style="display: none;">
            <div>
                <h3 class="column-header">
                    <span class="material-symbols-outlined" style="color: #ef4444;">emergency</span> 
                    Atención Inmediata
                </h3>
                <div id="listaUrgencias">
                    <div style="text-align: center; color: #94a3b8; padding: 20px; font-size: 0.9rem;">No hay dentistas recibiendo urgencias ahora mismo.</div>
                </div>
            </div>

            <div>
                <h3 class="column-header">
                    <span class="material-symbols-outlined" style="color: var(--pixar-cyan);">event_available</span> 
                    Agendamiento Normal
                </h3>
                <div id="listaNormal"></div>
            </div>
        </div>
    </div>

    <div id="modalFichaDoctor" class="modal-overlay">
        <div class="modal-content">
            <button class="btn-close" onclick="cerrarAgendamiento()" style="position: absolute; right: 15px; top: 15px; z-index: 20; background: white; box-shadow: 0 4px 10px rgba(0,0,0,0.15); border: none; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer;"><span class="material-symbols-outlined" style="font-size: 1.2rem;">close</span></button>
            
            <div class="modal-body-scroll" id="scrollContainerModal">
                
                <div style="text-align: center; margin-bottom: 20px; margin-top: 10px;">
                    <div style="position: relative; display: inline-block;">
                        <img id="modalDocAvatar" src="assets/avatar-default-doctor.png" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 4px solid white; box-shadow: 0 4px 15px rgba(0, 180, 216, 0.3);">
                        <span class="material-symbols-outlined" style="position: absolute; bottom: 0; right: 0; background: var(--green-success); color: white; border-radius: 50%; padding: 4px; font-size: 1rem; border: 2px solid white;">verified</span>
                    </div>
                    <h2 id="modalDocNombre" style="margin: 15px 0 5px 0; color: var(--blue-elegant); font-size: 1.4rem; font-weight: 900;">Cargando...</h2>
                    <p id="modalDocEspecialidad" style="margin: 0; color: var(--pixar-cyan); font-weight: bold; font-size: 0.95rem;">Especialidad</p>
                    
                    <div style="margin-top: 15px; background: #f1f5f9; display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; color: #475569; font-weight:bold;">
                        <span class="material-symbols-outlined" style="font-size: 1.1rem; color: #94a3b8;">domain</span> 
                        <span id="modalDocDireccion">Dirección de la clínica</span>
                    </div>
                </div>

                <div class="modal-tabs">
                    <button class="tab-btn active" id="btnTabSobreMi" onclick="cambiarPestanaModal('sobremi')">Sobre Mí</button>
                    <button class="tab-btn" id="btnTabAgendar" onclick="cambiarPestanaModal('agendar')">Agendar Hora</button>
                </div>

                <div id="tabSobreMiContenido">
                    <div id="modalDocPresentacion" class="doctor-presentacion-box"></div>
                    
                    <h3 style="font-size: 1.05rem; color: var(--blue-elegant); margin: 25px 0 10px; font-weight: bold; display: flex; align-items: center; gap: 5px;">
                        <span class="material-symbols-outlined" style="color: var(--pixar-cyan); font-size: 1.2rem;">list_alt</span> Arancel Referencial
                    </h3>
                    <div id="modalDocServicios" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 15px; overflow: hidden; margin-bottom: 10px;">
                        <div style="padding: 15px; text-align: center; color: #94a3b8; font-size: 0.85rem;">Cargando servicios...</div>
                    </div>
                </div>

                <div id="tabAgendarContenido" style="display: none;">
                    <div class="cal-nav-header">
                        <button type="button" onclick="cambiarSemanaAgendamiento(-1)"><span class="material-symbols-outlined">chevron_left</span></button>
                        <strong id="lblSemanaCita" style="color:var(--blue-elegant); font-size:0.85rem;">Cargando...</strong>
                        <button type="button" onclick="cambiarSemanaAgendamiento(1)"><span class="material-symbols-outlined">chevron_right</span></button>
                    </div>
                    
                    <div class="horarios-grid-container">
                        <div class="dias-row" id="modalCalendarioHoras"></div>
                    </div>

                    <button class="btn-google-maps" onclick="abrirRutaMapaPaciente()" style="width: 100%;">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/aa/Google_Maps_icon_%282020%29.svg/512px-Google_Maps_icon_%282020%29.svg.png" style="width: 15px; height: 15px;">
                        Ver ubicación en Google Maps
                    </button>
