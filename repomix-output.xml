    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const pacienteIdURL = urlParams.get('paciente');
        const isLocal = urlParams.get('local') === 'true';
        const citaId = urlParams.get('cita');
        
        let pacienteActual = { 
            nombre: urlParams.get('nombre') ? decodeURIComponent(urlParams.get('nombre')) : "Paciente No Encontrado", 
            telefono: urlParams.get('telefono') ? decodeURIComponent(urlParams.get('telefono')) : "", 
            rut: urlParams.get('rut') ? decodeURIComponent(urlParams.get('rut')) : "" 
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (!pacienteIdURL && !isLocal) {
                alert("Error: No se especificó un paciente válido.");
                window.history.back();
                return;
            }
            cargarDatosPaciente();
        });

        async function cargarDatosPaciente() {
            try {
                if (isLocal) {
                    // MODO FICHA LOCAL (Sin cuenta creada)
                    document.getElementById('headerNombrePaciente').innerText = pacienteActual.nombre + " (Ficha Local)";
                    document.getElementById('panelNombrePaciente').innerText = pacienteActual.nombre;
                    document.getElementById('panelRutPaciente').innerText = `RUT: ${pacienteActual.rut || 'No registrado'}`;
                    document.getElementById('panelTelefonoPaciente').innerHTML = `<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">call</span> ${pacienteActual.telefono || 'Sin teléfono'}`;
                    document.getElementById('derivarPcteNombre').innerText = pacienteActual.nombre;
                    
                    document.getElementById('panelAvatarImg').style.display = 'none';
                    document.getElementById('panelAvatarText').style.display = 'flex';
                    document.getElementById('panelAvatarText').innerText = pacienteActual.nombre.charAt(0).toUpperCase();
                    
                    document.getElementById('alertaClinicaContainer').style.display = 'none';
                    document.getElementById('btnActivarEdicionPaciente').style.display = 'none'; // No se edita si es local
                } else {
                    // MODO PACIENTE REGISTRADO OFICIAL
                    const { data: paciente, error } = await window.midental.from('perfiles_pacientes')
                        // ---> AGREGAMOS fecha_nacimiento A LA CONSULTA <---
                        .select('nombre_completo, rut, telefono, fecha_nacimiento, enfermedades_cronicas, medicamentos, alergias, avatar_url, notas_privadas, proxima_sesion_nota, proxima_sesion_duracion_minutos')
                        .eq('id', pacienteIdURL).single();
                        
                    if (error) throw error;
                    
                    if (paciente) {
                        pacienteActual.nombre = paciente.nombre_completo || "Sin Nombre";
                        pacienteActual.rut = paciente.rut || "No registrado";
                        pacienteActual.telefono = paciente.telefono || "";
                        pacienteActual.fecha_nacimiento = paciente.fecha_nacimiento || "";

                        // Llenar vista de lectura
                        document.getElementById('headerNombrePaciente').innerText = pacienteActual.nombre;
                        document.getElementById('panelNombrePaciente').innerText = pacienteActual.nombre;
                        document.getElementById('panelRutPaciente').innerText = `RUT: ${pacienteActual.rut}`;
                        document.getElementById('panelTelefonoPaciente').innerHTML = `<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">call</span> ${pacienteActual.telefono || 'Sin teléfono'}`;
                        document.getElementById('derivarPcteNombre').innerText = pacienteActual.nombre;
                        
                        // Formatear fecha de nacimiento si existe
                        if (pacienteActual.fecha_nacimiento) {
                            const [year, month, day] = pacienteActual.fecha_nacimiento.split('-');
                            document.getElementById('panelNacimientoPaciente').innerText = `Nacimiento: ${day}/${month}/${year}`;
                        } else {
                            document.getElementById('panelNacimientoPaciente').innerText = `Nacimiento: No registrado`;
                        }

                        // Preparar los inputs del modo edición
                        document.getElementById('editNombrePaciente').value = pacienteActual.nombre;
                        document.getElementById('editRutPaciente').value = pacienteActual.rut !== "No registrado" ? pacienteActual.rut : "";
                        document.getElementById('editTelefonoPaciente').value = pacienteActual.telefono;
                        document.getElementById('editNacimientoPaciente').value = pacienteActual.fecha_nacimiento;

                        const imgEl = document.getElementById('panelAvatarImg');
                        const txtEl = document.getElementById('panelAvatarText');
                        
                        if (paciente.avatar_url && paciente.avatar_url !== "") {
                            imgEl.src = paciente.avatar_url;
                            imgEl.style.display = 'block';
                            txtEl.style.display = 'none';
                        } else {
                            imgEl.style.display = 'none';
                            txtEl.style.display = 'flex';
                            txtEl.innerText = pacienteActual.nombre.charAt(0).toUpperCase();
                        }

                        // Llenar datos médicos del paciente
                        document.getElementById('txtCrónicas').innerText = paciente.enfermedades_cronicas || 'Ninguna';
                        document.getElementById('inputCronicas').value = paciente.enfermedades_cronicas || '';
                        document.getElementById('txtMedicamentos').innerText = paciente.medicamentos || 'Ninguno';
                        document.getElementById('inputMedicamentos').value = paciente.medicamentos || '';
                        document.getElementById('txtAlergias').innerText = paciente.alergias || 'Ninguna';
                        document.getElementById('inputAlergias').value = paciente.alergias || '';
                        
                        if (paciente.notas_privadas) {
                            document.getElementById('vistaNotasPrivadas').innerText = paciente.notas_privadas;
                            document.getElementById('inputNotasPrivadas').value = paciente.notas_privadas;
                        } else {
