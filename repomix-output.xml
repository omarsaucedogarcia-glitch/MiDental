async function generarCertificadoPagosPDF() {
    const fechaInicio = document.getElementById('fechaInicioPagos').value;
    const fechaFin = document.getElementById('fechaFinPagos').value;
    const dentistaId = localStorage.getItem('midental_user_id');

    if (!fechaInicio || !fechaFin) return alert("Debes seleccionar ambas fechas.");
    if (fechaInicio > fechaFin) return alert("La fecha de inicio no puede ser posterior a la fecha de fin.");

    const btn = document.getElementById('btnEmitirCertificadoPagos');
    const txtOriginal = btn.innerHTML;
    btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Generando Documento...';
    btn.disabled = true;

    try {
        // Aseguramos que la fecha fin cubra hasta las 23:59 del día seleccionado
        const fechaInicioQuery = `${fechaInicio}T00:00:00.000Z`;
        const fechaFinQuery = `${fechaFin}T23:59:59.999Z`;

        // 1. Obtener pagos filtrados por rango de fechas
        const { data: pagosRango, error: errPagos } = await window.midental.from('pagos')
            .select('*')
            .eq('paciente_id', pacienteIdURL)
            .gte('fecha_pago', fechaInicioQuery)
            .lte('fecha_pago', fechaFinQuery)
            .order('fecha_pago', { ascending: true });

        if (errPagos) throw errPagos;

        if (!pagosRango || pagosRango.length === 0) {
            alert("No se encontraron pagos registrados en el rango de fechas seleccionado.");
            return;
        }

        // 2. Obtener datos del Profesional y Sede
        const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut').eq('id', dentistaId).single();
        const { data: sedes } = await window.midental.from('sedes_dentistas').select('direccion, comuna, nombre_sede').eq('dentista_id', dentistaId).limit(1);

        const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo.toUpperCase()}` : 'Profesional Tratante';
        const drRut = dr ? dr.rut : '';
        const nombreCentro = (sedes && sedes.length > 0 && sedes[0].nombre_sede) ? sedes[0].nombre_sede : 'Centro Odontológico';
        const direccionCentro = (sedes && sedes.length > 0) ? `${sedes[0].direccion}, ${sedes[0].comuna}` : 'Atención Particular';

        // 3. Crear PDF
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // Membrete
        doc.setFontSize(22); doc.setTextColor(2, 132, 199); doc.text("MiDental", 14, 20);
        doc.setFontSize(10); doc.setTextColor(100, 116, 139); doc.text("Red de Salud Digital", 14, 26);
        
        doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text(nombreCentro, 200, 20, { align: "right" });
        doc.setFontSize(9); doc.setTextColor(85, 85, 85); doc.text(`Sede: ${direccionCentro}`, 200, 26, { align: "right" });
        doc.setDrawColor(200, 200, 200); doc.line(14, 32, 200, 32);

        // Título del Certificado
        doc.setFontSize(15); doc.setFont("helvetica", "bold"); doc.setTextColor(30, 58, 138);
        doc.text("CERTIFICADO DE HISTORIAL DE PAGOS", 105, 45, { align: "center" });

        // Datos del Paciente
        doc.setFontSize(10); doc.setTextColor(50, 50, 50); doc.setFont("helvetica", "bold");
        doc.text("ANTECEDENTES DEL PACIENTE", 14, 58);
        doc.setFont("helvetica", "normal");
        doc.text(`Nombre: ${pacienteActual.nombre.toUpperCase()}`, 14, 64);
        doc.text(`RUT: ${pacienteActual.rut}`, 14, 70);

        // Rango de Fechas
        const dInicioFmt = new Date(fechaInicioQuery).toLocaleDateString('es-CL');
        const dFinFmt = new Date(fechaFinQuery).toLocaleDateString('es-CL');
        doc.setFont("helvetica", "bold");
        doc.text(`Período Reportado: ${dInicioFmt} al ${dFinFmt}`, 14, 80);

        // Tabla de pagos
        const tableColumn = ["Fecha y Hora", "Medio de Pago", "Notas / Detalle", "Monto ($)"];
        const tableRows = [];
        let totalPeriodo = 0;

        pagosRango.forEach(p => {
            const fechaFmt = new Date(p.fecha_pago).toLocaleString('es-CL', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
            const monto = parseFloat(p.monto) || 0;
            totalPeriodo += monto;
            
            tableRows.push([
                fechaFmt,
                p.medio_pago || '—',
                p.notas || '—',
                `$${monto.toLocaleString('es-CL')}`
            ]);
        });

        doc.autoTable({
            startY: 85,
            head: [tableColumn],
            body: tableRows,
            theme: 'grid',
            headStyles: { fillColor: [30, 58, 138], fontSize: 9, fontStyle: 'bold', halign: 'left' },
            styles: { fontSize: 8.5, cellPadding: 3, textColor: [30, 30, 30] },
            columnStyles: {
                0: { cellWidth: 35 },
                1: { cellWidth: 30 },
                2: { cellWidth: 85 },
                3: { cellWidth: 30, halign: 'right', fontStyle: 'bold', textColor: [21, 128, 61] } // Verde para montos
            },
            margin: { left: 14, right: 14 }
        });

        const finalY = doc.lastAutoTable.finalY || 100;
        
        // Gran Total del período
        doc.setFontSize(12); doc.setFont("helvetica", "bold"); doc.setTextColor(30, 58, 138);
        doc.text(`TOTAL PAGADO EN EL PERÍODO: $${totalPeriodo.toLocaleString('es-CL')}`, 196, finalY + 12, { align: "right" });

        // Firma del Profesional
        let signatureY = finalY + 40;
        if (signatureY > doc.internal.pageSize.height - 30) {
            doc.addPage();
            signatureY = 40;
        }

        doc.setDrawColor(0, 0, 0); doc.setLineWidth(0.3);
        doc.line(120, signatureY, 180, signatureY);
        doc.setFontSize(9); doc.setFont("helvetica", "normal"); doc.setTextColor(0, 0, 0);
        doc.text(drName, 150, signatureY + 5, { align: "center" });
        if (drRut) doc.text(`RUT: ${drRut}`, 150, signatureY + 10, { align: "center" });

        // 4. Descargar el archivo SIN enviarlo a Supabase
        const nombreArchivo = `Pagos_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}_${dInicioFmt.replace(/\//g,'-')}_al_${dFinFmt.replace(/\//g,'-')}.pdf`;
        doc.save(nombreArchivo);

        document.getElementById('modalCertificadoPagos').style.display = 'none';

    } catch (err) {
        console.error("Error generando PDF de pagos:", err);
        alert("Ocurrió un error al generar el documento: " + err.message);
    } finally {
        btn.innerHTML = txtOriginal;
        btn.disabled = false;
    }
}

        // ==========================================================
        // NUEVO PRESUPUESTO · ÚNICO DISPARADOR DE CICLO
        // ----------------------------------------------------------
        // REGLA DE ORO (integridad financiera):
        //   Esta función NO ejecuta UPDATE/DELETE sobre la tabla
        //   `pagos`. El libro contable de pagos permanece intacto y
        //   `cargarHistorialPagos()` sigue mostrando el histórico
        //   perpetuo. El Dashboard del dentista que agrega pagos
        //   diarios/semanales/mensuales tampoco se ve afectado.
        //
        // Acciones al pulsar el botón:
        //   1) confirm() con texto explícito sobre el archivado.
        //   2) UPDATE perfiles_pacientes.presupuesto_integral = 0.
        //   3) Archivado tolerante de procedures en edr.clinical_findings
        //      (is_active=false) — el odontograma deja de mostrarlos.
        //   4) Reset VISUAL de las 3 stats (Presupuesto / Pagado /
        //      Saldo) a $0 sin consultar nuevamente vista_balance_paciente,
        //      para que el ciclo empiece en blanco aunque haya pagos
        //      históricos en la tabla `pagos`.
        //   5) Limpieza local: tabla de planificación y motor del
        //      odontograma (engine.events de sesión).
        // ==========================================================
        async function nuevoPresupuesto() {
            if (isLocal) return alert("No disponible para fichas locales.");
            const ok = confirm(
                "¿Deseas iniciar un nuevo presupuesto?\n\n" +
                "Los tratamientos planificados actuales se archivarán y los " +
                "contadores en pantalla volverán a $0.\n\n" +
                "El historial de PAGOS del paciente permanece intacto."
            );
            if (!ok) return;

            const btn = document.getElementById('btnNuevoPresupuesto');
            const txtOrig = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;animation:spin 1s linear infinite;">sync</span> Reiniciando…';
            }

            try {
                // 1) Reset del valor objetivo en perfiles_pacientes (sticky en BD)
                const { error: errPerfil } = await window.midental
                    .from('perfiles_pacientes')
                    .update({ presupuesto_integral: 0 })
                    .eq('id', pacienteIdURL);
                if (errPerfil) throw errPerfil;

                // 2) Archivar tratamientos PLANIFICADOS en EDR.
                //    Tolerante: si la migración Fase B aún no fue aplicada o
                //    el paciente no tiene registros EDR, no rompemos el flujo.
                try {
                    const { data: idsArchivar } = await window.midental
                        .schema('edr')
                        .from('v_active_findings_by_perfil')
                        .select('finding_id, ontology_category')
                        .eq('perfil_paciente_id', pacienteIdURL)
                        .eq('ontology_category', 'procedure');

                    const ids = (idsArchivar || []).map(r => r.finding_id).filter(Boolean);
                    if (ids.length > 0) {
                        await window.midental
                            .schema('edr')
                            .from('clinical_findings')
                            .update({ is_active: false })
                            .in('id', ids);
                    }
                } catch (errEdr) {
                    console.warn('Archivado EDR omitido:', errEdr.message || errEdr);
                }

                // 3) Reset VISUAL de las 3 stats a $0 — sin re-fetch
                //    (un cargarControlPresupuesto traería el total_pagado
                //    histórico de la tabla `pagos` y rompería el "ciclo en blanco").
                const cero = '$0';
                document.getElementById('statPresupuestoTotal').innerText = cero;
                document.getElementById('statTotalPagado').innerText      = cero;
                document.getElementById('statSaldoRestante').innerText    = cero;
                const inp = document.getElementById('inputPresupuesto');
                if (inp) inp.value = '';

                // 4) Limpieza local: tabla de planificación + total
                const tbody = document.getElementById('tbodyPresupuesto');
                if (tbody) {
                    tbody.innerHTML = `
                        <tr>
                            <td><input type="text" class="input-diente" placeholder="Ej: 1.4"></td>
