    surface_id           UUID,
    finding_id           UUID,
    ontology_id          UUID NOT NULL,                    -- procedimiento codificado (CDT/SNOMED/LOCAL)
    status_id            UUID NOT NULL,                    -- estado actual
    previous_status_id   UUID,                             -- último estado anterior (para auditoría rápida)
    scheduled_at         TIMESTAMPTZ,
