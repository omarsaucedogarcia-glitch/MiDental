        async function procesarSubidaDocumentoDentista(event) {
            const file = event.target.files[0];
            if (!file) return;

            const dentistaId = localStorage.getItem('midental_user_id');
            const labelBtn = document.getElementById('labelBtnSubidaDoc');

            if (file.size > 5 * 1024 * 1024) {
                alert("El archivo es muy pesado. Máximo 5MB.");
                event.target.value = "";
                return;
            }

            labelBtn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Subiendo...';

            try {
                const fileExt = file.name.split('.').pop();
                const fileName = `Dr_${dentistaId}_${Date.now()}.${fileExt}`;

                // AQUÍ TAMBIÉN: BUCKET EN MINÚSCULAS EXACTO
                const { error: uploadError } = await window.midental.storage
                    .from('documentos_clinicos')
                    .upload(fileName, file);

                if (uploadError) throw uploadError;

                const { error: dbError } = await window.midental.from('documentos_pacientes').insert([{
                    paciente_id: pacienteIdURL,
                    dentista_id: dentistaId,
                    nombre_archivo: file.name,
                    tipo: file.type.includes('pdf') ? 'pdf' : 'imagen',
                    archivo_url: fileName 
                }]);

                if (dbError) throw dbError;

                alert("✅ Documento subido de forma privada a la ficha del paciente.");
                cargarDocumentosPaciente();

            } catch (err) {
                alert("Error al subir el archivo: " + err.message);
            } finally {
                labelBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">cloud_upload</span> Subir <input type="file" accept="image/*,.pdf" style="display: none;" onchange="procesarSubidaDocumentoDentista(event)">';
            }
        }

        // ==========================================
        // LÓGICA DE TABLA DE PRESUPUESTO Y NUEVOS CAMPOS
        // ==========================================
        function agregarFila() { 
            const tbody = document.getElementById('tbodyPresupuesto');
            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td><input type="text" class="input-diente" placeholder="Ej: 1.4"></td>
                    <td><input type="text" class="input-diag" placeholder="Caries"></td>
                    <td><input type="text" class="input-tratamiento" placeholder="Restauración"></td>
                    <td><input type="number" class="input-ref" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="text" class="ref-val input-total input-readonly" placeholder="0" readonly></td>
                </tr>
            `); 
        }

        function calcularFila(element) {
            const row = element.closest('tr');
            const refVal = parseFloat(row.querySelector('.input-ref').value) || 0;
            const desc = parseFloat(row.querySelector('.input-desc').value) || 0;
            const totalInput = row.querySelector('.input-total');
            
            let finalVal = 0;
            if (desc <= 100) {
                finalVal = refVal - (refVal * (desc / 100));
            } else {
                finalVal = refVal - desc;
            }
            
            totalInput.value = Math.max(0, finalVal); 
            totalInput.dataset.valorReal = Math.max(0, finalVal); 
            calcularGranTotal();
        }
        
        function calcularGranTotal() {
            let total = 0;
            document.querySelectorAll('.input-total').forEach(i => {
                total += (parseFloat(i.dataset.valorReal) || 0);
            });
            document.getElementById('granTotalPagar').innerText = total.toLocaleString('es-CL');
            return total;
        }

        // ==========================================
        // HELPER · Información de la Clínica del Dentista
        // Lee `sedes_dentistas.nombre_sede` para usarlo como
        // título corporativo en TODOS los PDFs (ficha, presupuesto,
        // receta, odontograma). Tolerante a errores: si no hay
        // sede registrada devuelve un fallback genérico.
        // ==========================================
        async function obtenerInfoClinica(dentistaId) {
            const fallback = { nombre: 'Consulta Dental', direccion: '', comuna: '' };
            if (!dentistaId) return fallback;
            try {
                const { data: sedes } = await window.midental
                    .from('sedes_dentistas')
                    .select('nombre_sede, direccion, comuna')
                    .eq('dentista_id', dentistaId)
                    .limit(1);
                if (!sedes || sedes.length === 0) return fallback;
                const s = sedes[0];
                return {
                    nombre:    s.nombre_sede || fallback.nombre,
                    direccion: s.direccion   || '',
                    comuna:    s.comuna      || ''
                };
            } catch (err) {
                console.error('[obtenerInfoClinica] Error:', err);
                return fallback;
            }
        }

        // ==========================================
        // MOTOR NATIVO PDF (JSPDF + AUTOTABLE) ACTUALIZADO
        // ==========================================
        async function generarDocumentoJSPDF(dentistaId, motivoTxt, diagTxt, accionTxt) {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis').eq('id', dentistaId).single();
            const clinica = await obtenerInfoClinica(dentistaId);

            const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo}` : 'No especificado';
            const drRut = dr ? dr.rut : '--';
            const drSis = dr ? dr.registro_sis : '--';
            const drSede = (clinica.direccion || clinica.comuna)
                ? `${clinica.direccion}${clinica.comuna ? ', ' + clinica.comuna : ''}`
                : 'Atención Particular';

            // Cabecera (Branding)
            doc.setFontSize(22);
            doc.setTextColor(0, 180, 216); // Pixar Cyan
            doc.text("MiDental", 14, 20);

            doc.setFontSize(10);
            doc.setTextColor(100, 116, 139);
            doc.text("Red de Salud Digital", 14, 26);

            // Título Derecho: NOMBRE DE LA CLÍNICA del dentista
            // (reemplaza al antiguo "Ficha Clínica y Presupuesto").
            doc.setFontSize(16);
            doc.setTextColor(30, 58, 138); // Blue Elegant
            const tituloClinica = doc.splitTextToSize(clinica.nombre, 110);
            doc.text(tituloClinica, 200, 20, { align: "right" });

            doc.setFontSize(10);
            doc.setTextColor(85, 85, 85);
            const yFecha = 20 + (tituloClinica.length * 6);
            doc.text(`Ficha Clínica · Fecha Emisión: ${new Date().toLocaleDateString('es-CL')}`, 200, yFecha, { align: "right" });

            const yDivider = Math.max(30, yFecha + 4);
            doc.setDrawColor(200, 200, 200);
            doc.line(14, yDivider, 200, yDivider);

            // Info de Paciente y Doctor
            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Datos del Paciente", 14, 40);
            doc.setFontSize(10);
            doc.setTextColor(50, 50, 50);
            doc.text(`Nombre: ${pacienteActual.nombre}`, 14, 47);
            doc.text(`RUT: ${pacienteActual.rut}`, 14, 53);

            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Profesional Tratante", 110, 40);
            doc.setFontSize(10);
            doc.setTextColor(50, 50, 50);
            doc.text(`Dentista: ${drName}`, 110, 47);
            doc.text(`RUT: ${drRut} | Registro SIS: ${drSis}`, 110, 53);
            doc.text(`Sede: ${drSede}`, 110, 59);

            // Evolución Clínica Estructurada
            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Evolución Clínica", 14, 70);
            
            doc.setFontSize(10);
            doc.setTextColor(50, 50, 50);
            const splitMotivo = doc.splitTextToSize(`Motivo de Consulta: ${motivoTxt}`, 180);
            doc.text(splitMotivo, 14, 77);
            
            let startYDiag = 77 + (splitMotivo.length * 5) + 2;
            const splitDiag = doc.splitTextToSize(`Diagnóstico: ${diagTxt}`, 180);
            doc.text(splitDiag, 14, startYDiag);

            let startYTrat = startYDiag + (splitDiag.length * 5) + 2;
            const splitTrat = doc.splitTextToSize(`Procedimiento: ${accionTxt}`, 180);
            doc.text(splitTrat, 14, startYTrat);

            let tableStartY = startYTrat + (splitTrat.length * 5) + 10;

            // Generar Tabla con AutoTable
            const tableColumn = ["Pieza", "Diagnóstico", "Prestación", "Valor Ref.", "Dscto", "Total"];
            const tableRows = [];
            let hayPresupuesto = false;

            document.querySelectorAll('#tbodyPresupuesto tr').forEach(tr => {
                const pieza = tr.querySelector('.input-diente').value || '-';
                const diag = tr.querySelector('.input-diag').value || '-';
                const trat = tr.querySelector('.input-tratamiento').value || '-';
                const refInput = parseFloat(tr.querySelector('.input-ref').value) || 0;
                const descInput = parseFloat(tr.querySelector('.input-desc').value) || 0;
                
                let totalInput = 0;
                const elTotal = tr.querySelector('.input-total');
                if(elTotal.dataset.valorReal) totalInput = parseFloat(elTotal.dataset.valorReal);
                else if (elTotal.value) totalInput = parseFloat(elTotal.value);

                if (!pieza && !diag && !trat && refInput === 0 && totalInput === 0) return;

                hayPresupuesto = true;
                const tdDesc = descInput <= 100 && descInput > 0 ? `${descInput}%` : (descInput > 100 ? `$${descInput.toLocaleString('es-CL')}` : '0%');

                tableRows.push([pieza, diag, trat, `$${refInput.toLocaleString('es-CL')}`, tdDesc, `$${totalInput.toLocaleString('es-CL')}`]);
            });

            if (hayPresupuesto) {
                doc.autoTable({
                    startY: tableStartY,
                    head: [tableColumn],
                    body: tableRows,
                    theme: 'grid',
                    headStyles: { fillColor: [30, 58, 138] },
                    styles: { fontSize: 9 }
                });

                const finalY = doc.lastAutoTable.finalY || tableStartY + 20;
                doc.setFontSize(14);
                doc.setTextColor(30, 58, 138);
                doc.text(`TOTAL A PAGAR: $${document.getElementById('granTotalPagar').innerText}`, 200, finalY + 15, { align: "right" });
            }

            // Firmas
            const finalPageY = doc.internal.pageSize.height;
            doc.setFontSize(10);
            doc.setTextColor(0, 0, 0);
            doc.line(30, finalPageY - 30, 90, finalPageY - 30);
            doc.text("Firma Paciente", 45, finalPageY - 25);
            
            doc.line(120, finalPageY - 30, 180, finalPageY - 30);
            doc.text("Firma Profesional", 135, finalPageY - 25);

            return doc;
        }

