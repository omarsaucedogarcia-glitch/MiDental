        // --- NUEVA FUNCIÓN: ANULACIÓN POR FUERZA MAYOR (AVISA AL PACIENTE) ---
        async function anularCitaNotificando() {
            if(!confirm("¿Seguro que deseas ANULAR esta hora? Se cancelará en el sistema y se abrirá WhatsApp para notificar al paciente.")) return;
            
            try {
                const { error } = await window.midental.from('citas_agenda').update({ estado: 'cancelada' }).eq('id', citaEnCursoData.cita_id);
                if (error) throw error;
                
                // Si el paciente tiene un teléfono válido, le avisamos
                if (citaEnCursoData.telefono && citaEnCursoData.telefono !== 'Sin registro' && citaEnCursoData.telefono !== '000000000') {
                    const telLimpio = citaEnCursoData.telefono.replace(/[^0-9]/g, '');
                    const partesFecha = citaEnCursoData.fecha.split('-');
                    const diaTexto = partesFecha[0] ? partesFecha[0].trim() : '';
                    const horaTexto = partesFecha[1] ? partesFecha[1].trim() : '';
                    
                    const msg = `Estimado(a) paciente ${citaEnCursoData.nombre}, lamentamos informarle que su hora médica agendada para el día ${diaTexto} a las ${horaTexto} ha sido ANULADA por motivos de fuerza mayor. Por favor, contáctenos para poder reagendar su hora. Disculpe las molestias.`;
                    
                    window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(msg)}`, '_blank');
                }
                
                cerrarModal('modalDetallePaciente');
                renderizarSemanaActual();

            } catch (err) { alert("Error al anular la cita médica."); }
        }

        // --- AUTOCOMPLETADO BLINDADO POR PRIVACIDAD ---
        let timeoutBusquedaNombre;
        
        async function buscarPacientePorNombre() {
            const input = document.getElementById('manualNombre');
            const termino = input.value.trim().toLowerCase();
            const lista = document.getElementById('listaAutocompletadoNombre');
            const dentistaId = localStorage.getItem('midental_user_id'); // Identificador del Dentista

            // Si el dentista empieza a escribir de nuevo, desvinculamos el ID anterior
            pacienteManualEncontradoId = null;
            document.getElementById('statusBusquedaRut').innerText = "";

            if (termino.length < 3) {
                lista.style.display = 'none';
                return;
            }

            clearTimeout(timeoutBusquedaNombre);
            timeoutBusquedaNombre = setTimeout(async () => {
                try {
                    // CAMBIO CLAVE DE SEGURIDAD: Buscamos SOLO en las citas de este dentista
                    const { data, error } = await window.midental.from('citas_agenda')
                        .select('paciente_id, perfiles_pacientes!inner(id, rut, nombre_completo, telefono)')
                        .eq('dentista_id', dentistaId)
                        .ilike('perfiles_pacientes.nombre_completo', `%${termino}%`)
                        .limit(30); // Límite amplio por si hay múltiples citas de la misma persona

                    if (error) throw error;

                    if (data && data.length > 0) {
                        // Limpiamos duplicados (un paciente puede tener 5 citas, solo queremos mostrarlo 1 vez)
                        const pacientesUnicos = [];
                        const idsVistos = new Set();
                        
                        for (let cita of data) {
                            const pct = cita.perfiles_pacientes;
                            if (pct && !idsVistos.has(pct.id)) {
                                idsVistos.add(pct.id);
                                pacientesUnicos.push(pct);
                                if (pacientesUnicos.length === 5) break; // Mostramos máximo 5 sugerencias
                            }
                        }

                        if (pacientesUnicos.length > 0) {
                            lista.innerHTML = '';
                            pacientesUnicos.forEach(pct => {
                                const item = document.createElement('div');
                                item.className = 'autocomplete-item';
                                item.innerHTML = `<strong>${pct.nombre_completo}</strong><span>RUT: ${pct.rut || 'Sin RUT'} | Tel: ${pct.telefono || 'Sin registro'}</span>`;
                                item.onclick = () => seleccionarPacienteAutocompletado(pct);
                                lista.appendChild(item);
                            });
                            lista.style.display = 'block';
                        } else {
                            lista.style.display = 'none';
                        }
                    } else {
                        lista.style.display = 'none';
                    }
                } catch (err) {
                    console.error("Error buscando por nombre:", err);
                }
            }, 400); 
        }

        function seleccionarPacienteAutocompletado(paciente) {
            pacienteManualEncontradoId = paciente.id;
            document.getElementById('manualNombre').value = paciente.nombre_completo || '';
            document.getElementById('manualRut').value = paciente.rut || '';
            document.getElementById('manualTelefono').value = paciente.telefono || '';
            
            document.getElementById('listaAutocompletadoNombre').style.display = 'none';
            
            const status = document.getElementById('statusBusquedaRut');
            status.innerText = "✅ Paciente autocompletado y vinculado.";
            status.style.color = "var(--green-success)";
        }
        
        // Ocultar la lista si el usuario hace clic afuera del buscador
        document.addEventListener('click', function(e) {
            if(e.target.id !== 'manualNombre') {
                const lista = document.getElementById('listaAutocompletadoNombre');
                if(lista) lista.style.display = 'none';
            }
        });

        // =========================================================
        // MÓDULO SALDO CORRIENTE: REGISTRO DE PAGO AL FINALIZAR CITA
        // =========================================================
        function abrirModalPagoFinalizar() {
            if (!citaEnCursoData) return;
            document.getElementById('pagoNombrePaciente').innerText = citaEnCursoData.nombre || 'Paciente';
            document.getElementById('pagoMonto').value = '';
            document.getElementById('pagoMedio').value = 'Efectivo';
            document.getElementById('pagoNotas').value = '';
            // Ocultamos el modal de detalle para evitar superposición visual
            document.getElementById('modalDetallePaciente').style.display = 'none';
            document.getElementById('modalRegistrarPago').style.display = 'flex';
        }

        async function guardarPagoYFinalizar() {
            if (!citaEnCursoData || !citaEnCursoData.cita_id) return;

            const monto = parseFloat(document.getElementById('pagoMonto').value);
            const medio = document.getElementById('pagoMedio').value;
            const notas = document.getElementById('pagoNotas').value.trim();

            if (isNaN(monto) || monto < 0) {
                return alert("Ingresa un monto válido. Si no hay cobro, usa el botón 'Finalizar sin pago'.");
            }

            const dentistaId = localStorage.getItem('midental_user_id');
            const btn = document.getElementById('btnGuardarPago');
            btn.disabled = true;
            btn.innerText = "Guardando...";

            try {
                // 1) Registramos el pago respetando las columnas exactas de Supabase
                if (monto > 0) {
                    if (!citaEnCursoData.paciente_id) {
                        alert("⚠️ Esta cita no está vinculada a un paciente registrado. El pago no se podrá asociar al saldo del paciente.");
                    } else {
                        const { error: errPago } = await window.midental.from('pagos').insert([{
                            paciente_id: citaEnCursoData.paciente_id,
                            dentista_id: dentistaId,
                            monto: monto,
                            metodo_pago: medio, // Corregido: Coincide con tu SQL
                            notas: notas || null
                            // Eliminamos cita_id porque no existe en tu tabla de pagos
                        }]);
                        if (errPago) throw errPago;
                    }
                }

                // 2) Cerramos la atención clínica
                const { error: errEstado } = await window.midental.from('citas_agenda')
                    .update({ estado: 'completada' })
                    .eq('id', citaEnCursoData.cita_id);
                if (errEstado) throw errEstado;

                alert("✅ Atención finalizada" + (monto > 0 ? ` y pago de $${monto.toLocaleString('es-CL')} registrado.` : "."));
                cerrarModal('modalRegistrarPago');
                renderizarSemanaActual();
                
            } catch (err) {
                console.error("Error al guardar pago:", err);
                alert("Error al registrar el pago: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle; font-size: 1.1rem;">save</span> Guardar y Finalizar';
            }
        }

        async function finalizarSinPago() {
            if (!citaEnCursoData) return;
            cerrarModal('modalRegistrarPago');
            await actualizarEstadoCita('completada');
        }
    </script>
</body>
</html>
