<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Panel Profesional</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <style>
        /* =========================================================
           DISEÑO CORPORATIVO "EXECUTIVE PIXAR"
           ========================================================= */
        body { background-color: #f4f7fb; } 
        
        .dashboard-content { padding-top: 20px; }

        .topbar { background: white; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border-radius: 15px; }

        /* Monitor de Ofertas Flash - Rediseño Elegante */
        .active-offer-monitor { 
            background: linear-gradient(135deg, var(--blue-elegant), #1e3a8a); 
            border-radius: 20px; 
            padding: 25px; 
            color: white; 
            box-shadow: 0 10px 30px rgba(30, 58, 138, 0.2); 
            margin-bottom: 25px; 
            position: relative;
            overflow: hidden;
        }
        .active-offer-monitor::before {
            content: ""; position: absolute; top: -50%; right: -10%; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(0,180,216,0.3) 0%, transparent 70%); border-radius: 50%;
        }

        .monitor-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.15); padding-bottom: 15px; position: relative; z-index: 2;}
        .monitor-title { display: flex; align-items: center; gap: 12px; }
        .monitor-title h3 { margin: 0; font-size: 1.2rem; font-weight: normal; color: rgba(255,255,255,0.9); }
        .monitor-title h3 span { color: white; font-weight: 900; letter-spacing: 0.5px; }
        
        .btn-marketing-manage {
            background: white; color: var(--blue-elegant); border: none; padding: 10px 20px;
            border-radius: 12px; font-weight: 900; font-size: 0.85rem; cursor: pointer;
            transition: all 0.2s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        .btn-marketing-manage:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.15); background: #f8fafc; }

        .pulse-icon { color: var(--pixar-cyan); animation: pulse-cyan 2s infinite; }
        @keyframes pulse-cyan { 0% { transform: scale(1); opacity: 1; text-shadow: 0 0 10px rgba(0,180,216,0.5); } 50% { transform: scale(1.1); opacity: 0.8; text-shadow: 0 0 20px rgba(0,180,216,0.8); } 100% { transform: scale(1); opacity: 1; text-shadow: 0 0 10px rgba(0,180,216,0.5); } }
        
        .monitor-stats { display: flex; gap: 15px; position: relative; z-index: 2;}
        .stat-box { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 15px; padding: 15px 20px; display: inline-flex; align-items: center; gap: 15px; backdrop-filter: blur(5px); }
        .stat-box small { display: block; color: rgba(255,255,255,0.7); font-size: 0.8rem; font-weight: bold; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px; }
        .stat-box strong { display: block; font-size: 1.4rem; color: white; }
        .time-box strong { color: var(--pixar-cyan); }

        /* Estilo Desbloqueo PIN */
        .pin-unlock-box { background: white; border: 1px solid #e2e8f0; border-radius: 20px; padding: 25px; color: #334155; margin-bottom: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); display: flex; flex-direction: column; gap: 15px;}
        .pin-header { display: flex; align-items: center; gap: 12px;}
        .pin-header h3 { color: var(--blue-elegant); font-weight: 900; margin: 0; font-size: 1.3rem;}
        
        .pin-input-wrapper { display: flex; gap: 15px; }
        .pin-input { flex: 1; padding: 15px; border-radius: 12px; border: 2px solid #e2e8f0; background: #f8fafc; text-transform: uppercase; font-weight: 900; text-align: center; letter-spacing: 5px; font-size: 1.2rem; outline: none; transition: 0.3s; color: var(--blue-elegant);}
        .pin-input:focus { border-color: var(--pixar-cyan); box-shadow: 0 0 0 4px rgba(0, 180, 216, 0.1); background: white;}
        .btn-desbloquear { border-radius: 12px; padding: 0 25px; font-size: 1rem; font-weight: bold; letter-spacing: 0.5px;}

        /* Solicitudes Pendientes */
        .request-card { background: white; border: 1px solid #e2e8f0; border-left: 6px solid var(--pixar-orange); border-radius: 15px; padding: 18px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02); transition: 0.2s;}
        .request-card:hover { transform: translateX(5px); box-shadow: 0 6px 15px rgba(0,0,0,0.05); }
        .request-info h4 { margin: 0 0 8px 0; color: var(--blue-elegant); font-size: 1.1rem; }
        .request-info p { margin: 0; font-size: 0.9rem; color: #64748b; display: flex; align-items: center; gap: 6px; }
        
        .btn-confirm-action { background: var(--green-success); color: white; padding: 10px 15px; font-size: 0.9rem; border-radius: 10px; border: none; cursor: pointer; display: flex; align-items: center; gap: 5px; font-weight: bold; transition: 0.2s;}
        .btn-confirm-action:hover { background: #15803d; }
        
        .btn-reject-action { background: white; color: var(--red-urgency); border: 1px solid var(--red-urgency); padding: 10px 15px; font-size: 0.9rem; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 5px; font-weight: bold; transition: 0.2s;}
        .btn-reject-action:hover { background: #fef2f2; }
        
        .request-actions { display: flex; gap: 10px; }

        /* Citas Confirmadas */
        .appointment-card { background: white; border: 1px solid #e2e8f0; border-left: 6px solid var(--green-success); border-radius: 15px; padding: 18px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 10px rgba(0,0,0,0.02);}
        .appointment-time { font-size: 1.4rem; font-weight: 900; color: var(--blue-elegant); min-width: 90px; text-align: center; background: #f8fafc; padding: 10px; border-radius: 10px; border: 1px solid #e2e8f0;}
        .summary-widgets-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .summary-card { background: white; border: 1px solid #e2e8f0; border-radius: 20px; padding: 25px; display: flex; align-items: center; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
        .summary-icon { width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0;}
        .summary-icon.blue-bg { background: #eff6ff; color: #3b82f6; }
        .summary-icon.orange-bg { background: #fff7ed; color: #d97706; }
        .summary-info h3 { margin: 0 0 5px 0; font-size: 0.9rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;}
        .summary-info strong { font-size: 1.6rem; color: var(--blue-elegant); font-weight: 900;}

        /* Estilo Switch Apple */
        .status-toggle-container { background: #f8fafc; padding: 12px 20px; border-radius: 15px; border: 1px solid #e2e8f0; }
        .apple-switch { position: relative; display: inline-block; width: 54px; height: 30px; }
        .apple-switch input { opacity: 0; width: 0; height: 0; }
        .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #cbd5e1; transition: .4s; }
        .slider:before { position: absolute; content: ""; height: 22px; width: 22px; left: 4px; bottom: 4px; background-color: white; transition: .3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        input:checked + .slider { background-color: var(--red-urgency); }
        input:checked + .slider:before { transform: translateX(24px); }
        .slider.round { border-radius: 34px; }
        .slider.round:before { border-radius: 50%; }
        
        @media (max-width: 768px) {
            .summary-widgets-grid { grid-template-columns: 1fr; }
            .pin-input-wrapper { flex-direction: column; }
            .btn-desbloquear { padding: 15px; }
            .active-offer-monitor { padding: 20px; }
            .monitor-header { flex-direction: column; align-items: flex-start; gap: 15px; }
            .btn-marketing-manage { width: 100%; text-align: center; }
            .request-card { flex-direction: column; align-items: flex-start; gap: 15px;}
            .request-actions { width: 100%; justify-content: space-between;}
            .btn-confirm-action, .btn-reject-action { flex: 1; justify-content: center;}
        }
        /* =========================================================
           SISTEMA DE PESTAÑAS (TABS) PARA AGENDA
           ========================================================= */
        .agenda-tabs { display: flex; gap: 10px; background: #e2e8f0; padding: 5px; border-radius: 12px; width: fit-content; }
        .agenda-tab-btn { background: transparent; border: none; padding: 8px 20px; border-radius: 8px; font-weight: bold; color: #64748b; cursor: pointer; transition: 0.3s; font-size: 0.9rem;}
        .agenda-tab-btn.active { background: white; color: var(--blue-elegant); box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .tab-content { display: none; animation: fadeIn 0.3s ease; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

    </style>
</head>
