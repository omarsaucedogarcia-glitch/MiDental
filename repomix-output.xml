    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        let archivoVideoSeleccionado = null;
        let videosSemanaActual = 0;

        document.addEventListener('DOMContentLoaded', () => {
            verificarCuotaSemanal();
            cargarMisShorts();
        });

        // 1. Manejo de Archivos Visual
        function seleccionarArchivoVideo(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                
                // Validación básica de tamaño (Max 50MB)
                if (file.size > 50 * 1024 * 1024) {
                    alert("El video es muy pesado. El tamaño máximo es 50MB.");
                    input.value = "";
                    return;
                }

                archivoVideoSeleccionado = file;
                document.getElementById('uploadIcon').innerText = "check_circle";
                document.getElementById('uploadIcon').style.color = "var(--green-success)";
                document.getElementById('uploadText').innerText = "Video preparado para subir";
                document.getElementById('fileNameDisplay').innerText = file.name;
                document.getElementById('uploadZone').style.borderColor = "var(--green-success)";
            }
        }

        // 2. Cálculo de la Cuota Freemium
        async function verificarCuotaSemanal() {
            const userId = localStorage.getItem('midental_user_id');
            if(!userId) return;

            try {
                // Calcular hace 7 días
                const haceUnaSemana = new Date();
                haceUnaSemana.setDate(haceUnaSemana.getDate() - 7);

                // Contar cuántos videos ha subido el usuario en los últimos 7 días
                const { count, error } = await window.midental
                    .from('shorts_videos')
                    .select('*', { count: 'exact', head: true })
                    .eq('dentista_id', userId)
                    .gte('created_at', haceUnaSemana.toISOString());

                if (error) throw error;

                videosSemanaActual = count || 0;
                document.getElementById('shortsUsed').innerText = videosSemanaActual;

                // Cambiar el diseño del botón según la cuota
                const btn = document.getElementById('btnPublicarShort');
                if (videosSemanaActual >= 2) {
                    btn.className = "btn-publish-premium";
                    btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">toll</span> Publicar Video (-1 Token)`;
                } else {
                    btn.className = "btn-publish-free";
                    btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">publish</span> Publicar Gratis (${2 - videosSemanaActual} restantes)`;
                }

            } catch (err) {
                console.error("Error al calcular cuota:", err);
            }
        }

        // 3. Lógica de Subida a Supabase (CORREGIDA A MINÚSCULAS)
        async function lanzarShortReal() {
            const userId = localStorage.getItem('midental_user_id');
            if(!userId) return alert("Sesión inválida.");

            if(!archivoVideoSeleccionado) return alert("⚠️ Debes seleccionar un archivo de video primero.");
            const desc = document.getElementById('shortDescription').value.trim();
            if(!desc) return alert("⚠️ Escribe una descripción atractiva para tu video.");
            const cta = document.getElementById('shortCTA').value;

            const requierePago = videosSemanaActual >= 2;
            let saldoRealDB = 0;

            const btn = document.getElementById('btnPublicarShort');
            btn.disabled = true;
            btn.innerHTML = `<span class="material-symbols-outlined" style="animation: spin 1s linear infinite; vertical-align: middle;">sync</span> Verificando...`;

            try {
                // Si requiere pago, verificar saldo real
                if (requierePago) {
                    const { data: perfilData, error: perfilError } = await window.midental
                        .from('perfiles_dentistas')
                        .select('tokens_disponibles')
                        .eq('id', userId)
                        .single();
                    
                    if (perfilError) throw new Error("Error al verificar el monedero.");
                    saldoRealDB = perfilData.tokens_disponibles || 0;

                    if (saldoRealDB < 1) {
                        throw new Error("No te quedan Tokens para publicar videos extra esta semana. Recarga en el Monedero.");
                    }
                }

                btn.innerHTML = `<span class="material-symbols-outlined" style="animation: spin 1s linear infinite; vertical-align: middle;">sync</span> Subiendo video... (No cierres la ventana)`;

                // A. Subir el MP4 al Storage en minúsculas: 'reels'
                const fileExt = archivoVideoSeleccionado.name.split('.').pop();
                const fileName = `short_${userId}_${Date.now()}.${fileExt}`;
                
                const { error: uploadError } = await window.midental.storage
                    .from('reels')
                    .upload(fileName, archivoVideoSeleccionado);
                
                if (uploadError) throw new Error("Error al subir el video al servidor (Storage): " + uploadError.message);
                
                // Obtener URL Pública desde el bucket en minúsculas
                const { data: urlData } = window.midental.storage
                    .from('reels')
                    .getPublicUrl(fileName);
                    
                const videoPublicUrl = urlData.publicUrl;

                // B. Guardar el registro en la base de datos
                const { error: insertError } = await window.midental.from('shorts_videos').insert([{
                    dentista_id: userId,
                    video_url: videoPublicUrl,
                    descripcion: desc,
                    cta_tipo: cta,
                    costo_token: requierePago // true si costó un token, false si fue gratis
                }]);

                if (insertError) throw new Error("Error al registrar en la Base de Datos: " + insertError.message);

                // C. Cobrar el Token asegurado
                if (requierePago) {
                    const nuevoSaldo = saldoRealDB - 1;
                    await window.midental.from('perfiles_dentistas').update({ tokens_disponibles: nuevoSaldo }).eq('id', userId);
                    if (typeof window.sincronizarDatosGlobales === 'function') window.sincronizarDatosGlobales(); 
                }

                // D. Éxito
                alert("🚀 ¡Short publicado con éxito! Ya está visible en la red MiDental.");
                
                // Limpiar formulario y recargar
                archivoVideoSeleccionado = null;
                document.getElementById('uploadIcon').innerText = "movie";
                document.getElementById('uploadIcon').style.color = "#cbd5e1";
                document.getElementById('uploadText').innerText = "Selecciona un video (.mp4)";
                document.getElementById('fileNameDisplay').innerText = "";
                document.getElementById('shortDescription').value = "";
                document.getElementById('uploadZone').style.borderColor = "#ccc";

                verificarCuotaSemanal();
                cargarMisShorts();

            } catch (err) {
                alert("Fallo al publicar: " + err.message);
            } finally {
                btn.disabled = false;
                verificarCuotaSemanal(); 
            }
        }

        // 4. Mostrar los videos activos del dentista
        async function cargarMisShorts() {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('shortsActivosContenedor');
            if(!userId || !contenedor) return;

            const { data: videos, error } = await window.midental.from('shorts_videos')
                .select('*')
                .eq('dentista_id', userId)
                .order('created_at', { ascending: false });

            if (error || !videos || videos.length === 0) {
                contenedor.innerHTML = '<p style="color:#aaa; font-size: 0.9rem; text-align: center; margin-top: 20px;">No tienes videos publicados.</p>';
                return;
            }

            contenedor.innerHTML = "";
            videos.forEach(video => {
                const fecha = new Date(video.created_at).toLocaleDateString('es-CL');
                const badgePago = video.costo_token ? '<span style="color: var(--dentist-purple); font-size: 0.7rem; font-weight:bold;">PREMIUM</span>' : '<span style="color: var(--green-success); font-size: 0.7rem; font-weight:bold;">GRATIS</span>';
                
                let ctaTexto = "Botón: Ver Perfil";
                if(video.cta_tipo === 'agenda') ctaTexto = "Botón: Agendar Cita";
                if(video.cta_tipo === 'oferta') ctaTexto = "Botón: Ver Oferta Flash";

                // Extraemos el nombre del archivo de la URL pública para poder borrarlo después
                const fileNameArray = video.video_url.split('/');
                const fileName = fileNameArray[fileNameArray.length - 1];

                contenedor.innerHTML += `
                    <div class="my-shorts-card">
                        <div class="short-thumb-placeholder">
                            <span class="material-symbols-outlined">play_arrow</span>
                        </div>
                        <div style="flex: 1;">
                            <div class="short-card-header">
                                <span style="font-size: 0.75rem; color: #888;">${fecha}</span>
                                ${badgePago}
                            </div>
                            <p style="margin: 5px 0; font-size: 0.85rem; color: var(--blue-elegant); font-weight: bold; line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${video.descripcion}</p>
                            <p style="margin: 0; font-size: 0.75rem; color: var(--pixar-cyan);">${ctaTexto}</p>
                        </div>
                        <button onclick="eliminarShort('${video.id}', '${fileName}')" style="background:transparent; border:none; color:var(--red-urgency); cursor:pointer;" title="Eliminar Video">
                            <span class="material-symbols-outlined">delete</span>
                        </button>
                    </div>
                `;
            });
        }

        // CORRECCIÓN: Borrado completo (DB + Storage apuntando a bucket 'reels' en minúsculas)
        async function eliminarShort(idVideo, fileName) {
            if(!confirm("¿Estás seguro de eliminar este Short? Se borrará permanentemente de los servidores de MiDental.")) return;
            
            try {
                // 1. Borrar el archivo físico del Storage ('reels') para liberar espacio
                if(fileName) {
                    await window.midental.storage.from('reels').remove([fileName]);
                }

                // 2. Borrar el registro de la Base de Datos
                const { error } = await window.midental.from('shorts_videos').delete().eq('id', idVideo);
                if(error) throw error;
                
                cargarMisShorts();
                verificarCuotaSemanal(); // Recalcula la cuota por si borró un video de esta semana

            } catch (err) {
                alert("Error al borrar el video: " + err.message);
            }
        }
        
        function cerrarSesionLocal() {
            localStorage.removeItem('midental_user_id');
            localStorage.removeItem('midental_user_tipo');
            window.location.href = 'index.html';
        }
    </script>
</body>
</html>
