            titulo: 'Contensor Post-Orto',
            claseAlerta: 'smart-recommendation', icon: 'check_box',
            rec: 'Paciente portador activo. Establecer controles cada 3 meses y revisar integridad de la ferulización.',
            opciones: []
        }
    };

    // ==========================================
    // FUNCIÓN DE DISPARO Y CONEXIÓN CON PRESUPUESTO
    // ==========================================
    let hallazgoActivoSeleccionado = null;

    function lanzarAsistenteClinico(codigoKey) {
        const data = arbolClinico[codigoKey];
        if (!data) return;
        
        hallazgoActivoSeleccionado = data.titulo;
        const panel = document.getElementById('smartPanelContainer');
        
        // Armamos los botones de opciones de tratamiento dinámicamente
        let htmlOpciones = '';
        if (data.opciones.length > 0) {
            htmlOpciones = `<div class="smart-options-title">Planes de Tratamiento sugeridos:</div>`;
            data.opciones.forEach(op => {
                // Al hacer clic, enviamos la opción seleccionada directo a la tabla de presupuesto
                htmlOpciones += `<button class="smart-plan-btn" onclick="agregarPlanAlPresupuesto('${op}', this)"><span>+</span> ${op}</button>`;
            });
        } else {
            htmlOpciones = `<div class="smart-options-title" style="color:var(--green-success);">✓ Condición auto-gestionable. No requiere plan adicional.</div>`;
        }

        panel.innerHTML = `
            <h4 class="smart-panel-title"><span class="material-symbols-outlined">${data.icon}</span> ${data.titulo}</h4>
            <div class="${data.claseAlerta}">
                <strong>Recomendación Clínica:</strong><br>${data.rec}
            </div>
            ${htmlOpciones}
        `;
        
        panel.style.display = 'block';
    }

    function agregarPlanAlPresupuesto(prestacionSeleccionada, btnElement) {
        let piezaNum = "Pieza ?";

        // 1) Preferimos la pieza expuesta por el motor del odontograma
        //    (engine.selectedFDI) → es la fuente de verdad y respeta
        //    multi-pieza/multi-superficie.
        let fdi = null;
        if (window.MiDentalOdontograma && typeof window.MiDentalOdontograma.getState === 'function') {
            const st = window.MiDentalOdontograma.getState();
            if (st && st.selectedFDI) fdi = st.selectedFDI;
        }
        // 2) Fallback: leer la clase real del motor (.odn-selected, NO .selected).
        if (!fdi) {
            const activeTooth = document.querySelector('g.odn-tooth.odn-selected[data-fdi]');
            if (activeTooth && activeTooth.dataset.fdi) fdi = activeTooth.dataset.fdi;
        }
        if (fdi && fdi.length >= 2) {
            piezaNum = `${fdi.charAt(0)}.${fdi.charAt(1)}`;
        }

        const tbody = document.getElementById('tbodyPresupuesto');
        const filas = tbody.querySelectorAll('tr');
        let insertada = false;
        
        if (filas.length === 1) {
            const r = filas[0];
            const empty = !r.querySelector('.input-diente').value && !r.querySelector('.input-diag').value && !r.querySelector('.input-tratamiento').value;
            if (empty) {
                r.querySelector('.input-diente').value = piezaNum;
                r.querySelector('.input-diag').value = hallazgoActivoSeleccionado;
                r.querySelector('.input-tratamiento').value = prestacionSeleccionada;
                insertada = true;
            }
        }

        if (!insertada) {
            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td><input type="text" class="input-diente" value="${piezaNum}" placeholder="Ej: 1.4"></td>
                    <td><input type="text" class="input-diag" value="${hallazgoActivoSeleccionado}" placeholder="Diagnóstico"></td>
                    <td><input type="text" class="input-tratamiento" value="${prestacionSeleccionada}" placeholder="Prestación"></td>
                    <td><input type="number" class="input-ref" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="text" class="ref-val input-total input-readonly" placeholder="0" readonly></td>
                </tr>
            `);
        }

        // =========================================================
        // NUEVO: REGISTRO AUTOMÁTICO EN EL TIMELINE (HISTORIAL DERECHO)
        // =========================================================
        const timelineRail = document.getElementById('odontogramaTimelineRail');
        const emptyMsg = document.getElementById('odnTimelineEmpty');
        if (emptyMsg) emptyMsg.style.display = 'none'; // Ocultamos el mensaje de "Vacío"

        const fechaHora = new Date().toLocaleString('es-CL', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: 'short' });
        
        // Lógica de colores según gravedad
        let colorBadge = "var(--pixar-cyan)";
        if (hallazgoActivoSeleccionado.includes('Caries') || hallazgoActivoSeleccionado.includes('Pulpitis') || hallazgoActivoSeleccionado.includes('Necrosis')) {
            colorBadge = "#ef4444"; // Alerta Roja
        } else if (hallazgoActivoSeleccionado.includes('Sano') || prestacionSeleccionada.includes('Preventivo')) {
            colorBadge = "#10b981"; // Verde Estable
        } else if (hallazgoActivoSeleccionado.includes('Mancha') || hallazgoActivoSeleccionado.includes('Rehabilitación')) {
            colorBadge = "#f59e0b"; // Naranja Advertencia
        }

        // Recuperamos la recomendación actual de la IA que está en pantalla
        const reco = document.querySelector('.smart-recommendation');
        const aiRecomendacion = reco ? reco.innerText : '';

        // Inyectamos la tarjeta al inicio del historial
        const cardTimelineHTML = `
            <div style="background: white; border: 1px solid #e2e8f0; border-left: 5px solid ${colorBadge}; border-radius: 12px; padding: 15px; margin-bottom: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.03); animation: fadeIn 0.4s ease;">
                <div style="font-size: 0.8rem; color: #64748b; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                    <span><span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">schedule</span> ${fechaHora}</span>
                    <strong style="color: var(--blue-elegant); font-size: 1rem; background: #f8fafc; padding: 2px 8px; border-radius: 6px;">${piezaNum}</strong>
                </div>
                <div style="font-size: 0.95rem; color: #1e293b; font-weight: 900; margin-bottom: 6px;">${hallazgoActivoSeleccionado}</div>
                <div style="font-size: 0.85rem; color: #475569; margin-bottom: 8px;"><span class="material-symbols-outlined" style="font-size: 0.9rem; vertical-align: middle; color: ${colorBadge};">medical_services</span> ${prestacionSeleccionada}</div>
                <div style="font-size: 0.8rem; color: #64748b; background: #f1f5f9; padding: 8px; border-radius: 6px; font-style: italic;">
                    ${aiRecomendacion}
                </div>
            </div>
        `;
        timelineRail.insertAdjacentHTML('afterbegin', cardTimelineHTML);

        // Feedback visual seguro cross-browser
        if (btnElement) {
            btnElement.style.background = "var(--green-success)";
            btnElement.style.color = "white";
            btnElement.style.borderColor = "var(--green-success)";
            btnElement.innerHTML = `<span>✓</span> Agregado y Registrado`;
        }
        
        setTimeout(() => {
            document.getElementById('smartPanelContainer').style.display = 'none';
        }, 800);
    }

    // =========================================================
    // [DESACTIVADO] · Listener legacy de selección por SVG
    // ---------------------------------------------------------
    // Este handler aplicaba la clase `.selected` (sin prefijo
    // `odn-`) que pintaba las caras de CYAN por encima de los
    // colores clínicos del motor (rojo activo / verde planificado
    // / azul histórico). El motor en js/odontograma.js ya tiene
    // su propia delegación de clicks que aplica `.odn-selected`
    // sobre `g.odn-tooth`, por lo que mantener este listener
    // generaba una doble pintura y rompía la semántica visual.
    // Se elimina para que el motor sea la única fuente de verdad.
    // =========================================================

    // Pequeño script para manejar los menús desplegables del nuevo panel (Acordeones)
    document.querySelectorAll('.odn-finding-group__head').forEach(btn => {
        btn.addEventListener('click', function() {
            const body = this.nextElementSibling;
            const icon = this.querySelector('.odn-finding-group__chevron');
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            
            this.setAttribute('aria-expanded', !isExpanded);
            if(isExpanded) {
                body.style.display = 'none';
                icon.style.transform = 'rotate(0deg)';
            } else {
                body.style.display = 'block';
                icon.style.transform = 'rotate(180deg)';
            }
            // Al cambiar de categoría, ocultamos el panel inteligente si estaba abierto
            document.getElementById('smartPanelContainer').style.display = 'none';
        });
    });
</script>
</body>
</html>
