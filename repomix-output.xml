        <a href="ofertas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom priv-link"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom priv-link"><span class="material-symbols-outlined">description</span>Documentos</a>
