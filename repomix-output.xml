async function generarEpicrisisImprimiblePDF() {
    const dentistaId = localStorage.getItem('midental_user_id');
    if (!dentistaId) return alert("Error de sesión.");

    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();

        // 1. Obtener datos del Profesional y su Sede
        const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis, especialidad').eq('id', dentistaId).single();
        const { data: sedes } = await window.midental.from('sedes_dentistas').select('nombre_sede, direccion, comuna').eq('dentista_id', dentistaId).limit(1);

        const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo.toUpperCase()}` : 'No especificado';
        const drRut = dr ? dr.rut : '--';
        const drSis = dr ? dr.registro_sis : '--';
        const nombreCentro = (sedes && sedes.length > 0 && sedes[0].nombre_sede) ? sedes[0].nombre_sede.toUpperCase() : 'CENTRO ODONTOLÓGICO';
        const direccionCentro = (sedes && sedes.length > 0) ? `${sedes[0].direccion}, ${sedes[0].comuna}` : 'Atención Particular';

        // 2. Obtener TODAS las atenciones clínicas del paciente
        let query = window.midental.from('fichas_clinicas').select('*').order('created_at', { ascending: true });
        
        if (isLocal && pacienteActual.rut && pacienteActual.rut !== "No registrado") {
            query = query.eq('paciente_rut', pacienteActual.rut);
        } else if (!isLocal) {
            query = query.eq('paciente_id', pacienteIdURL);
        } else {
            query = query.eq('paciente_nombre', pacienteActual.nombre);
        }

        const { data: historial, error: histError } = await query;
        if (histError) throw histError;

        if (!historial || historial.length === 0) {
            return alert("El paciente no registra atenciones previas firmadas para generar el informe.");
        }

        // 3. Encabezado del Documento Estilo Clínico Institucional
        doc.setFontSize(18); doc.setTextColor(30, 58, 138); doc.setFont("helvetica", "bold");
        doc.text(nombreCentro, 14, 20);
        doc.setFontSize(9); doc.setTextColor(100, 116, 139); doc.setFont("helvetica", "normal");
        doc.text(`Ubicación: ${direccionCentro}`, 14, 25);

        doc.setFontSize(14); doc.setTextColor(15, 23, 42); doc.setFont("helvetica", "bold");
        doc.text("RESUMEN DE ATENCIONES CLÍNICAS (EPICRISIS)", 105, 40, { align: "center" });
        doc.setDrawColor(200, 200, 200); doc.line(14, 44, 200, 44);

        // Bloque informativo del Paciente y Profesional
        doc.setFontSize(9); doc.setTextColor(50, 50, 50); doc.setFont("helvetica", "bold");
        doc.text("ANTECEDENTES DEL PACIENTE", 14, 51);
        doc.setFont("helvetica", "normal");
        doc.text(`Nombre: ${pacienteActual.nombre.toUpperCase()}`, 14, 56);
        doc.text(`RUT: ${pacienteActual.rut}`, 14, 61);
        if (pacienteActual.fecha_nacimiento) {
            const [y, m, d] = pacienteActual.fecha_nacimiento.split('-');
            doc.text(`F. Nacimiento: ${d}/${m}/${y}`, 14, 66);
        }

        doc.setFont("helvetica", "bold");
        doc.text("PROFESIONAL RESPONSABLE", 110, 51);
        doc.setFont("helvetica", "normal");
        doc.text(`Odontólogo: ${drName}`, 110, 56);
        doc.text(`RUT: ${drRut} | Registro SIS: ${drSis}`, 110, 61);
        doc.text(`Fecha Emisión: ${new Date().toLocaleDateString('es-CL')}`, 110, 66);

        doc.line(14, 71, 200, 71);

        // 4. Estructuración de la Tabla de Atenciones
        const tableColumn = ["Fecha", "Motivo de Consulta", "Diagnóstico Clínico", "Procedimiento Realizado", "Monto"];
        const tableRows = [];

        historial.forEach(ficha => {
            const fechaAtencion = new Date(ficha.ultima_atencion || ficha.created_at).toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' });
            const histoJson = ficha.historial_json || {};
            
            const motivoStr = histoJson.motivo || ficha.motivo_consulta || 'Sin especificar';
            const diagStr = histoJson.diagnostico || 'Revisar registro';
            const accionStr = histoJson.tratamiento || ficha.accion_realizada || 'Sin registro';
            const pptoStr = ficha.presupuesto_total > 0 ? `$${ficha.presupuesto_total.toLocaleString('es-CL')}` : '—';

            tableRows.push([
                fechaAtencion,
                motivoStr,
                diagStr,
                accionStr,
                pptoStr
            ]);
        });

        // 5. Configuración de AutoTable optimizada para textos largos
        doc.autoTable({
            startY: 76,
            head: [tableColumn],
            body: tableRows,
            theme: 'grid',
            headStyles: { 
                fillColor: [30, 58, 138], 
                fontSize: 8, 
                fontStyle: 'bold', 
                halign: 'left',
                cellPadding: 3 
            },
            styles: { 
                fontSize: 7.5, // Fuente un poco más pequeña para maximizar el espacio
                cellPadding: 3, 
                overflow: 'linebreak', // <-- SOLUCIÓN: Obliga al texto a bajar a la siguiente línea
                valign: 'top',
                textColor: [30, 30, 30]
            },
            columnStyles: {
                0: { cellWidth: 18 }, // Fecha
                1: { cellWidth: 35 }, // Motivo
                2: { cellWidth: 35 }, // Diagnóstico
                3: { cellWidth: 74 }, // Procedimiento (Ancho máximo otorgado a esta columna)
                4: { cellWidth: 20, halign: 'right' } // Monto
            },
            margin: { left: 14, right: 14 }
        });

        // 6. Cierre Legal y Firmas Clínicas
        const finalY = doc.lastAutoTable.finalY || 100;
        const espacioRestante = doc.internal.pageSize.height - finalY;
        
        let signatureY = finalY + 25;
        if (espacioRestante < 45) {
            doc.addPage();
            signatureY = 40;
        }

        doc.setFontSize(8); doc.setFont("helvetica", "italic"); doc.setTextColor(100, 116, 139);
        doc.text("El presente documento consolida la historia clínica del tratamiento realizado en la plataforma de salud. Documento emitido a solicitud del interesado para los fines pertinentes.", 14, signatureY - 15);

        doc.setDrawColor(0, 0, 0); doc.setLineWidth(0.3);
        doc.line(120, signatureY, 180, signatureY);
        doc.setFontSize(9); doc.setFont("helvetica", "normal"); doc.setTextColor(0, 0, 0);
        doc.text(drName, 150, signatureY + 5, { align: "center" });
        doc.text(`Firma Profesional Odontólogo`, 150, signatureY + 10, { align: "center" });

        // 7. Descarga Directa Única
        const nombreArchivo = `Epicrisis_Total_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`;
        doc.save(nombreArchivo);

    } catch (err) {
        console.error("Error al generar la epicrisis:", err);
        alert("Ocurrió un error al compilar el informe: " + err.message);
    }
}

