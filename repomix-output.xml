<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Inicio Paciente</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <style>
        /* Estilos específicos para la vista móvil del paciente */
        body { background-color: #f8fafc; padding-bottom: 90px; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        .patient-header { padding: 25px 20px; background: white; border-bottom: 1px solid #e2e8f0; border-radius: 0 0 20px 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.02); position: sticky; top: 0; z-index: 50;}
        
        .brand-container { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; }
        .brand-container img { height: 35px; }
        .brand-container span { font-size: 1.5rem; font-weight: 900; color: var(--blue-elegant); letter-spacing: -0.5px; }

        .search-bar-mock { background: #f1f5f9; padding: 14px 20px; border-radius: 30px; display: flex; align-items: center; gap: 12px; color: #64748b; margin-top: 15px; cursor: pointer; border: 1px solid #e2e8f0; transition: 0.2s; }
        .search-bar-mock:active { transform: scale(0.98); background: #e2e8f0; }
        
        .specialty-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 20px; }
        
        .specialty-btn { background: white; border: 1px solid #e2e8f0; padding: 15px 5px; border-radius: 15px; display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 0.75rem; color: #334155; text-align: center; font-weight: 500; box-shadow: 0 2px 5px rgba(0,0,0,0.02); transition: 0.2s; cursor: pointer; }
        .specialty-btn:active { transform: scale(0.95); border-color: var(--pixar-cyan); }
        
        /* Estilos unificados para íconos de Google y SVG personalizados */
        .specialty-btn .material-symbols-outlined { color: var(--pixar-cyan); font-size: 2.2rem; margin-bottom: 2px;}
        .specialty-btn svg { width: 35px; height: 35px; stroke: var(--pixar-cyan); fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 2px; }

        .urgency-btn { grid-column: span 3; flex-direction: row; justify-content: center; background: #fef2f2; border-color: #fca5a5; padding: 16px; box-shadow: 0 4px 10px rgba(239, 68, 68, 0.15); }
        .urgency-btn .material-symbols-outlined { color: #ef4444; font-size: 2rem; margin-bottom: 0;}
        .urgency-btn span:last-child { color: #b91c1c; font-size: 1rem; font-weight: bold; }
        
        .sync-card { background: white; margin: 0 20px 20px 20px; padding: 25px 20px; border-radius: 20px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; }
        
        /* BARRA DE NAVEGACIÓN INFERIOR */
        .bottom-nav { background: white; border-top: none; }
    </style>
</head>
<body>

    <header class="patient-header">
        <div class="brand-container">
            <img src="assets/LogoMiDental.png" alt="Logo MiDental">
            <span>MiDental</span>
        </div>
        
        <h1 style="margin: 0; font-size: 1.6rem; color: var(--blue-elegant);">Hola, <span id="nombrePacienteUi" style="color: var(--pixar-cyan);">...</span> 👋</h1>
        
        <div class="search-bar-mock" onclick="window.location.href='mapa-paciente.html'">
            <span class="material-symbols-outlined" style="font-size: 1.3rem;">search</span>
            <span>Encuentra especialista o clínica</span>
        </div>
    </header>

    <div class="specialty-grid">
        <div class="specialty-btn urgency-btn" onclick="window.location.href='mapa-paciente.html?urgencia=true'">
            <span class="material-symbols-outlined">emergency</span>
            <span>Urgencia Dental</span>
        </div>

        <div class="specialty-btn" onclick="window.location.href='mapa-paciente.html'">
            <svg viewBox="0 0 24 24">
                <path d="M7 3c-2.2 0-4 1.8-4 4 0 2.5 1.5 4.5 3 6.5v3.5A2.5 2.5 0 0 0 8.5 19.5h0A2.5 2.5 0 0 0 11 17v-2h2v2a2.5 2.5 0 0 0 2.5 2.5h0a2.5 2.5 0 0 0 2.5-2.5v-3.5c1.5-2 3-4 3-6.5 0-2.2-1.8-4-4-4-1.5 0-2.8 1-3.5 2.5C12.8 4 11.5 3 10 3z"/>
            </svg>
            Odontología General
        </div>
