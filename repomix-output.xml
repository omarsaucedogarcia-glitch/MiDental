    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    
    <script>
        // ==========================================
        // 1. CREACIÓN DE PACIENTE NUEVO (HUÉRFANO)
        // ==========================================
        async function guardarPacienteNuevoDesdeDentista() {
            const rut = document.getElementById('altaPacienteRUT').value.trim();
            const nombre = document.getElementById('altaPacienteNombre').value.trim();
            const telefono = document.getElementById('altaPacienteTelefono').value.trim();
            const cronicas = document.getElementById('altaPacienteCronicas').value.trim();
            const medicamentos = document.getElementById('altaPacienteMedicamentos').value.trim();
            const alergias = document.getElementById('altaPacienteAlergias').value.trim();

            if(!rut || !nombre || !telefono) return alert("Por favor completa los datos obligatorios (RUT, Nombre y Teléfono).");

            const btn = document.getElementById('btnGuardarAltaPaciente');
            btn.innerText = "Guardando en la Red...";
            btn.disabled = true;

            try {
                // Generar UUID y guardar el perfil huérfano (user_id = null)
                const { data, error } = await window.midental
                    .from('perfiles_pacientes')
                    .insert([{
                        id: crypto.randomUUID(), 
                        rut: rut,
                        nombre_completo: nombre,
                        telefono: telefono.replace(/[^0-9]/g, ''),
                        enfermedades_cronicas: cronicas || 'Ninguna',
                        medicamentos: medicamentos || 'Ninguno',
                        alergias: alergias || 'Ninguna', 
                        user_id: null 
                    }])
                    .select();

                if (error) {
                    if(error.code === '23505') throw new Error("Este RUT ya está registrado en la base de datos de MiDental.");
                    throw error;
                }
                
                // Redirección directa a la Ficha Oficial recién creada
                const nuevoPaciente = data[0];
                alert(`🏥 Ficha de ${nombre} creada exitosamente. Te llevaremos a su ficha para que registres su primera atención o presupuesto.`);
                window.location.href = `ficha-paciente.html?paciente=${nuevoPaciente.id}`;

            } catch (err) {
                alert("Error de registro: " + err.message);
            } finally {
                btn.innerText = "Crear Historial Clínico";
                btn.disabled = false;
            }
        }

        // ==========================================
        // 2. LÓGICA DEL DIRECTORIO Y EXPORTACIÓN
        // ==========================================
        let basePacientes = {}; 

        document.addEventListener('DOMContentLoaded', () => {
            cargarFicheroCompleto();
        });

        // Extraer TODAS las atenciones y agruparlas
        async function cargarFicheroCompleto() {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('contenedorListaPacientes');
            if(!userId) return;

            try {
                const { data: fichas, error } = await window.midental.from('fichas_clinicas')
                    .select('paciente_id, paciente_nombre, paciente_rut, created_at, ultima_atencion, perfiles_pacientes (fecha_nacimiento, telefono)')
                    .eq('dentista_id', userId)
                    .order('created_at', { ascending: false });

                if(error) throw error;

                basePacientes = {};

                fichas.forEach(ficha => {
                    const clave = ficha.paciente_id || `manual-${ficha.paciente_rut || ficha.paciente_nombre}`;
                    
                    if(!basePacientes[clave]) {
                        basePacientes[clave] = {
                            id: ficha.paciente_id,
                            nombre: ficha.paciente_nombre || 'Paciente Sin Nombre',
                            fecha_nacimiento: ficha.perfiles_pacientes?.fecha_nacimiento || null,
                            telefono: ficha.perfiles_pacientes?.telefono || '', 
                            claveUnica: clave,
                            nombre: ficha.paciente_nombre || 'Paciente Sin Nombre',
                            ultima_visita: ficha.ultima_atencion || ficha.created_at,
                            num_atenciones: 0
                        };
                    }
                    basePacientes[clave].num_atenciones++;
                });

                renderizarListaPacientes();

            } catch(err) {
                contenedor.innerHTML = `<p style="color:red; text-align:center;">Error al cargar el fichero: ${err.message}</p>`;
            }
        }

        let centroMedicoOficial = "nuestra clínica"; // Para el mensaje de WhatsApp

        document.addEventListener('DOMContentLoaded', async () => {
            // Obtenemos la sede del dentista para el mensaje
            const userId = localStorage.getItem('midental_user_id');
            if(userId) {
                const { data } = await window.midental.from('sedes_dentistas').select('nombre_sede').eq('dentista_id', userId).limit(1).maybeSingle();
                if(data && data.nombre_sede) centroMedicoOficial = data.nombre_sede;
            }
            cargarFicheroCompleto();
        });

        // ==========================================
        // 1. RENDERIZADO CON BOTONES DE EDICIÓN Y CUMPLEAÑOS
        // ==========================================
        function renderizarListaPacientes(filtroTexto = "") {
            const contenedor = document.getElementById('contenedorListaPacientes');
            const contador = document.getElementById('totalPacientesContador');
            contenedor.innerHTML = "";

            const claves = Object.keys(basePacientes);
            let mostrados = 0;
            const hoy = new Date();

            claves.forEach(clave => {
                const paciente = basePacientes[clave];
                const searchText = paciente.nombre.toLowerCase();
                
                if(filtroTexto === "" || searchText.includes(filtroTexto)) {
                    mostrados++;
                    
                    const fechaAtencion = new Date(paciente.ultima_visita).toLocaleDateString('es-CL');
                    const isManual = !paciente.id;
                    const idCorto = isManual ? "SIN REGISTRO" : paciente.id.split('-')[0].toUpperCase();
                    
                    // --- MAGIA DE CUMPLEAÑOS ---
                    let esCumplehoy = false;
                    let edadActual = "";
                    if (paciente.fecha_nacimiento) {
                        const partes = paciente.fecha_nacimiento.toString().split('-'); // YYYY-MM-DD
                        if (hoy.getMonth() + 1 === parseInt(partes[1]) && hoy.getDate() === parseInt(partes[2])) {
                            esCumplehoy = true;
                        }
                        edadActual = hoy.getFullYear() - parseInt(partes[0]);
                        const m = hoy.getMonth() + 1 - parseInt(partes[1]);
                        if (m < 0 || (m === 0 && hoy.getDate() < parseInt(partes[2]))) edadActual--;
                    }

                    // Badge de Cumpleaños si es hoy
                    const badgeCumple = esCumplehoy ? `<span style="background: #fef08a; color: #b45309; padding: 2px 8px; border-radius: 10px; font-size: 0.7rem; font-weight: bold; margin-left: 10px; border: 1px solid #fde047;">🎂 ¡Hoy es su Cumpleaños!</span>` : '';
                    
                    // Botón de WhatsApp Felicitar
                    const btnFelicitar = (esCumplehoy && paciente.telefono) ? `
                        <button onclick="event.stopPropagation(); enviarFelicitacion('${paciente.nombre}', '${paciente.telefono}')" style="background:#25d366; color:white; border:none; padding:6px 12px; border-radius:8px; font-size:0.8rem; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:5px; box-shadow:0 2px 4px rgba(37,211,102,0.3);">
                            <span class="material-symbols-outlined" style="font-size:1rem;">celebration</span> Saludar
                        </button>` : '';

                    const card = document.createElement('div');
                    card.className = 'patient-card';
                    card.onclick = () => { window.location.href = `ficha-paciente.html?paciente=${paciente.id}`; };
                    
                    card.innerHTML = `
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <div style="background: ${isManual ? '#fff7ed' : '#e6f5ff'}; color: ${isManual ? '#d97706' : 'var(--pixar-cyan)'}; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">
                                ${paciente.nombre.charAt(0).toUpperCase()}
                            </div>
                            <div class="patient-basic-info">
                                <h3>${paciente.nombre} ${badgeCumple}</h3>
                                <p>
                                    <span class="material-symbols-outlined" style="font-size:1rem;">vpn_key</span> ID: ${idCorto} 
                                    <span style="margin-left:10px; color:var(--blue-elegant); font-weight:bold;">${edadActual ? `(${edadActual} años)` : ''}</span>
                                </p>
                            </div>
                        </div>
                        <div style="text-align: right; display: flex; align-items: center; gap: 15px;">
                            ${btnFelicitar}
                            <button onclick="event.stopPropagation(); abrirEdicionPaciente('${paciente.id}', '${paciente.nombre}', '${paciente.fecha_nacimiento || ''}')" style="background:transparent; border:1px solid #cbd5e1; color:#64748b; padding:6px 12px; border-radius:8px; font-size:0.8rem; font-weight:bold; cursor:pointer;">
                                Editar
                            </button>
                            <button class="btn-abrir-ficha">Abrir Ficha <span class="material-symbols-outlined" style="font-size: 1.1rem;">arrow_forward</span></button>
                        </div>
                    `;
                    contenedor.appendChild(card);
                }
            });

            contador.innerText = mostrados;
        }

        // ==========================================
        // 2. EDICIÓN DEL PACIENTE
        // ==========================================
        function abrirEdicionPaciente(id, nombre, nacimiento) {
            if(!id || id === 'undefined') return alert("Este paciente fue ingresado con el sistema antiguo. Pídele que se registre con su RUT.");
            document.getElementById('editPctId').value = id;
            document.getElementById('editPctNombre').value = nombre;
            document.getElementById('editPctNacimiento').value = nacimiento;
            document.getElementById('modalEditarPaciente').style.display = 'flex';
        }

        async function guardarEdicionPacienteBase() {
            const id = document.getElementById('editPctId').value;
            const nombre = document.getElementById('editPctNombre').value.trim();
            const nacimiento = document.getElementById('editPctNacimiento').value;

            if(!nombre) return alert("El nombre no puede quedar vacío.");
            
            const btn = document.getElementById('btnGuardarEdicionPct');
            btn.innerHTML = "Guardando..."; btn.disabled = true;

            try {
                const { error } = await window.midental.from('perfiles_pacientes')
                    .update({ nombre_completo: nombre, fecha_nacimiento: nacimiento || null })
                    .eq('id', id);

                if(error) throw error;
                
                alert("✅ Datos actualizados. Refrescando fichero...");
                document.getElementById('modalEditarPaciente').style.display = 'none';
                cargarFicheroCompleto(); // Recargamos para ver los cambios

            } catch (err) {
                alert("Error: " + err.message);
            } finally {
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Actualizar Paciente';
                btn.disabled = false;
            }
        }

        // ==========================================
        // 3. MENSAJE WHATSAPP DE CUMPLEAÑOS
        // ==========================================
        function enviarFelicitacion(nombrePaciente, telefonoPaciente) {
            if(!telefonoPaciente) return alert("El paciente no tiene un teléfono registrado.");
            
            const telLimpio = telefonoPaciente.replace(/[^0-9]/g, '');
            const mensaje = `¡Hola ${nombrePaciente}! 🎉 Te escribimos de parte de todo el equipo de ${centroMedicoOficial} para desearte un muy ¡Feliz Cumpleaños! 🎂 Queremos agradecerte por tu compromiso y fidelidad con el cuidado de tu salud dental. ¡Que tengas un día excelente junto a los tuyos!`;
            
            window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(mensaje)}`, '_blank');
        }

        function filtrarListaPacientes() {
            const texto = document.getElementById('buscadorPacientes').value.toLowerCase().trim();
            renderizarListaPacientes(texto);
        }

        // ==========================================
        // EXPORTACIÓN A EXCEL (BLINDADA LEGALMENTE)
        // ==========================================
        async function exportarPacientesExcel() {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) return alert("Error de sesión. Vuelve a ingresar.");

            const btn = document.getElementById('btnExportarExcel');
            const textoOriginal = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Generando Excel...';
            btn.disabled = true;

            try {
                const { data: fichas, error } = await window.midental
                    .from('fichas_clinicas')
                    .select('paciente_id, paciente_nombre, paciente_rut, motivo_consulta, ultima_atencion, perfiles_pacientes(rut, telefono, email)')
                    .eq('dentista_id', userId)
                    .order('ultima_atencion', { ascending: false });

                if (error) throw error;

                if (!fichas || fichas.length === 0) {
                    alert("Aún no tienes pacientes registrados para exportar.");
                    btn.innerHTML = textoOriginal;
                    btn.disabled = false;
                    return;
                }

                const pacientesUnicos = [];
                const idsVistos = new Set();

                fichas.forEach(ficha => {
                    const idUnico = ficha.paciente_id || `manual-${ficha.paciente_rut || ficha.paciente_nombre}`;
                    
                    if (idUnico && !idsVistos.has(idUnico)) {
                        idsVistos.add(idUnico);
                        
                        const contacto = Array.isArray(ficha.perfiles_pacientes) ? ficha.perfiles_pacientes[0] : (ficha.perfiles_pacientes || {});
                        const rutMostrado = contacto.rut || ficha.paciente_rut || 'Sin RUT';
                        
                        pacientesUnicos.push({
                            "Nombre Completo": ficha.paciente_nombre || 'Sin Nombre',
                            "RUT": rutMostrado,
                            "Teléfono": contacto.telefono || 'No registrado',
                            "Email": contacto.email || 'No registrado',
                            "Última Atención": new Date(ficha.ultima_atencion).toLocaleDateString('es-CL'),
                            "Último Motivo": ficha.motivo_consulta || 'Sin especificar'
                        });
                    }
                });

                const libroDeTrabajo = XLSX.utils.book_new();
                const hojaDeTrabajo = XLSX.utils.json_to_sheet(pacientesUnicos);

                // Inyección de Disclaimer Legal (Ley 20.584)
                XLSX.utils.sheet_add_aoa(hojaDeTrabajo, [
                    ["CONFIDENCIAL: Documento protegido bajo Ley 20.584 de Derechos y Deberes del Paciente. Uso exclusivo clínico."],
                    [] // Fila vacía para separar
                ], { origin: "A1" });
                
                // Mover los datos hacia abajo para dejar espacio al disclaimer
                XLSX.utils.sheet_add_json(hojaDeTrabajo, pacientesUnicos, { origin: "A3", skipHeader: false });

                XLSX.utils.book_append_sheet(libroDeTrabajo, hojaDeTrabajo, "Mis Pacientes");

                const wbout = XLSX.write(libroDeTrabajo, { bookType: 'xlsx', type: 'binary' });

                function s2ab(s) {
                    const buf = new ArrayBuffer(s.length);
                    const view = new Uint8Array(buf);
                    for (let i = 0; i < s.length; i++) view[i] = s.charCodeAt(i) & 0xFF;
                    return buf;
                }

                const blob = new Blob([s2ab(wbout)], { type: "application/octet-stream" });
                const nombreArchivo = `Base_Pacientes_MiDental_${new Date().toLocaleDateString('es-CL').replace(/\//g, '-')}.xlsx`;

                const link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = nombreArchivo;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(link.href);

            } catch (err) {
                console.error("Error exportando a Excel:", err);
                alert("Hubo un error al generar el archivo. Por favor, intenta de nuevo.");
            } finally {
                btn.innerHTML = textoOriginal;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
