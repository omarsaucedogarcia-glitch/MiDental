        // ==========================================
        // MONITOR DE OFERTAS FLASH
        // ==========================================
        async function cargarOfertaActivaMonitor() {
            const userId = localStorage.getItem('midental_user_id');
            const { data } = await window.midental.from('ofertas_flash')
                .select('servicio_nombre, expira_at')
                .eq('dentista_id', userId).eq('activa', true)
                .gte('expira_at', new Date().toISOString())
                .order('created_at', { ascending: false }).limit(1).single();

            if(data) {
                document.getElementById('dashCampaignName').innerText = data.servicio_nombre;
                document.getElementById('monitorOfertaDashboard').style.display = 'block';
                const fechaExp = new Date(data.expira_at).getTime();

                clearInterval(cronometroIntervalo);
                cronometroIntervalo = setInterval(function() {
                    const distancia = fechaExp - new Date().getTime();
                    if (distancia < 0) {
                        clearInterval(cronometroIntervalo);
                        document.getElementById('dashCronometroFlash').innerText = "Campaña Finalizada";
                        return;
                    }
                    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((distancia % (1000 * 60)) / 1000);
                    document.getElementById('dashCronometroFlash').innerText = `${horas}h ${minutos}m ${segundos}s restantes`;
                }, 1000);
            }
        }

        // ==========================================
        // SOLICITUDES PENDIENTES DE LA PLATAFORMA
        // ==========================================
        async function cargarSolicitudesPendientes() {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('bandejaSolicitudes');
            
            const { data: citas } = await window.midental.from('citas_agenda')
                .select('*, perfiles_pacientes(nombre_completo, telefono)')
                .eq('dentista_id', userId).eq('estado', 'pendiente');

            if(citas && citas.length > 0) {
                solicitudesPendientesMemoria = citas;
                contenedor.innerHTML = "";
                citas.forEach(cita => {
                    const pctName = cita.paciente_nombre_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.nombre_completo : 'Paciente');
                    contenedor.innerHTML += `
                        <div class="request-card" id="req-${cita.id}">
                            <div class="request-info">
                                <h4>${cita.motivo || 'Evaluación General'}</h4>
                                <p><span class="material-symbols-outlined" style="font-size:1rem; color:var(--pixar-cyan);">person</span> <strong>Paciente:</strong> ${pctName}</p>
                                <p><span class="material-symbols-outlined" style="font-size:1rem; color:var(--pixar-cyan);">calendar_today</span> <strong>Horario:</strong> ${cita.fecha_hora_formato_slot || 'Por definir'}</p>
                            </div>
                            <div class="request-actions">
                                <button class="btn-reject-action" onclick="rechazarCitaReal(${cita.id})"><span class="material-symbols-outlined">close</span> Rechazar</button>
                                <button class="btn-confirm-action" onclick="confirmarCitaReal(${cita.id})"><span class="material-symbols-outlined">check_circle</span> Confirmar</button>
                            </div>
                        </div>`;
                });
            } else {
                contenedor.innerHTML = '<p style="color: #94a3b8; padding: 25px; background: white; border-radius: 15px; text-align: center; border: 1px dashed #cbd5e1; font-weight: bold; margin:0;">No tienes solicitudes pendientes de confirmación.</p>';
            }
        }

        async function confirmarCitaReal(citaId) {
            const { error } = await window.midental.from('citas_agenda').update({ estado: 'Confirmado' }).eq('id', citaId);
            if(error) return alert("Error: " + error.message);
            
            const citaData = solicitudesPendientesMemoria.find(c => c.id === citaId);
            if (citaData) {
                const nombrePct = citaData.paciente_nombre_manual || (citaData.perfiles_pacientes ? citaData.perfiles_pacientes.nombre_completo : 'Paciente');
                const fonoRaw = citaData.paciente_telefono_manual || (citaData.perfiles_pacientes ? citaData.perfiles_pacientes.telefono : '');
                if(fonoRaw) {
                    const msg = `Estimado paciente ${nombrePct}, su hora para el bloque [${citaData.fecha_hora_formato_slot}] ha sido CONFIRMADA de manera exitosa en ${centroMedicoOficial}. ¡Le esperamos!`;
                    window.open(`https://wa.me/${fonoRaw.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(msg)}`, '_blank');
                }
            }
            alert("✅ Cita confirmada de forma exitosa.");
            location.reload();
        }

        async function rechazarCitaReal(citaId) {
            if(!confirm("¿Rechazar esta hora médica?")) return;
            await window.midental.from('citas_agenda').update({ estado: 'cancelada' }).eq('id', citaId);
            location.reload();
        }

        // ==========================================
        // LÓGICA DE AGENDA (HOY Y MAÑANA) SEPARADA POR TABS
        // ==========================================
        async function cargarJornadaCompleta(userId) {
            const hoy = new Date();
            const manana = new Date(hoy);
            manana.setDate(hoy.getDate() + 1);

            const formateaFecha = (fecha) => `${String(fecha.getDate()).padStart(2, '0')}/${String(fecha.getMonth() + 1).padStart(2, '0')}/${fecha.getFullYear()}`;
            
            const fechaHoyStr = formateaFecha(hoy);
            const fechaMananaStr = formateaFecha(manana);

            // Reiniciamos los contadores en memoria
            resumenAgenda = {
                hoy: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 },
                manana: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 }
            };

            try {
                const { data: citas, error } = await window.midental.from('citas_agenda')
                    .select('*, perfiles_pacientes(nombre_completo, telefono)')
                    .eq('dentista_id', userId)
                    .neq('estado', 'cancelada')
                    .neq('estado', 'Rechazado')
                    .neq('estado', 'bloqueado');

                if (error) throw error;

                // 1. Filtramos para obtener solo las citas de HOY y MAÑANA
                const citasProximas = citas.filter(c => 
                    c.fecha_hora_formato_slot && 
                    (c.fecha_hora_formato_slot.includes(fechaHoyStr) || c.fecha_hora_formato_slot.includes(fechaMananaStr))
                );

                // --- NUEVO: ORDENAMIENTO CRONOLÓGICO ESTRICTO ---
                citasProximas.sort((a, b) => {
                    // Intentamos ordenar usando la marca de tiempo exacta de la base de datos (Máxima precisión)
                    if (a.fecha_hora && b.fecha_hora) {
                        return new Date(a.fecha_hora) - new Date(b.fecha_hora);
                    }
                    // Plan B: Si no hay marca de tiempo, extraemos la hora del texto (ej. "09:30") y ordenamos numéricamente
                    const horaA = (a.fecha_hora_formato_slot.split('-')[1] || a.fecha_hora_formato_slot).trim();
                    const horaB = (b.fecha_hora_formato_slot.split('-')[1] || b.fecha_hora_formato_slot).trim();
                    return horaA.localeCompare(horaB);
                });

                citasProximas.forEach(cita => {
                    const esHoy = cita.fecha_hora_formato_slot.includes(fechaHoyStr);
                    const diaKey = esHoy ? 'hoy' : 'manana';
                    const argDia = esHoy ? 'hoy' : 'mañana'; // String corregido para WhatsApp
                    
                    const estadoLower = cita.estado ? cita.estado.toLowerCase() : 'pendiente';
                    
                    // Sumamos al contador del día que corresponda
                    if (estadoLower === 'pendiente') resumenAgenda[diaKey].pendientes++;
                    else if (estadoLower === 'confirmado' || estadoLower === 'confirmada') resumenAgenda[diaKey].confirmadas++;
                    else if (estadoLower === 'completada' || estadoLower === 'en_atencion') resumenAgenda[diaKey].atendidos++;
                    else if (estadoLower === 'no_asiste') resumenAgenda[diaKey].noAsistieron++;

                    resumenAgenda[diaKey].total++;

                    const pctName = cita.paciente_nombre_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.nombre_completo : 'Paciente');
                    const pctTel = cita.paciente_telefono_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.telefono : '');
                    const horaSolo = cita.fecha_hora_formato_slot.split('-')[1]?.trim() || cita.fecha_hora_formato_slot;
                    
                    let estadoLabel = 'Por Confirmar';
                    let colorBadge = 'background:#fff7ed; color:#d97706; border-color:#fde68a;'; 
                    let borderIzquierdo = 'var(--pixar-orange)';
                    let opacidad = "1";

                    if (estadoLower === 'confirmado' || estadoLower === 'confirmada') {
                        estadoLabel = 'Confirmado';
                        colorBadge = 'background:#f0fdf4; color:#16a34a; border-color:#bbf7d0;'; 
                        borderIzquierdo = 'var(--green-success)';
                    } else if (estadoLower === 'completada' || estadoLower === 'en_atencion') {
                        estadoLabel = estadoLower === 'en_atencion' ? 'En Curso' : 'Atendido';
                        colorBadge = 'background:#eff6ff; color:#3b82f6; border-color:#bfdbfe;'; 
                        borderIzquierdo = '#3b82f6';
                        if (estadoLower === 'completada') opacidad = "0.6"; 
                    } else if (estadoLower === 'no_asiste') {
                        estadoLabel = 'No Asistió';
                        colorBadge = 'background:#fef2f2; color:#ef4444; border-color:#fecaca;'; 
                        borderIzquierdo = 'var(--red-urgency)';
                        opacidad = "0.5"; 
                    }

                    // CORRECCIÓN WHATSAPP: Le pasamos 'hoy' o 'mañana' en lugar de true/false
                    let btnRecordatorioHTML = "";
                    if ((estadoLower === 'confirmado' || estadoLower === 'confirmada' || estadoLower === 'pendiente') && pctTel) {
                        btnRecordatorioHTML = `
                            <button class="btn-pixar" style="background:#25d366; display:inline-flex; align-items:center; gap:5px; margin-top:8px; padding:6px 12px; font-size:0.8rem; border:none; box-shadow: 0 2px 5px rgba(37,211,102,0.2);" 
                                onclick="enviarRecordatorioWhatsApp('${pctName}', '${pctTel.replace(/[^0-9]/g, '')}', '${horaSolo}', '${argDia}')">
                                <span class="material-symbols-outlined" style="font-size:1rem;">chat</span> Recordar Cita
                            </button>
                        `;
                    }

                    // Insertamos la tarjeta en el HTML del día que le corresponde
                    resumenAgenda[diaKey].html += `
                        <div class="appointment-card" style="opacity: ${opacidad}; border-left-color: ${borderIzquierdo};">
                            <div class="appointment-time" style="display: flex; flex-direction: column; justify-content: center;">
                                ${horaSolo}
                            </div>
                            <div class="appointment-info" style="flex:1; margin-left: 20px;">
                                <h4 style="margin:0 0 5px 0; color: var(--blue-elegant); font-size: 1.1rem;">${pctName}</h4>
                                <p style="margin:0; font-size:0.9rem; color:#64748b; font-weight: 500;">${cita.motivo || 'Consulta General'}</p>
                                ${btnRecordatorioHTML}
                            </div>
                            <div class="appointment-status">
                                <span class="badge-status-verificado" style="padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; border: 1px solid; ${colorBadge}">
                                    ${estadoLabel}
                                </span>
                            </div>
                        </div>
                    `;
                });

                // Cargamos por defecto la vista de HOY
                cambiarVistaDia('hoy');

            } catch (err) {
                console.error("Error al cargar la jornada:", err);
            }
        }

        // --- Controlador del Carrusel/Pestañas ---
        function cambiarVistaDia(dia) {
            // Actualizar botones UI
            document.getElementById('tabHoy').classList.toggle('active', dia === 'hoy');
            document.getElementById('tabManana').classList.toggle('active', dia === 'manana');

            // Mostrar la lista correspondiente
            document.getElementById('listaHoy').classList.toggle('active', dia === 'hoy');
            document.getElementById('listaManana').classList.toggle('active', dia === 'manana');

            const datos = resumenAgenda[dia];
            const diaTexto = dia === 'hoy' ? 'hoy' : 'mañana';

            // Actualizar Título
            document.getElementById('tituloListaCitas').innerHTML = `<span class="material-symbols-outlined">calendar_today</span> Pacientes de ${diaTexto.charAt(0).toUpperCase() + diaTexto.slice(1)}`;

            // Actualizar Contadores Widgets
            document.getElementById('dashConfirmedCount').innerText = datos.confirmadas;
            document.getElementById('dashPendingCount').innerText = datos.pendientes;
            if(document.getElementById('dashCompletedCount')) document.getElementById('dashCompletedCount').innerText = datos.atendidos;
            if(document.getElementById('dashNoShowCount')) document.getElementById('dashNoShowCount').innerText = datos.noAsistieron;

            // Actualizar Frase Motivacional
            let mensajeJornada = "";
            if (datos.total === 0) {
                mensajeJornada = `Tienes tu agenda despejada para ${diaTexto}. Un respiro excelente para planificar.`;
            } else if (datos.confirmadas === 0 && datos.pendientes === 0 && datos.atendidos > 0) {
                mensajeJornada = `¡Jornada finalizada con éxito! Has atendido a *${datos.atendidos} pacientes* ${diaTexto}.`;
            } else {
                mensajeJornada = `Para ${diaTexto} coordinas un total de *${datos.total} pacientes* (*${datos.atendidos} ya atendidos* y *${datos.confirmadas} próximos*). ¡Éxito en tu turno!`;
            }
            document.getElementById('dashMotivationalQuote').innerHTML = mensajeJornada;

            // Inyectar HTML o mensaje vacío
            const listaEl = document.getElementById(dia === 'hoy' ? 'listaHoy' : 'listaManana');
            if(datos.html !== "") {
                listaEl.innerHTML = datos.html;
            } else {
                listaEl.innerHTML = `<p style="color: #94a3b8; padding: 30px 20px; background: white; border-radius: 15px; text-align: center; border: 1px dashed #cbd5e1; font-weight: bold;">No tienes citas registradas para ${diaTexto}.</p>`;
            }
        }

        // ==========================================
        // MOTOR ENVIAR RECORDATORIO WHATSAPP CORREGIDO
        // ==========================================
        function enviarRecordatorioWhatsApp(nombrePaciente, telefonoPaciente, horaCita, fechaCita = "hoy") {
            if(!telefonoPaciente) return alert("El paciente no registra un teléfono válido.");
            
            const telLimpio = telefonoPaciente.replace(/[^0-9]/g, '');
            
            // Evaluamos correctamente la variable string que ahora enviamos
            const textoDia = (fechaCita === 'mañana' || fechaCita === 'manana') ? "el día de mañana" : "el día de hoy";
            
            const mensaje = `Hola ${nombrePaciente}, te escribimos de ${centroMedicoOficial} para recordarte tu cita agendada para ${textoDia} a las ${horaCita}. Te solicitamos puntualidad para resguardar los tiempos de tu atención. ¡Nos vemos pronto!`;
            
            window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(mensaje)}`, '_blank');
        }

        // ==========================================
        // VALIDAR PIN INTERCONSULTA
        // ==========================================
        async function validarPinInterconsulta() {
            const pin = document.getElementById('pinInterconsulta').value.trim().toUpperCase();
            if(pin.length < 6) return alert("Por favor ingresa el PIN completo de 6 dígitos.");

            const btn = document.getElementById('btnDesbloquearPin');
            btn.innerText = "Verificando..."; btn.disabled = true;

            try {
                const { data, error } = await window.midental.from('interconsultas').select('paciente_id, id').eq('token_pin', pin).single();
                if (error || !data) throw new Error("Código PIN no válido o ya expirado.");

                const userId = localStorage.getItem('midental_user_id');
                await window.midental.from('interconsultas').update({ estado: 'abierto', dentista_destino_id: userId }).eq('id', data.id);

                alert("🔓 Ficha clínica desbloqueada con éxito.");
                window.location.href = `ficha-paciente.html?paciente=${data.paciente_id}`;
            } catch (err) {
                alert(err.message);
                btn.innerText = "Desbloquear Ficha"; btn.disabled = false;
            }
        }
        // =========================================================
        // MÓDULO FINANCIERO: 3 RANGOS (DÍA / SEMANA / MES)
        // ---------------------------------------------------------
        // - Día      : tarjeta solo informativa (suma de monto de pagos)
        // - Semana   : tarjeta clickable → modal con lab + convenios +
        //              historial de pagos de la semana (ERP-ready)
        // - Mes      : tarjeta informativa sin modal (vista acumulada)
        // =========================================================
        let cacheFinanzasSemana = { brutos: 0, lab: 0, conv: 0, neto: 0 };
        let cacheFinanzasMes    = { brutos: 0, lab: 0, conv: 0, neto: 0 };

        // Offset de la semana visible dentro del modal histórico.
        // 0 = semana en curso, -1 = semana pasada, -N = N semanas atrás.
        // Las tarjetas del dashboard (Día / Semana / Mes) IGNORAN este offset
        // y siempre muestran la semana actual.
        let semanasOffset = 0;

        // ---- Helpers de fecha (lunes-domingo y mes calendario) ----
        function getRangoDia() {
            const hoy = new Date();
            const ini = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
            const fin = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + 1);
            return { inicio: ini.toISOString(), fin: fin.toISOString() };
        }
        /**
         * Devuelve el rango lunes→lunes de la semana cuyo offset es `n`
         * relativo a la semana en curso. n=0 actual, n=-1 anterior.
         * Trabaja con fechas locales para evitar drift por TZ.
         */
        function getRangoSemanaOffset(n) {
            const hoy = new Date();
            const dow = hoy.getDay();                  // 0=domingo, 1=lunes ... 6=sábado
            const offsetLunes = (dow === 0) ? -6 : (1 - dow);
            const ini = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + offsetLunes + (n * 7));
            const fin = new Date(ini.getFullYear(), ini.getMonth(), ini.getDate() + 7);
            return { inicio: ini.toISOString(), fin: fin.toISOString(), iniDate: ini, finDate: fin };
        }
        function getRangoSemana() { return getRangoSemanaOffset(0); }
        function getRangoMes() {
            const hoy = new Date();
            const ini = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            const fin = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 1);
            return { inicio: ini.toISOString(), fin: fin.toISOString() };
        }

        /**
         * Navegación del modal histórico. delta = -1 (atrás) o +1 (adelante).
         * Tope superior: 0 (no se permite avanzar más allá de la semana actual).
         * Tope inferior: práctico, sin límite hard (la BD puede no tener pagos).
         */
        function navSemana(delta) {
            const nuevoOffset = semanasOffset + delta;
            if (nuevoOffset > 0) return;       // no permitir futuro
            semanasOffset = nuevoOffset;
            refrescarPanelFinanzas();
        }

        // ---- Cálculo paramétrico para un rango temporal arbitrario ----
        // Devuelve { brutos, lab, conv, neto } para [inicio, fin).
        async function calcularFinanzasRango(userId, inicioIso, finIso) {
            const [resPagos, resLab, resConv] = await Promise.all([
                window.midental.from('pagos')
                    .select('monto')
                    .eq('dentista_id', userId)
                    .gte('fecha_pago', inicioIso)
                    .lt('fecha_pago', finIso),
                window.midental.from('pagos_laboratorio')
                    .select('monto')
                    .eq('dentista_id', userId)
                    .gte('fecha_gasto', inicioIso)
                    .lt('fecha_gasto', finIso),
                window.midental.from('convenios_centros_medicos')
                    .select('porcentaje')
                    .eq('dentista_id', userId)
                    .eq('activo', true)
            ]);
            if (resPagos.error) throw resPagos.error;
            if (resLab.error)   throw resLab.error;
            if (resConv.error)  throw resConv.error;

            const brutos = (resPagos.data || []).reduce((acc, p) => acc + parseFloat(p.monto || 0), 0);
            const lab    = (resLab.data   || []).reduce((acc, g) => acc + parseFloat(g.monto || 0), 0);
            const postLab = Math.max(0, brutos - lab);
            const conv   = (resConv.data  || []).reduce(
                (acc, c) => acc + (postLab * (parseFloat(c.porcentaje || 0) / 100)), 0
            );
            const neto   = postLab - conv;
            return { brutos, lab, conv, neto, pagosCount: (resPagos.data || []).length };
        }

        async function cargarWidgetsFinancieros() {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) return;

            const rd = getRangoDia();
            const rs = getRangoSemana();
            const rm = getRangoMes();

            try {
                const [dia, semana, mes] = await Promise.all([
                    calcularFinanzasRango(userId, rd.inicio, rd.fin),
                    calcularFinanzasRango(userId, rs.inicio, rs.fin),
                    calcularFinanzasRango(userId, rm.inicio, rm.fin)
                ]);

                // Día: solo bruto
                document.getElementById('dashIngresosDia').innerText      = '$ ' + dia.brutos.toLocaleString('es-CL');
                document.getElementById('dashIngresosDiaCount').innerText = `${dia.pagosCount} pago(s) hoy`;

                // Semana
                cacheFinanzasSemana = semana;
                document.getElementById('dashIngresosNetoSemana').innerText  = '$ ' + Math.round(semana.neto).toLocaleString('es-CL');
                document.getElementById('dashIngresosBrutoSemana').innerText =
                    `Bruto: $${semana.brutos.toLocaleString('es-CL')} · Lab: $${semana.lab.toLocaleString('es-CL')} · Conv: $${Math.round(semana.conv).toLocaleString('es-CL')}`;

                // Mes (informativo)
                cacheFinanzasMes = mes;
                document.getElementById('dashIngresosNetoMes').innerText  = '$ ' + Math.round(mes.neto).toLocaleString('es-CL');
                document.getElementById('dashIngresosBrutoMes').innerText =
                    `Bruto: $${mes.brutos.toLocaleString('es-CL')} · Lab: $${mes.lab.toLocaleString('es-CL')} · Conv: $${Math.round(mes.conv).toLocaleString('es-CL')}`;
            } catch (err) {
                console.error("Error al cargar widgets financieros:", err);
            }
        }

