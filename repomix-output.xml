        doc.text("CERTIFICADO DE ATENCIÓN DENTAL", 105, 80, { align: "center" });

        // Párrafo principal (Más espaciado y posicionado más abajo)
        doc.setFontSize(11); doc.setFont("helvetica", "normal"); doc.setTextColor(30, 30, 30);
        const fechaEspanol = new Date().toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
        
        const parrafoPrincipal = `A quien corresponda:\n\nPor el presente documento, certifico que el paciente ${pacienteActual.nombre.toUpperCase()}, RUT ${pacienteActual.rut}, ha recibido atención odontológica el día de hoy, ${fechaEspanol}, en nuestras dependencias ubicadas en ${direccionCentro}.`;
        const splitParrafo = doc.splitTextToSize(parrafoPrincipal, 180);
        doc.text(splitParrafo, 14, 100);

        // Aumentamos el espaciado dinámico
        let startY = 100 + (splitParrafo.length * 6) + 15;

        // Diagnóstico
        doc.setFont("helvetica", "bold"); doc.text("Diagnóstico Clínico:", 14, startY);
        doc.setFont("helvetica", "normal");
        const splitDiag = doc.splitTextToSize(diagnostico, 140);
        doc.text(splitDiag, 55, startY);
        startY += (splitDiag.length * 6) + 15;

        // Observaciones (Si existen)
        if (observaciones) {
            doc.setFont("helvetica", "bold"); doc.text("Observaciones:", 14, startY);
            doc.setFont("helvetica", "normal");
            const splitObs = doc.splitTextToSize(observaciones, 140);
            doc.text(splitObs, 45, startY);
            startY += (splitObs.length * 6) + 25;
        } else {
            startY += 15;
        }

        // Frase final solicitada
        doc.setFont("helvetica", "italic"); doc.setTextColor(80, 80, 80);
        const fraseCierre = "Se extiende el presente certificado para ser presentado en los establecimientos que el paciente requiera.";
        const splitCierre = doc.splitTextToSize(fraseCierre, 180);
        doc.text(splitCierre, 14, startY);

        // Firma del profesional (Se mantiene anclada perfectamente al final de la página)
        const finalPageY = doc.internal.pageSize.height;
        doc.setFont("helvetica", "normal"); doc.setTextColor(0, 0, 0); doc.setFontSize(10);
        doc.line(120, finalPageY - 35, 180, finalPageY - 35); 
        doc.text(drName, 150, finalPageY - 30, { align: "center" });
        if (drRut) doc.text(`RUT: ${drRut}`, 150, finalPageY - 25, { align: "center" });

        // Guardado local y subida a la nube
        const nombreArchivo = `Certificado_Atencion_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}.pdf`;
        doc.save(nombreArchivo);

        const pdfBlob = doc.output('blob');
        const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });
        
        if (!uploadError) {
            await window.midental.from('documentos_pacientes').insert([{
                paciente_id: pacienteIdURL, dentista_id: dentistaId,
                nombre_archivo: `Certificado de Atención (${new Date().toLocaleDateString('es-CL')})`,
                tipo: 'pdf', archivo_url: nombreArchivo 
            }]);
            cargarDocumentosPaciente();
        }

        alert("✅ Certificado de Atención generado y resguardado en la ficha del paciente.");
        document.getElementById('certDiagnostico').value = '';
        document.getElementById('certObservaciones').value = '';
        document.getElementById('modalCertificado').style.display = 'none';

    } catch (err) { 
        alert("Error al emitir el certificado: " + err.message); 
        console.error(err); 
    } finally { 
        btn.innerHTML = '<span class="material-symbols-outlined">picture_as_pdf</span> Generar Certificado'; 
        btn.disabled = false; 
    }
}
