<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Tu salud bucal a un clic</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <style>
        /* MEJORAS DE DISEÑO: NAVBAR Y LOGO PREMIUM */
        .navbar { display: flex; justify-content: space-between; align-items: center; padding: 15px 5%; position: sticky; top: 0; z-index: 1000; background: rgba(255,255,255,0.98); box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
        .logo { display: flex; align-items: center; gap: 8px; cursor: pointer; text-decoration: none; }
        .logo-img { height: 42px; width: auto; }
        .logo h1 { font-size: 1.8rem; font-weight: 900; letter-spacing: -0.8px; color: var(--blue-elegant); margin: 0; line-height: 1; }
        
        .nav-links { display: flex; gap: 20px; }
        .nav-links a { text-decoration: none; color: #475569; font-weight: 600; font-size: 0.95rem; transition: color 0.2s; }
        .nav-links a:hover { color: var(--pixar-cyan); }
        .nav-buttons { display: flex; gap: 15px; }

        /* ADAPTACIÓN MÓVIL (CABECERA COMPACTA Y NO INVASIVA) */
        @media (max-width: 768px) {
            .navbar { padding: 12px 15px; flex-wrap: wrap; justify-content: center; gap: 12px; }
            .logo { width: 100%; justify-content: center; margin-bottom: 2px; }
            .logo-img { height: 36px; }
            .logo h1 { font-size: 1.6rem; letter-spacing: -0.5px; }
            .nav-links { display: none; } /* Ocultamos los links para dar respiro visual */
            .nav-buttons { width: 100%; gap: 10px; justify-content: space-between; }
            .nav-buttons .btn-pixar { padding: 10px 12px !important; font-size: 0.8rem !important; flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 12px; }
            .nav-buttons .btn-pixar span { font-size: 1.1rem !important; margin-right: 4px; }
        }

        /* Estilos adicionales para FAQ Interactivo */
        .faq-section { padding: 60px 20px; background: white; }
        .faq-container { max-width: 800px; margin: 0 auto; }
        .faq-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; margin-bottom: 15px; overflow: hidden; transition: 0.3s; }
        .faq-item:hover { border-color: var(--pixar-cyan); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        .faq-question { font-weight: bold; color: var(--blue-elegant); font-size: 1.1rem; padding: 20px; margin: 0; display: flex; align-items: center; justify-content: space-between; cursor: pointer; user-select: none; }
        .faq-question .q-text { display: flex; align-items: center; gap: 10px; }
        .faq-answer { color: #64748b; line-height: 1.6; font-size: 0.95rem; margin: 0; padding: 0 20px; max-height: 0; opacity: 0; transition: all 0.3s ease-out; }
        
        /* Clases activas para el FAQ */
