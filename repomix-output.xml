                </div>
                <button id="btn-upgrade-sidebar" style="width: 100%; margin-top: 10px; padding: 10px; background: linear-gradient(135deg, #FFD700, #FDB931); color: #453814; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 5px; box-shadow: 0 4px 6px rgba(253, 185, 49, 0.2); transition: transform 0.2s;">
                    <span class="material-symbols-outlined" style="font-size: 1.2rem;">workspace_premium</span>
                    Mejorar a PRO
                </button>
            </div>

            <div class="sidebar-footer">
                <button class="btn-logout" onclick="window.cerrarSesionLocal()"><span class="material-symbols-outlined">logout</span> Cerrar Sesión</button>
            </div>
        </aside>

        <main class="dashboard-content">
            <header class="topbar">
                <div class="welcome-text">
                    <h1>Inteligencia de Negocio Clínico</h1>
                    <p>Análisis de rendimiento y marketing del mes en curso.</p>
                </div>
            </header>

            <div class="filter-bar">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span class="material-symbols-outlined" style="color: var(--blue-elegant);">storefront</span>
                    <strong style="color: var(--blue-elegant);">Sede Clínica:</strong>
                    <select id="sedeSelector" class="apple-select" onchange="cargarDatosAnalisis()">
                        <option value="todas">Todas las Sedes</option>
                        <!-- Se llenará dinámicamente -->
                    </select>
                </div>
                <div>
                    <strong style="color: var(--text-light);" id="labelMes">Mes en curso</strong>
                </div>
            </div>

            <!-- Métricas Principales -->
            <div class="stats-grid">
                <div class="summary-card" style="border-left: 5px solid var(--blue-elegant);">
                    <div class="summary-icon" style="background: #eff6ff; color: #3b82f6;"><span class="material-symbols-outlined">book_online</span></div>
                    <div class="summary-info">
                        <h3>Agendados Total</h3>
                        <strong id="statAgendados">0</strong>
                    </div>
                </div>
                <div class="summary-card" style="border-left: 5px solid var(--green-success);">
                    <div class="summary-icon" style="background: #f0fdf4; color: var(--green-success);"><span class="material-symbols-outlined">how_to_reg</span></div>
                    <div class="summary-info">
                        <h3>Atendidos</h3>
                        <strong id="statAtendados">0</strong>
                    </div>
                </div>
                <div class="summary-card" style="border-left: 5px solid var(--red-urgency);">
                    <div class="summary-icon" style="background: #fef2f2; color: var(--red-urgency);"><span class="material-symbols-outlined">event_busy</span></div>
                    <div class="summary-info">
                        <h3>Cancelados</h3>
                        <strong id="statCancelados">0</strong>
                    </div>
                </div>
                <div class="summary-card" style="border-left: 5px solid var(--pixar-orange);">
                    <div class="summary-icon" style="background: #fff7ed; color: var(--pixar-orange);"><span class="material-symbols-outlined">person_off</span></div>
                    <div class="summary-info">
                        <h3>No Asistieron (No-Show)</h3>
                        <strong id="statNoShow">0</strong>
                    </div>
                </div>
            </div>

            <!-- Perfil de Atención -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                <div class="profile-list">
                    <h3 style="color: var(--blue-elegant); border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-top: 0;">
                        <span class="material-symbols-outlined" style="vertical-align: middle;">pie_chart</span> Perfil de Atenciones Realizadas
                    </h3>
                    <div id="listaMotivos">
                        <p style="color: #94a3b8; text-align: center;">Cargando perfil clínico...</p>
                    </div>
                </div>
                
                <div class="profile-list" style="background: #f8fafc;">
                    <h3 style="color: var(--blue-elegant); border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-top: 0;">
                        <span class="material-symbols-outlined" style="vertical-align: middle;">trending_up</span> Tasas de Conversión
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 15px;">
                        <div>
                            <small style="color: var(--text-light); font-weight: bold;">Asistencia Efectiva</small>
                            <div style="background: #e2e8f0; border-radius: 10px; height: 10px; margin-top: 5px; overflow: hidden;">
                                <div id="barAsistencia" style="background: var(--green-success); width: 0%; height: 100%;"></div>
                            </div>
                            <small id="txtAsistencia" style="float: right; margin-top: 5px;">0%</small>
                        </div>
                        <div>
                            <small style="color: var(--text-light); font-weight: bold;">Tasa de Cancelación</small>
                            <div style="background: #e2e8f0; border-radius: 10px; height: 10px; margin-top: 5px; overflow: hidden;">
                                <div id="barCancelacion" style="background: var(--red-urgency); width: 0%; height: 100%;"></div>
                            </div>
                            <small id="txtCancelacion" style="float: right; margin-top: 5px;">0%</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Módulo IA -->
            <div class="ia-marketing-panel">
                <div class="ia-header">
                    <span class="material-symbols-outlined pulse-icon">auto_awesome</span>
                    <h2>Plan de Marketing Individualizado IA</h2>
                </div>
                <p style="opacity: 0.9; margin-bottom: 20px;">Basado en tu perfil de atención de este mes, la IA generará una estrategia publicitaria enfocada en potenciar tus servicios más rentables y reducir las ausencias en esta sede.</p>
                
                <button class="btn-generate" onclick="generarEstrategiaIA()">
                    <span class="material-symbols-outlined">robot_2</span> Generar Estrategia Ahora
                </button>
                
                <div id="iaResultado" class="ia-prompt-box" style="display: none; margin-top: 20px;">
                    <!-- El prompt/estrategia aparecerá aquí -->
                </div>
            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script>
        // Variables globales de estado para la IA
        let topServicio = "Consulta General";
        let resumenMes = { atendidos: 0, cancelados: 0, noshow: 0, total: 0 };

        document.addEventListener('DOMContentLoaded', async () => {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) {
                window.location.href = '../index.html';
                return;
            }
            
            // Configurar etiqueta del mes
            const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            const hoy = new Date();
            document.getElementById('labelMes').innerText = `Mes en curso: ${meses[hoy.getMonth()]} ${hoy.getFullYear()}`;

            await cargarSedes(userId);
            await cargarDatosAnalisis();
        });

        async function cargarSedes(userId) {
            try {
                const { data: sedes, error } = await window.midental
                    .from('sedes_dentistas')
                    .select('id, nombre_sede')
                    .eq('dentista_id', userId);
                
                if (error) throw error;
                
                const selector = document.getElementById('sedeSelector');
                sedes.forEach(sede => {
                    const option = document.createElement('option');
                    option.value = sede.id;
                    option.textContent = sede.nombre_sede;
                    selector.appendChild(option);
                });
            } catch (error) {
                console.error("Error al cargar sedes:", error);
            }
        }

        async function cargarDatosAnalisis() {
            const userId = localStorage.getItem('midental_user_id');
            const sedeId = document.getElementById('sedeSelector').value;
            
            const hoy = new Date();
            // Formatear mes en formato que usas en 'fecha_hora_formato_slot' o usar timestamps si existen.
            // OJO: No estoy seguro de la estructura exacta de la columna de fecha en citas_agenda. 
            // Quizás sea mejor verificar esto en la documentación actual de tu esquema Supabase.
            // Usaremos una aproximación filtrando las citas y validando en memoria por mes para mayor seguridad si el formato es texto.
            
            try {
                // Consulta base
                let query = window.midental.from('citas_agenda').select('*').eq('dentista_id', userId);
                
                // NO TENGO CERTEZA de que la columna se llame exactamente 'sede_id' en citas_agenda.
                // Si tienes un esquema diferente (ej: centro_medico_id), debes actualizar este campo.
                if (sedeId !== 'todas') {
                    query = query.eq('sede_id', sedeId); 
                }

                const { data: citas, error } = await query;
                if (error) throw error;

                // Filtrar solo las del mes actual en memoria (para evitar fallos de formato de fecha en SQL)
                const mesActual = hoy.getMonth() + 1;
                const yearActual = hoy.getFullYear();
                
                const citasMes = citas.filter(cita => {
                    if(!cita.created_at) return false;
                    const fechaCita = new Date(cita.created_at); // O reemplazar por cita.fecha_hora si existe
                    return fechaCita.getMonth() + 1 === mesActual && fechaCita.getFullYear() === yearActual;
                });

                procesarMetricas(citasMes);
            } catch (error) {
                console.error("Error al cargar citas para análisis:", error);
                alert("Error al cargar los datos del mes.");
            }
        }

        function procesarMetricas(citas) {
            let agendados = citas.length;
            let atendidos = 0;
            let cancelados = 0;
            let noshow = 0;
            
            const conteoMotivos = {};

            citas.forEach(cita => {
                const estado = (cita.estado || '').toLowerCase();
                
                // Clasificación de estados
                if (estado === 'completada' || estado === 'en_atencion') atendidos++;
                else if (estado === 'cancelada' || estado === 'rechazado') cancelados++;
                else if (estado === 'no_asiste') noshow++;

                // Conteo de perfil clínico
                if (estado === 'completada' || estado === 'en_atencion') {
                    const motivo = cita.motivo || 'Consulta General';
                    conteoMotivos[motivo] = (conteoMotivos[motivo] || 0) + 1;
                }
            });

            // Actualizar UI
            document.getElementById('statAgendados').innerText = agendados;
            document.getElementById('statAtendados').innerText = atendidos;
            document.getElementById('statCancelados').innerText = cancelados;
            document.getElementById('statNoShow').innerText = noshow;

            // Guardar para la IA
            resumenMes = { atendidos, cancelados, noshow, total: agendados };

            // Barras de conversión
            const tasaAsistencia = agendados > 0 ? Math.round((atendidos / agendados) * 100) : 0;
            const tasaCancelacion = agendados > 0 ? Math.round((cancelados / agendados) * 100) : 0;
            
            document.getElementById('barAsistencia').style.width = `${tasaAsistencia}%`;
            document.getElementById('txtAsistencia').innerText = `${tasaAsistencia}%`;
            
            document.getElementById('barCancelacion').style.width = `${tasaCancelacion}%`;
            document.getElementById('txtCancelacion').innerText = `${tasaCancelacion}%`;

            // Renderizar Perfil
            const contenedorMotivos = document.getElementById('listaMotivos');
            contenedorMotivos.innerHTML = '';
            
            // Ordenar motivos de mayor a menor
            const motivosOrdenados = Object.entries(conteoMotivos).sort((a, b) => b[1] - a[1]);
            
            if (motivosOrdenados.length > 0) {
                topServicio = motivosOrdenados[0][0]; // Guardar el más popular para la IA
                
                motivosOrdenados.forEach(([motivo, cantidad]) => {
                    contenedorMotivos.innerHTML += `
                        <div class="profile-item">
                            <span style="font-weight: 600;">${motivo}</span>
                            <span style="background: var(--pixar-cyan); color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.8rem; font-weight: bold;">${cantidad} atenciones</span>
                        </div>
                    `;
                });
            } else {
                contenedorMotivos.innerHTML = '<p style="color: #94a3b8; text-align: center;">No hay atenciones completadas este mes aún.</p>';
                topServicio = "Servicios Generales";
            }
            
            // Limpiar área de IA si los datos cambian
            document.getElementById('iaResultado').style.display = 'none';
        }

        function generarEstrategiaIA() {
            const panel = document.getElementById('iaResultado');
            panel.style.display = 'block';
            panel.innerHTML = '<span class="material-symbols-outlined spin-icon" style="vertical-align: middle;">sync</span> Analizando perfil y redactando estrategia...';
            
            // Simulación de llamada a API de IA (Ej: OpenAI o Claude)
            setTimeout(() => {
                const promptGenerado = 
`--- ESTRATEGIA DE MARKETING AUTOMATIZADA ---

📊 CONTEXTO DE LA CLÍNICA (Mes actual):
- Atenciones exitosas: ${resumenMes.atendidos}
- Tasa de pacientes que no asisten (No-Show): ${resumenMes.total > 0 ? Math.round((resumenMes.noshow / resumenMes.total)*100) : 0}%
- Tratamiento líder del mes: "${topServicio}"

🎯 PLAN DE ACCIÓN RECOMENDADO:

1. CAMPAÑA DE ADS (Facebook/Instagram):
Crea una "Oferta Flash" en MiDental centrada en [${topServicio}]. El algoritmo detecta que es tu servicio de mayor demanda orgánica. Publicítalo mostrando un "Antes y Después" para maximizar la conversión.

2. RETENCIÓN Y REDUCCIÓN DE AUSENCIAS:
Tienes ${resumenMes.noshow} ausencias este mes. Se recomienda:
- Activar los recordatorios automatizados por WhatsApp 24h y 4h antes.
- Implementar cobro de reserva mediante Tokens/billetera para pacientes nuevos.

3. UPSELLING A PACIENTES ACTUALES:
A los ${resumenMes.atendidos} pacientes que ya confían en ti este mes, ofréceles un control de higiene o blanqueamiento complementario a su [${topServicio}] utilizando el Monedero MiDental.`;

                panel.innerHTML = promptGenerado;
            }, 1500);
        }
    </script>
</body>
</html>
