        // ==========================================
        // HISTORIAL CLÍNICO Y DOCUMENTOS
        // ==========================================
        async function cargarHistorialPaciente() {
            const dentistaId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('contenedorHistorial');
            if (!dentistaId) return;

            try {
                let query = window.midental.from('fichas_clinicas').select('*').order('created_at', { ascending: false });
                
                if (isLocal && pacienteActual.rut && pacienteActual.rut !== "No registrado") query = query.eq('paciente_rut', pacienteActual.rut);
                else if (!isLocal) query = query.eq('paciente_id', pacienteIdURL);
                else query = query.eq('paciente_nombre', pacienteActual.nombre);

                const { data: historial, error } = await query;
                if (error) throw error;
                contenedor.innerHTML = "";

                if (!historial || historial.length === 0) {
                    contenedor.innerHTML = `<div style="text-align: center; color: #94a3b8; margin-top: 40px; font-size: 0.95rem;"><span class="material-symbols-outlined" style="font-size: 2.5rem; display: block; margin-bottom: 10px; opacity: 0.5;">history</span>No hay atenciones previas registradas.</div>`;
                    return;
                }

                historial.forEach(ficha => {
                    const fechaAtencion = new Date(ficha.ultima_atencion || ficha.created_at).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' });
                    const histoJson = ficha.historial_json || {};
                    const motivoStr = histoJson.motivo || ficha.motivo_consulta || 'Sin especificar';
                    const diagStr = histoJson.diagnostico || 'Revisar detalle clínico';
                    const accionStr = histoJson.tratamiento || ficha.accion_realizada || 'Sin registro';
                    const presupuestoNum = ficha.presupuesto_total || 0;

                    const dataFichaStr = encodeURIComponent(JSON.stringify({ fecha: fechaAtencion, motivo: motivoStr, diagnostico: diagStr, accion: accionStr, presupuesto: presupuestoNum }));

                    contenedor.innerHTML += `
                        <div class="evolucion-card" onclick="abrirBovedaPasada('${dataFichaStr}')" title="Clic para ver detalle completo">
                            <div class="evo-date"><span>Atención Médica</span><span>${fechaAtencion}</span></div>
                            <div class="evo-title" style="color: var(--blue-elegant); font-size: 0.8rem; font-weight: bold;">Motivo Principal:</div>
                            <div class="evo-text" style="font-size: 0.8rem;">${motivoStr.length > 50 ? motivoStr.substring(0, 50) + '...' : motivoStr}</div>
                            ${presupuestoNum > 0 ? `<div class="evo-price">Costo Presupuestado: $${presupuestoNum.toLocaleString('es-CL')}</div>` : ''}
                        </div>
                    `;
                });
            } catch (err) { console.error(err); }
        }

