        /**
         * Actualiza la barra de navegación (rótulo + estado disabled).
         * Llamada por refrescarPanelFinanzas al cambiar de semana.
         */
        function actualizarBarraNavSemana(rs) {
            const dominioFin = new Date(rs.finDate.getTime() - 24 * 60 * 60 * 1000);
            const fmt = (d, opts) => d.toLocaleDateString('es-CL', opts || { day: 'numeric', month: 'short' });
            const lblRango = document.getElementById('lblSemanaActualFinanzas');
            const lblOff   = document.getElementById('lblSemanaOffset');
            if (lblRango) lblRango.innerText = `${fmt(rs.iniDate)} - ${fmt(dominioFin)} ${rs.finDate.getFullYear()}`;
            if (lblOff) {
                if (semanasOffset === 0)       lblOff.innerText = 'Semana actual';
                else if (semanasOffset === -1) lblOff.innerText = 'Semana pasada';
                else                            lblOff.innerText = `${Math.abs(semanasOffset)} semanas atrás`;
            }

            // Botón siguiente deshabilitado cuando ya estamos en la semana actual
            const btnNext = document.getElementById('btnSemanaNext');
            if (btnNext) {
                const yaEsActual = semanasOffset >= 0;
                btnNext.disabled = yaEsActual;
                btnNext.style.cursor  = yaEsActual ? 'not-allowed' : 'pointer';
                btnNext.style.opacity = yaEsActual ? '0.4' : '1';
            }
            const btnPrev = document.getElementById('btnSemanaPrev');
            if (btnPrev) btnPrev.style.cursor = 'pointer';

            // Modo histórico: inputs de "agregar" se deshabilitan porque los
            // INSERT usan NOW() y caerían en la semana actual, no en la vista.
            // Esto evita registros mal datados sin necesidad de un picker de fecha.
            const enHistorico = (semanasOffset !== 0);
            ['labDescripcion','labMonto','convNombre','convPorcentaje'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.disabled = enHistorico;
                el.title    = enHistorico ? 'Vuelve a la semana actual para agregar registros.' : '';
            });
            document.querySelectorAll('#modalFinanzasSemana button[onclick^="agregar"]').forEach(btn => {
                btn.disabled = enHistorico;
                btn.style.opacity = enHistorico ? '0.4' : '1';
                btn.style.cursor  = enHistorico ? 'not-allowed' : 'pointer';
                btn.title = enHistorico ? 'Vuelve a la semana actual para agregar registros.' : '';
            });
        }

        /**
         * Repinta TODO el contenido dependiente de la semana visible.
         * Usa `semanasOffset` para calcular el rango UNA sola vez y lo
         * propaga a todos los loaders + el resumen de 4 recuadros.
         * Las tarjetas del dashboard fuera del modal se refrescan por
         * separado con cargarWidgetsFinancieros (siempre semana actual).
         */
        async function refrescarPanelFinanzas() {
            const userId = localStorage.getItem('midental_user_id');
            const rs = getRangoSemanaOffset(semanasOffset);

            // 1) Barra de navegación (rótulos + disabled del botón siguiente)
            actualizarBarraNavSemana(rs);

            // 2) Limpieza visual antes de pintar los datos históricos
            const labCont  = document.getElementById('listaLaboratorio');
            const convCont = document.getElementById('listaConvenios');
            const histCont = document.getElementById('historialPagosSemana');
            if (labCont)  labCont.innerHTML  = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:15px;">Cargando…</p>';
            if (convCont) convCont.innerHTML = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:15px;">Cargando…</p>';
            if (histCont) histCont.innerHTML = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:15px;">Cargando…</p>';
            ['finBrutos','finLabTotal','finConvTotal','finNetoTotal'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.innerText = '…';
            });

            // 3) Cómputo agregado para la semana visible (4 recuadros)
            if (userId) {
                try {
                    const semana = await calcularFinanzasRango(userId, rs.inicio, rs.fin);
                    cacheFinanzasSemana = semana;
                    document.getElementById('finBrutos').innerText    = '$' + semana.brutos.toLocaleString('es-CL');
                    document.getElementById('finLabTotal').innerText  = '$' + semana.lab.toLocaleString('es-CL');
                    document.getElementById('finConvTotal').innerText = '$' + Math.round(semana.conv).toLocaleString('es-CL');
                    document.getElementById('finNetoTotal').innerText = '$' + Math.round(semana.neto).toLocaleString('es-CL');
                } catch (err) {
                    console.error('Error agregando finanzas de la semana:', err);
                }
            }

            // 4) Tarjetas del dashboard (siempre semana ACTUAL) + listas históricas
            await Promise.all([
                cargarWidgetsFinancieros(),       // tarjetas Día/Semana/Mes — sin offset
                cargarListaLaboratorio(rs),       // ← rango paramétrico
                cargarListaConvenios(rs),
                cargarHistorialPagosSemana(rs)
            ]);
        }

