                <!-- Lista de Fármacos Agregados -->
                <h3 style="color: var(--blue-elegant); font-size: 1.1rem; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">Rp. (Fármacos a prescribir)</h3>
                <div id="listaFármacosAgregados" style="min-height: 100px;">
                    <p style="color: #94a3b8; font-size: 0.9rem; text-align: center; margin-top: 20px;">No has agregado medicamentos a la receta.</p>
                </div>
            </div>
            
            <div class="modal-footer-fixed" style="padding: 20px 30px; display: flex; gap: 15px;">
                <button type="button" class="btn-login-outline btn-full" style="margin: 0; font-weight: bold;" onclick="document.getElementById('modalRecetaMedica').style.display='none'">Cancelar</button>
                <button type="button" class="btn-pixar btn-full" id="btnEmitirReceta" style="margin: 0; font-weight: bold; font-size: 1.1rem; background: var(--green-success);" onclick="emitirYGuardarRecetaPDF()">
                    <span class="material-symbols-outlined">print</span> Emitir Orden Médica
                </button>
            </div>
        </div>
    </div>

    <!-- ======================================================= -->
    <!-- MODAL REGISTRAR ABONO DESDE FICHA (MÓDULO SALDO)        -->
    <!-- ======================================================= -->
    <div id="modalPagoFicha" class="modal-overlay" style="display:none; z-index: 1100;">
        <div class="modal-content" style="max-width: 480px; border-radius: 20px;">
            <button class="btn-close" onclick="document.getElementById('modalPagoFicha').style.display='none'"><span class="material-symbols-outlined">close</span></button>
            <h2 class="modal-title" style="color: var(--green-success); display: flex; align-items: center; gap: 10px; margin-top: 0;">
                <span class="material-symbols-outlined" style="font-size: 2rem;">payments</span> Registrar Abono
            </h2>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0 0 18px;">Saldo restante actual: <strong id="modalPagoSaldoActual" style="color: var(--pixar-orange);">$0</strong></p>

            <div class="input-group-modal">
                <label style="font-size: 0.85rem; font-weight: bold; color: #475569;">Monto del abono ($)</label>
                <input type="number" id="fichaPagoMonto" class="apple-input-modal" placeholder="Ej: 50000" min="0" step="500">
            </div>

            <div class="input-group-modal">
                <label style="font-size: 0.85rem; font-weight: bold; color: #475569;">Medio de Pago</label>
                <select id="fichaPagoMedio" class="apple-input-modal" style="background: white;">
                    <option value="Efectivo">Efectivo</option>
                    <option value="Débito">Débito</option>
                    <option value="Crédito">Crédito</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
            </div>

            <div class="input-group-modal">
                <label style="font-size: 0.85rem; font-weight: bold; color: #475569;">Notas (opcional)</label>
                <input type="text" id="fichaPagoNotas" class="apple-input-modal" placeholder="Ej: Cuota 2 de 4">
            </div>

            <button class="btn-pixar btn-full" id="btnGuardarPagoFicha" onclick="guardarPagoFicha()" style="margin-top: 18px; padding: 14px; background: var(--green-success); font-size: 1rem; border-radius: 12px;">
                <span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Guardar Abono
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const pacienteIdURL = urlParams.get('paciente');
        const isLocal = urlParams.get('local') === 'true';
        const citaId = urlParams.get('cita');
        
        let pacienteActual = { 
            nombre: urlParams.get('nombre') ? decodeURIComponent(urlParams.get('nombre')) : "Paciente No Encontrado", 
            telefono: urlParams.get('telefono') ? decodeURIComponent(urlParams.get('telefono')) : "", 
            rut: urlParams.get('rut') ? decodeURIComponent(urlParams.get('rut')) : "" 
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (!pacienteIdURL && !isLocal) {
                alert("Error: No se especificó un paciente válido.");
                window.history.back();
                return;
            }
            cargarDatosPaciente();
        });

        async function cargarDatosPaciente() {
            try {
                if (isLocal) {
                    // MODO FICHA LOCAL (Sin cuenta creada)
                    document.getElementById('headerNombrePaciente').innerText = pacienteActual.nombre + " (Ficha Local)";
                    document.getElementById('panelNombrePaciente').innerText = pacienteActual.nombre;
                    document.getElementById('panelRutPaciente').innerText = `RUT: ${pacienteActual.rut || 'No registrado'}`;
                    document.getElementById('panelTelefonoPaciente').innerHTML = `<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">call</span> ${pacienteActual.telefono || 'Sin teléfono'}`;
                    document.getElementById('derivarPcteNombre').innerText = pacienteActual.nombre;
                    
                    document.getElementById('panelAvatarImg').style.display = 'none';
                    document.getElementById('panelAvatarText').style.display = 'flex';
                    document.getElementById('panelAvatarText').innerText = pacienteActual.nombre.charAt(0).toUpperCase();
                    
                    document.getElementById('alertaClinicaContainer').style.display = 'none';
                } else {
                    // MODO PACIENTE REGISTRADO OFICIAL
                    const { data: paciente, error } = await window.midental.from('perfiles_pacientes')
                        // ---> AGREGAMOS notas_privadas AQUÍ <---
                        .select('nombre_completo, rut, telefono, enfermedades_cronicas, medicamentos, alergias, avatar_url, notas_privadas')
                        .eq('id', pacienteIdURL).single();
                        
                    if (error) throw error;
                    
                    if (paciente) {
                        pacienteActual.nombre = paciente.nombre_completo || "Sin Nombre";
                        pacienteActual.rut = paciente.rut || "No registrado";
                        pacienteActual.telefono = paciente.telefono || "";

                        document.getElementById('headerNombrePaciente').innerText = pacienteActual.nombre;
                        document.getElementById('panelNombrePaciente').innerText = pacienteActual.nombre;
                        document.getElementById('panelRutPaciente').innerText = `RUT: ${pacienteActual.rut}`;
                        document.getElementById('panelTelefonoPaciente').innerHTML = `<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">call</span> ${pacienteActual.telefono || 'Sin teléfono'}`;
                        document.getElementById('derivarPcteNombre').innerText = pacienteActual.nombre;

                        const imgEl = document.getElementById('panelAvatarImg');
                        const txtEl = document.getElementById('panelAvatarText');
                        
                        if (paciente.avatar_url && paciente.avatar_url !== "") {
                            imgEl.src = paciente.avatar_url;
                            imgEl.style.display = 'block';
                            txtEl.style.display = 'none';
                        } else {
                            imgEl.style.display = 'none';
                            txtEl.style.display = 'flex';
                            txtEl.innerText = pacienteActual.nombre.charAt(0).toUpperCase();
                        }

                        // Llenar datos médicos del paciente (Lectura y Cajas de Edición)
                        document.getElementById('txtCrónicas').innerText = paciente.enfermedades_cronicas || 'Ninguna';
                        document.getElementById('inputCronicas').value = paciente.enfermedades_cronicas || '';

                        document.getElementById('txtMedicamentos').innerText = paciente.medicamentos || 'Ninguno';
                        document.getElementById('inputMedicamentos').value = paciente.medicamentos || '';

                        document.getElementById('txtAlergias').innerText = paciente.alergias || 'Ninguna';
                        document.getElementById('inputAlergias').value = paciente.alergias || '';
                        
                        // ---> NUEVO: Llenar notas privadas <---
                        if (paciente.notas_privadas) {
                            document.getElementById('vistaNotasPrivadas').innerText = paciente.notas_privadas;
                            document.getElementById('inputNotasPrivadas').value = paciente.notas_privadas;
                        } else {
                            document.getElementById('vistaNotasPrivadas').innerText = 'Sin notas internas registradas.';
                            document.getElementById('inputNotasPrivadas').value = '';
                        }

                        // ---> NUEVO: Siempre mostramos la caja de alerta para dar acceso a las notas <---
                        document.getElementById('alertaClinicaContainer').style.display = 'block';
                    
                    }
                }
                
                // Estas dos llamadas deben quedar dentro de cargarDatosPaciente, pero al final
                cargarHistorialPaciente();
                cargarDocumentosPaciente();
                cargarControlPresupuesto();

            } catch (err) {
                console.error("Error al cargar paciente:", err);
            }
        } // <--- ¡AQUÍ CERRAMOS CORRECTAMENTE LA FUNCIÓN cargarDatosPaciente()!

        // =========================================================
        // MÓDULO SALDO CORRIENTE: PRESUPUESTO INTEGRAL + PAGOS
        // =========================================================
        async function cargarControlPresupuesto() {
            // En modo Ficha Local no hay paciente registrado: ocultamos el módulo
            if (isLocal || !pacienteIdURL) {
                const cont = document.getElementById('controlPresupuestoContainer');
                const hist = document.getElementById('historialPagosContainer');
                if (cont) cont.style.display = 'none';
                if (hist) hist.style.display = 'none';
                return;
            }

            try {
                // 1) Consultamos la vista que ya calcula presupuesto, pagado y saldo
                const { data: balance, error: errBalance } = await window.midental
                    .from('vista_balance_paciente')
                    .select('*')
                    .eq('paciente_id', pacienteIdURL)
                    .maybeSingle();

                if (errBalance) throw errBalance;

                const presup = balance ? parseFloat(balance.presupuesto_integral || 0) : 0;
                const pagado = balance ? parseFloat(balance.total_pagado || 0) : 0;
                const saldo  = presup - pagado;

                document.getElementById('statPresupuestoTotal').innerText = '$' + presup.toLocaleString('es-CL');
                document.getElementById('statTotalPagado').innerText      = '$' + pagado.toLocaleString('es-CL');
                document.getElementById('statSaldoRestante').innerText    = '$' + saldo.toLocaleString('es-CL');
                document.getElementById('inputPresupuesto').value         = presup || '';

                // 2) Cargamos el historial de pagos del paciente
                await cargarHistorialPagos();
            } catch (err) {
                console.error("Error cargando control de presupuesto:", err);
            }
        }

        async function cargarHistorialPagos() {
            const tbody = document.getElementById('tbodyHistorialPagos');
            if (!tbody) return;

            try {
                const { data: pagos, error } = await window.midental.from('pagos')
                    .select('*')
                    .eq('paciente_id', pacienteIdURL)
                    .order('fecha_pago', { ascending: false });

                if (error) throw error;

                if (!pagos || pagos.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" style="padding: 20px; text-align: center; color: #94a3b8;">Aún no se han registrado pagos para este paciente.</td></tr>`;
                    return;
                }

                tbody.innerHTML = pagos.map(p => `
                    <tr style="border-bottom: 1px solid #e2e8f0;">
                        <td style="padding: 10px 12px; color: #475569;">${new Date(p.fecha_pago).toLocaleString('es-CL', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' })}</td>
                        <td style="padding: 10px 12px; text-align: right; color: var(--green-success); font-weight: bold;">$${parseFloat(p.monto).toLocaleString('es-CL')}</td>
                        <td style="padding: 10px 12px;"><span style="background: #eff6ff; color: var(--blue-elegant); padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: bold;">${p.medio_pago}</span></td>
                        <td style="padding: 10px 12px; color: #64748b; font-size: 0.85rem;">${p.notas || '—'}</td>
                    </tr>
                `).join('');
            } catch (err) {
                console.error("Error cargando pagos:", err);
                tbody.innerHTML = `<tr><td colspan="4" style="padding: 20px; text-align: center; color: var(--red-urgency);">Error al cargar el historial.</td></tr>`;
            }
        }

        function togglePresupuestoEdit() {
            const vista   = document.getElementById('vistaPresupuesto');
            const edicion = document.getElementById('edicionPresupuesto');
            const btn     = document.getElementById('btnEditarPresupuesto');
            if (edicion.style.display === 'none' || edicion.style.display === '') {
                vista.style.display   = 'none';
                edicion.style.display = 'block';
                btn.innerText = 'Cancelar';
            } else {
                vista.style.display   = 'grid';
                edicion.style.display = 'none';
                btn.innerText = 'Editar Presupuesto';
            }
        }

        async function guardarPresupuesto() {
            if (isLocal) return alert("No disponible para fichas locales.");
            const valor = parseFloat(document.getElementById('inputPresupuesto').value);
            if (isNaN(valor) || valor < 0) return alert("Ingresa un valor de presupuesto válido (≥ 0).");

            try {
                const { error } = await window.midental.from('perfiles_pacientes')
                    .update({ presupuesto_integral: valor })
                    .eq('id', pacienteIdURL);
                if (error) throw error;

                togglePresupuestoEdit();
                await cargarControlPresupuesto();
            } catch (err) {
                alert("Error al guardar el presupuesto: " + err.message);
            }
        }

        function abrirModalRegistrarPagoFicha() {
            if (isLocal) return alert("No disponible para fichas locales.");
            document.getElementById('fichaPagoMonto').value = '';
            document.getElementById('fichaPagoMedio').value = 'Efectivo';
            document.getElementById('fichaPagoNotas').value = '';
            document.getElementById('modalPagoSaldoActual').innerText = document.getElementById('statSaldoRestante').innerText;
            document.getElementById('modalPagoFicha').style.display = 'flex';
        }

        async function guardarPagoFicha() {
            const dentistaId = localStorage.getItem('midental_user_id');
            const monto = parseFloat(document.getElementById('fichaPagoMonto').value);
            const medio = document.getElementById('fichaPagoMedio').value;
            const notas = document.getElementById('fichaPagoNotas').value.trim();

            if (isNaN(monto) || monto <= 0) return alert("Ingresa un monto válido (> 0).");
            if (!dentistaId) return alert("No hay sesión activa de dentista.");

            const btn = document.getElementById('btnGuardarPagoFicha');
            btn.disabled = true; btn.innerText = "Guardando...";

            try {
                const { error } = await window.midental.from('pagos').insert([{
                    paciente_id: pacienteIdURL,
                    dentista_id: dentistaId,
                    monto: monto,
                    medio_pago: medio,
                    notas: notas || null
                }]);
                if (error) throw error;

                document.getElementById('modalPagoFicha').style.display = 'none';
                await cargarControlPresupuesto();
                alert("✅ Abono de $" + monto.toLocaleString('es-CL') + " registrado correctamente.");
            } catch (err) {
                alert("Error al guardar el abono: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle;">save</span> Guardar Abono';
            }
        }


        // ==========================================
        // EDICIÓN DE ANTECEDENTES SISTÉMICOS (AHORA ESTÁN LIBRES Y GLOBALES)
        // ==========================================
        function toggleEdicionAlerta() {
            const vista = document.getElementById('vistaAlertaMedica');
            const edicion = document.getElementById('edicionAlertaMedica');
            const btn = document.getElementById('btnEditarAlerta');
            
            if (edicion.style.display === 'none') {
                vista.style.display = 'none';
                edicion.style.display = 'flex';
                btn.innerText = 'Cancelar';
            } else {
                vista.style.display = 'block';
                edicion.style.display = 'none';
                btn.innerText = 'Editar Antecedentes';
            }
        }

        async function guardarAlertaMedica() {
            if (isLocal) return alert("Esta acción no está disponible para Fichas Locales temporales.");
            
            const cronicas = document.getElementById('inputCronicas').value.trim();
            const medicamentos = document.getElementById('inputMedicamentos').value.trim();
            const alergias = document.getElementById('inputAlergias').value.trim();
            
            const btnGuardar = document.getElementById('btnGuardarAlerta');
            btnGuardar.innerText = "Guardando..."; btnGuardar.disabled = true;

            try {
                // Hacemos el UPDATE directamente al perfil del paciente usando su ID Clínico
                const { error } = await window.midental.from('perfiles_pacientes')
                    .update({
                        enfermedades_cronicas: cronicas || 'Ninguna',
                        medicamentos: medicamentos || 'Ninguno',
                        alergias: alergias || 'Ninguna'
                    })
                    .eq('id', pacienteIdURL);
                    
                if (error) throw error;
                
                // Actualizamos la vista de lectura sin necesidad de recargar la página
                document.getElementById('txtCrónicas').innerText = cronicas || 'Ninguna';
                document.getElementById('txtMedicamentos').innerText = medicamentos || 'Ninguno';
                document.getElementById('txtAlergias').innerText = alergias || 'Ninguna';
                
                toggleEdicionAlerta();
                
            } catch (err) {
                alert("Error al actualizar la Alerta Médica: " + err.message);
            } finally {
                btnGuardar.innerText = "Guardar Antecedentes"; btnGuardar.disabled = false;
            }
        }

        async function cargarHistorialPaciente() {
            const dentistaId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('contenedorHistorial');
            if (!dentistaId) return;

            try {
                // Inteligencia de Búsqueda: Si es local busca por RUT, si es oficial busca por ID.
                let query = window.midental.from('fichas_clinicas').select('*').order('created_at', { ascending: false });
                
                if (isLocal && pacienteActual.rut && pacienteActual.rut !== "No registrado") {
                    query = query.eq('paciente_rut', pacienteActual.rut);
                } else if (!isLocal) {
                    query = query.eq('paciente_id', pacienteIdURL);
                } else {
                    query = query.eq('paciente_nombre', pacienteActual.nombre);
                }

                const { data: historial, error } = await query;

                if (error) throw error;
                contenedor.innerHTML = "";

                if (!historial || historial.length === 0) {
                    contenedor.innerHTML = `<div style="text-align: center; color: #94a3b8; margin-top: 40px; font-size: 0.95rem;"><span class="material-symbols-outlined" style="font-size: 2.5rem; display: block; margin-bottom: 10px; opacity: 0.5;">history</span>No hay atenciones previas registradas.</div>`;
                    return;
                }

                historial.forEach(ficha => {
                    const fechaAtencion = new Date(ficha.ultima_atencion || ficha.created_at).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' });
                    const histoJson = ficha.historial_json || {};
                    const motivoStr = histoJson.motivo || ficha.motivo_consulta || 'Sin especificar';
                    const diagStr = histoJson.diagnostico || 'Revisar detalle clínico';
                    const accionStr = histoJson.tratamiento || ficha.accion_realizada || 'Sin registro';
                    const presupuestoNum = ficha.presupuesto_total || 0;

                    const dataFichaStr = encodeURIComponent(JSON.stringify({ fecha: fechaAtencion, motivo: motivoStr, diagnostico: diagStr, accion: accionStr, presupuesto: presupuestoNum }));

                    contenedor.innerHTML += `
                        <div class="evolucion-card" onclick="abrirBovedaPasada('${dataFichaStr}')" title="Clic para ver detalle completo">
                            <div class="evo-date"><span>Atención Médica</span><span>${fechaAtencion}</span></div>
                            <div class="evo-title" style="color: var(--blue-elegant); font-size: 0.8rem; font-weight: bold;">Motivo Principal:</div>
                            <div class="evo-text" style="font-size: 0.8rem;">${motivoStr.length > 50 ? motivoStr.substring(0, 50) + '...' : motivoStr}</div>
                            ${presupuestoNum > 0 ? `<div class="evo-price">Costo Presupuestado: $${presupuestoNum.toLocaleString('es-CL')}</div>` : ''}
                        </div>
                    `;
                });
            } catch (err) { console.error(err); }
        }

        // ==========================================
        // SISTEMA DE DOCUMENTOS CON URLS FIRMADAS (BUCKET EN MINÚSCULAS CORRECTO)
        // ==========================================
        async function cargarDocumentosPaciente() {
            const contenedor = document.getElementById('contenedorDocumentosPaciente');
            if (!contenedor) return;
            if (isLocal) {
                contenedor.innerHTML = '<p style="color: #f59e0b; font-size: 0.85rem; grid-column: 1/-1; text-align: center; margin-top:10px;"><b>Atención:</b> La carga de archivos no está disponible para Fichas Locales.</p>';
                document.getElementById('labelBtnSubidaDoc').style.display = 'none';
                return;
            }
            
            try {
                const { data: docs, error } = await window.midental
                    .from('documentos_pacientes')
                    .select('*')
                    .eq('paciente_id', pacienteIdURL)
                    .order('created_at', { ascending: false });

                if (error) throw error;
                contenedor.innerHTML = "";

                if (!docs || docs.length === 0) {
                    contenedor.innerHTML = '<p style="color: #94a3b8; font-size: 0.9rem; text-align: center; grid-column: 1/-1; margin: 10px 0;">El paciente no ha subido archivos aún.</p>';
                    return;
                }

                for (const doc of docs) {
                    let urlSegura = '';
                    const archivoRef = doc.archivo_url || doc.file_url || doc.url || '';
                    
                    if (!archivoRef) continue;

                    if (archivoRef.startsWith('http')) {
                        urlSegura = archivoRef;
                    } else {
                        // AQUÍ: BUCKET EN MINÚSCULAS EXACTO PARA QUE COINCIDA
                        const { data: signedData } = await window.midental.storage
                            .from('documentos_clinicos')
                            .createSignedUrl(archivoRef, 3600);
                        urlSegura = signedData?.signedUrl || '#';
                    }

                    const esImagen = archivoRef.match(/\.(jpeg|jpg|gif|png)$/i) != null;
                    const esPresupuesto = doc.nombre_archivo && doc.nombre_archivo.toLowerCase().includes('presupuesto');
                    
                    const iconSymbol = esPresupuesto ? 'request_quote' : (esImagen ? 'image' : 'description');
                    const colorStyle = esPresupuesto ? 'color: white; background: var(--pixar-cyan);' : 'color: var(--pixar-cyan);';

                    contenedor.innerHTML += `
                        <div style="background: #f8fafc; padding: 15px 10px; border-radius: 12px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; display: flex; flex-direction: column; align-items: center; justify-content: space-between; transition: 0.2s;">
                            <div style="width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; ${colorStyle}">
                                <span class="material-symbols-outlined" style="font-size: 1.8rem;">${iconSymbol}</span>
                            </div>
                            <p style="font-size: 0.75rem; margin: 0 0 10px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%; color: #334155; font-weight: bold;" title="${doc.nombre_archivo}">${doc.nombre_archivo || 'Documento Adjunto'}</p>
