        .menu-toggle-btn {
            background: transparent; border: none; color: var(--blue-elegant); cursor: pointer;
            margin-right: 15px; display: flex; align-items: center; justify-content: center;
            padding: 5px; border-radius: 8px; transition: 0.2s;
        }
        .menu-toggle-btn:hover { background: #f1f5f9; color: var(--pixar-cyan); }


        /* =========================================================
           DISEÑO DE GRILLA (Lienzo estático panorámico tipo Medilink/Dentalink)
           ========================================================= */
        .calendar-grid-container * { box-sizing: border-box; }

        /* Filas de tiempo: alto fijo estricto de 40px (granularidad 30 min) */
        .time-slot-label {
            height: 40px !important; min-height: 40px !important; max-height: 40px !important;
            overflow: hidden;
        }
        .time-block {
            height: 40px !important; min-height: 40px !important; max-height: 40px !important;
            position: relative; /* Permite que las citas largas se superpongan en absolute */
        }
        .time-header-spacer, .day-header {
            height: 50px !important; min-height: 50px !important; max-height: 50px !important;
            overflow: hidden;
        }
        /* Columna de horas: ancho fijo 60px */
        .time-labels {
            display: flex; flex-direction: column;
            width: 60px; min-width: 60px; max-width: 60px;
            border-right: 1px solid #e2e8f0;
            position: sticky; left: 0; background: white; z-index: 20;
            box-shadow: 2px 0 5px rgba(0,0,0,0.02);
        }
        .time-header-spacer { border-bottom: 2px solid #cbd5e1; background: #f8fafc; position: sticky; top: 0; z-index: 30; }
        .time-slot-label { display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: bold; color: #64748b; border-bottom: 1px solid #e2e8f0; background: #fff; }

        /* Columnas de día: ancho fijo 140px (no se aplastan en móvil) */
        .days-container { display: grid; grid-template-columns: repeat(7, 140px); flex: 0 0 auto; min-width: max-content; }
        .day-col { display: flex; flex-direction: column; border-right: 1px solid #e2e8f0; width: 140px; min-width: 140px; max-width: 140px; }
        .day-header { display: flex; align-items: center; justify-content: center; font-weight: bold; color: var(--blue-elegant); border-bottom: 2px solid #cbd5e1; background: #f8fafc; position: sticky; top: 0; z-index: 10; flex-direction: column; line-height: 1.1; }
        .day-header small { font-weight: normal; font-size: 0.75rem; color: #64748b; margin-top: 2px;}
        .time-block { border-bottom: 1px solid #e2e8f0; padding: 2px; }

        .slot-workplace { background: #eafaea; border: 1px solid #cce8dd; width: 100%; height: 100%; border-radius: 4px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 6px; cursor: pointer; transition: 0.2s; color: #166534; }
        .slot-workplace:hover { background: #d1f4e0; border-color: #a7e0c4; }
        .sede-text-mini { font-size: 0.7rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; text-align: left; margin-left: 4px; }

        /* Evento posicionado en absolute: permite que cubra varios bloques verticalmente */
        .event-base {
            position: absolute; top: 0; left: 0; width: 100%; z-index: 10;
            padding: 4px 6px; border-radius: 4px; cursor: pointer;
            display: flex; flex-direction: column; justify-content: flex-start;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05); line-height: 1.2;
            overflow: hidden;
        }
        .event-pendiente { background-color: #fef3c7; border-left: 4px solid #f59e0b; color: #92400e; }
        .event-Confirmado { background-color: #dcfce7; border-left: 4px solid #10b981; color: #065f46; } /* Ajustado a mayúscula por Dashboard */
        .event-confirmada { background-color: #dcfce7; border-left: 4px solid #10b981; color: #065f46; } /* Respaldo */
        .event-en_atencion { background-color: #e0e7ff; border-left: 4px solid #3b82f6; color: #1e40af; }
        .event-completada { background-color: #f1f5f9; border-left: 4px solid #94a3b8; color: #475569; }
        .event-bloqueado { background-color: #f8fafc; border-left: 4px solid #64748b; color: #475569; opacity: 0.9; }

        .calendar-wrapper { display: flex; flex-direction: column; flex: 1; min-height: 0;}
        .calendar-toolbar-compact { display: flex; align-items: center; justify-content: space-between; background: white; padding: 10px 20px; border-radius: 10px 10px 0 0; border: 1px solid #e2e8f0; border-bottom: none; flex-wrap: wrap; gap: 15px;}
        .calendar-grid-container { flex: 1; overflow: auto; background: white; border: 1px solid #e2e8f0; display: flex; position: relative; border-radius: 0 0 10px 10px; -webkit-overflow-scrolling: touch; }

        /* Autocompletado Inteligente de Pacientes */
        .autocomplete-list {
            position: absolute; z-index: 1000; background: white; border: 1px solid #e2e8f0;
            border-radius: 8px; max-height: 160px; overflow-y: auto; width: 100%;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1); display: none; margin-top: 5px; top: 100%;
        }
        .autocomplete-item {
            padding: 10px 15px; cursor: pointer; border-bottom: 1px solid #f1f5f9;
            font-size: 0.85rem; color: #475569; display: flex; flex-direction: column; gap: 3px;
        }
        .autocomplete-item:hover { background: #f8fafc; }
        .autocomplete-item strong { color: var(--blue-elegant); font-size: 0.95rem; }

        /* =========================================================
           ESTRUCTURA DE MODAL CON BOTONES INMÓVILES (FIXED FOOTER)
           ========================================================= */
        .modal-content-split {
            display: flex; flex-direction: column; max-height: 90vh; 
            padding: 0 !important; overflow: hidden;
        }
        .modal-body-scroll {
            padding: 25px; overflow-y: auto; flex: 1; -webkit-overflow-scrolling: touch;
        }
        .modal-footer-fixed {
            padding: 15px 25px 20px 25px; background: white; border-top: 1px solid #e2e8f0; 
            flex-shrink: 0; box-shadow: 0 -5px 15px rgba(0,0,0,0.03); z-index: 10;
        }
        /* =========================================================
           MODO CELULAR: solo reflow de la barra superior.
           La grilla mantiene tamaños fijos y se navega por scroll H/V
           sobre el lienzo estático (estándar Medilink/Dentalink).
           ========================================================= */
        @media (max-width: 768px) {
            .dashboard-content { padding: 10px 10px; }
            .calendar-toolbar-compact { flex-direction: column; align-items: stretch; padding: 10px; }
            .cal-nav-buttons { justify-content: space-between; width: 100%; }
            #textoSemanaActual { font-size: 1rem; min-width: 150px;}
            .cal-leyend-compact { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; font-size: 0.7rem; }
        }
        /* =========================================================
           PARCHE: AGENDA MÓVIL 100% ESTÁTICA Y NATIVA
           ========================================================= */
        @media (max-width: 768px) {
            body { 
                overflow: hidden !important; /* Bloquea que la página entera se mueva */
                position: fixed; width: 100%; height: 100%; /* Inmoviliza el chasis */
            }
            .dashboard-layout, .dashboard-content { 
                height: 100dvh !important; /* dvh = Altura Dinámica Real del celular */
                display: flex !important; 
                flex-direction: column !important; 
                padding-bottom: 70px !important; /* Protege el espacio del menú inferior */
            }
            .calendar-wrapper { 
                flex: 1 !important; 
                display: flex !important; 
                flex-direction: column !important; 
                min-height: 0 !important; /* Magia CSS: obliga a que el scroll ocurra adentro */
            }
            .calendar-grid-container { 
                flex: 1 !important; 
                overflow-y: auto !important; 
                overflow-x: auto !important; 
                -webkit-overflow-scrolling: touch; /* Scroll suave de iPhone */
            }
        }
    </style>
