        .historial-panel { background: white; border-radius: 20px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }
        .historial-header { background: linear-gradient(135deg, var(--blue-elegant), #1e3a8a); color: white; padding: 25px 20px; text-align: center; position: relative; border-radius: 20px 20px 0 0;}
        .historial-body { padding: 20px; background: #f8fafc; min-height: 200px; max-height: 400px; overflow-y: auto;}
        
        .alerta-clinica { background: #fef2f2; border-left: 4px solid #ef4444; padding: 15px 20px; text-align: left; display: none; }
        .alerta-clinica h4 { margin: 0 0 10px 0; color: #b91c1c; display: flex; align-items: center; gap: 5px; font-size: 0.95rem; }
        .alerta-item { margin: 0 0 5px 0; font-size: 0.85rem; color: #7f1d1d; line-height: 1.4; }
        
        .btn-interconsulta-flotante { position: absolute; top: 15px; right: 15px; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 6px 12px; border-radius: 12px; font-size: 0.8rem; display: flex; align-items: center; gap: 5px; cursor: pointer; transition: 0.2s; font-weight: bold;}
        .btn-interconsulta-flotante:hover { background: white; color: var(--blue-elegant); }

        .ficha-avatar-container { position: relative; width: 90px; height: 90px; margin: 0 auto 15px; }
        .ficha-avatar-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid rgba(255,255,255,0.9); box-shadow: 0 4px 15px rgba(0,0,0,0.2); display: none; background: white;}
        .ficha-avatar-text { width: 100%; height: 100%; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: bold; color: white; border: 3px solid rgba(255,255,255,0.9); }

        .evolucion-card { background: white; border-left: 5px solid var(--pixar-cyan); padding: 20px; border-radius: 12px; margin-bottom: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.02); cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; position: relative; border: 1px solid #f1f5f9;}
        .evolucion-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); border-left-color: var(--pixar-orange); }
        .evo-date { font-size: 0.85rem; color: #64748b; font-weight: bold; margin-bottom: 8px; display: flex; justify-content: space-between; text-transform: uppercase; letter-spacing: 0.5px;}
        .evo-text { font-size: 0.9rem; color: #475569; line-height: 1.5; margin-bottom: 12px; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0;}
        .evo-price { font-size: 0.9rem; color: var(--green-success); font-weight: 900; text-align: right; margin-top: 10px; border-top: 1px dashed #cbd5e1; padding-top: 8px;}

        /* Panel Derecho */
        .nueva-evo-panel { background: white; border-radius: 20px; border: 1px solid #e2e8f0; padding: 30px; display: flex; flex-direction: column; box-shadow: 0 10px 30px rgba(0,0,0,0.03); overflow: hidden; }
        .form-section-title { color: var(--blue-elegant); border-bottom: 2px solid #f1f5f9; padding-bottom: 12px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; font-size: 1.2rem; }
        .textarea-clinico { width: 100%; border: 1px solid #cbd5e1; border-radius: 12px; padding: 15px; font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 80px; margin-bottom: 25px; background: #f8fafc; box-sizing: border-box;}
        .textarea-clinico:focus { outline: none; border-color: var(--pixar-cyan); box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.1); background: white;}
        
        /* Tabla Presupuesto */
        .presupuesto-table-wrapper { overflow-x: auto; margin-bottom: 15px; border-radius: 12px; border: 1px solid #e2e8f0; width: 100%; }
        .presupuesto-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 650px;}
        .presupuesto-table th { background-color: var(--blue-elegant); color: white; padding: 12px 8px; border-bottom: 2px solid #1e3a8a; text-align: left; }
        .presupuesto-table td { border-bottom: 1px solid #e2e8f0; padding: 8px; background: white;}
        .presupuesto-table input { width: 100%; border: none; outline: none; background: transparent; font-family: inherit; font-size: 0.9rem;}
        .presupuesto-table .input-readonly { background: #f1f5f9; color: #475569; font-weight: bold; padding: 5px; border-radius: 6px;}
        .total-final-box { text-align: right; font-size: 1.3rem; color: var(--blue-elegant); padding: 15px 10px 0; border-top: 2px solid var(--blue-elegant); margin-top: 15px; font-weight: 900; }

        /* Estilo input file oculto para el botón */
        .btn-upload-doc { cursor: pointer; padding: 6px 12px; border-radius: 8px; background: #f1f5f9; color: var(--blue-elegant); font-size: 0.8rem; font-weight: bold; border: 1px solid #cbd5e1; display: flex; align-items: center; gap: 5px; transition: 0.2s; }
        .btn-upload-doc:hover { background: var(--pixar-cyan); color: white; border-color: var(--pixar-cyan); }
   /* =========================================================
           INTERACCIÓN DE CARAS DEL ODONTOGRAMA (SVG)
           ========================================================= */
        #odontogramaSVG polygon, 
        #odontogramaSVG path,
        .odn-surface, 
        .odn-tooth { 
            transition: fill 0.2s, stroke 0.2s; 
            cursor: pointer; 
        }
        
        /* Efecto al pasar el mouse por encima (Celeste claro) */
        #odontogramaSVG polygon:hover, 
        #odontogramaSVG path:hover { 
            fill: #bae6fd !important; 
            stroke: #0284c7; 
        }
        
        /* Efecto al hacer clic / Selección activa (Cyan corporativo) */
        #odontogramaSVG polygon.selected, 
        #odontogramaSVG path.selected,
        .odn-surface.selected { 
            fill: var(--pixar-cyan) !important; 
            stroke: #0369a1 !important; 
            stroke-width: 2px; 
        }
        /* =========================================================
           MOTOR DE INTELIGENCIA CLÍNICA (PREMIUM)
           ========================================================= */
        .premium-ai-card { background: linear-gradient(145deg, #ffffff, #f8fafc); border: 1px solid #e2e8f0; border-left: 6px solid #8b5cf6; border-radius: 15px; padding: 20px; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(139, 92, 246, 0.1); display: none; position: relative; overflow: hidden; }
        .premium-ai-card::before { content: "PREMIUM"; position: absolute; top: 15px; right: -25px; background: #8b5cf6; color: white; font-size: 0.65rem; font-weight: 900; padding: 4px 30px; transform: rotate(45deg); letter-spacing: 2px; }
        .ai-header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; }
        .ai-header h3 { margin: 0; color: #1e293b; font-size: 1.15rem; font-weight: 900; }
        .ai-risk-badge { padding: 5px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: bold; color: white; }
        .ai-content p { margin: 0 0 8px 0; font-size: 0.9rem; color: #475569; line-height: 1.5; }
        .ai-content strong { color: #1e293b; }
        .btn-premium-action { background: #8b5cf6; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: 0.2s; box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3); margin-top: 10px; }
        .btn-premium-action:hover { background: #7c3aed; transform: translateY(-2px); }
    /* =========================================================
           ASISTENTE CLÍNICO INTELIGENTE (ODONTOGRAMA PREMIUM)
           ========================================================= */
        .odn-smart-panel { background: white; padding: 15px; display: none; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        
        /* Modificadores para su nueva ubicación en la columna derecha */
        .odn-smart-panel.right-side-panel {
            margin: 15px 15px 0 15px; 
            border-top: 4px solid var(--pixar-cyan); 
            border-radius: 12px;
            border-left: 1px solid #e2e8f0;
            border-right: 1px solid #e2e8f0;
            border-bottom: 1px solid #e2e8f0;
            animation: slideDown 0.3s ease-out;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        
        .smart-panel-title { color: var(--blue-elegant); font-size: 1rem; margin: 0 0 10px 0; font-weight: 900; display: flex; align-items: center; gap: 5px; }
        .smart-recommendation { background: #f0fdfa; border: 1px solid #ccfbf1; color: #0f766e; padding: 12px; border-radius: 8px; font-size: 0.85rem; line-height: 1.4; margin-bottom: 15px; font-weight: 500; }
        .smart-recommendation.alert { background: #fef2f2; border-color: #fecaca; color: #b91c1c; }
        .smart-recommendation.warning { background: #fff7ed; border-color: #fde68a; color: #b45309; }
        
        .smart-options-title { font-size: 0.8rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; font-weight: bold; margin-bottom: 8px; }
        .smart-plan-btn { display: block; width: 100%; text-align: left; background: white; border: 1px solid #cbd5e1; padding: 10px 12px; border-radius: 8px; margin-bottom: 8px; cursor: pointer; color: #334155; font-size: 0.85rem; transition: 0.2s; }
        .smart-plan-btn:hover { border-color: var(--pixar-cyan); background: #f8fafc; transform: translateX(3px); }
        .smart-plan-btn span { color: var(--pixar-cyan); font-weight: bold; margin-right: 5px; }
    </style>
    
