        doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text("Datos del Paciente", 14, 40);
        doc.setFontSize(10); doc.setTextColor(50, 50, 50); doc.text(`Nombre: ${pacienteActual.nombre}`, 14, 47); doc.text(`RUT: ${pacienteActual.rut}`, 14, 53);

        doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text("Profesional Tratante", 110, 40);
        doc.setFontSize(10); doc.setTextColor(50, 50, 50); doc.text(`Dentista: ${drName}`, 110, 47); if(dr) doc.text(`RUT: ${dr.rut}`, 110, 53);

        const tableColumn = ["Pieza", "Diagnóstico", "Prestación", "Valor Ref.", "Dscto", "Total"];
        const tableRows = [];
        
        document.querySelectorAll('#tbodyPresupuesto tr').forEach(tr => {
            const piezaVal = tr.querySelector('.input-diente').value.trim();
            const diagVal = tr.querySelector('.input-diag').value.trim();
            const tratVal = tr.querySelector('.input-tratamiento').value.trim();
            const refInput = parseFloat(tr.querySelector('.input-ref').value) || 0;
            const descInput = parseFloat(tr.querySelector('.input-desc').value) || 0;
            
            let totalInput = 0;
            const elTotal = tr.querySelector('.input-total');
            if(elTotal.dataset.valorReal) totalInput = parseFloat(elTotal.dataset.valorReal);
            else if (elTotal.value) totalInput = parseFloat(elTotal.value);

            if (!piezaVal && !diagVal && !tratVal && refInput === 0 && totalInput === 0) return;

            const tdDesc = descInput <= 100 && descInput > 0 ? `${descInput}%` : (descInput > 100 ? `$${descInput.toLocaleString('es-CL')}` : '0%');
            tableRows.push([piezaVal || '-', diagVal || '-', tratVal || '-', `$${refInput.toLocaleString('es-CL')}`, tdDesc, `$${totalInput.toLocaleString('es-CL')}`]);
        });

        doc.autoTable({ startY: 65, head: [tableColumn], body: tableRows, theme: 'grid', headStyles: { fillColor: [30, 58, 138] }, styles: { fontSize: 9 } });

        const finalY = doc.lastAutoTable.finalY || 70;
        doc.setFontSize(14); doc.setTextColor(30, 58, 138); doc.text(`TOTAL A PAGAR: $${document.getElementById('granTotalPagar').innerText}`, 200, finalY + 15, { align: "right" });

        const nombrePuro = pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_');
        const nombreArchivo = `Presupuesto_Comercial_${nombrePuro}_${Date.now()}.pdf`;
        doc.save(nombreArchivo); 

        if (!isLocal) {
            const pdfBlob = doc.output('blob');
            const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });
            if (!uploadError) {
                await window.midental.from('documentos_pacientes').insert([{ paciente_id: pacienteIdURL, dentista_id: dentistaId, nombre_archivo: `Presupuesto Cotización ${new Date().toLocaleDateString('es-CL')}.pdf`, tipo: 'pdf', archivo_url: nombreArchivo }]);
                if(typeof cargarDocumentosPaciente === 'function') cargarDocumentosPaciente(); 
            }
        }
        alert("✅ Presupuesto generado y resguardado con éxito en los documentos del paciente.");
    } catch (err) { 
        alert("Error al generar el presupuesto: " + err.message); 
        console.error(err); 
    } finally { 
        if (btn) {
            btn.innerHTML = textoOriginal; 
            btn.disabled = false; 
        }
    }
}

