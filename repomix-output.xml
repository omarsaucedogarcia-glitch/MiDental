        // MÓDULO SALDO CORRIENTE: REGISTRO DE PAGO AL FINALIZAR CITA
        // =========================================================
        function abrirModalPagoFinalizar() {
            if (!citaEnCursoData) return;
            document.getElementById('pagoNombrePaciente').innerText = citaEnCursoData.nombre || 'Paciente';
            document.getElementById('pagoMonto').value = '';
            document.getElementById('pagoMedio').value = 'Efectivo';
            document.getElementById('pagoNotas').value = '';
            // Ocultamos el modal de detalle para evitar superposición visual
            document.getElementById('modalDetallePaciente').style.display = 'none';
            document.getElementById('modalRegistrarPago').style.display = 'flex';
        }

        async function guardarPagoYFinalizar() {
            if (!citaEnCursoData || !citaEnCursoData.cita_id) return;

            const monto = parseFloat(document.getElementById('pagoMonto').value);
            const medio = document.getElementById('pagoMedio').value;
            const notas = document.getElementById('pagoNotas').value.trim();

            if (isNaN(monto) || monto < 0) {
                return alert("Ingresa un monto válido. Si no hay cobro, usa el botón 'Finalizar sin pago'.");
            }

            const dentistaId = localStorage.getItem('midental_user_id');
            const btn = document.getElementById('btnGuardarPago');
            btn.disabled = true;
            btn.innerText = "Guardando...";

            try {
                // 1) Registramos el pago respetando las columnas exactas de Supabase
                if (monto > 0) {
                    if (!citaEnCursoData.paciente_id) {
                        alert("⚠️ Esta cita no está vinculada a un paciente registrado. El pago no se podrá asociar al saldo del paciente.");
                    } else {
                        const { error: errPago } = await window.midental.from('pagos').insert([{
                            paciente_id: citaEnCursoData.paciente_id,
                            dentista_id: dentistaId,
                            monto: monto,
                            metodo_pago: medio, // Corregido: Coincide con tu SQL
                            notas: notas || null
                            // Eliminamos cita_id porque no existe en tu tabla de pagos
                        }]);
                        if (errPago) throw errPago;
                    }
                }

                // 2) Cerramos la atención clínica
                const { error: errEstado } = await window.midental.from('citas_agenda')
                    .update({ estado: 'completada' })
                    .eq('id', citaEnCursoData.cita_id);
                if (errEstado) throw errEstado;

                alert("✅ Atención finalizada" + (monto > 0 ? ` y pago de $${monto.toLocaleString('es-CL')} registrado.` : "."));
                cerrarModal('modalRegistrarPago');
                renderizarSemanaActual();
                
            } catch (err) {
                console.error("Error al guardar pago:", err);
                alert("Error al registrar el pago: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle; font-size: 1.1rem;">save</span> Guardar y Finalizar';
            }
        }

        async function finalizarSinPago() {
            if (!citaEnCursoData) return;
            cerrarModal('modalRegistrarPago');
            await actualizarEstadoCita('completada');
        }
        async function verificarRecordatorioPaciente(pacienteId) {
    const cajaRecordatorio = document.getElementById('cajaRecordatorioClinico');
    const textoRecordatorio = document.getElementById('textoRecordatorioClinico');
    const selectDuracion = document.getElementById('manualDuracion');
    
    if (!pacienteId) {
        cajaRecordatorio.style.display = 'none';
        return;
    }

    try {
        const { data, error } = await window.midental
            .from('perfiles_pacientes')
            .select('proxima_sesion_nota, proxima_sesion_duracion_minutos')
            .eq('id', pacienteId)
            .single();

        if (error && error.code !== 'PGRST116') throw error; // Ignorar si no hay datos

        if (data && data.proxima_sesion_nota) {
            cajaRecordatorio.style.display = 'block';
            
            let mensaje = data.proxima_sesion_nota;
            if (data.proxima_sesion_duracion_minutos) {
                mensaje += `<br><br>⏱️ <em>Tiempo sugerido: ${data.proxima_sesion_duracion_minutos} minutos.</em>`;
                
                // Auto-seleccionar la duración en el formulario
                if(selectDuracion) {
                    selectDuracion.value = data.proxima_sesion_duracion_minutos;
                }
            }
            textoRecordatorio.innerHTML = mensaje;
        } else {
            cajaRecordatorio.style.display = 'none';
        }
    } catch (err) {
        console.error("Error al buscar el recordatorio del paciente:", err);
    }
}
    </script>
    <script>
    // ==========================================
    // NORMALIZACIÓN DE MOTIVOS DE CONSULTA
    // ==========================================
    const categoriasMotivos = {
        "Diagnóstico y Prevención": [
            "Evaluación / Diagnóstico", 
            "Radiografía / Imagenología", 
            "Prevención y Limpieza"
        ],
        "Odontología Restauradora": [
            "Restauración", 
            "Blanqueamiento"
        ],
        "Endodoncia": [
            "Endodoncia", 
            "Urgencia Endodóntica / Fase Previa", 
            "Control Endodóntico"
        ],
        "Rehabilitación Oral": [
            "Prótesis Removible", 
            "Prótesis Fija", 
            "Control de Prótesis", 
            "Trastornos Temporomandibulares (TTM)"
        ],
        "Cirugía Bucal y Maxilofacial": [
            "Exodoncia", 
            "Cirugía Menor", 
            "Control Post-Exodoncia"
        ],
        "Periodoncia": [
            "Tratamiento Periodontal", 
            "Cirugía Periodontal", 
            "Mantención Periodontal"
        ],
        "Implantología": [
            "Fase Quirúrgica (Implante)", 
            "Fase Protésica", 
            "Mantención de Implantes"
        ],
        "Ortodoncia y Ortopedia": [
            "Estudio Quirúrgico / Inicial", 
            "Instalación", 
            "Control de Ortodoncia", 
            "Contención"
        ],
        "Odontopediatría": [
            "Atención Odontopediatrica", 
            "Pulpotomía / Pulpectomía"
        ],
        "Estética y Armonización Facial": [
            "Estética Facial", 
            "Control Estética"
        ]
    };

    function inicializarEspecialidades() {
        const selEspecialidad = document.getElementById('selEspecialidad');
        if (!selEspecialidad) return;
        
        selEspecialidad.innerHTML = '<option value="">Especialidad...</option>';
        for (const especialidad in categoriasMotivos) {
            let option = document.createElement('option');
            option.value = especialidad;
            option.textContent = especialidad;
            selEspecialidad.appendChild(option);
        }
    }

    function actualizarAcciones() {
        const selEspecialidad = document.getElementById('selEspecialidad');
        const selAccion = document.getElementById('selAccion');
        const especialidadSeleccionada = selEspecialidad.value;
        
        // Limpiamos las acciones anteriores
        selAccion.innerHTML = '<option value="">Acción...</option>';
        
        // Llenamos con las nuevas acciones según la especialidad
        if (especialidadSeleccionada && categoriasMotivos[especialidadSeleccionada]) {
            categoriasMotivos[especialidadSeleccionada].forEach(accion => {
                let option = document.createElement('option');
                option.value = accion;
                option.textContent = accion;
                selAccion.appendChild(option);
            });
        }
        sincronizarMotivoOculto();
    }

    function sincronizarMotivoOculto() {
        const selEspecialidad = document.getElementById('selEspecialidad').value;
        const selAccion = document.getElementById('selAccion').value;
        const manualMotivo = document.getElementById('manualMotivo');
        
        // Formato final que se guardará en la base de datos: "Especialidad - Acción"
        if (selEspecialidad && selAccion) {
            manualMotivo.value = `${selEspecialidad} - ${selAccion}`;
        } else if (selEspecialidad) {
            manualMotivo.value = selEspecialidad;
        } else {
            manualMotivo.value = "Evaluación General"; // Fallback por defecto
        }
    }

    // Inicializamos los selectores cuando la página cargue
    document.addEventListener('DOMContentLoaded', inicializarEspecialidades);
</script>
</body>
</html>
