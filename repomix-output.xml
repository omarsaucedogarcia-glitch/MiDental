<body>

    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="assets/LogoMiDental.png" alt="Logo MiDental" class="logo-img" style="height: 40px; margin-right: 10px;">
                <h2>MiDental</h2>
            </div>
            <nav class="sidebar-nav">
                <a href="dashboard-dentista.html" class="nav-item"><span class="material-symbols-outlined">grid_view</span> Inicio</a>
                <a href="agenda-dentista.html" class="nav-item active"><span class="material-symbols-outlined">calendar_month</span> Mi Agenda</a>
                <a href="mis-pacientes.html" class="nav-item"><span class="material-symbols-outlined">folder_shared</span> Mis Pacientes</a>
            </nav>
        </aside>

        <main class="dashboard-content">
            <header class="topbar" style="margin-bottom: 25px; padding: 15px 25px;">
                <div class="welcome-text">
                    <button class="btn-login-outline" style="padding: 6px 12px; margin-bottom: 15px; font-size: 0.85rem; border-radius: 10px;" onclick="window.history.back()">
                        <span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">arrow_back</span> Volver
                    </button>
                    <h1 style="font-size: 1.6rem;">Ficha Clínica: <span id="headerNombrePaciente" style="color: var(--pixar-cyan);">Cargando...</span></h1>
                </div>
            </header>

            <!-- ============================================================== -->
            <!-- ODONTOGRAMA · CTA con contadores en vivo (atajo: Alt+O)          -->
            <!-- ============================================================== -->
            <section class="odn-launcher-strip" aria-label="Acceso al odontograma clínico">
                <div class="odn-launcher-strip__info">
                    <p class="odn-launcher-strip__title">
                        <span class="material-symbols-outlined" aria-hidden="true">dentistry</span>
                        Odontograma Clínico
                    </p>
                    <p class="odn-launcher-strip__subtitle">
                        Diagnóstico por superficie · planificación · timeline por pieza  ·  <kbd style="background:rgba(255,255,255,0.12);padding:1px 6px;border-radius:4px;font-size:0.72rem;">Alt + O</kbd>
                    </p>
                </div>

                <div class="odn-launcher-strip__stats" aria-live="polite" aria-label="Resumen del odontograma">
                    <span class="odn-stat-chip" data-state="active" title="Patologías activas registradas">
                        <span class="odn-stat-chip__dot" aria-hidden="true"></span>
                        <span class="odn-stat-chip__num" id="odnStatPatologia">0</span>
                        <span class="odn-stat-chip__label">patología</span>
                    </span>
                    <span class="odn-stat-chip" data-state="planned" title="Tratamientos planificados">
                        <span class="odn-stat-chip__dot" aria-hidden="true"></span>
                        <span class="odn-stat-chip__num" id="odnStatPlan">0</span>
                        <span class="odn-stat-chip__label">plan</span>
                    </span>
                    <span class="odn-stat-chip" data-state="completed" title="Estados existentes registrados">
                        <span class="odn-stat-chip__dot" aria-hidden="true"></span>
                        <span class="odn-stat-chip__num" id="odnStatExistente">0</span>
                        <span class="odn-stat-chip__label">existente</span>
                    </span>
                </div>

                <button type="button" class="odn-launcher" id="btnAbrirOdontograma"
                        onclick="abrirOdontograma()" aria-controls="odontogramaModal" aria-expanded="false">
                    <span class="material-symbols-outlined" aria-hidden="true">grid_on</span>
                    Abrir Odontograma
                </button>
            </section>
            <div class="premium-ai-card" id="tarjetaInteligenciaClinica">
                <div class="ai-header">
                    <span class="material-symbols-outlined" style="color: #8b5cf6; font-size: 2rem;">psychology</span>
                    <h3>Análisis de Riesgo Integral</h3>
                    <span class="ai-risk-badge" id="aiNivelRiesgo">Calculando...</span>
                </div>
                <div class="ai-content">
                    <!-- Desglose por área (Cariología × Periodoncia) -->
                    <div id="aiDesgloseGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin: 10px 0 14px;">
                        <div class="ai-area-card" id="aiAreaCaries" style="background:#fff; border:1px solid #e2e8f0; border-left:5px solid #94a3b8; border-radius:10px; padding:10px 12px; display:flex; gap:10px; align-items:flex-start;">
                            <span class="material-symbols-outlined" style="color:#0ea5e9; font-size:1.6rem; flex-shrink:0;">dentistry</span>
                            <div style="min-width:0;">
                                <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; margin-bottom:4px;">
                                    <strong style="color:#1e293b; font-size:0.85rem;">Cariología</strong>
                                    <span class="ai-area-badge" id="aiCariesBadge" style="font-size:0.7rem; padding:2px 8px; border-radius:999px; font-weight:bold; color:white; background:#94a3b8;">—</span>
                                </div>
                                <p id="aiCariesReco" style="margin:0; font-size:0.82rem; color:#475569; line-height:1.4;">Aún sin datos.</p>
                            </div>
                        </div>
                        <div class="ai-area-card" id="aiAreaPerio" style="background:#fff; border:1px solid #e2e8f0; border-left:5px solid #94a3b8; border-radius:10px; padding:10px 12px; display:flex; gap:10px; align-items:flex-start;">
                            <span class="material-symbols-outlined" style="color:#7c3aed; font-size:1.6rem; flex-shrink:0;">monitor_heart</span>
                            <div style="min-width:0;">
