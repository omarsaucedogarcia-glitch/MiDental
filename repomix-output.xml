        async function emitirYGuardarConsentimientoPDF() {
            if (isLocal) return alert("Esta acción no está disponible para Fichas Locales temporales.");

            const tipoSel = document.getElementById('selectTipoConsentimiento').value;
            const dataCons = diccionarioConsentimientos[tipoSel];
            const dentistaId = localStorage.getItem('midental_user_id');

            const btn = document.getElementById('btnEmitirConsentimiento');
