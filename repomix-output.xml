            });
            track.appendChild(col);
        }
    }
}

window.seleccionarSlotReserva = function(btnHtml, slotIdBD, textoVisual) {
    document.querySelectorAll('.time-slot-btn').forEach(b => {
        b.style.background = 'white';
        b.style.color = '#334155';
