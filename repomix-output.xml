/* ========================================== */
/* 1. VARIABLES GLOBALES Y RESETEO            */
/* ========================================== */
:root {
    --blue-elegant: #0A3D62;
    --text-dark: #333333;
    --text-light: #666666;
    --white: #FFFFFF;
    --pixar-cyan: #00A8FF;
    --pixar-cyan-shadow: #0086CC;
    --pixar-orange: #FFA502;
    --green-success: #2ED573;
    --red-urgency: #FF4757;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
    overflow: hidden; 
    background-color: #f0f2f5;
}

/* ========================================== */
/* 2. MAPA DE FONDO Y PINES                   */
/* ========================================== */
.map-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-size: cover;
    background-position: center;
    z-index: 0;
}

.map-pin {
    position: absolute;
    color: var(--blue-elegant);
    cursor: pointer;
    transform: translate(-50%, -100%);
    transition: transform 0.2s;
    background: white;
    border-radius: 50%;
    padding: 5px;
    box-shadow: 0 5px 10px rgba(0,0,0,0.2);
}

.map-pin:hover { transform: translate(-50%, -100%) scale(1.2); }
.active-pin { color: white; background: var(--pixar-cyan); }
.urgency-pin { color: white; background: var(--red-urgency); }

/* ========================================== */
/* 3. BARRA DE NAVEGACIÓN FLOTANTE            */
/* ========================================== */
.floating-navbar {
    position: fixed;
    top: 20px;
    left: 20px;
    right: 20px;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    padding: 15px 25px;
    border-radius: 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    gap: 20px;
}

/* Grupo 1: Logo y Perfil */
.logo-and-profile { 
    display: flex; 
    align-items: center; 
    gap: 20px; 
}
.logo-small { display: flex; align-items: center; gap: 8px; color: var(--blue-elegant); }
.icon-blue { color: var(--pixar-cyan); }

.user-profile { display: flex; align-items: center; gap: 12px; }
.notifications-icon { color: var(--text-light); cursor: pointer; }
.user-reputation { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
.reputation-score { font-weight: bold; color: var(--pixar-orange); font-size: 0.95rem; }
.reputation-label { font-size: 0.7rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.5px; }
.avatar-circle { background: var(--pixar-orange); color: white; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; }

/* Grupo 2: Buscador y Ofertas */
.search-and-offers {
    display: flex;
    align-items: center;
    gap: 15px;
    flex: 1;
    max-width: 700px;
}

/* NUEVO: Contenedor integrado de búsqueda + botón */
.search-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
}

.search-box {
    display: flex;
    align-items: center;
    background: #f0f2f5;
    padding: 8px 15px;
    border-radius: 20px;
    flex: 1;
    border: 1px solid transparent;
    transition: border 0.2s;
}
.search-box:focus-within { border-color: var(--pixar-cyan); background: white; }
.search-box input { border: none; background: transparent; outline: none; width: 100%; margin-left: 10px; font-size: 1rem; color: var(--text-dark); }

/* NUEVO: Botón explícito de Buscar */
.btn-search-action {
    background-color: var(--pixar-cyan);
    box-shadow: 0 4px 0 var(--pixar-cyan-shadow);
    color: white;
    border: none;
    padding: 8px 20px;
    border-radius: 15px;
    font-weight: bold;
    cursor: pointer;
    font-size: 0.95rem;
    transition: transform 0.1s;
}
.btn-search-action:active { transform: translateY(4px); box-shadow: 0 0 0 transparent; }

/* Botón Ofertas Flash */
.btn-ofertas-small {
    background-color: #9b59b6; 
    box-shadow: 0 4px 0 #8e44ad;
    padding: 8px 15px;
    white-space: nowrap; 
    border-radius: 15px;
    border: none;
    color: white;
    font-weight: bold;
    cursor: pointer;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 5px;
    animation: palpitar-small 2s infinite;
}
.btn-ofertas-small:active { transform: translateY(4px); box-shadow: 0 0 0 transparent; }

@keyframes palpitar-small {
    0% { transform: scale(1); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
}

/* ========================================== */
/* 4. PANEL LATERAL Y TARJETAS                */
/* ========================================== */
.results-panel {
    position: fixed;
    top: 100px;
    left: 20px;
    bottom: 20px;
    width: 420px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    border-radius: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    z-index: 10;
    overflow: hidden;
}

.filters-scroll { display: flex; gap: 10px; padding: 20px; overflow-x: auto; border-bottom: 1px solid #eee; }
.filters-scroll::-webkit-scrollbar { display: none; }
.filter-chip { padding: 8px 16px; border-radius: 20px; border: 1px solid #ddd; background: white; color: var(--text-dark); font-weight: 500; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
.filter-chip.active { background: var(--blue-elegant); color: white; border-color: var(--blue-elegant); }
.filter-chip.urgency { border-color: var(--red-urgency); color: var(--red-urgency); }
.filter-chip.urgency:hover { background: var(--red-urgency); color: white; }

.results-header { padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
.results-header h3 { font-size: 1.1rem; color: var(--text-dark); }
.sort-by { font-size: 0.85rem; color: var(--pixar-cyan); cursor: pointer; font-weight: bold; }

.cards-container { flex: 1; overflow-y: auto; padding: 0 20px 20px 20px; display: flex; flex-direction: column; gap: 15px; }

.doctor-card { background: white; border-radius: 20px; padding: 15px; display: flex; gap: 15px; border: 2px solid transparent; box-shadow: 0 5px 15px rgba(0,0,0,0.05); transition: all 0.2s; }
.doctor-card:hover { border-color: #e0e0e0; transform: translateY(-2px); }
.doctor-card.active-card { border-color: var(--pixar-cyan); }
.doc-photo { width: 70px; height: 70px; border-radius: 15px; object-fit: cover; }
.doc-details { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.doc-header { display: flex; justify-content: space-between; align-items: center; }
.doc-header h4 { font-size: 1.05rem; color: var(--blue-elegant); }
.rating { font-size: 0.85rem; font-weight: bold; }
.specialty { font-size: 0.85rem; color: var(--text-light); }
.distance { font-size: 0.8rem; color: var(--text-dark); display: flex; align-items: center; gap: 4px; }
.icon-small { font-size: 1rem; color: #999; }
.price-availability { display: flex; justify-content: space-between; align-items: center; margin-top: 5px; font-size: 0.85rem; font-weight: bold; }
.availability.green { color: var(--green-success); }
.availability.orange { color: var(--pixar-orange); }

.btn-book { margin-top: 10px; background: var(--pixar-cyan); box-shadow: 0 4px 0 var(--pixar-cyan-shadow); padding: 10px; border: none; border-radius: 15px; color: white; font-weight: bold; cursor: pointer; transition: transform 0.1s; }
.btn-book:active { transform: translateY(4px); box-shadow: 0 0 0 transparent; }

/* ========================================== */
/* 5. MODALES (OFERTAS Y FICHA DOCTOR)        */
/* ========================================== */
.ficha-content {
    background: var(--white);
    width: 100%;
    max-width: 500px;
    height: 90vh;
    margin-top: 10vh;
    border-radius: 30px 30px 0 0;
    position: relative;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.2);
    display: flex;
    flex-direction: column;
    animation: slideUpFicha 0.3s ease-out;
    overflow: hidden;
}

@keyframes slideUpFicha { from { transform: translateY(100%); } to { transform: translateY(0); } }

@media (min-width: 600px) {
    .ficha-content {
        height: auto;
        max-height: 85vh;
        margin-top: 0;
        border-radius: 30px;
        animation: popUpFicha 0.3s ease-out;
    }
    @keyframes popUpFicha { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
}

.btn-close-ficha { position: absolute; top: 15px; right: 15px; background: rgba(0,0,0,0.05); border: none; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-dark); cursor: pointer; z-index: 10; }
.ficha-header { padding: 30px 20px 20px 20px; display: flex; gap: 15px; border-bottom: 1px solid #eee; background: #fafafa; }
.ficha-profile-img { width: 80px; height: 80px; border-radius: 20px; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
.ficha-title-area h2 { font-size: 1.3rem; color: var(--blue-elegant); margin-bottom: 3px; }
.ficha-specialty { color: var(--text-light); font-size: 0.9rem; margin-bottom: 5px; }
.ficha-rating { display: flex; align-items: center; gap: 5px; font-size: 0.85rem; }
.reviews-count { color: var(--pixar-cyan); font-weight: bold; cursor: pointer; }

.ficha-body { flex: 1; overflow-y: auto; padding: 20px; padding-bottom: 100px; }
.info-row { display: flex; flex-direction: column; gap: 15px; margin-bottom: 25px; }
.info-item { display: flex; align-items: flex-start; gap: 10px; }
.info-item strong { display: block; color: var(--text-dark); font-size: 0.95rem; }
.info-item p { color: var(--text-light); font-size: 0.85rem; margin-top: 2px; }

.section-title { font-weight: bold; color: var(--blue-elegant); font-size: 1.05rem; margin-bottom: 15px; margin-top: 10px; }
.gallery-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 15px; }
.gallery-scroll::-webkit-scrollbar { display: none; }
.gallery-img { width: 140px; height: 100px; border-radius: 15px; object-fit: cover; flex-shrink: 0; border: 1px solid #eee; }

.slots-container { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 25px; }
.time-slot { padding: 10px 20px; border-radius: 15px; border: 1px solid #ddd; background: white; color: var(--text-dark); font-weight: bold; cursor: pointer; transition: all 0.2s; }
.time-slot:hover { border-color: var(--pixar-cyan); }
.active-slot { background: var(--pixar-cyan); color: white; border-color: var(--pixar-cyan); box-shadow: 0 4px 10px rgba(0, 168, 255, 0.3); }

.bio-text { color: var(--text-light); font-size: 0.9rem; line-height: 1.5; }

.ficha-footer { position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-top: 1px solid #eee; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; }
.footer-price-info { display: flex; flex-direction: column; }
.footer-price-info span { font-size: 0.75rem; color: var(--text-light); text-transform: uppercase; }
.footer-price-info strong { font-size: 1.2rem; color: var(--text-dark); }
.btn-book-large { background-color: var(--pixar-cyan); box-shadow: 0 4px 0 var(--pixar-cyan-shadow); color: white; border: none; padding: 12px 25px; border-radius: 20px; font-weight: bold; font-size: 1rem; cursor: pointer; }
.btn-book-large:active { transform: translateY(4px); box-shadow: 0 0 0 transparent; }

/* ========================================== */
/* 6. DISEÑO RESPONSIVO DEFINITIVO (MÓVILES)  */
/* ========================================== */
@media (max-width: 900px) {
    .floating-navbar { 
        top: 10px; left: 10px; right: 10px; 
        padding: 12px 15px; 
        flex-direction: column; 
        border-radius: 20px;
        gap: 15px;
    }
    
    .logo-and-profile { width: 100%; justify-content: space-between; }
    .user-reputation { display: none; }
    
    /* En móvil, el grupo de búsqueda y el botón de ofertas se apilan inteligentemente */
    .search-and-offers { 
        width: 100%;
        flex-direction: column; /* Apila búsqueda y ofertas en móvil */
        gap: 10px;
    }
    
    .search-group { width: 100%; }
    .search-box { flex: 1; padding: 8px 10px; }
    .btn-search-action { padding: 8px 15px; }
    
    .btn-ofertas-small { width: 100%; justify-content: center; } /* Botón ofertas ocupa todo el ancho abajo */
    
    .results-panel {
        top: auto; left: 0; right: 0; bottom: 0;
        width: 100%; height: 50vh; 
        border-radius: 25px 25px 0 0;
    }
}
</file>

