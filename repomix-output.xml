        // ==========================================
        // PERFIL, SALUDO MOTIVACIONAL Y CENTRO MÉDICO
        // ==========================================
        async function cargarPerfilYCentroMedico(userId) {
            try {
                // 1. Obtener Datos del Profesional
                const { data: dr } = await window.midental.from('perfiles_dentistas').select('nombre_completo, prefijo, avatar_url').eq('id', userId).single();
                if(dr) {
                    if(dr.avatar_url) document.getElementById('topbarAvatar').src = dr.avatar_url;
                    
                    const primerNombre = dr.nombre_completo.split(' ')[0];
                    const prefijo = dr.prefijo || 'Dr/a.';
                    
                    const hrs = new Date().getHours();
                    let saludo = "¡Buenos días";
                    if (hrs >= 12 && hrs < 20) saludo = "¡Buenas tardes";
                    if (hrs >= 20 || hrs < 5) saludo = "¡Buenas noches";
                    
                    document.getElementById('dashGreeting').innerText = `${saludo}, ${prefijo} ${primerNombre}! 🦷`;
                }

                // 2. Obtener Sede para el WhatsApp de Recordatorio
                const { data: sede } = await window.midental.from('sedes_dentistas').select('nombre_sede').eq('dentista_id', userId).limit(1).maybeSingle();
                if (sede && sede.nombre_sede) {
                    centroMedicoOficial = sede.nombre_sede;
