    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        // VARIABLES GLOBALES
        let dentistaSeleccionado = null;
        let offsetSemanasPaciente = 0;
        let bloqueAgendamientoSeleccionado = null;
        let horariosDentistaDB = []; 
        let pestanaActivaModal = 'sobremi'; // 'sobremi' o 'agendar'
        let citasOcupadasDB = []; // <--- NUEVA VARIABLE: Guardará las citas ya tomadas

        document.addEventListener('DOMContentLoaded', async () => {
            const userId = localStorage.getItem('midental_user_id');
            const tipoUser = localStorage.getItem('midental_user_tipo');

            if (!userId || tipoUser !== 'paciente') {
                document.querySelectorAll('.priv-link').forEach(enlace => {
                    enlace.addEventListener('click', function(e) {
                        e.preventDefault(); 
                        alert("🔒 Modo Invitado: Para acceder a tu panel, debes iniciar sesión o crear una cuenta gratuita.");
                        window.location.href = 'index.html';
                    });
                });
            }

            await cargarDirectorioMedico();
        });

        // 1. CARGA RELACIONAL DEL DIRECTORIO
        async function cargarDirectorioMedico() {
            try {
                // Seleccionamos también la nueva columna servicios_json
                const { data: doctores, error } = await window.midental
                    .from('perfiles_dentistas')
                    .select('*, sedes_dentistas(nombre_sede, direccion, comuna)');
                    
                if (error) throw error;

                const contenedorUrgencias = document.getElementById('listaUrgencias');
                const contenedorNormal = document.getElementById('listaNormal');
                
                let htmlUrgencias = "";
                let htmlNormal = "";

                doctores.forEach(doc => {
                    const nombreCompleto = `${doc.prefijo || 'Dr.'} ${doc.nombre_completo}`;
                    const especialidad = doc.especialidad || 'Odontología General';
                    const avatar = doc.avatar_url || 'assets/avatar-default-doctor.png';
                    const telefono = doc.telefono || '';
                    const biografia = doc.presentacion || ''; 
                    const serviciosList = doc.servicios_json || []; // Rescatamos el Arancelario
                    
                    const sedePrincipal = (doc.sedes_dentistas && doc.sedes_dentistas.length > 0) ? doc.sedes_dentistas[0] : null;
                    const ubicacionStr = sedePrincipal ? `${sedePrincipal.comuna}` : 'Consulta Privada';
                    const direccionExacta = sedePrincipal ? `${sedePrincipal.direccion}, ${sedePrincipal.comuna}` : 'Consulta Privada';

                    const nombreSedeOficial = sedePrincipal ? sedePrincipal.nombre_sede : 'Consulta Privada';

                    const docDataCodificado = encodeURIComponent(JSON.stringify({
                        id: doc.id,
                        nombre: nombreCompleto,
                        especialidad: especialidad,
                        avatar: avatar,
                        direccion: direccionExacta,
                        nombre_sede: nombreSedeOficial, // <-- AGREGAMOS EL NOMBRE DE LA SEDE
                        telefono: telefono,
                        presentacion: biografia,
                        servicios: serviciosList
                    }));

                    const tarjetaHtml = `
                        <div class="doctor-card" data-buscar="${nombreCompleto.toLowerCase()} ${especialidad.toLowerCase()} ${ubicacionStr.toLowerCase()}">
                            <img src="${avatar}" class="doc-avatar">
                            <div class="doc-info" onclick="abrirPerfilDoctor('${docDataCodificado}')">
                                <h4>${nombreCompleto}</h4>
                                <p><span class="material-symbols-outlined" style="font-size:1rem; color:var(--pixar-orange);">star</span> ${doc.reputacion || '5.0'}</p>
                                <p><span class="material-symbols-outlined" style="font-size:1rem;">location_on</span> ${ubicacionStr}</p>
                                <p style="color:var(--blue-elegant); font-weight:bold;"><span class="material-symbols-outlined" style="font-size:1rem;">medical_services</span> ${especialidad}</p>
                            </div>
                        </div>
                    `;

                    const tarjetaUrgenciaHtml = `
                        <div class="doctor-card urgencia-card" data-buscar="${nombreCompleto.toLowerCase()} ${especialidad.toLowerCase()} ${ubicacionStr.toLowerCase()}">
                            <img src="${avatar}" class="doc-avatar">
                            <div class="doc-info">
                                <h4>${nombreCompleto}</h4>
                                <p><span class="material-symbols-outlined" style="font-size:1rem;">location_on</span> ${ubicacionStr}</p>
                                <button class="btn-llamar-urgencia" onclick="llamarUrgencia('${telefono}', '${nombreCompleto}')">
                                    <span class="material-symbols-outlined" style="font-size: 1.2rem;">call</span> LLAMAR AHORA
                                </button>
                            </div>
                        </div>
                    `;

                    if (doc.disponibilidad_urgencia || doc.acepta_urgencias) {
                        htmlUrgencias += tarjetaUrgenciaHtml;
                    }
                    htmlNormal += tarjetaHtml;
                });

                document.getElementById('cargandoDirectorio').style.display = 'none';
                document.getElementById('panelColumnasBase').style.display = 'flex'; 

                if (htmlUrgencias !== "") contenedorUrgencias.innerHTML = htmlUrgencias;
                if (htmlNormal !== "") contenedorNormal.innerHTML = htmlNormal;
                
                document.getElementById('contadorResultados').innerText = `${doctores.length} especialistas encontrados`;

            } catch (err) {
                console.error("Error al cargar directorio:", err);
                document.getElementById('cargandoDirectorio').innerHTML = `<p style="color:red;">Error de conexión. Reintenta más tarde.</p>`;
            }
        }

        function llamarUrgencia(telefono, nombreDr) {
            if(!telefono) return alert("Este especialista no tiene un teléfono público configurado.");
            let fonoLimpio = telefono.replace(/[^0-9]/g, '');
            let msg = `Hola ${nombreDr}, los encontré en MiDental. Tengo una URGENCIA DENTAL y necesito atención inmediata.`;
            window.open(`https://wa.me/${fonoLimpio}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        document.getElementById('filtroComuna').addEventListener('input', function(e) {
            const termino = e.target.value.toLowerCase().trim();
            const tarjetas = document.querySelectorAll('.doctor-card');
            let visibles = 0;
            tarjetas.forEach(card => {
                const textoBuscable = card.getAttribute('data-buscar');
                if(textoBuscable.includes(termino)) { card.style.display = 'flex'; visibles++; } 
                else { card.style.display = 'none'; }
            });
            document.getElementById('contadorResultados').innerText = `${visibles} especialistas encontrados`;
        });

        // ==========================================
        // 2. MODAL Y CONTROL DE PESTAÑAS (TABS)
        // ==========================================
        async function abrirPerfilDoctor(dataCodificada) {
            dentistaSeleccionado = JSON.parse(decodeURIComponent(dataCodificada));
            offsetSemanasPaciente = 0;
            bloqueAgendamientoSeleccionado = null;
            horariosDentistaDB = [];

            document.body.classList.add('modal-abierto');

            // Llenar Cabecera
            document.getElementById('modalDocNombre').innerText = dentistaSeleccionado.nombre;
            document.getElementById('modalDocAvatar').src = dentistaSeleccionado.avatar;
            document.getElementById('modalDocEspecialidad').innerText = dentistaSeleccionado.especialidad;
            // Ahora muestra el nombre de la clínica (Ej: Centro Médico Los Gladiolos)
document.getElementById('modalDocDireccion').innerText = dentistaSeleccionado.nombre_sede;

            // PESTAÑA: SOBRE MI (Presentación)
            const cajaPresentacion = document.getElementById('modalDocPresentacion');
            if (dentistaSeleccionado.presentacion) {
                cajaPresentacion.innerText = `"${dentistaSeleccionado.presentacion}"`;
                cajaPresentacion.style.display = 'block';
            } else {
                cajaPresentacion.style.display = 'none';
            }

            // PESTAÑA: SOBRE MI (Servicios y Aranceles)
            const cajaServicios = document.getElementById('modalDocServicios');
            cajaServicios.innerHTML = '';
            if (dentistaSeleccionado.servicios && dentistaSeleccionado.servicios.length > 0) {
                dentistaSeleccionado.servicios.forEach(serv => {
                    cajaServicios.innerHTML += `
                        <div class="servicio-item">
                            <span class="servicio-nombre">${serv.nombre}</span>
                            <span class="servicio-precio">$${serv.precio.toLocaleString('es-CL')}</span>
                        </div>
                    `;
                });
            } else {
                cajaServicios.innerHTML = '<div style="padding: 15px; text-align: center; color: #94a3b8; font-size: 0.85rem;">El especialista no ha publicado sus aranceles aún.</div>';
            }

            // Forzar inicio en pestaña "Sobre Mí"
            cambiarPestanaModal('sobremi');

            document.getElementById('modalCalendarioHoras').innerHTML = `<div style="text-align: center; color: #94a3b8; width: 100%; padding: 20px;">Descargando disponibilidad...</div>`;
            document.getElementById('modalFichaDoctor').style.display = 'flex';

            // RESCATE DE HORARIOS EN SEGUNDO PLANO
            try {
                let arrTemporal = [];
                const { data: perfilInfo } = await window.midental.from('perfiles_dentistas').select('telefono, disponibilidad_json, horarios_json').eq('id', dentistaSeleccionado.id).single();
                if (perfilInfo) {
                    if (perfilInfo.telefono) dentistaSeleccionado.telefono = perfilInfo.telefono;
                    if (perfilInfo.disponibilidad_json) arrTemporal.push(...perfilInfo.disponibilidad_json);
                    if (perfilInfo.horarios_json) arrTemporal.push(...perfilInfo.horarios_json);
                }

                const { data: sedesInfo } = await window.midental.from('sedes_dentistas').select('disponibilidad_json, horarios_json').eq('dentista_id', dentistaSeleccionado.id);
                if (sedesInfo) {
                    sedesInfo.forEach(sede => {
                        if (sede.disponibilidad_json) arrTemporal.push(...sede.disponibilidad_json);
                        if (sede.horarios_json) arrTemporal.push(...sede.horarios_json);
                    });
                }
                horariosDentistaDB = [...new Set(arrTemporal)];
                // ---> NUEVO: DESCARGAR HORAS YA TOMADAS (EVITA DOBLE AGENDAMIENTO) <---
                const { data: citasTomadas } = await window.midental
                    .from('citas_agenda')
                    .select('fecha_hora_formato_slot')
                    .eq('dentista_id', dentistaSeleccionado.id)
                    .neq('estado', 'cancelada')
                    .neq('estado', 'Rechazado'); // Descarta las canceladas

                if (citasTomadas) {
                    citasOcupadasDB = citasTomadas.map(cita => cita.fecha_hora_formato_slot);
                } else {
                    citasOcupadasDB = [];
                }
                // ------------------------------------------------------------------------
            } catch (err) {
                console.log("Error al sincronizar agenda:", err);
            }

            renderizarCalendarioMovil();
        }

        function cambiarPestanaModal(pestana) {
            pestanaActivaModal = pestana;
            
            // Botones de las pestañas
            document.getElementById('btnTabSobreMi').classList.toggle('active', pestana === 'sobremi');
            document.getElementById('btnTabAgendar').classList.toggle('active', pestana === 'agendar');
            
            // Contenedores
            document.getElementById('tabSobreMiContenido').style.display = pestana === 'sobremi' ? 'block' : 'none';
            document.getElementById('tabAgendarContenido').style.display = pestana === 'agendar' ? 'block' : 'none';

            // Comportamiento inteligente del Botón Inferior Fijo
            actualizarEstadoBotonFijo();
        }

        function actualizarEstadoBotonFijo() {
            const btn = document.getElementById('btnConfirmarCita');
            
            if (pestanaActivaModal === 'sobremi') {
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.style.background = 'var(--pixar-cyan)';
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle;">calendar_month</span> Ver Horarios Disponibles';
            } else if (pestanaActivaModal === 'agendar') {
                if (bloqueAgendamientoSeleccionado) {
                    btn.disabled = false;
                    btn.style.opacity = '1';
                    btn.style.background = 'linear-gradient(135deg, #10b981, #059669)'; // Verde
                    btn.innerHTML = `<span class="material-symbols-outlined" style="vertical-align: middle;">chat</span> Agendar: ${bloqueAgendamientoSeleccionado.formato_wa.split(' a las ')[0]} ${bloqueAgendamientoSeleccionado.formato_wa.split(' a las ')[1]}`;
                } else {
                    btn.disabled = true;
                    btn.style.opacity = '0.5';
                    btn.style.background = 'linear-gradient(135deg, #10b981, #059669)'; // Verde apagado
                    btn.innerHTML = 'Selecciona un bloque de horario arriba';
                }
            }
        }

        // Esta función decide qué hace el botón fijo dependiendo de la pestaña actual
        function accionBotonPrincipal() {
            if (pestanaActivaModal === 'sobremi') {
                cambiarPestanaModal('agendar'); // Lo pasa a la siguiente pestaña
            } else if (pestanaActivaModal === 'agendar') {
                ejecutarAgendamiento(); // Realiza la reserva real
            }
        }

        function cerrarAgendamiento() {
            document.getElementById('modalFichaDoctor').style.display = 'none';
            document.body.classList.remove('modal-abierto');
        }

        function abrirRutaMapaPaciente() {
            const dir = document.getElementById('modalDocDireccion').innerText;
            if (!dir || dir === "Consulta Privada") return alert("Dirección exacta no disponible.");
            window.open(`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(dir)}`, '_blank');
        }

        // ==========================================
        // 3. RENDERIZADO DEL CALENDARIO
        // ==========================================
        function cambiarSemanaAgendamiento(direccion) {
            offsetSemanasPaciente += direccion;
            if(offsetSemanasPaciente < 0) offsetSemanasPaciente = 0;
            renderizarCalendarioMovil();
        }

        function renderizarCalendarioMovil() {
            const container = document.getElementById('modalCalendarioHoras');
            container.innerHTML = '';
            
            const diasAbrev = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
            const mesesCortos = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            const lunes = new Date();
            const diaSemana = lunes.getDay() === 0 ? 7 : lunes.getDay();
            lunes.setDate(lunes.getDate() - diaSemana + 1 + (offsetSemanasPaciente * 7));

            let domingo = new Date(lunes);
            domingo.setDate(lunes.getDate() + 6);

            document.getElementById('lblSemanaCita').innerText = `Semana del ${lunes.getDate()} ${mesesCortos[lunes.getMonth()]} al ${domingo.getDate()} ${mesesCortos[domingo.getMonth()]}`;

            // Granularidad 30 min (coherente con perfil-dentista y agenda)
            const horasTrabajo = [];
            for (let h = 8; h <= 20; h++) {
                horasTrabajo.push(`${h.toString().padStart(2,'0')}:00`);
                horasTrabajo.push(`${h.toString().padStart(2,'0')}:30`);
            }

            for (let i = 0; i < 7; i++) {
                let fCol = new Date(lunes);
                fCol.setDate(lunes.getDate() + i);
                let dd = fCol.getDate().toString().padStart(2, '0');
                let mm = (fCol.getMonth()+1).toString().padStart(2, '0');
                let yyyy = fCol.getFullYear();
                
                const colDiv = document.createElement('div');
                colDiv.className = 'dia-col';
                colDiv.innerHTML = `<div class="dia-header">${diasAbrev[i]}<br><small style="font-weight:normal; color:#64748b;">${dd}/${mm}</small></div>`;

                let horasAgregadasEsteDia = 0;

                horasTrabajo.forEach(horaStr => {
                    const slotID = `${diasAbrev[i]}-${horaStr}`; 
                    
                    if (horariosDentistaDB.length > 0 && !horariosDentistaDB.includes(slotID)) {
                        return; 
                    }
                    // ---> NUEVO: VERIFICAR SI LA HORA YA FUE TOMADA POR UN PACIENTE <---
                    let bloqueExacto = `${diasAbrev[i]} ${dd}/${mm}/${yyyy} - ${horaStr}`;
                    let estaOcupado = citasOcupadasDB.includes(bloqueExacto);

                    horasAgregadasEsteDia++;

                    const btn = document.createElement('button');
                    btn.className = 'hora-btn';
                    btn.innerText = estaOcupado ? "Ocupado" : horaStr; // Cambia el texto
                    
                    const ahora = new Date();
                    const [hhStr, mmStr] = horaStr.split(':');
                    const fechaBloque = new Date(fCol.getFullYear(), fCol.getMonth(), fCol.getDate(), parseInt(hhStr, 10), parseInt(mmStr, 10));
                    
                    // Desactivar si la hora ya pasó o si ya está ocupada
                    if(fechaBloque < ahora || estaOcupado) {
                        btn.disabled = true;
                        if(estaOcupado) {
                            btn.style.backgroundColor = "#f1f5f9"; // Fondo grisáceo
                            btn.style.color = "#cbd5e1"; // Texto apagado
                        }
                    } else {
                        btn.onclick = function() {
                            document.querySelectorAll('.hora-btn').forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                            
                            bloqueAgendamientoSeleccionado = { 
                                formato_wa: `${diasAbrev[i]} ${dd}/${mm}/${yyyy} a las ${horaStr}`,
                                formato_db: `${diasAbrev[i]} ${dd}/${mm}/${yyyy} - ${horaStr}`
                            };
                            
                            // Re-evaluamos el botón fijo
                            actualizarEstadoBotonFijo();
                        };
                    }
                    colDiv.appendChild(btn);
                });

                if (horasAgregadasEsteDia === 0) {
                    colDiv.innerHTML += `<div style="color: #94a3b8; font-size: 0.75rem; text-align: center; margin-top: 15px; font-weight: bold; border: 1px dashed #cbd5e1; padding: 10px 5px; border-radius: 8px;">Sin atención</div>`;
                }

                container.appendChild(colDiv);
            }
        }

        // ==========================================
        // 4. GUARDAR EN DB Y ENVIAR MENSAJE WHATSAPP
        // ==========================================
        async function ejecutarAgendamiento() {
            if (!bloqueAgendamientoSeleccionado || !dentistaSeleccionado) return;

            // 1. Extraemos las identidades del almacenamiento local
            const userIdMaestro = localStorage.getItem('midental_user_id');
            const rutActual = localStorage.getItem('midental_paciente_rut');
            const tipoUser = localStorage.getItem('midental_user_tipo');

            if (!userIdMaestro || tipoUser !== 'paciente' || !rutActual) {
                alert("Debes iniciar sesión con tu cuenta de paciente para poder confirmar esta hora.");
                window.location.href = 'index.html';
                return;
            }

            const telefonoDoc = dentistaSeleccionado.telefono;
            if(!telefonoDoc || telefonoDoc === "") {
                alert("⚠️ No se ha encontrado el teléfono de contacto de este profesional en la base de datos.");
                return;
            }

            const btnConfirmar = document.getElementById('btnConfirmarCita');
            btnConfirmar.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Guardando cita...';
            btnConfirmar.disabled = true;

            try {
                // 2. Buscamos el ID Clínico EXACTO del familiar que está usando la app
                const { data: perfilPaciente, error: errorPerfil } = await window.midental
                    .from('perfiles_pacientes')
                    .select('id, nombre_completo, telefono')
                    .eq('user_id', userIdMaestro)
                    .eq('rut', rutActual)
                    .single();

                if (errorPerfil || !perfilPaciente) {
                    throw new Error("No pudimos validar tu perfil clínico. Intenta iniciar sesión nuevamente.");
                }

                // 3. Enviamos la cita a Supabase con la llave correcta y los datos de contacto
                const { error: errorReserva } = await window.midental
                    .from('citas_agenda')
                    .insert([{
                        dentista_id: dentistaSeleccionado.id,
                        paciente_id: perfilPaciente.id,      // <-- Llave maestra que soluciona el Error 409
                        fecha_hora_formato_slot: bloqueAgendamientoSeleccionado.formato_db,
                        motivo: 'Evaluación General (Vía Mapa)',
                        estado: 'pendiente',
                        paciente_nombre_manual: perfilPaciente.nombre_completo,
                        paciente_telefono_manual: perfilPaciente.telefono,
                        duracion_minutos: 30
                    }]);

                if (errorReserva) throw errorReserva;

                // 4. Éxito: abrimos WhatsApp para que el paciente notifique al doctor
                const telLimpio = telefonoDoc.replace(/[^0-9]/g, '');
                const textoPredefinido = `Hola ${dentistaSeleccionado.nombre}, soy ${perfilPaciente.nombre_completo}. Vi tu disponibilidad en la plataforma de MiDental y me gustaría agendar una hora de atención contigo para el día ${bloqueAgendamientoSeleccionado.formato_wa}. Quedo atento a tu confirmación. ¡Saludos!`;
                window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(textoPredefinido)}`, '_blank');

                alert("✅ ¡Tu hora ha sido solicitada con éxito! El profesional la confirmará en breve.");
                cerrarAgendamiento();
                window.location.href = "citas-paciente.html";

            } catch (err) {
                console.error("Error al registrar intención de cita:", err);
                alert("Error al registrar la cita: " + (err.message || "Verifica tu conexión."));
                btnConfirmar.disabled = false;
                actualizarEstadoBotonFijo();
            }
        }
    </script>
</body>
</html>
