    <script>
        function formatearRutInput(input) {
            let valor = input.value.replace(/[^0-9kK]/g, '').toUpperCase();
            if (valor.length > 1) {
                let cuerpo = valor.slice(0, -1);
                let dv = valor.slice(-1);
                cuerpo = cuerpo.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                input.value = `${cuerpo}-${dv}`;
            } else {
                input.value = valor;
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('appSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('open');
            if (sidebar.classList.contains('open')) {
                overlay.classList.add('active');
            } else {
                overlay.classList.remove('active');
            }
        }
        // ==========================================
        // CIERRE DE SESIÓN BLINDADO
        // ==========================================
        window.cerrarSesionLocal = async function() {
            const btn = document.querySelector('.btn-logout');
            if(btn) btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Saliendo...';
            
            try {
                if (window.midental && window.midental.auth) {
                    await window.midental.auth.signOut();
                }
            } catch (err) {
                console.error("Error al cerrar sesión:", err);
            } finally {
                localStorage.removeItem('midental_user_id');
                localStorage.removeItem('midental_user_tipo');
                localStorage.removeItem('midental_user_name');
                sessionStorage.removeItem('sesion_validada_hoy');
                window.location.href = 'index.html';
            }
        };

        let fechaBase = new Date(); 
        let citaEnCursoData = null; 
        let slotManualId = null;
        let pacienteManualEncontradoId = null;

        document.addEventListener('DOMContentLoaded', () => {
            irAHoy();
        });

        function irAHoy() {
            fechaBase = new Date();
            renderizarSemanaActual();
        }

        function cambiarSemana(direccion) {
            fechaBase.setDate(fechaBase.getDate() + (direccion * 7));
            renderizarSemanaActual();
        }

        function renderizarSemanaActual() {
            const timeLabelsContainer = document.getElementById('timeLabelsContainer');
            const daysContainer = document.getElementById('diasSemanaContainer');
            if(!timeLabelsContainer || !daysContainer) return;

            const lunes = new Date(fechaBase);
            const diaSemana = lunes.getDay() === 0 ? 7 : lunes.getDay(); 
            lunes.setDate(lunes.getDate() - diaSemana + 1);

            const diasAbreviados = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
            const mesesCortos = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            const domingo = new Date(lunes);
            domingo.setDate(lunes.getDate() + 6);
            
            document.getElementById('textoSemanaActual').innerText = `Semana del ${lunes.getDate()} ${mesesCortos[lunes.getMonth()]} al ${domingo.getDate()} ${mesesCortos[domingo.getMonth()]} ${lunes.getFullYear()}`;

            timeLabelsContainer.innerHTML = '<div class="time-header-spacer"></div>';
            daysContainer.innerHTML = '';

            // Granularidad 30 min: 08:00, 08:30, 09:00, ..., 20:00, 20:30
            for(let h = 8; h <= 20; h++) {
                timeLabelsContainer.innerHTML += `<div class="time-slot-label">${h.toString().padStart(2,'0')}:00</div>`;
                timeLabelsContainer.innerHTML += `<div class="time-slot-label">${h.toString().padStart(2,'0')}:30</div>`;
            }

            for (let i = 0; i < 7; i++) {
                let fechaColumna = new Date(lunes);
                fechaColumna.setDate(lunes.getDate() + i);

                let diaNum = fechaColumna.getDate().toString().padStart(2, '0');
                let mesNum = (fechaColumna.getMonth()+1).toString().padStart(2, '0');
                let mesStr = mesesCortos[fechaColumna.getMonth()];
                let añoStr = fechaColumna.getFullYear();
                let diaLetra = diasAbreviados[i];

                let fechaRealStr = `${diaNum}/${mesNum}/${añoStr}`;

                let colHTML = `<div class="day-col"><div class="day-header">${diaLetra}<small>${diaNum} ${mesStr}</small></div>`;

                // Bloques cada 30 minutos desde 08:00 hasta 20:30
                for(let hora = 8; hora <= 20; hora++) {
                    for(let min of [0, 30]) {
                        let horaStr = `${hora.toString().padStart(2, '0')}:${min.toString().padStart(2, '0')}`;
                        let numDiaJS = fechaColumna.getDay() === 0 ? 7 : fechaColumna.getDay();

                        // FORMATO EXACTO SINCRONIZADO: "Lun 04/05/2026 - 09:00" / "Lun 04/05/2026 - 09:30"
                        let slotRealId = `${diaLetra} ${fechaRealStr} - ${horaStr}`;

                        colHTML += `<div class="time-block" data-dia-semana="${numDiaJS}" data-hora="${horaStr}" data-slot-real="${slotRealId}"></div>`;
                    }
                }
                colHTML += `</div>`;
                daysContainer.innerHTML += colHTML;
            }

            poblarGrillaConDatosDeSupabase();
        }

        async function poblarGrillaConDatosDeSupabase() {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) return;

            try {
                // 1. SINCRONIZACIÓN DE DISPONIBILIDAD (Igual que en el mapa del paciente)
                const { data: perfil } = await window.midental.from('perfiles_dentistas').select('disponibilidad_json, horarios_json').eq('id', userId).single();
                const { data: sedes } = await window.midental.from('sedes_dentistas').select('nombre_sede, disponibilidad_json, horarios_json').eq('dentista_id', userId);

                let slotsMap = {};
                
                // Mapeamos lo del perfil
                if (perfil) {
                    if (perfil.disponibilidad_json) perfil.disponibilidad_json.forEach(s => slotsMap[s] = 'Consulta Privada');
                    if (perfil.horarios_json) perfil.horarios_json.forEach(s => slotsMap[s] = 'Consulta Privada');
                }
                
                // Mapeamos las sedes (sobrescribe si hay choque, mostrando el nombre correcto)
                if (sedes) {
                    sedes.forEach(s => {
                        if (s.disponibilidad_json) s.disponibilidad_json.forEach(slot => slotsMap[slot] = s.nombre_sede);
                        if (s.horarios_json) s.horarios_json.forEach(slot => slotsMap[slot] = s.nombre_sede);
                    });
                }

                const numDiaMap = { 'Lun': 1, 'Mar': 2, 'Mié': 3, 'Jue': 4, 'Vie': 5, 'Sáb': 6, 'Dom': 7 };

                // Pintamos los bloques disponibles verdes
                Object.keys(slotsMap).forEach(slotKey => {
                    let partes = slotKey.split('-'); // Ej: ["Lun", "09:00"]
                    if(partes.length !== 2) return;
                    
                    let numDia = numDiaMap[partes[0]];
                    let hora = partes[1];
                    let nombreSede = slotsMap[slotKey];

                    let celda = document.querySelector(`[data-dia-semana="${numDia}"][data-hora="${hora}"]`);
                    if (celda) {
                        const slotReal = celda.getAttribute('data-slot-real');
                        celda.innerHTML = `
                            <div class="slot-workplace" onclick="abrirModalAgendarManual('${slotReal}')" title="Agendar en ${nombreSede}">
                                <span class="material-symbols-outlined" style="font-size: 14px; color: #4ade80;">location_on</span>
                                <span class="sede-text-mini">${nombreSede}</span>
                                <span class="material-symbols-outlined" style="font-size: 16px; color: #22c55e;">add_circle</span>
                            </div>
                        `;
                    }
                });

                // 2. EXTRAER CITAS AGENDADAS Y DIBUJARLAS ENCIMA
                const { data: citas } = await window.midental
                    .from('citas_agenda')
                    .select('*, perfiles_pacientes(nombre_completo, telefono)')
                    .eq('dentista_id', userId)
                    .neq('estado', 'cancelada')
                    .neq('estado', 'Rechazado'); // Ocultar rechazadas para limpiar visual

                if (citas) {
                    citas.forEach(cita => {
                        let slotIdBusqueda = cita.fecha_hora_formato_slot;
                        let celda = document.querySelector(`[data-slot-real="${slotIdBusqueda}"]`);

                        if (celda) {
                            const pctName = cita.paciente_nombre_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.nombre_completo : 'Paciente');
                            const pctTel = cita.paciente_telefono_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.telefono : '');
                            const estado = cita.estado || 'pendiente';

                            // Cálculo dinámico del alto: cada bloque = 30 min.
                            // 30 min => 1 bloque => height: calc(100% + 0px)
                            // 60 min => 2 bloques => height: calc(200% + 1px)
                            // 90 min => 3 bloques => height: calc(300% + 2px)
                            // 120 min => 4 bloques => height: calc(400% + 3px)
                            // Fallback a 60 min para citas históricas sin duracion_minutos (preserva look previo de 1h)
                            const duracionMin = parseInt(cita.duracion_minutos, 10) || 60;
                            const bloques = Math.max(1, Math.round(duracionMin / 30));
                            const alturaCss = `calc(${bloques * 100}% + ${bloques - 1}px)`;

                            const citaDataStr = encodeURIComponent(JSON.stringify({
                                cita_id: cita.id,
                                paciente_id: cita.paciente_id || '',
                                nombre: pctName,
                                motivo: cita.motivo,
                                telefono: pctTel,
                                rut: cita.paciente_rut_manual || '',
                                estado: estado,
                                fecha: slotIdBusqueda,
                                duracion_minutos: duracionMin
                            }));

                            celda.innerHTML = `
                                <div class="event-base event-${estado}" style="height: ${alturaCss};" onclick="abrirOpcionesCita('${citaDataStr}')" title="${pctName} - ${cita.motivo} (${duracionMin} min)">
                                    <strong style="font-size:0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: inherit;">${pctName}</strong>
                                    <span style="font-size:0.65rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity:0.9;">${cita.motivo || ''}</span>
                                </div>
                            `;
                        }
                    });
                }
            } catch (err) {
                console.error("Error cargando datos de agenda sincronizados:", err);
            }
        }

