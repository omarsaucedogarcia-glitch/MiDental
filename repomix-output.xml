        // --- AUTOCOMPLETADO BLINDADO POR PRIVACIDAD ---
        let timeoutBusquedaNombre;
        
        async function buscarPacientePorNombre() {
            const input = document.getElementById('manualNombre');
            const termino = input.value.trim().toLowerCase();
            const lista = document.getElementById('listaAutocompletadoNombre');
            const dentistaId = localStorage.getItem('midental_user_id'); // Identificador del Dentista

            // Si el dentista empieza a escribir de nuevo, desvinculamos el ID anterior
            pacienteManualEncontradoId = null;
            document.getElementById('statusBusquedaRut').innerText = "";

            if (termino.length < 3) {
                lista.style.display = 'none';
                return;
            }

            clearTimeout(timeoutBusquedaNombre);
            timeoutBusquedaNombre = setTimeout(async () => {
                try {
                    // CAMBIO CLAVE DE SEGURIDAD: Buscamos SOLO en las citas de este dentista
                    const { data, error } = await window.midental.from('citas_agenda')
                        .select('paciente_id, perfiles_pacientes!inner(id, rut, nombre_completo, telefono)')
                        .eq('dentista_id', dentistaId)
                        .ilike('perfiles_pacientes.nombre_completo', `%${termino}%`)
                        .limit(30); // Límite amplio por si hay múltiples citas de la misma persona

                    if (error) throw error;

                    if (data && data.length > 0) {
                        // Limpiamos duplicados (un paciente puede tener 5 citas, solo queremos mostrarlo 1 vez)
                        const pacientesUnicos = [];
                        const idsVistos = new Set();
                        
                        for (let cita of data) {
                            const pct = cita.perfiles_pacientes;
                            if (pct && !idsVistos.has(pct.id)) {
                                idsVistos.add(pct.id);
                                pacientesUnicos.push(pct);
                                if (pacientesUnicos.length === 5) break; // Mostramos máximo 5 sugerencias
                            }
                        }

                        if (pacientesUnicos.length > 0) {
                            lista.innerHTML = '';
                            pacientesUnicos.forEach(pct => {
                                const item = document.createElement('div');
                                item.className = 'autocomplete-item';
                                item.innerHTML = `<strong>${pct.nombre_completo}</strong><span>RUT: ${pct.rut || 'Sin RUT'} | Tel: ${pct.telefono || 'Sin registro'}</span>`;
                                item.onclick = () => seleccionarPacienteAutocompletado(pct);
                                lista.appendChild(item);
                            });
                            lista.style.display = 'block';
                        } else {
                            lista.style.display = 'none';
                        }
                    } else {
                        lista.style.display = 'none';
                    }
                } catch (err) {
                    console.error("Error buscando por nombre:", err);
                }
            }, 400); 
        }

        function seleccionarPacienteAutocompletado(paciente) {
            pacienteManualEncontradoId = paciente.id;
            verificarRecordatorioPaciente(paciente.id);
            document.getElementById('manualNombre').value = paciente.nombre_completo || '';
            document.getElementById('manualRut').value = paciente.rut || '';
            document.getElementById('manualTelefono').value = paciente.telefono || '';
            
            document.getElementById('listaAutocompletadoNombre').style.display = 'none';
            
            const status = document.getElementById('statusBusquedaRut');
            status.innerText = "✅ Paciente autocompletado y vinculado.";
            status.style.color = "var(--green-success)";
        }
        
        // Ocultar la lista si el usuario hace clic afuera del buscador
        document.addEventListener('click', function(e) {
            if(e.target.id !== 'manualNombre') {
                const lista = document.getElementById('listaAutocompletadoNombre');
                if(lista) lista.style.display = 'none';
            }
        });

