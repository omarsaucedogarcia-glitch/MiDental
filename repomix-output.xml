                                <button type="button" class="odn-perio-btn" data-perio-rx="rar-g2">Grupo II</button>
                                <button type="button" class="odn-perio-btn" data-perio-rx="rar-g3">Grupo III</button>
                                <button type="button" class="odn-perio-btn" data-perio-rx="rar-g4">Grupo IV</button>
