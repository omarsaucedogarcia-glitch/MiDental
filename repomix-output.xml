        function abrirOdontograma() {
            const modal = document.getElementById('odontogramaModal');
            if (!modal) return;
            const nombre = (pacienteActual && pacienteActual.nombre) ? pacienteActual.nombre : 'Paciente';
            const rut    = (pacienteActual && pacienteActual.rut)    ? pacienteActual.rut    : '--';
            document.getElementById('odnNombrePaciente').innerText = nombre;
            document.getElementById('odnRutPaciente').innerText    = 'RUT: ' + rut;
            document.getElementById('odnAvatar').innerText         = (nombre.charAt(0) || '?').toUpperCase();
            modal.classList.add('odn-active');
            document.getElementById('btnAbrirOdontograma').setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            document.dispatchEvent(new CustomEvent('odontograma:open', { detail: { pacienteId: pacienteIdURL, isLocal: isLocal, paciente: pacienteActual } }));
        }

        function cerrarOdontograma() {
            const modal = document.getElementById('odontogramaModal');
            if (!modal) return;
            modal.classList.remove('odn-active');
            const btn = document.getElementById('btnAbrirOdontograma');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            document.dispatchEvent(new CustomEvent('odontograma:close'));
            actualizarContadoresOdontograma();
            analizarPerfilClinicoPaciente();
        }

        let recallCalculadoPara = null;
        function analizarPerfilClinicoPaciente() {
            const card = document.getElementById('tarjetaInteligenciaClinica');
            if (!window.MiDentalOdontograma || typeof window.MiDentalOdontograma.calcularRiesgoIntegral !== 'function') {
                if (card) card.style.display = 'none'; return;
            }
            const eventos = window.MiDentalOdontograma.getEvents();
            const hallazgos = (typeof window.MiDentalOdontograma.getHallazgos === 'function') ? window.MiDentalOdontograma.getHallazgos() : [];
            const perio = (window.MiDentalOdontograma.getPerio && window.MiDentalOdontograma.getPerio()) || null;
            const tieneAlgo = eventos.length > 0 || hallazgos.length > 0 || (perio && (perio.bop || perio.cal_leve || perio.cal_severa));
            if (!tieneAlgo) { if (card) card.style.display = 'none'; return; }

            const riesgo = window.MiDentalOdontograma.calcularRiesgoIntegral(hallazgos, null);
            const NIVEL_META = { 'alto':  { label: 'Alto Riesgo',  color: '#ef4444' }, 'medio': { label: 'Riesgo Moderado', color: '#f59e0b' }, 'bajo':  { label: 'Bajo Riesgo / Mantenimiento', color: '#10b981' } };
            const m = NIVEL_META[riesgo.nivel] || NIVEL_META.bajo;

            const fechaControl = new Date();
            fechaControl.setMonth(fechaControl.getMonth() + riesgo.control_meses);
            recallCalculadoPara = fechaControl.toISOString();

            const badge = document.getElementById('aiNivelRiesgo');
            badge.innerText = m.label; badge.style.background = m.color;

            const desg = riesgo.desglose || {};
            const pintarArea = (areaId, badgeId, recoId, sub) => {
                const meta = NIVEL_META[sub.nivel] || NIVEL_META.bajo;
                const cardEl = document.getElementById(areaId);
                if (cardEl) cardEl.style.borderLeftColor = meta.color;
                const b = document.getElementById(badgeId);
                if (b) { b.textContent = meta.label; b.style.background = meta.color; }
                const r = document.getElementById(recoId);
                if (r) r.textContent = sub.recomendacion || '—';
            };
            pintarArea('aiAreaCaries', 'aiCariesBadge', 'aiCariesReco', desg.caries || { nivel: 'bajo', recomendacion: '—' });
            pintarArea('aiAreaPerio',  'aiPerioBadge',  'aiPerioReco',  desg.perio  || { nivel: 'bajo', recomendacion: '—' });

            document.getElementById('aiRecomendacion').innerText = riesgo.recomendaciones;
            document.getElementById('aiMesesControl').innerText  = riesgo.control_meses;
            document.getElementById('aiFechaControl').innerText  = fechaControl.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
            card.style.display = 'block';
        }

        async function programarRecallPremium() {
            if (!recallCalculadoPara) return;
            alert("Esta acción guardará el 'Recall' en la base de datos de MiDental. Un servidor automatizado enviará un mensaje de WhatsApp al paciente 3 días antes de la fecha límite para invitarlo a agendar su control.");
        }

        function actualizarContadoresOdontograma() {
            if (!window.MiDentalOdontograma) return;
            const eventos = window.MiDentalOdontograma.getEvents();
            const ultimos = new Map();
            for (let i = eventos.length - 1; i >= 0; i--) {
                const e = eventos[i];
                const k = e.scope === 'whole-tooth' ? `${e.fdi}|TOOTH` : `${e.fdi}|${e.surface}`;
                if (!ultimos.has(k)) ultimos.set(k, e);
            }
            let nPat = 0, nPlan = 0, nExist = 0;
            ultimos.forEach(e => {
                if (e.state === 'active') nPat++;
                else if (e.state === 'planned') nPlan++;
                else if (e.state === 'completed' || e.state === 'historic') nExist++;
            });
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = String(v); };
            set('odnStatPatologia', nPat); set('odnStatPlan', nPlan); set('odnStatExistente', nExist);
        }

        function llevarHallazgosAPresupuesto() {
            if (!window.MiDentalOdontograma) return alert("Motor del odontograma no disponible.");
            const eventos = window.MiDentalOdontograma.getEvents();
            if (!eventos.length) return alert("No hay hallazgos registrados en el odontograma todavía.");

            // Filtrar SOLO los tratamientos planificados (los amarillos)
            const planificados = eventos.filter(e => e.state === 'planned');

            if (planificados.length === 0) {
                return alert("Sólo hay hallazgos históricos / existentes o patologías activas sin planificar. Marca algún tratamiento planificado (amarillo) en el panel derecho para enviarlo al presupuesto.");
            }

            // Agrupar planificados por pieza dental
            const grouped = {};
            planificados.forEach(e => {
                if (!grouped[e.fdi]) {
                    grouped[e.fdi] = {
                        fdi: e.fdi,
                        surfaces: new Set(),
                        treatment: e,
                        isResina: e.label.toLowerCase().includes('resina')
                    };
                }
                const g = grouped[e.fdi];
                if (e.surface) g.surfaces.add(e.surface);
            });

            const tbody = document.getElementById('tbodyPresupuesto');
            const piezasYa = new Set();
            tbody.querySelectorAll('tr').forEach(tr => {
                const d = tr.querySelector('.input-diente');
                if (d && d.value.trim()) piezasYa.add(d.value.trim());
            });

            const rows = tbody.querySelectorAll('tr');
            if (rows.length === 1) {
                const r = rows[0];
                const empty = !r.querySelector('.input-diente').value && !r.querySelector('.input-diag').value && !r.querySelector('.input-tratamiento').value && !r.querySelector('.input-ref').value;
                if (empty) tbody.innerHTML = '';
            }

            let agregadas = 0;
            const payload = [];

            Object.values(grouped).forEach(g => {
                const piezaFmt = `${g.fdi.charAt(0)}.${g.fdi.charAt(1)}`;
                const sortedSurfs = Array.from(g.surfaces).sort().join('');
                const piezaCol = sortedSurfs ? `${piezaFmt} ${sortedSurfs}` : piezaFmt;

                // Diagnóstico primario asociado
                const diag = "Patología dental / Necesidad de restauración";

                // Tratamiento
                let txName = g.treatment.label.split(': ')[1] || g.treatment.label;
                let price = 45000;

                // Inferencia inteligente de caras (ej: MOD) para caries/resina
                if (g.isResina) {
                    if (g.surfaces.size > 2) {
                        txName = `Restauración en resina compleja ${sortedSurfs}`;
                        price = 85000;
                    } else if (g.surfaces.size === 1) {
                        txName = `Restauración en resina simple`;
                        price = 35000;
                    } else if (g.surfaces.size === 2) {
                        txName = `Restauración en resina compleja ${sortedSurfs}`;
                        price = 55000;
                    }
                }

                if (piezasYa.has(piezaCol)) return;

                const itemPayload = {
                    pieza: piezaCol,
                    diagnostico: diag,
                    prestacion: txName,
                    valor: price
                };
                payload.push(itemPayload);

                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td><input type="text" class="input-diente" value="${piezaCol}" placeholder="Ej: 1.4"></td>
                        <td><input type="text" class="input-diag" value="${diag}" placeholder="Diagnóstico"></td>
                        <td><input type="text" class="input-tratamiento" value="${txName.replace(/"/g, '"')}" placeholder="Prestación a definir"></td>
                        <td><input type="number" class="input-ref" value="${price}" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="text" class="ref-val input-total input-readonly" value="${price}" placeholder="0" readonly></td>
                    </tr>
                `);
                piezasYa.add(piezaCol);
                agregadas++;
            });

            console.log("Payload enviado a presupuesto:", payload);

            calcularGranTotal();
            cerrarOdontograma();

            const tabla = document.querySelector('.presupuesto-table-wrapper');
            if (tabla) tabla.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            if (agregadas > 0) {
                alert(`✓ Éxito: Se agregaron ${agregadas} pieza(s) con tratamientos planificados al presupuesto.`);
            } else {
                alert("Las piezas planificadas ya estaban registradas en el presupuesto.");
            }
        }

        function mostrarToastFicha(msg) {
            let t = document.getElementById('odnFichaToast');
            if (!t) {
                t = document.createElement('div'); t.id = 'odnFichaToast';
                t.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#0f172a;color:white;padding:12px 22px;border-radius:12px;font-weight:600;font-size:0.92rem;box-shadow:0 12px 30px rgba(0,0,0,0.35);z-index:9500;opacity:0;transition:opacity 200ms ease;pointer-events:none;';
                document.body.appendChild(t);
            }
            t.textContent = msg; t.style.opacity = '1';
            clearTimeout(t._timer);
            t._timer = setTimeout(() => { t.style.opacity = '0'; }, 2400);
        }

        document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('odontogramaModal');
            const open  = modal && modal.classList.contains('odn-active');
            if (e.key === 'Escape' && open) cerrarOdontograma();
            if (e.altKey && (e.key === 'o' || e.key === 'O') && !open) { e.preventDefault(); abrirOdontograma(); }
        });

        async function exportarHistorialOdontogramaPDF() {
            if (!window.MiDentalOdontograma) return alert("Motor del odontograma no disponible.");
            const eventos = window.MiDentalOdontograma.getEvents();
            if (!eventos || eventos.length === 0) return alert("Aún no hay registros en el odontograma para exportar.");
            
            const { jsPDF } = window.jspdf; const doc = new jsPDF();
            doc.setFontSize(16); doc.text("Historial del Odontograma", 200, 20, { align: "right" });
            const nombreArchivo = `Odontograma_${Date.now()}.pdf`;
            doc.save(nombreArchivo);
            mostrarToastFicha('✓ Historial del odontograma descargado en PDF.');
        }
        document.addEventListener('odontograma:export-pdf', exportarHistorialOdontogramaPDF);

