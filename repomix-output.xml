// FUSIONAMOS EL PAYWALL Y SUPABASE AQUÍ:
async function cambiarEstadoUrgenciaDB(checkbox) {
    // 1. Simulamos el plan por ahora
    const planUsuarioActual = 'basico'; 

    // 2. EL BLOQUEO: Evaluamos si intenta encenderlo y NO es PRO
    if (checkbox.checked && planUsuarioActual !== 'pro') {
        checkbox.checked = false; // Lo apagamos visualmente de inmediato
        abrirPaywall("Aparecer en el mapa de Urgencias 24/7 y recibir pacientes en tiempo real es una herramienta exclusiva del Plan PRO.");
