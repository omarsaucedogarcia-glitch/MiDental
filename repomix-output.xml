        .btn-call-to-action { background: linear-gradient(135deg, var(--blue-elegant), #2563eb); color: white; padding: 16px; border-radius: 14px; font-size: 1.1rem; font-weight: 900; border: none; cursor: pointer; width: 100%; display: flex; justify-content: center; align-items: center; gap: 8px; box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3); transition: 0.3s;}
