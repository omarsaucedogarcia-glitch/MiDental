        async function buscarPacienteRed() {
            const rut = document.getElementById('manualRut').value.trim();
            const status = document.getElementById('statusBusquedaRut');
            const dentistaId = localStorage.getItem('midental_user_id');
            if(!rut) return;

            status.innerText = "Buscando...";
            status.style.color = "var(--blue-elegant)";

            try {
                // Buscamos si el RUT existe en la base de datos
                const { data, error } = await window.midental.from('perfiles_pacientes').select('id, nombre_completo, telefono, user_id').eq('rut', rut).single();
                
                if(data) {
                    // Comprobamos si este dentista ya lo ha atendido antes
                    const { data: citasHistorial } = await window.midental.from('citas_agenda')
                        .select('id').eq('dentista_id', dentistaId).eq('paciente_id', data.id).limit(1);

                    const esPacienteConocido = (citasHistorial && citasHistorial.length > 0);
                    const esPacienteGlobalConApp = (data.user_id !== null); // El paciente tiene cuenta oficial de MiDental

                    if (esPacienteConocido || esPacienteGlobalConApp) {
                        // Es SEGURO mostrar los datos
                        pacienteManualEncontradoId = data.id;
                        document.getElementById('manualNombre').value = data.nombre_completo || '';
                        document.getElementById('manualTelefono').value = data.telefono || '';
                        status.innerText = "✅ Paciente encontrado y vinculado.";
                        status.style.color = "var(--green-success)";
                    } else {
                        // ALERTA DE PRIVACIDAD: Es un paciente manual de OTRO dentista. Ocultamos sus datos.
                        pacienteManualEncontradoId = data.id; // Vinculamos el ID de forma invisible para no duplicar el RUT en la BD
                        document.getElementById('manualNombre').value = '';
                        document.getElementById('manualTelefono').value = '';
                        status.innerText = "Paciente registrado en otra clínica. Por favor ingresa su Nombre y Teléfono manualmente.";
                        status.style.color = "var(--pixar-orange)";
                    }
                } else {
                    pacienteManualEncontradoId = null;
                    status.innerText = "Paciente nuevo. Ingresa sus datos abajo.";
                    status.style.color = "var(--pixar-orange)";
                }
            } catch(e) {
                pacienteManualEncontradoId = null;
                status.innerText = "Paciente nuevo. Ingresa sus datos abajo.";
                status.style.color = "var(--pixar-orange)";
            }
        }

        async function guardarCitaManual() {
            const dentistaId = localStorage.getItem('midental_user_id');
            const rut = document.getElementById('manualRut').value.trim();
            const nombre = document.getElementById('manualNombre').value.trim();
            const telInput = document.getElementById('manualTelefono').value.trim();
            const motivo = document.getElementById('manualMotivo').value.trim();
            const duracion = parseInt(document.getElementById('manualDuracion').value, 10) || 30;

            if(!nombre || !telInput) return alert("El Nombre y Teléfono son obligatorios.");

            const btn = document.getElementById('btnGuardarManual');
            btn.innerText = "Creando Ficha y Agendando..."; btn.disabled = true;

            try {
                let telLimpio = telInput.replace(/[^0-9]/g, '');
                if (telLimpio.length === 8) {
                    telLimpio = '569' + telLimpio; 
                } else if (telLimpio.length === 9 && telLimpio.startsWith('9')) {
                    telLimpio = '56' + telLimpio; 
                }

                let pacienteIdFinal = pacienteManualEncontradoId;
                let esPacienteNuevo = false;

                // 1. MAGIA CLÍNICA: SI EL PACIENTE NO EXISTE, LE CREAMOS SU FICHA BASE
                if (!pacienteIdFinal) {
                    const nuevoId = crypto.randomUUID();
                    const { error: insertPctError } = await window.midental.from('perfiles_pacientes').insert([{
                        id: nuevoId,
                        rut: rut || null, // Guardamos el RUT si lo ingresó para que luego lo reclame
                        nombre_completo: nombre,
                        telefono: telLimpio,
                        enfermedades_cronicas: 'Ninguna',
                        medicamentos: 'Ninguno',
                        alergias: 'Ninguna',
                        user_id: null // Paciente huérfano
                    }]);

                    if (insertPctError) {
                        if(insertPctError.code === '23505') throw new Error("Este RUT ya existe. Por favor usa el botón de la lupa para buscarlo.");
                        throw insertPctError;
                    }
                    
                    pacienteIdFinal = nuevoId;
                    esPacienteNuevo = true;
                }

                // 2. CREAMOS LA CITA AMARRADA AL ID REAL DEL PACIENTE
                const { error } = await window.midental.from('citas_agenda').insert([{
                    dentista_id: dentistaId,
                    paciente_id: pacienteIdFinal, // AHORA SIEMPRE TENDRÁ UN ID CLÍNICO
                    fecha_hora_formato_slot: slotManualId,
                    estado: 'Confirmado',
                    motivo: motivo,
                    duracion_minutos: duracion
                }]);

                if(error) throw error;

                // 3. MENSAJE DE WHATSAPP INTELIGENTE
                let mensaje = `Hola ${nombre}, te hemos reservado una hora en MiDental para el día ${slotManualId.replace('-', ' a las ')}. `;
                if(esPacienteNuevo && rut) {
                    mensaje += `Hemos creado tu ficha clínica. Te invitamos a registrarte gratis con tu RUT para gestionarla y ver tus documentos aquí: www.midental.cl`;
                }

                alert("✅ Cita agregada exitosamente en la agenda y conectada a la Ficha Clínica.");
                cerrarModal('modalAgendarManual');
                renderizarSemanaActual();

                window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(mensaje)}`, '_blank');

            } catch (err) {
                alert("Error al agendar: " + err.message);
            } finally {
                btn.innerText = "Agendar y Enviar Invitación"; btn.disabled = false;
            }
        }

