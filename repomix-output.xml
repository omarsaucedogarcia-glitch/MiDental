        function abrirModalReceta() {
            document.getElementById('recetaNombrePaciente').innerText = pacienteActual.nombre;
            recetaMedicamentos = [];
            limpiarFormularioFarmaco();
            renderizarListaReceta();
            document.getElementById('modalRecetaMedica').style.display = 'flex';
        }

        function limpiarFormularioFarmaco() {
            document.getElementById('buscadorFarmaco').value = "";
            document.getElementById('posCantidad').value = "";
            document.getElementById('posFormato').value = "Comprimido(s)";
            document.getElementById('posFrecuencia').value = "";
            document.getElementById('posFrecUnidad').value = "Hora(s)";
            document.getElementById('posVia').value = "Vía Oral";
            document.getElementById('posDuracion').value = "";
            document.getElementById('posDurUnidad').value = "Día(s)";
            document.getElementById('posIndicaciones').value = "";
            document.getElementById('listaResultadosFarmacos').style.display = 'none';
        }

        function filtrarVademecum() {
            const query = document.getElementById('buscadorFarmaco').value.toLowerCase();
            const caja = document.getElementById('listaResultadosFarmacos');
            
            if (query.length < 2) { caja.style.display = 'none'; return; }
            
            const resultados = vademecumDB.filter(f => f.nombre.toLowerCase().includes(query));
            caja.innerHTML = "";
            
            if (resultados.length > 0) {
                resultados.forEach(f => {
                    const div = document.createElement('div');
                    div.style.cssText = "padding: 10px 15px; border-bottom: 1px solid #f1f5f9; cursor: pointer; color: #334155; font-size: 0.9rem;";
                    div.innerText = f.nombre;
                    div.onmouseover = () => div.style.background = "#f8fafc";
                    div.onmouseout = () => div.style.background = "white";
                    div.onclick = () => autocompletarPosologia(f);
                    caja.appendChild(div);
                });
                
                // Opción para texto libre
                const divLibre = document.createElement('div');
                divLibre.style.cssText = "padding: 10px 15px; cursor: pointer; color: var(--pixar-cyan); font-size: 0.9rem; font-style: italic;";
                divLibre.innerText = `+ Usar "${query.toUpperCase()}" como fármaco libre`;
                divLibre.onclick = () => { document.getElementById('buscadorFarmaco').value = query.toUpperCase(); caja.style.display = 'none'; };
                caja.appendChild(divLibre);
                
                caja.style.display = 'block';
            } else {
                caja.style.display = 'none';
            }
        }

        function autocompletarPosologia(farmaco) {
            document.getElementById('buscadorFarmaco').value = farmaco.nombre;
            document.getElementById('posCantidad').value = farmaco.cant;
            document.getElementById('posFormato').value = farmaco.form;
            document.getElementById('posFrecuencia').value = farmaco.frec;
            document.getElementById('posFrecUnidad').value = farmaco.funid;
            document.getElementById('posVia').value = farmaco.via;
            document.getElementById('posDuracion').value = farmaco.dur;
            document.getElementById('posDurUnidad').value = farmaco.dunid;
            document.getElementById('posIndicaciones').value = farmaco.ind;
            document.getElementById('listaResultadosFarmacos').style.display = 'none';
        }

        function agregarFarmacoAReceta() {
            const nombre = document.getElementById('buscadorFarmaco').value.trim();
            const cant = document.getElementById('posCantidad').value;
            const form = document.getElementById('posFormato').value;
            const frec = document.getElementById('posFrecuencia').value;
            const funid = document.getElementById('posFrecUnidad').value;
            const via = document.getElementById('posVia').value;
            const dur = document.getElementById('posDuracion').value;
            const dunid = document.getElementById('posDurUnidad').value;
            const ind = document.getElementById('posIndicaciones').value.trim();

            if (!nombre || !cant || !frec || !dur) return alert("Completa al menos el Fármaco, Cantidad, Frecuencia y Duración.");

            const posologiaArmada = `${cant} ${form} cada ${frec} ${funid} ${via} durante ${dur} ${dunid}`;
            
            recetaMedicamentos.push({ nombre: nombre, posologia: posologiaArmada, indicaciones: ind, id: Date.now() });
            
            limpiarFormularioFarmaco();
            renderizarListaReceta();
        }

        function eliminarFarmacoReceta(id) {
            recetaMedicamentos = recetaMedicamentos.filter(m => m.id !== id);
            renderizarListaReceta();
        }

        function renderizarListaReceta() {
            const contenedor = document.getElementById('listaFármacosAgregados');
            contenedor.innerHTML = "";
            
            if (recetaMedicamentos.length === 0) {
                contenedor.innerHTML = '<p style="color: #94a3b8; font-size: 0.9rem; text-align: center; margin-top: 20px;">No has agregado medicamentos a la receta.</p>';
                return;
            }

            recetaMedicamentos.forEach((med, index) => {
                contenedor.innerHTML += `
                    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-bottom: 10px; position: relative;">
                        <button onclick="eliminarFarmacoReceta(${med.id})" style="position: absolute; top: 15px; right: 15px; background: none; border: none; color: #ef4444; cursor: pointer;"><span class="material-symbols-outlined">delete</span></button>
                        <strong style="color: #0f172a; font-size: 1rem;">${index + 1}. ${med.nombre}</strong>
                        <ul style="margin: 5px 0 0 0; padding-left: 20px; color: #475569; font-size: 0.9rem;">
                            <li>${med.posologia}</li>
                            ${med.indicaciones ? `<li><em>Nota: ${med.indicaciones}</em></li>` : ''}
                        </ul>
                    </div>
                `;
            });
        }

        async function emitirYGuardarRecetaPDF() {
            if (recetaMedicamentos.length === 0) return alert("Debes agregar al menos un medicamento a la receta.");
            
            const dentistaId = localStorage.getItem('midental_user_id');
            const btn = document.getElementById('btnEmitirReceta');
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Generando...';
            btn.disabled = true;

            try {
                // 1. Obtener info profesional + clínica
                const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis').eq('id', dentistaId).single();
                const clinica = await obtenerInfoClinica(dentistaId);

                // 2. Generar PDF
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();

                const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo.toUpperCase()}` : '';
                const drInfo = dr ? `Esp. Odontología - General, RUT: ${dr.rut}\nID/Folio: ${Date.now().toString().slice(-6)}\nFecha receta: ${new Date().toLocaleDateString('es-CL')}` : '';

                // Header — nombre de la clínica como branding principal
                doc.setFontSize(16);
                doc.setTextColor(30, 58, 138);
                doc.setFont("helvetica", "bold");
                const tituloClinica = doc.splitTextToSize(clinica.nombre, 110);
                doc.text(tituloClinica, 14, 20);

                doc.setFont("helvetica", "normal");
                doc.setFontSize(8);
                doc.setTextColor(0, 0, 0);
                doc.text(drName, 200, 16, { align: "right" });
                doc.text(drInfo, 200, 20, { align: "right" });

                // Título
                doc.setFontSize(14);
                doc.setFont("helvetica", "bold");
                doc.setTextColor(0, 0, 0);
                doc.text("Receta Médica", 105, 35, { align: "center" });

                // Datos Paciente
                doc.setFontSize(12);
                doc.text("Datos del paciente", 14, 50);
                
                doc.setFontSize(8);
                doc.setFont("helvetica", "normal");
                doc.text(`Nombre: ${pacienteActual.nombre.toUpperCase()}`, 14, 56);
                doc.text(`RUT: ${pacienteActual.rut}`, 14, 61);
                doc.text(`Teléfono: ${pacienteActual.telefono || 'Sin registro'}`, 14, 66);
                
                // Listado Rp.
                doc.setFontSize(12);
                doc.setFont("helvetica", "bold");
                doc.text("Rp.", 14, 80);
                
                let startY = 88;
                doc.setFontSize(9);
                recetaMedicamentos.forEach((med, i) => {
                    doc.setFont("helvetica", "bold");
                    doc.text(`${i + 1}. ${med.nombre.toUpperCase()}`, 14, startY);
                    
                    doc.setFont("helvetica", "normal");
                    let txtLine = `• ${med.posologia}`;
                    if (med.indicaciones) txtLine += `\n• Nota: ${med.indicaciones}`;
                    
                    const splitText = doc.splitTextToSize(txtLine, 180);
                    doc.text(splitText, 18, startY + 5);
                    
                    startY += (splitText.length * 4) + 8;
                });

                // Firma Inferior
                const finalPageY = doc.internal.pageSize.height;
                doc.setDrawColor(0, 0, 0);
                doc.line(75, finalPageY - 35, 135, finalPageY - 35);
                doc.setFontSize(8);
                doc.setFont("helvetica", "normal");
                doc.text(drName, 105, finalPageY - 30, { align: "center" });
                doc.text("Odontología - General", 105, finalPageY - 26, { align: "center" });
                if(dr) doc.text(dr.rut, 105, finalPageY - 22, { align: "center" });

                // 3. Descargar y Guardar en Nube
                const nombreArchivo = `Receta_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}.pdf`;
                doc.save(nombreArchivo); // Descarga local para imprimir
                
                if (!isLocal) {
                    const pdfBlob = doc.output('blob');
                    const { error: uploadError } = await window.midental.storage
                        .from('documentos_clinicos')
                        .upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });

                    if (!uploadError) {
                        await window.midental.from('documentos_pacientes').insert([{
                            paciente_id: pacienteIdURL,
                            dentista_id: dentistaId,
                            nombre_archivo: `Receta Médica ${new Date().toLocaleDateString('es-CL')}.pdf`,
                            tipo: 'pdf',
                            archivo_url: nombreArchivo 
                        }]);
                        cargarDocumentosPaciente(); // Refresca la lista de archivos
                    }
                }
                
                alert("✅ Receta emitida exitosamente. Se ha guardado en los documentos del paciente.");
                document.getElementById('modalRecetaMedica').style.display = 'none';

            } catch (err) {
                alert("Error al emitir receta: " + err.message);
            } finally {
                btn.innerHTML = '<span class="material-symbols-outlined">print</span> Emitir Orden Médica';
                btn.disabled = false;
            }
        }

        // =====================================================================
        // ODONTOGRAMA · puente con la ficha clínica
        // - Apertura / cierre del modal sincronizando datos del paciente
        // - Contadores en vivo en el launcher strip (Patología/Plan/Existente)
        // - "Llevar a presupuesto": auto-inserta filas en la tabla a partir
        //   de los hallazgos planificados o de patología registrados.
        // - Atajo de teclado Alt+O para abrir sin levantar la mano del mouse.
        // =====================================================================

        function abrirOdontograma() {
            const modal = document.getElementById('odontogramaModal');
            if (!modal) return;
            const nombre = (pacienteActual && pacienteActual.nombre) ? pacienteActual.nombre : 'Paciente';
            const rut    = (pacienteActual && pacienteActual.rut)    ? pacienteActual.rut    : '--';
            document.getElementById('odnNombrePaciente').innerText = nombre;
            document.getElementById('odnRutPaciente').innerText    = 'RUT: ' + rut;
            document.getElementById('odnAvatar').innerText         = (nombre.charAt(0) || '?').toUpperCase();

            modal.classList.add('odn-active');
            document.getElementById('btnAbrirOdontograma').setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';

            document.dispatchEvent(new CustomEvent('odontograma:open', {
                detail: { pacienteId: pacienteIdURL, isLocal: isLocal, paciente: pacienteActual }
            }));
        }

        function cerrarOdontograma() {
            const modal = document.getElementById('odontogramaModal');
            if (!modal) return;
            modal.classList.remove('odn-active');
            const btn = document.getElementById('btnAbrirOdontograma');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            document.dispatchEvent(new CustomEvent('odontograma:close'));
            
            actualizarContadoresOdontograma();
            
            // NUEVO: Ejecutar la IA de perfilamiento al cerrar el odontograma
            analizarPerfilClinicoPaciente();
        }

        // ==========================================
        // MOTOR DE INTELIGENCIA Y RECALL PREMIUM
        // ==========================================
        let recallCalculadoPara = null;

        /**
         * Lee el motor de riesgo integral (cariología × periodoncia) y proyecta
         * el resultado unificado en la tarjeta premium. Si el motor no está
         * disponible o el odontograma está vacío, oculta la tarjeta.
         */
        function analizarPerfilClinicoPaciente() {
            const card = document.getElementById('tarjetaInteligenciaClinica');
            if (!window.MiDentalOdontograma || typeof window.MiDentalOdontograma.calcularRiesgoIntegral !== 'function') {
                if (card) card.style.display = 'none';
                return;
            }

            const eventos = window.MiDentalOdontograma.getEvents();
            const hallazgos = (typeof window.MiDentalOdontograma.getHallazgos === 'function')
                ? window.MiDentalOdontograma.getHallazgos()
                : [];
            const perio = (window.MiDentalOdontograma.getPerio && window.MiDentalOdontograma.getPerio()) || null;
            const tieneAlgo = eventos.length > 0 || hallazgos.length > 0 || (perio && (perio.bop || perio.cal_leve || perio.cal_severa));
            if (!tieneAlgo) { if (card) card.style.display = 'none'; return; }

            // Motor unificado.
            const riesgo = window.MiDentalOdontograma.calcularRiesgoIntegral(hallazgos, null);

            const NIVEL_META = {
                'alto':  { label: 'Alto Riesgo',  color: '#ef4444' },
                'medio': { label: 'Riesgo Moderado', color: '#f59e0b' },
                'bajo':  { label: 'Bajo Riesgo / Mantenimiento', color: '#10b981' }
            };
            const m = NIVEL_META[riesgo.nivel] || NIVEL_META.bajo;

            // Próximo control (fecha exacta)
            const fechaControl = new Date();
            fechaControl.setMonth(fechaControl.getMonth() + riesgo.control_meses);
            recallCalculadoPara = fechaControl.toISOString();

            // Badge global
            const badge = document.getElementById('aiNivelRiesgo');
            badge.innerText = m.label;
            badge.style.background = m.color;

            // Desglose por área — pinta el borde-left y el sub-badge según subnivel
            const desg = riesgo.desglose || {};
            const pintarArea = (areaId, badgeId, recoId, sub) => {
                const meta = NIVEL_META[sub.nivel] || NIVEL_META.bajo;
                const cardEl = document.getElementById(areaId);
                if (cardEl) cardEl.style.borderLeftColor = meta.color;
                const b = document.getElementById(badgeId);
                if (b) { b.textContent = meta.label; b.style.background = meta.color; }
                const r = document.getElementById(recoId);
                if (r) r.textContent = sub.recomendacion || '—';
            };
            pintarArea('aiAreaCaries', 'aiCariesBadge', 'aiCariesReco', desg.caries || { nivel: 'bajo', recomendacion: '—' });
            pintarArea('aiAreaPerio',  'aiPerioBadge',  'aiPerioReco',  desg.perio  || { nivel: 'bajo', recomendacion: '—' });

            // Bloque global
            document.getElementById('aiRecomendacion').innerText = riesgo.recomendaciones;
            document.getElementById('aiMesesControl').innerText  = riesgo.control_meses;
            document.getElementById('aiFechaControl').innerText  = fechaControl.toLocaleDateString('es-CL',
                { day: 'numeric', month: 'long', year: 'numeric' });

            card.style.display = 'block';
        }

        async function programarRecallPremium() {
            if (!recallCalculadoPara) return;
            
            // Aquí entra la realidad técnica del envío futuro:
            alert("Esta acción guardará el 'Recall' en la base de datos de MiDental. Un servidor automatizado enviará un mensaje de WhatsApp al paciente 3 días antes de la fecha límite para invitarlo a agendar su control.");
            
            /* LÓGICA DE INSERCIÓN PARA SUPABASE (Se asume que crearás la tabla 'recalls_premium')
            try {
                const { error } = await window.midental.from('recalls_premium').insert([{
                    paciente_id: pacienteIdURL,
                    dentista_id: localStorage.getItem('midental_user_id'),
                    fecha_disparo: recallCalculadoPara,
                    estado: 'pendiente'
                }]);
                if (error) throw error;
                alert("✅ Recordatorio automático programado con éxito.");
            } catch (err) {
                alert("Error al programar el Recall: " + err.message);
            }
            */
        }

        // ---------- Contadores en vivo del launcher strip ----------
        function actualizarContadoresOdontograma() {
            if (!window.MiDentalOdontograma) return;
            const eventos = window.MiDentalOdontograma.getEvents();
            // Sólo contamos el último evento por (fdi+surface o fdi+TOOTH) para no inflar.
            const ultimos = new Map();
            // Recorremos en reverso para conservar el más reciente.
            for (let i = eventos.length - 1; i >= 0; i--) {
                const e = eventos[i];
                const k = e.scope === 'whole-tooth' ? `${e.fdi}|TOOTH` : `${e.fdi}|${e.surface}`;
                if (!ultimos.has(k)) ultimos.set(k, e);
            }
            let nPat = 0, nPlan = 0, nExist = 0;
            ultimos.forEach(e => {
                if (e.state === 'active')                                    nPat++;
                else if (e.state === 'planned')                              nPlan++;
                else if (e.state === 'completed' || e.state === 'historic')  nExist++;
            });
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = String(v); };
            set('odnStatPatologia', nPat);
            set('odnStatPlan',      nPlan);
            set('odnStatExistente', nExist);
        }

        // ---------- "Llevar a presupuesto": auto-fill de filas de la tabla ----------
        function llevarHallazgosAPresupuesto() {
            if (!window.MiDentalOdontograma) {
                alert("Motor del odontograma no disponible.");
                return;
            }
            const eventos = window.MiDentalOdontograma.getEvents();
            if (!eventos.length) {
                alert("No hay hallazgos registrados en el odontograma todavía.");
                return;
            }

            // Agrupamos por pieza + finding code, quedándonos con el último (state vigente).
            const map = new Map();   // key: fdi|code → evento
            // Iteramos del más antiguo al más reciente para que el último sobreescriba.
            for (let i = eventos.length - 1; i >= 0; i--) {
                const e = eventos[i];
                if (e.state !== 'planned' && e.state !== 'active') continue;
                const k = `${e.fdi}|${e.findingCode || e.findingLabel}`;
                map.set(k, e);
            }

            if (map.size === 0) {
                alert("Sólo hay hallazgos históricos / existentes. Marca patología o planificación para llevarlos al presupuesto.");
                return;
            }

            const tbody = document.getElementById('tbodyPresupuesto');

            // Recolectamos piezas que ya están en filas existentes para no duplicar.
            const piezasYa = new Set();
            tbody.querySelectorAll('tr').forEach(tr => {
                const d = tr.querySelector('.input-diente');
                const g = tr.querySelector('.input-diag');
                if (d && d.value.trim()) piezasYa.add(`${d.value.trim()}|${(g.value || '').trim().toLowerCase()}`);
            });

            // Si la única fila es la vacía de plantilla, la limpiamos.
            const rows = tbody.querySelectorAll('tr');
            if (rows.length === 1) {
                const r = rows[0];
                const empty = !r.querySelector('.input-diente').value &&
                              !r.querySelector('.input-diag').value &&
                              !r.querySelector('.input-tratamiento').value &&
                              !r.querySelector('.input-ref').value;
                if (empty) tbody.innerHTML = '';
            }

            let agregadas = 0;
            map.forEach(e => {
                const piezaFmt = `${e.fdi.charAt(0)}.${e.fdi.charAt(1)}`;
                // Multi-superficie agrupada: anexa el código compuesto (ej. "OMD") a la pieza.
                const surfaces = e.surfaces && e.surfaces.length
                    ? e.surfaces
                    : (e.surface ? [e.surface] : []);
                const surfCode = (e.scope === 'whole-tooth' || surfaces.length === 0) ? '' : surfaces.join('');
                const piezaCol = surfCode ? `${piezaFmt} ${surfCode}` : piezaFmt;
                const diag = e.findingLabel || 'Hallazgo clínico';
                const key  = `${piezaCol}|${diag.toLowerCase()}`;
                if (piezasYa.has(key)) return;
                tbody.insertAdjacentHTML('beforeend', `
                    <tr>
                        <td><input type="text" class="input-diente" value="${piezaCol}" placeholder="Ej: 1.4"></td>
                        <td><input type="text" class="input-diag" value="${diag.replace(/"/g, '&quot;')}" placeholder="Diagnóstico"></td>
                        <td><input type="text" class="input-tratamiento" placeholder="Prestación a definir"></td>
                        <td><input type="number" class="input-ref" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="text" class="ref-val input-total input-readonly" placeholder="0" readonly></td>
                    </tr>
                `);
                piezasYa.add(key);
                agregadas++;
            });

            calcularGranTotal();
            cerrarOdontograma();

            // Feedback no bloqueante: scroll a la tabla y aviso temporal.
            const tabla = document.querySelector('.presupuesto-table-wrapper');
            if (tabla) tabla.scrollIntoView({ behavior: 'smooth', block: 'center' });
            mostrarToastFicha(agregadas > 0
                ? `✓ ${agregadas} fila(s) agregada(s) al presupuesto desde el odontograma.`
                : 'Sin filas nuevas: las piezas ya estaban en el presupuesto.');
        }

        function mostrarToastFicha(msg) {
            let t = document.getElementById('odnFichaToast');
            if (!t) {
                t = document.createElement('div');
                t.id = 'odnFichaToast';
                t.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#0f172a;color:white;padding:12px 22px;border-radius:12px;font-weight:600;font-size:0.92rem;box-shadow:0 12px 30px rgba(0,0,0,0.35);z-index:9500;opacity:0;transition:opacity 200ms ease;pointer-events:none;';
                document.body.appendChild(t);
            }
            t.textContent = msg;
            t.style.opacity = '1';
            clearTimeout(t._timer);
            t._timer = setTimeout(() => { t.style.opacity = '0'; }, 2400);
        }

        // ---------- Cableado global ----------
        document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('odontogramaModal');
            const open  = modal && modal.classList.contains('odn-active');
            if (e.key === 'Escape' && open) cerrarOdontograma();
            if (e.altKey && (e.key === 'o' || e.key === 'O') && !open) {
                e.preventDefault();
                abrirOdontograma();
            }
        });

        document.addEventListener('odontograma:event-registered', actualizarContadoresOdontograma);
        document.addEventListener('odontograma:open',              actualizarContadoresOdontograma);

        document.addEventListener('DOMContentLoaded', () => {
            // Botón "Llevar a presupuesto" del topbar del modal.
            const btnPpto = document.getElementById('odnBtnAplicarPresupuesto');
            if (btnPpto) btnPpto.addEventListener('click', llevarHallazgosAPresupuesto);
            actualizarContadoresOdontograma();
        });

        // -----------------------------------------------------------------
        // PDF · Historial completo del Odontograma
        // Sustituye al antiguo "copiar historial JSON". Genera un PDF
        // imprimible con encabezado profesional, datos del paciente y una
        // tabla cronológica de hallazgos por pieza (multi-superficie
        // colapsada en una sola fila).
        // -----------------------------------------------------------------
        async function exportarHistorialOdontogramaPDF() {
            if (!window.MiDentalOdontograma) {
                alert("Motor del odontograma no disponible.");
                return;
            }
            const eventos = window.MiDentalOdontograma.getEvents();
            if (!eventos || eventos.length === 0) {
                alert("Aún no hay registros en el odontograma para exportar.");
                return;
            }
            if (!window.jspdf || !window.jspdf.jsPDF) {
                alert("Generador PDF no disponible.");
                return;
            }

            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            const dentistaId = localStorage.getItem('midental_user_id');

            // Datos del dentista + clínica (best-effort, no bloqueante si no hay sesión).
            let drName = '—', drRut = '—', drSis = '—';
            let clinica = { nombre: 'Consulta Dental', direccion: '', comuna: '' };
            try {
                if (dentistaId) {
                    const { data: dr } = await window.midental.from('perfiles_dentistas')
                        .select('prefijo, nombre_completo, rut, registro_sis')
                        .eq('id', dentistaId).single();
                    if (dr) {
                        drName = `${dr.prefijo || 'Dr.'} ${dr.nombre_completo || ''}`.trim();
                        drRut  = dr.rut || '—';
                        drSis  = dr.registro_sis || '—';
                    }
                    clinica = await obtenerInfoClinica(dentistaId);
                }
            } catch (_) { /* silencioso */ }

            // ============ CABECERA ============
            doc.setFontSize(22);
            doc.setTextColor(0, 168, 255);
            doc.text("MiDental", 14, 20);
            doc.setFontSize(10);
            doc.setTextColor(100, 116, 139);
            doc.text("Red de Salud Digital", 14, 26);

            doc.setFontSize(16);
            doc.setTextColor(30, 58, 138);
            const tituloClinica = doc.splitTextToSize(clinica.nombre, 110);
            doc.text(tituloClinica, 200, 20, { align: "right" });
            doc.setFontSize(10);
            doc.setTextColor(85, 85, 85);
            const yFecha = 20 + (tituloClinica.length * 6);
            doc.text(`Historial del Odontograma · ${new Date().toLocaleDateString('es-CL')} ${new Date().toLocaleTimeString('es-CL')}`,
                     200, yFecha, { align: "right" });

            const yDivider = Math.max(30, yFecha + 4);
            doc.setDrawColor(200, 200, 200);
            doc.line(14, yDivider, 200, yDivider);

            // ============ DATOS DEL PACIENTE Y DENTISTA ============
            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Paciente", 14, 40);
            doc.setFontSize(10);
            doc.setTextColor(50, 50, 50);
            doc.text(`Nombre: ${pacienteActual.nombre || '—'}`, 14, 47);
            doc.text(`RUT: ${pacienteActual.rut || '—'}`,       14, 53);

            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Profesional tratante", 110, 40);
            doc.setFontSize(10);
            doc.setTextColor(50, 50, 50);
            doc.text(`Dentista: ${drName}`, 110, 47);
            doc.text(`RUT: ${drRut} · Registro SIS: ${drSis}`, 110, 53);

            // ============ RESUMEN DE CONTADORES ============
            const resumen = { active: 0, planned: 0, completed: 0, 'control-ok': 0, historic: 0 };
            eventos.forEach(e => { if (resumen[e.state] !== undefined) resumen[e.state]++; });

            doc.setFontSize(12);
            doc.setTextColor(30, 58, 138);
            doc.text("Resumen clínico", 14, 66);
            doc.setFontSize(9);
            doc.setTextColor(50, 50, 50);
            const linRes = `Patologías: ${resumen.active}    ·    Plan: ${resumen.planned}    `
                         + `·    Realizados: ${resumen['control-ok']}    `
                         + `·    Estado existente: ${resumen.completed}    `
                         + `·    Histórico/ausente: ${resumen.historic}    `
                         + `·    Total eventos: ${eventos.length}`;
            doc.text(linRes, 14, 73);

            // ============ TABLA CRONOLÓGICA ============
            const STATE_ES = {
                'active':     'Patología',
                'planned':    'Plan',
                'completed':  'Existente',
                'control-ok': 'Realizado',
                'review':     'Revisión',
                'historic':   'Histórico'
            };
            const SURF_FULL = { V:'Vestibular', P:'Palatina', L:'Lingual', M:'Mesial', D:'Distal', O:'Oclusal', I:'Incisal' };

            const filas = [];
            // Ordenamos por timestamp ascendente (más antiguo arriba) para lectura clínica.
            const eventosOrdenados = eventos.slice().sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));
            eventosOrdenados.forEach(e => {
                const pieza = `${e.fdi.charAt(0)}.${e.fdi.charAt(1)}`;
                const surfaces = e.surfaces && e.surfaces.length ? e.surfaces : (e.surface ? [e.surface] : []);
                let zona;
                if (e.scope === 'whole-tooth') {
                    zona = 'Pieza completa';
                } else if (surfaces.length > 1) {
                    zona = `${surfaces.join('')}  (${surfaces.map(s => SURF_FULL[s] || s).join(', ')})`;
                } else if (surfaces.length === 1) {
                    zona = `${surfaces[0]} · ${SURF_FULL[surfaces[0]] || ''}`;
                } else {
                    zona = '—';
                }
                const ts = new Date(e.timestamp);
                const fecha = ts.toLocaleDateString('es-CL') + ' ' + ts.toLocaleTimeString('es-CL', { hour:'2-digit', minute:'2-digit' });
                filas.push([fecha, pieza, zona, e.findingLabel || '—', STATE_ES[e.state] || e.state]);
            });

            doc.autoTable({
                startY: 82,
                head:   [['Fecha / Hora', 'Pieza', 'Zona', 'Hallazgo / Procedimiento', 'Estado']],
                body:   filas,
                theme:  'grid',
                headStyles: { fillColor: [30, 58, 138], textColor: 255, fontSize: 9 },
                bodyStyles: { fontSize: 8.5, textColor: 30 },
                alternateRowStyles: { fillColor: [248, 250, 252] },
                columnStyles: {
                    0: { cellWidth: 32 },
                    1: { cellWidth: 16, halign: 'center' },
                    2: { cellWidth: 48 },
                    3: { cellWidth: 60 },
                    4: { cellWidth: 24, halign: 'center' }
                },
                styles: { lineColor: [226, 232, 240], lineWidth: 0.2 }
            });

            // ============ FIRMA ============
            const finalPageY = doc.internal.pageSize.height;
            doc.setFontSize(10);
            doc.setTextColor(0, 0, 0);
            doc.line(30, finalPageY - 30, 90, finalPageY - 30);
            doc.text("Firma Paciente", 45, finalPageY - 25);
            doc.line(120, finalPageY - 30, 180, finalPageY - 30);
            doc.text("Firma Profesional", 135, finalPageY - 25);

            // ============ DESCARGA Y ALMACENAMIENTO OPCIONAL ============
            const nombrePuro = (pacienteActual.nombre || 'Paciente').replace(/[^a-zA-Z0-9]/g, '_');
            const nombreArchivo = `Odontograma_${nombrePuro}_${Date.now()}.pdf`;
            doc.save(nombreArchivo);

            // Si el paciente está registrado oficialmente, sube copia a Storage + indexa.
            try {
                if (!isLocal && pacienteIdURL) {
                    const blob = doc.output('blob');
                    const { error: upErr } = await window.midental.storage
                        .from('documentos_clinicos')
                        .upload(nombreArchivo, blob, { contentType: 'application/pdf' });
                    if (!upErr) {
                        await window.midental.from('documentos_pacientes').insert([{
                            paciente_id:   pacienteIdURL,
                            dentista_id:   dentistaId,
                            nombre_archivo:`Odontograma ${new Date().toLocaleDateString('es-CL')}.pdf`,
                            tipo:          'pdf',
                            archivo_url:   nombreArchivo
                        }]);
                        if (typeof cargarDocumentosPaciente === 'function') cargarDocumentosPaciente();
                        mostrarToastFicha('✓ Historial PDF descargado y archivado en la ficha del paciente.');
                        return;
                    }
                }
            } catch (_) { /* nube opcional */ }
            mostrarToastFicha('✓ Historial del odontograma descargado en PDF.');
        }

        // Engancha el evento que dispara el motor cuando se pulsa el botón
        // con icono picture_as_pdf en el topbar del modal.
        document.addEventListener('odontograma:export-pdf', exportarHistorialOdontogramaPDF);
    </script>
