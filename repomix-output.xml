                    </div>
                </aside>

                <!-- ============================================================
                     FILA INFERIOR (full-width): HISTORIAL DE PLANIFICACIÓN Y PRESUPUESTO
                     ------------------------------------------------------------
                     Recibe los bloques pendiente/planificado/auto-perio y el
                     timeline cronológico como referencia colapsable.
                     ============================================================ -->
                <section class="odn-historial" aria-label="Historial de Planificación y Presupuesto">
                    <header class="odn-historial__header">
                        <h3 class="odn-historial__title">
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            Historial de Planificación y Presupuesto
                        </h3>
                        <span class="odn-historial__chip" id="odnHistorialChip">0 hallazgos</span>
                        <div class="odn-timeline__filter" role="group" aria-label="Filtros del historial">
                            <button class="odn-timeline__filter-btn odn-active" data-filter="all"          type="button">Todos</button>
                            <button class="odn-timeline__filter-btn"            data-filter="pendiente"    type="button">Pendiente</button>
                            <button class="odn-timeline__filter-btn"            data-filter="planificado"  type="button">Planificado</button>
                            <button class="odn-timeline__filter-btn"            data-filter="auto-perio"   type="button">Periodontal</button>
                        </div>
                    </header>

                    <div id="smartPanelContainer" class="odn-smart-panel"></div>

                    <div class="odn-historial__body">
                        <!-- Bloques de planificación terapéutica (lista principal) -->
                        <div class="odn-plan-list" id="odnPlanList" data-empty="true">
                            <div class="odn-plan-empty" id="odnPlanEmpty">
                                <span class="material-symbols-outlined" aria-hidden="true" style="vertical-align:middle;">touch_app</span>
                                Aún no hay hallazgos registrados. Selecciona una condición y marca una superficie dental.
                            </div>
                        </div>
                    </div>

                    <!-- Timeline cronológico (referencia colapsable) -->
                    <details class="odn-timeline" style="margin-top:6px; background:#f8fafc; border:1px solid var(--odn-border); border-radius:var(--odn-radius-md); padding:6px 12px;">
                        <summary style="cursor:pointer; font-size:0.85rem; font-weight:700; color:var(--odn-accent-deep);">
                            <span class="material-symbols-outlined" aria-hidden="true" style="vertical-align:middle;">timeline</span>
                            Ver timeline cronológico
                            <span class="odn-timeline__chip" id="odnTimelineChip" data-empty="true" style="margin-left:10px;">0 evento(s)</span>
                        </summary>
                        <div class="odn-timeline__scroll" style="max-height:240px; padding:8px 0;">
                            <div class="odn-timeline__rail" id="odontogramaTimelineRail">
                                <div class="odn-timeline__empty" id="odnTimelineEmpty">
                                    <span class="material-symbols-outlined" aria-hidden="true">touch_app</span>
                                    Selecciona una pieza dental en el lienzo para ver su historial clínico completo.
                                </div>
                            </div>
                        </div>
                    </details>
                </section>
            </div>
        </div>
    </div>

