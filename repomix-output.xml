        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT clinical_events_odontogram_fk
        FOREIGN KEY (odontogram_id)
        REFERENCES edr.odontograms(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT clinical_events_tooth_fk
        FOREIGN KEY (tooth_id)
