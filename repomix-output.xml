                    <div class="video-upload-zone" id="uploadZone" onclick="document.getElementById('inputVideoShort').click()">
                        <span class="material-symbols-outlined" id="uploadIcon" style="font-size: 3rem; color: #cbd5e1;">movie</span>
                        <h4 id="uploadText" style="margin: 10px 0 5px; color: #64748b;">Haz clic para seleccionar un video (.mp4)</h4>
                        <p id="fileNameDisplay" style="color: var(--pixar-cyan); font-weight: bold; margin: 0;"></p>
                    </div>
                    <input type="file" id="inputVideoShort" accept="video/mp4,video/quicktime" style="display: none;" onchange="seleccionarArchivoVideo(this)">

                    <form class="form-registro">
                        <div class="mb-20">
                            <label class="input-label" style="font-weight: bold;">Descripción del Short</label>
                            <textarea id="shortDescription" class="apple-input-modal" placeholder="Ej: Así realizamos un blanqueamiento LED sin sensibilidad en Clínica X..." style="height: 80px; resize: none;"></textarea>
                        </div>

                        <div class="mb-20">
                            <label class="input-label" style="font-weight: bold;">Llamado a la acción (Botón visible para el paciente)</label>
                            <select id="shortCTA" class="apple-input-modal" style="background: white;">
                                <option value="perfil">Ver mi Perfil Clínico</option>
                                <option value="agenda">Agendar Cita Ahora</option>
                                <option value="oferta">Ver Oferta Flash Activa</option>
                            </select>
                            <p style="font-size: 0.8rem; color: #888; margin-top: 5px;">*Si el paciente selecciona 'Agendar Cita', se le pedirá iniciar sesión o registrarse.</p>
                        </div>

                        <button type="button" id="btnPublicarShort" class="btn-publish-free" onclick="lanzarShortReal()">
                            <span class="material-symbols-outlined" style="vertical-align: middle;">publish</span> Publicar Video (Calculando Cuota...)
                        </button>
                    </form>
                </div>

                <div class="creator-sidebar">
                    <div class="quota-box">
                        <div class="quota-title">Cuota Semanal Gratuita</div>
                        <div class="quota-counter">
                            <span id="shortsUsed" style="color: var(--pixar-cyan);">0</span> <span style="font-size: 2rem;">/</span> <span style="color: #ccc; font-size: 2rem;">2</span>
                        </div>
                        <p style="font-size: 0.8rem; color: #666; margin-top: 10px; line-height: 1.4;">
                            Publica hasta 2 videos gratis por semana.<br>Videos adicionales cuestan <strong>1 Token</strong>.
                        </p>
                    </div>

                    <div style="background: white; border-radius: 18px; padding: 20px; border: 1px solid #eee; flex: 1;">
                        <h4 style="margin: 0 0 15px 0; color: var(--blue-elegant); display: flex; align-items: center; gap: 5px;">
                            <span class="material-symbols-outlined">video_library</span> Mis Videos en Vivo
                        </h4>
                        <div id="shortsActivosContenedor" style="display: flex; flex-direction: column; gap: 10px;">
                            <p style="color:#aaa; font-size: 0.9rem; text-align: center; margin-top: 20px;">No tienes videos publicados.</p>
