    <!-- MODAL: GESTIÓN FINANCIERA DEL MES (LAB + CONVENIOS)     -->
    <!-- ======================================================= -->
    <div id="modalFinanzasMes" class="modal-overlay" style="display:none; z-index: 1100;">
        <div class="modal-content modal-content-split" style="max-width: 720px; max-height: 92vh; border-radius: 20px; display: flex; flex-direction: column; padding: 0; overflow: hidden;">
            <button class="btn-close" onclick="cerrarModalFinanzas()" style="position: absolute; top: 15px; right: 15px; z-index: 20;"><span class="material-symbols-outlined">close</span></button>

            <div class="modal-body-scroll" style="padding: 25px; overflow-y: auto; flex: 1;">
                <h2 class="modal-title" style="color: var(--blue-elegant); display: flex; align-items: center; gap: 10px; margin-top: 0;">
                    <span class="material-symbols-outlined" style="font-size: 2rem;">monitoring</span> Gestión Financiera del Mes
                </h2>
                <p style="color: #64748b; font-size: 0.9rem; margin: 0 0 20px;" id="lblMesActualFinanzas">Mes en curso</p>

                <!-- Resumen Calculado -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 25px;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px;">
                        <div style="text-align: center; padding: 10px; background: white; border-radius: 8px;">
                            <small style="color: #94a3b8; font-size: 0.7rem; text-transform: uppercase; font-weight: bold;">Bruto</small>
                            <strong style="display: block; font-size: 1.1rem; color: var(--green-success); margin-top: 4px;" id="finBrutos">$0</strong>
                        </div>
                        <div style="text-align: center; padding: 10px; background: white; border-radius: 8px;">
                            <small style="color: #94a3b8; font-size: 0.7rem; text-transform: uppercase; font-weight: bold;">Lab</small>
                            <strong style="display: block; font-size: 1.1rem; color: var(--pixar-orange); margin-top: 4px;" id="finLabTotal">$0</strong>
                        </div>
                        <div style="text-align: center; padding: 10px; background: white; border-radius: 8px;">
                            <small style="color: #94a3b8; font-size: 0.7rem; text-transform: uppercase; font-weight: bold;">Convenios</small>
                            <strong style="display: block; font-size: 1.1rem; color: var(--red-urgency); margin-top: 4px;" id="finConvTotal">$0</strong>
                        </div>
                        <div style="text-align: center; padding: 10px; background: white; border-radius: 8px; border: 2px solid var(--blue-elegant);">
                            <small style="color: var(--blue-elegant); font-size: 0.7rem; text-transform: uppercase; font-weight: bold;">Neto Final</small>
                            <strong style="display: block; font-size: 1.1rem; color: var(--blue-elegant); margin-top: 4px;" id="finNetoTotal">$0</strong>
                        </div>
                    </div>
                </div>

                <!-- Pagos a Laboratorio -->
                <h3 style="color: var(--pixar-orange); font-size: 1.05rem; border-bottom: 2px solid #fff7ed; padding-bottom: 8px; display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                    <span class="material-symbols-outlined">science</span> Pagos a Laboratorio
                </h3>
                <div style="display: flex; gap: 8px; margin: 12px 0; flex-wrap: wrap;">
                    <input type="text" id="labDescripcion" class="apple-input-modal" placeholder="Descripción (ej: Corona pieza 16)" style="flex: 2; min-width: 200px;">
                    <input type="number" id="labMonto" class="apple-input-modal" placeholder="Monto $" style="flex: 1; min-width: 120px;" min="0" step="500">
                    <button class="btn-pixar" onclick="agregarGastoLaboratorio()" style="padding: 10px 16px; background: var(--pixar-orange);" title="Agregar gasto">
                        <span class="material-symbols-outlined">add</span>
                    </button>
                </div>
                <div id="listaLaboratorio" style="margin-bottom: 25px;">
                    <p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin gastos de laboratorio este mes.</p>
                </div>

                <!-- Convenios con Centros Médicos -->
                <h3 style="color: var(--red-urgency); font-size: 1.05rem; border-bottom: 2px solid #fef2f2; padding-bottom: 8px; display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                    <span class="material-symbols-outlined">handshake</span> Convenios con Centros Médicos
                </h3>
                <p style="color: #64748b; font-size: 0.78rem; margin: 6px 0 12px;">El porcentaje se aplica sobre los ingresos del mes <i>después</i> de descontar laboratorio.</p>
                <div style="display: flex; gap: 8px; margin: 12px 0; flex-wrap: wrap;">
                    <input type="text" id="convNombre" class="apple-input-modal" placeholder="Ej: Centro Médico Los Gladiolos" style="flex: 2; min-width: 200px;">
                    <input type="number" id="convPorcentaje" class="apple-input-modal" placeholder="% (ej: 40)" style="flex: 1; min-width: 120px;" min="0" max="100" step="0.5">
                    <button class="btn-pixar" onclick="agregarConvenio()" style="padding: 10px 16px; background: var(--red-urgency);" title="Agregar convenio">
                        <span class="material-symbols-outlined">add</span>
                    </button>
                </div>
                <div id="listaConvenios">
                    <p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin convenios configurados.</p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        let solicitudesPendientesMemoria = [];
        let cronometroIntervalo; 
        let centroMedicoOficial = "nuestra clínica"; // Fallback por defecto
        let resumenAgenda = {
            hoy: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 },
            manana: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 }
        };

        document.addEventListener('DOMContentLoaded', async () => {
            // 1. Validar primero
    await validarSesionActiva(); 
    
    // 2. Luego cargar el resto
    await cargarPerfilYCentroMedico(localStorage.getItem('midental_user_id'));
    cargarEstadoUrgencia();
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) {
                window.location.href = 'index.html';
                return;
            }
            
            await cargarPerfilYCentroMedico(userId);
            cargarEstadoUrgencia();
            cargarOfertaActivaMonitor();
            await cargarJornadaCompleta(userId);
            cargarSolicitudesPendientes();
            cargarWidgetsFinancieros();
        });

        // ==========================================
        // PERFIL, SALUDO MOTIVACIONAL Y CENTRO MÉDICO
        // ==========================================
        async function cargarPerfilYCentroMedico(userId) {
            try {
                // 1. Obtener Datos del Profesional
                const { data: dr } = await window.midental.from('perfiles_dentistas').select('nombre_completo, prefijo, avatar_url').eq('id', userId).single();
                if(dr) {
                    if(dr.avatar_url) document.getElementById('topbarAvatar').src = dr.avatar_url;
                    
                    const primerNombre = dr.nombre_completo.split(' ')[0];
                    const prefijo = dr.prefijo || 'Dr/a.';
                    
                    const hrs = new Date().getHours();
                    let saludo = "¡Buenos días";
                    if (hrs >= 12 && hrs < 20) saludo = "¡Buenas tardes";
                    if (hrs >= 20 || hrs < 5) saludo = "¡Buenas noches";
                    
                    document.getElementById('dashGreeting').innerText = `${saludo}, ${prefijo} ${primerNombre}! 🦷`;
                }

                // 2. Obtener Sede para el WhatsApp de Recordatorio
                const { data: sede } = await window.midental.from('sedes_dentistas').select('nombre_sede').eq('dentista_id', userId).limit(1).maybeSingle();
                if (sede && sede.nombre_sede) {
                    centroMedicoOficial = sede.nombre_sede;
                }
            } catch (err) {
                console.error("Error al inicializar perfil:", err);
            }
        }

        // ==========================================
        // SWITCH DE URGENCIAS NATIVO
        // ==========================================
        async function cargarEstadoUrgencia() {
            const userId = localStorage.getItem('midental_user_id');
            const { data } = await window.midental.from('perfiles_dentistas').select('acepta_urgencias').eq('id', userId).single();
            if(data) {
                const checkbox = document.getElementById('toggleDisponible');
                checkbox.checked = data.acepta_urgencias;
                actualizarTextoUrgencia(checkbox.checked);
            }
        }

        async function cambiarEstadoUrgenciaDB(checkbox) {
            const userId = localStorage.getItem('midental_user_id');
            actualizarTextoUrgencia(checkbox.checked);
            if(userId) {
                await window.midental.from('perfiles_dentistas').update({ acepta_urgencias: checkbox.checked }).eq('id', userId);
            }
        }

        function actualizarTextoUrgencia(isActiva) {
            const texto = document.getElementById('statusText');
            if(isActiva) {
                texto.innerText = "Disponible para Urgencias"; texto.style.color = "var(--red-urgency)"; texto.style.fontWeight = "900";
            } else {
                texto.innerText = "Apagado"; texto.style.color = "#94a3b8"; texto.style.fontWeight = "normal";
            }
        }

        // ==========================================
        // MONITOR DE OFERTAS FLASH
        // ==========================================
        async function cargarOfertaActivaMonitor() {
            const userId = localStorage.getItem('midental_user_id');
            const { data } = await window.midental.from('ofertas_flash')
                .select('servicio_nombre, expira_at')
                .eq('dentista_id', userId).eq('activa', true)
                .gte('expira_at', new Date().toISOString())
                .order('created_at', { ascending: false }).limit(1).single();

            if(data) {
                document.getElementById('dashCampaignName').innerText = data.servicio_nombre;
                document.getElementById('monitorOfertaDashboard').style.display = 'block';
                const fechaExp = new Date(data.expira_at).getTime();

                clearInterval(cronometroIntervalo);
                cronometroIntervalo = setInterval(function() {
                    const distancia = fechaExp - new Date().getTime();
                    if (distancia < 0) {
                        clearInterval(cronometroIntervalo);
                        document.getElementById('dashCronometroFlash').innerText = "Campaña Finalizada";
                        return;
                    }
                    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((distancia % (1000 * 60)) / 1000);
                    document.getElementById('dashCronometroFlash').innerText = `${horas}h ${minutos}m ${segundos}s restantes`;
                }, 1000);
            }
        }

        // ==========================================
        // SOLICITUDES PENDIENTES DE LA PLATAFORMA
        // ==========================================
        async function cargarSolicitudesPendientes() {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('bandejaSolicitudes');
            
            const { data: citas } = await window.midental.from('citas_agenda')
                .select('*, perfiles_pacientes(nombre_completo, telefono)')
                .eq('dentista_id', userId).eq('estado', 'pendiente');

            if(citas && citas.length > 0) {
                solicitudesPendientesMemoria = citas;
                contenedor.innerHTML = "";
                citas.forEach(cita => {
                    const pctName = cita.paciente_nombre_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.nombre_completo : 'Paciente');
                    contenedor.innerHTML += `
                        <div class="request-card" id="req-${cita.id}">
                            <div class="request-info">
                                <h4>${cita.motivo || 'Evaluación General'}</h4>
                                <p><span class="material-symbols-outlined" style="font-size:1rem; color:var(--pixar-cyan);">person</span> <strong>Paciente:</strong> ${pctName}</p>
                                <p><span class="material-symbols-outlined" style="font-size:1rem; color:var(--pixar-cyan);">calendar_today</span> <strong>Horario:</strong> ${cita.fecha_hora_formato_slot || 'Por definir'}</p>
                            </div>
                            <div class="request-actions">
                                <button class="btn-reject-action" onclick="rechazarCitaReal(${cita.id})"><span class="material-symbols-outlined">close</span> Rechazar</button>
                                <button class="btn-confirm-action" onclick="confirmarCitaReal(${cita.id})"><span class="material-symbols-outlined">check_circle</span> Confirmar</button>
                            </div>
                        </div>`;
                });
            } else {
                contenedor.innerHTML = '<p style="color: #94a3b8; padding: 25px; background: white; border-radius: 15px; text-align: center; border: 1px dashed #cbd5e1; font-weight: bold; margin:0;">No tienes solicitudes pendientes de confirmación.</p>';
            }
        }

        async function confirmarCitaReal(citaId) {
            const { error } = await window.midental.from('citas_agenda').update({ estado: 'Confirmado' }).eq('id', citaId);
            if(error) return alert("Error: " + error.message);
            
            const citaData = solicitudesPendientesMemoria.find(c => c.id === citaId);
            if (citaData) {
                const nombrePct = citaData.paciente_nombre_manual || (citaData.perfiles_pacientes ? citaData.perfiles_pacientes.nombre_completo : 'Paciente');
                const fonoRaw = citaData.paciente_telefono_manual || (citaData.perfiles_pacientes ? citaData.perfiles_pacientes.telefono : '');
                if(fonoRaw) {
                    const msg = `Estimado paciente ${nombrePct}, su hora para el bloque [${citaData.fecha_hora_formato_slot}] ha sido CONFIRMADA de manera exitosa en ${centroMedicoOficial}. ¡Le esperamos!`;
                    window.open(`https://wa.me/${fonoRaw.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(msg)}`, '_blank');
                }
            }
            alert("✅ Cita confirmada de forma exitosa.");
            location.reload();
        }

        async function rechazarCitaReal(citaId) {
            if(!confirm("¿Rechazar esta hora médica?")) return;
            await window.midental.from('citas_agenda').update({ estado: 'cancelada' }).eq('id', citaId);
            location.reload();
        }

        // ==========================================
        // LÓGICA DE AGENDA (HOY Y MAÑANA) SEPARADA POR TABS
        // ==========================================
        async function cargarJornadaCompleta(userId) {
            const hoy = new Date();
            const manana = new Date(hoy);
            manana.setDate(hoy.getDate() + 1);

            const formateaFecha = (fecha) => `${String(fecha.getDate()).padStart(2, '0')}/${String(fecha.getMonth() + 1).padStart(2, '0')}/${fecha.getFullYear()}`;
            
            const fechaHoyStr = formateaFecha(hoy);
            const fechaMananaStr = formateaFecha(manana);

            // Reiniciamos los contadores en memoria
            resumenAgenda = {
                hoy: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 },
                manana: { confirmadas: 0, pendientes: 0, atendidos: 0, noAsistieron: 0, html: "", total: 0 }
            };

            try {
                const { data: citas, error } = await window.midental.from('citas_agenda')
                    .select('*, perfiles_pacientes(nombre_completo, telefono)')
                    .eq('dentista_id', userId)
                    .neq('estado', 'cancelada')
                    .neq('estado', 'Rechazado')
                    .neq('estado', 'bloqueado');

                if (error) throw error;

                // 1. Filtramos para obtener solo las citas de HOY y MAÑANA
                const citasProximas = citas.filter(c => 
                    c.fecha_hora_formato_slot && 
                    (c.fecha_hora_formato_slot.includes(fechaHoyStr) || c.fecha_hora_formato_slot.includes(fechaMananaStr))
                );

                // --- NUEVO: ORDENAMIENTO CRONOLÓGICO ESTRICTO ---
                citasProximas.sort((a, b) => {
                    // Intentamos ordenar usando la marca de tiempo exacta de la base de datos (Máxima precisión)
                    if (a.fecha_hora && b.fecha_hora) {
                        return new Date(a.fecha_hora) - new Date(b.fecha_hora);
                    }
                    // Plan B: Si no hay marca de tiempo, extraemos la hora del texto (ej. "09:30") y ordenamos numéricamente
                    const horaA = (a.fecha_hora_formato_slot.split('-')[1] || a.fecha_hora_formato_slot).trim();
                    const horaB = (b.fecha_hora_formato_slot.split('-')[1] || b.fecha_hora_formato_slot).trim();
                    return horaA.localeCompare(horaB);
                });

                citasProximas.forEach(cita => {
                    const esHoy = cita.fecha_hora_formato_slot.includes(fechaHoyStr);
                    const diaKey = esHoy ? 'hoy' : 'manana';
                    const argDia = esHoy ? 'hoy' : 'mañana'; // String corregido para WhatsApp
                    
                    const estadoLower = cita.estado ? cita.estado.toLowerCase() : 'pendiente';
                    
                    // Sumamos al contador del día que corresponda
                    if (estadoLower === 'pendiente') resumenAgenda[diaKey].pendientes++;
                    else if (estadoLower === 'confirmado' || estadoLower === 'confirmada') resumenAgenda[diaKey].confirmadas++;
                    else if (estadoLower === 'completada' || estadoLower === 'en_atencion') resumenAgenda[diaKey].atendidos++;
                    else if (estadoLower === 'no_asiste') resumenAgenda[diaKey].noAsistieron++;

                    resumenAgenda[diaKey].total++;

                    const pctName = cita.paciente_nombre_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.nombre_completo : 'Paciente');
                    const pctTel = cita.paciente_telefono_manual || (cita.perfiles_pacientes ? cita.perfiles_pacientes.telefono : '');
                    const horaSolo = cita.fecha_hora_formato_slot.split('-')[1]?.trim() || cita.fecha_hora_formato_slot;
                    
                    let estadoLabel = 'Por Confirmar';
                    let colorBadge = 'background:#fff7ed; color:#d97706; border-color:#fde68a;'; 
                    let borderIzquierdo = 'var(--pixar-orange)';
                    let opacidad = "1";

                    if (estadoLower === 'confirmado' || estadoLower === 'confirmada') {
                        estadoLabel = 'Confirmado';
                        colorBadge = 'background:#f0fdf4; color:#16a34a; border-color:#bbf7d0;'; 
                        borderIzquierdo = 'var(--green-success)';
                    } else if (estadoLower === 'completada' || estadoLower === 'en_atencion') {
                        estadoLabel = estadoLower === 'en_atencion' ? 'En Curso' : 'Atendido';
                        colorBadge = 'background:#eff6ff; color:#3b82f6; border-color:#bfdbfe;'; 
                        borderIzquierdo = '#3b82f6';
                        if (estadoLower === 'completada') opacidad = "0.6"; 
                    } else if (estadoLower === 'no_asiste') {
                        estadoLabel = 'No Asistió';
                        colorBadge = 'background:#fef2f2; color:#ef4444; border-color:#fecaca;'; 
                        borderIzquierdo = 'var(--red-urgency)';
                        opacidad = "0.5"; 
                    }

                    // CORRECCIÓN WHATSAPP: Le pasamos 'hoy' o 'mañana' en lugar de true/false
                    let btnRecordatorioHTML = "";
                    if ((estadoLower === 'confirmado' || estadoLower === 'confirmada' || estadoLower === 'pendiente') && pctTel) {
                        btnRecordatorioHTML = `
                            <button class="btn-pixar" style="background:#25d366; display:inline-flex; align-items:center; gap:5px; margin-top:8px; padding:6px 12px; font-size:0.8rem; border:none; box-shadow: 0 2px 5px rgba(37,211,102,0.2);" 
                                onclick="enviarRecordatorioWhatsApp('${pctName}', '${pctTel.replace(/[^0-9]/g, '')}', '${horaSolo}', '${argDia}')">
                                <span class="material-symbols-outlined" style="font-size:1rem;">chat</span> Recordar Cita
                            </button>
                        `;
                    }

                    // Insertamos la tarjeta en el HTML del día que le corresponde
                    resumenAgenda[diaKey].html += `
                        <div class="appointment-card" style="opacity: ${opacidad}; border-left-color: ${borderIzquierdo};">
                            <div class="appointment-time" style="display: flex; flex-direction: column; justify-content: center;">
                                ${horaSolo}
                            </div>
                            <div class="appointment-info" style="flex:1; margin-left: 20px;">
                                <h4 style="margin:0 0 5px 0; color: var(--blue-elegant); font-size: 1.1rem;">${pctName}</h4>
                                <p style="margin:0; font-size:0.9rem; color:#64748b; font-weight: 500;">${cita.motivo || 'Consulta General'}</p>
                                ${btnRecordatorioHTML}
                            </div>
                            <div class="appointment-status">
                                <span class="badge-status-verificado" style="padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; border: 1px solid; ${colorBadge}">
                                    ${estadoLabel}
                                </span>
                            </div>
                        </div>
                    `;
                });

                // Cargamos por defecto la vista de HOY
                cambiarVistaDia('hoy');

            } catch (err) {
                console.error("Error al cargar la jornada:", err);
            }
        }

        // --- Controlador del Carrusel/Pestañas ---
        function cambiarVistaDia(dia) {
            // Actualizar botones UI
            document.getElementById('tabHoy').classList.toggle('active', dia === 'hoy');
            document.getElementById('tabManana').classList.toggle('active', dia === 'manana');

            // Mostrar la lista correspondiente
            document.getElementById('listaHoy').classList.toggle('active', dia === 'hoy');
            document.getElementById('listaManana').classList.toggle('active', dia === 'manana');

            const datos = resumenAgenda[dia];
            const diaTexto = dia === 'hoy' ? 'hoy' : 'mañana';

            // Actualizar Título
            document.getElementById('tituloListaCitas').innerHTML = `<span class="material-symbols-outlined">calendar_today</span> Pacientes de ${diaTexto.charAt(0).toUpperCase() + diaTexto.slice(1)}`;

            // Actualizar Contadores Widgets
            document.getElementById('dashConfirmedCount').innerText = datos.confirmadas;
            document.getElementById('dashPendingCount').innerText = datos.pendientes;
            if(document.getElementById('dashCompletedCount')) document.getElementById('dashCompletedCount').innerText = datos.atendidos;
            if(document.getElementById('dashNoShowCount')) document.getElementById('dashNoShowCount').innerText = datos.noAsistieron;

            // Actualizar Frase Motivacional
            let mensajeJornada = "";
            if (datos.total === 0) {
                mensajeJornada = `Tienes tu agenda despejada para ${diaTexto}. Un respiro excelente para planificar.`;
            } else if (datos.confirmadas === 0 && datos.pendientes === 0 && datos.atendidos > 0) {
                mensajeJornada = `¡Jornada finalizada con éxito! Has atendido a *${datos.atendidos} pacientes* ${diaTexto}.`;
            } else {
                mensajeJornada = `Para ${diaTexto} coordinas un total de *${datos.total} pacientes* (*${datos.atendidos} ya atendidos* y *${datos.confirmadas} próximos*). ¡Éxito en tu turno!`;
            }
            document.getElementById('dashMotivationalQuote').innerHTML = mensajeJornada;

            // Inyectar HTML o mensaje vacío
            const listaEl = document.getElementById(dia === 'hoy' ? 'listaHoy' : 'listaManana');
            if(datos.html !== "") {
                listaEl.innerHTML = datos.html;
            } else {
                listaEl.innerHTML = `<p style="color: #94a3b8; padding: 30px 20px; background: white; border-radius: 15px; text-align: center; border: 1px dashed #cbd5e1; font-weight: bold;">No tienes citas registradas para ${diaTexto}.</p>`;
            }
        }

        // ==========================================
        // MOTOR ENVIAR RECORDATORIO WHATSAPP CORREGIDO
        // ==========================================
        function enviarRecordatorioWhatsApp(nombrePaciente, telefonoPaciente, horaCita, fechaCita = "hoy") {
            if(!telefonoPaciente) return alert("El paciente no registra un teléfono válido.");
            
            const telLimpio = telefonoPaciente.replace(/[^0-9]/g, '');
            
            // Evaluamos correctamente la variable string que ahora enviamos
            const textoDia = (fechaCita === 'mañana' || fechaCita === 'manana') ? "el día de mañana" : "el día de hoy";
            
            const mensaje = `Hola ${nombrePaciente}, te escribimos de ${centroMedicoOficial} para recordarte tu cita agendada para ${textoDia} a las ${horaCita}. Te solicitamos puntualidad para resguardar los tiempos de tu atención. ¡Nos vemos pronto!`;
            
            window.open(`https://wa.me/${telLimpio}?text=${encodeURIComponent(mensaje)}`, '_blank');
        }

        // ==========================================
        // VALIDAR PIN INTERCONSULTA
        // ==========================================
        async function validarPinInterconsulta() {
            const pin = document.getElementById('pinInterconsulta').value.trim().toUpperCase();
            if(pin.length < 6) return alert("Por favor ingresa el PIN completo de 6 dígitos.");

            const btn = document.getElementById('btnDesbloquearPin');
            btn.innerText = "Verificando..."; btn.disabled = true;

            try {
                const { data, error } = await window.midental.from('interconsultas').select('paciente_id, id').eq('token_pin', pin).single();
                if (error || !data) throw new Error("Código PIN no válido o ya expirado.");

                const userId = localStorage.getItem('midental_user_id');
                await window.midental.from('interconsultas').update({ estado: 'abierto', dentista_destino_id: userId }).eq('id', data.id);

                alert("🔓 Ficha clínica desbloqueada con éxito.");
                window.location.href = `ficha-paciente.html?paciente=${data.paciente_id}`;
            } catch (err) {
                alert(err.message);
                btn.innerText = "Desbloquear Ficha"; btn.disabled = false;
            }
        }
        // =========================================================
        // MÓDULO FINANCIERO: INGRESOS DEL DÍA Y DEL MES (NETO)
        // =========================================================
        let cacheFinanzasMes = { brutos: 0, lab: 0, conv: 0, neto: 0 };

        async function cargarWidgetsFinancieros() {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) return;

            const hoy = new Date();
            // Rangos ISO en hora local: [inicio, fin)
            const inicioDia = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()).toISOString();
            const finDia    = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + 1).toISOString();
            const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1).toISOString();
            const finMes    = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 1).toISOString();

            try {
                // 1) Pagos del día
                const { data: pagosDia, error: errDia } = await window.midental.from('pagos')
                    .select('monto')
                    .eq('dentista_id', userId)
                    .gte('fecha_pago', inicioDia)
                    .lt('fecha_pago', finDia);
                if (errDia) throw errDia;

                const totalDia = (pagosDia || []).reduce((acc, p) => acc + parseFloat(p.monto || 0), 0);
                document.getElementById('dashIngresosDia').innerText = '$ ' + totalDia.toLocaleString('es-CL');
                document.getElementById('dashIngresosDiaCount').innerText = `${(pagosDia || []).length} pago(s) hoy`;

                // 2) Pagos del mes (brutos)
                const { data: pagosMes, error: errMes } = await window.midental.from('pagos')
                    .select('monto')
                    .eq('dentista_id', userId)
                    .gte('fecha_pago', inicioMes)
                    .lt('fecha_pago', finMes);
                if (errMes) throw errMes;

                const brutosMes = (pagosMes || []).reduce((acc, p) => acc + parseFloat(p.monto || 0), 0);

                // 3) Gastos de laboratorio del mes
                const { data: gastosLab } = await window.midental.from('pagos_laboratorio')
                    .select('monto')
                    .eq('dentista_id', userId)
                    .gte('fecha_gasto', inicioMes)
                    .lt('fecha_gasto', finMes);
                const totalLab = (gastosLab || []).reduce((acc, g) => acc + parseFloat(g.monto || 0), 0);

                // 4) Convenios activos -> comisión total sobre (brutos - lab)
                const { data: convenios } = await window.midental.from('convenios_centros_medicos')
                    .select('porcentaje')
                    .eq('dentista_id', userId)
                    .eq('activo', true);

                const postLab = Math.max(0, brutosMes - totalLab);
                const totalConv = (convenios || []).reduce(
                    (acc, c) => acc + (postLab * (parseFloat(c.porcentaje || 0) / 100)), 0
                );
                const netoMes = postLab - totalConv;

                cacheFinanzasMes = { brutos: brutosMes, lab: totalLab, conv: totalConv, neto: netoMes };

                document.getElementById('dashIngresosNetoMes').innerText = '$ ' + Math.round(netoMes).toLocaleString('es-CL');
                document.getElementById('dashIngresosBrutoMes').innerText =
                    `Bruto: $${brutosMes.toLocaleString('es-CL')} · Lab: $${totalLab.toLocaleString('es-CL')} · Conv: $${Math.round(totalConv).toLocaleString('es-CL')}`;
            } catch (err) {
                console.error("Error al cargar widgets financieros:", err);
            }
        }

        async function abrirModalFinanzasMes() {
            const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
            const hoy = new Date();
            document.getElementById('lblMesActualFinanzas').innerText = `Mes de ${meses[hoy.getMonth()]} ${hoy.getFullYear()}`;
            document.getElementById('modalFinanzasMes').style.display = 'flex';
            await refrescarPanelFinanzas();
        }

        function cerrarModalFinanzas() {
            document.getElementById('modalFinanzasMes').style.display = 'none';
        }

        async function refrescarPanelFinanzas() {
            await cargarWidgetsFinancieros(); // recalcula cache global
            await cargarListaLaboratorio();
            await cargarListaConvenios();

            document.getElementById('finBrutos').innerText    = '$' + cacheFinanzasMes.brutos.toLocaleString('es-CL');
            document.getElementById('finLabTotal').innerText  = '$' + cacheFinanzasMes.lab.toLocaleString('es-CL');
            document.getElementById('finConvTotal').innerText = '$' + Math.round(cacheFinanzasMes.conv).toLocaleString('es-CL');
            document.getElementById('finNetoTotal').innerText = '$' + Math.round(cacheFinanzasMes.neto).toLocaleString('es-CL');
        }

        // -------- Laboratorio (gastos del dentista) --------
        async function cargarListaLaboratorio() {
            const userId = localStorage.getItem('midental_user_id');
            const cont = document.getElementById('listaLaboratorio');
            const hoy = new Date();
            const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1).toISOString();
            const finMes    = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 1).toISOString();

            try {
                const { data, error } = await window.midental.from('pagos_laboratorio')
                    .select('*')
                    .eq('dentista_id', userId)
                    .gte('fecha_gasto', inicioMes)
                    .lt('fecha_gasto', finMes)
                    .order('fecha_gasto', { ascending: false });
                if (error) throw error;

                if (!data || data.length === 0) {
                    cont.innerHTML = '<p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin gastos de laboratorio este mes.</p>';
                    return;
                }

                cont.innerHTML = data.map(g => `
                    <div style="display: flex; justify-content: space-between; align-items: center; background: #fff7ed; border: 1px solid #fde68a; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px;">
                        <div>
                            <strong style="color: var(--pixar-orange); font-size: 0.9rem;">${g.descripcion}</strong>
                            <small style="display: block; color: #92400e; font-size: 0.75rem;">${new Date(g.fecha_gasto).toLocaleDateString('es-CL')}</small>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <strong style="color: var(--pixar-orange); font-size: 1rem;">$${parseFloat(g.monto).toLocaleString('es-CL')}</strong>
                            <button onclick="eliminarGastoLaboratorio('${g.id}')" style="background: transparent; border: none; cursor: pointer; color: var(--red-urgency);" title="Eliminar">
                                <span class="material-symbols-outlined" style="font-size: 1.1rem;">delete</span>
                            </button>
                        </div>
                    </div>
                `).join('');
            } catch (err) {
                console.error("Error cargando gastos de laboratorio:", err);
            }
        }

        async function agregarGastoLaboratorio() {
            const userId = localStorage.getItem('midental_user_id');
            const descripcion = document.getElementById('labDescripcion').value.trim();
            const monto = parseFloat(document.getElementById('labMonto').value);
            if (!descripcion || isNaN(monto) || monto <= 0) {
                return alert("Ingresa una descripción y un monto válido (> 0).");
            }
            try {
                const { error } = await window.midental.from('pagos_laboratorio').insert([{
                    dentista_id: userId, descripcion, monto
                }]);
                if (error) throw error;
                document.getElementById('labDescripcion').value = '';
                document.getElementById('labMonto').value = '';
                await refrescarPanelFinanzas();
            } catch (err) {
                alert("Error al guardar gasto: " + err.message);
            }
        }

        async function eliminarGastoLaboratorio(id) {
            if (!confirm("¿Eliminar este gasto de laboratorio?")) return;
            try {
                const { error } = await window.midental.from('pagos_laboratorio').delete().eq('id', id);
                if (error) throw error;
                await refrescarPanelFinanzas();
            } catch (err) {
                alert("Error al eliminar: " + err.message);
            }
        }

        // -------- Convenios con centros médicos --------
        async function cargarListaConvenios() {
            const userId = localStorage.getItem('midental_user_id');
            const cont = document.getElementById('listaConvenios');

            try {
                const { data, error } = await window.midental.from('convenios_centros_medicos')
                    .select('*')
                    .eq('dentista_id', userId)
                    .eq('activo', true)
                    .order('created_at', { ascending: false });
                if (error) throw error;

                if (!data || data.length === 0) {
                    cont.innerHTML = '<p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin convenios configurados.</p>';
                    return;
                }

                const postLab = Math.max(0, cacheFinanzasMes.brutos - cacheFinanzasMes.lab);
                cont.innerHTML = data.map(c => {
                    const comision = postLab * (parseFloat(c.porcentaje) / 100);
                    return `
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px;">
                            <div>
                                <strong style="color: var(--red-urgency); font-size: 0.9rem;">${c.nombre_centro}</strong>
                                <small style="display: block; color: #991b1b; font-size: 0.75rem;">Cobra ${c.porcentaje}% sobre ingresos post laboratorio</small>
                            </div>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <strong style="color: var(--red-urgency); font-size: 1rem;">$${Math.round(comision).toLocaleString('es-CL')}</strong>
                                <button onclick="eliminarConvenio('${c.id}')" style="background: transparent; border: none; cursor: pointer; color: var(--red-urgency);" title="Eliminar">
                                    <span class="material-symbols-outlined" style="font-size: 1.1rem;">delete</span>
                                </button>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                console.error("Error cargando convenios:", err);
            }
        }

        async function agregarConvenio() {
            const userId = localStorage.getItem('midental_user_id');
            const nombre = document.getElementById('convNombre').value.trim();
            const porcentaje = parseFloat(document.getElementById('convPorcentaje').value);
            if (!nombre || isNaN(porcentaje) || porcentaje < 0 || porcentaje > 100) {
                return alert("Ingresa un nombre y un porcentaje entre 0 y 100.");
            }
            try {
                const { error } = await window.midental.from('convenios_centros_medicos').insert([{
                    dentista_id: userId, nombre_centro: nombre, porcentaje, activo: true
                }]);
                if (error) throw error;
                document.getElementById('convNombre').value = '';
                document.getElementById('convPorcentaje').value = '';
                await refrescarPanelFinanzas();
            } catch (err) {
                alert("Error al guardar convenio: " + err.message);
            }
        }

        async function eliminarConvenio(id) {
            if (!confirm("¿Eliminar este convenio? Dejará de descontarse del cálculo neto.")) return;
            try {
                const { error } = await window.midental.from('convenios_centros_medicos').delete().eq('id', id);
                if (error) throw error;
                await refrescarPanelFinanzas();
            } catch (err) {
                alert("Error al eliminar: " + err.message);
            }
        }

        // FORZAR SINCRONIZACIÓN PROFESIONAL
async function validarSesionActiva() {
    const userId = localStorage.getItem('midental_user_id');
    if (!userId) return;

    try {
        // Consultamos la base de datos para ver si el dentista aún existe y está activo
        const { data, error } = await window.midental
            .from('perfiles_dentistas')
            .select('id')
            .eq('id', userId)
            .single();

        if (error || !data) {
            // Si la base de datos dice que no existe, cerramos sesión por seguridad
            console.warn("Sesión invalidada en servidor.");
            window.cerrarSesionLocal();
        } else {
            console.log("Sesión validada exitosamente con el servidor.");
            // Opcional: Aquí podrías refrescar datos clave si los hubiera
        }
    } catch (err) {
        console.error("Error validando sesión:", err);
    }
}
    </script>
</body>
</html>
