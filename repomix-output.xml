            const { data: sedes } = await window.midental.from('sedes_dentistas').select('nombre_sede, direccion, comuna').eq('dentista_id', dentistaId).limit(1);

            const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo}` : 'No especificado';
            const drRut = dr ? dr.rut : '--';
            const drSis = dr ? dr.registro_sis : '--';
            const drSede = (sedes && sedes.length > 0) ? `${sedes[0].direccion}, ${sedes[0].comuna}` : 'Atención Particular';
            
            // Lógica para el nombre del centro médico (título del PDF)
            let nombreCentro = 'Presupuesto Dental';
            if (sedes && sedes.length > 0 && sedes[0].nombre_sede && sedes[0].nombre_sede.trim() !== '') {
                nombreCentro = sedes[0].nombre_sede.trim();
            }

            doc.setFontSize(22); doc.setTextColor(0, 180, 216); doc.text("MiDental", 14, 20);
            doc.setFontSize(10); doc.setTextColor(100, 116, 139); doc.text("Red de Salud Digital", 14, 26);
            
            // Se reemplaza "Ficha Clínica y Presupuesto" por el nombre del centro médico
            doc.setFontSize(16); doc.setTextColor(30, 58, 138); doc.text(nombreCentro, 200, 20, { align: "right" });
            doc.setFontSize(10); doc.setTextColor(85, 85, 85); doc.text(`Fecha Emisión: ${new Date().toLocaleDateString('es-CL')}`, 200, 26, { align: "right" });
            doc.setDrawColor(200, 200, 200); doc.line(14, 30, 200, 30);

            doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text("Datos del Paciente", 14, 40);
            doc.setFontSize(10); doc.setTextColor(50, 50, 50);
            doc.text(`Nombre: ${pacienteActual.nombre}`, 14, 47); doc.text(`RUT: ${pacienteActual.rut}`, 14, 53);

            doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text("Profesional Tratante", 110, 40);
            doc.setFontSize(10); doc.setTextColor(50, 50, 50);
            doc.text(`Dentista: ${drName}`, 110, 47); doc.text(`RUT: ${drRut} | Registro SIS: ${drSis}`, 110, 53); doc.text(`Sede: ${drSede}`, 110, 59);

            // ==========================================
            // SE ELIMINÓ LA EVOLUCIÓN CLÍNICA DEL PDF
            // (Motivo, Diagnóstico y Procedimiento ya no se imprimen aquí)
            // ==========================================

            // La tabla comienza directamente debajo de los datos del paciente y profesional
            let tableStartY = 70; 
            const tableColumn = ["Pieza", "Diagnóstico", "Prestación", "Valor Ref.", "Dscto", "Total"];
            const tableRows = [];
            let hayPresupuesto = false;

            document.querySelectorAll('#tbodyPresupuesto tr').forEach(tr => {
                const piezaVal = tr.querySelector('.input-diente').value.trim();
                const diagVal = tr.querySelector('.input-diag').value.trim();
                const tratVal = tr.querySelector('.input-tratamiento').value.trim();
                const refInput = parseFloat(tr.querySelector('.input-ref').value) || 0;
                const descInput = parseFloat(tr.querySelector('.input-desc').value) || 0;
                
                let totalInput = 0;
                const elTotal = tr.querySelector('.input-total');
                if(elTotal.dataset.valorReal) totalInput = parseFloat(elTotal.dataset.valorReal);
                else if (elTotal.value) totalInput = parseFloat(elTotal.value);

                if (!piezaVal && !diagVal && !tratVal && refInput === 0 && totalInput === 0) return;

                hayPresupuesto = true;
                const tdDesc = descInput <= 100 && descInput > 0 ? `${descInput}%` : (descInput > 100 ? `$${descInput.toLocaleString('es-CL')}` : '0%');
                tableRows.push([piezaVal || '-', diagVal || '-', tratVal || '-', `$${refInput.toLocaleString('es-CL')}`, tdDesc, `$${totalInput.toLocaleString('es-CL')}`]);
            });

            if (hayPresupuesto) {
                doc.autoTable({ startY: tableStartY, head: [tableColumn], body: tableRows, theme: 'grid', headStyles: { fillColor: [30, 58, 138] }, styles: { fontSize: 9 } });
                const finalY = doc.lastAutoTable.finalY || tableStartY + 20;
                doc.setFontSize(14); doc.setTextColor(30, 58, 138); doc.text(`TOTAL A PAGAR: $${document.getElementById('granTotalPagar').innerText}`, 200, finalY + 15, { align: "right" });
            }

            const finalPageY = doc.internal.pageSize.height;
            doc.setFontSize(10); doc.setTextColor(0, 0, 0);
            doc.line(30, finalPageY - 30, 90, finalPageY - 30); doc.text("Firma Paciente", 45, finalPageY - 25);
            doc.line(120, finalPageY - 30, 180, finalPageY - 30); doc.text("Firma Profesional", 135, finalPageY - 25);

            return doc;
        }

