        .nav-btn.active { color: var(--pixar-cyan); background: #e6f5ff; }

        .patient-profile-wrapper { max-width: 1000px; margin: 40px auto; display: grid; grid-template-columns: 320px 1fr; gap: 30px; padding: 0 20px; }
