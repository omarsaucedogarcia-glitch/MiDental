                        <div class="token-info-header"><span>Monedero</span><small>Tokens</small></div>
                        <div class="token-balance-header pulse-glow-purple">
                            <span class="material-symbols-outlined">toll</span><strong id="headerTokenBalance">--</strong>
                        </div>
                    </div>
