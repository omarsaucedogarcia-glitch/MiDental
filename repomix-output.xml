    <script>
        // Variables globales de estado del CRM
        let crmData = {
            inversion: 0,
            leads: 0,
            citas: 0,
            tratamientosAceptados: 0,
            tiempoRespuestaHoras: 0,
            motivosRechazo: {},
            totalRechazos: 0
        };

        document.addEventListener('DOMContentLoaded', async () => {
            const userId = localStorage.getItem('midental_user_id');
            if (!userId) {
                window.location.href = '../index.html';
                return;
            }
            await cargarCampanas(userId);
            await cargarDatosCRM();
        });

        async function cargarCampanas(userId) {
            try {
                // Consultamos las ofertas_flash (Campañas)
                const { data: campanas, error } = await window.midental
                    .from('ofertas_flash')
                    .select('id, servicio_nombre')
                    .eq('dentista_id', userId)
                    .order('created_at', { ascending: false });
                
                if (error) throw error;
                
                const selector = document.getElementById('campanaSelector');
                campanas.forEach(campana => {
                    const option = document.createElement('option');
                    option.value = campana.id;
                    option.textContent = campana.servicio_nombre;
                    selector.appendChild(option);
                });
            } catch (error) {
                console.error("Error al cargar campañas:", error);
            }
        }

        async function cargarDatosCRM() {
            const userId = localStorage.getItem('midental_user_id');
            const campanaId = document.getElementById('campanaSelector').value;
            
            // Reiniciar estado
            crmData = { inversion: 0, leads: 0, citas: 0, tratamientosAceptados: 0, tiempoRespuestaHoras: 0, motivosRechazo: {}, totalRechazos: 0 };
            
            try {
                // 1. Obtener Inversión de la campaña (o sumatoria si son todas)
                let queryCampana = window.midental.from('ofertas_flash').select('inversion_clp').eq('dentista_id', userId);
                if (campanaId !== 'todas') queryCampana = queryCampana.eq('id', campanaId);
                
                const { data: campanasData } = await queryCampana;
                if (campanasData) {
                    crmData.inversion = campanasData.reduce((acc, curr) => acc + (Number(curr.inversion_clp) || 0), 0);
                }

                // 2. Obtener Leads y Tiempos de Respuesta
                let queryLeads = window.midental.from('marketing_leads').select('*').eq('dentista_id', userId);
                if (campanaId !== 'todas') queryLeads = queryLeads.eq('oferta_id', campanaId);
                
                const { data: leads } = await queryLeads;
                let leadsSinContacto = 0;

                if (leads && leads.length > 0) {
                    crmData.leads = leads.length;
                    let tiempoTotalMs = 0;
                    let leadsContactados = 0;

                    leads.forEach(lead => {
                        if (lead.cita_id) crmData.citas++;
                        
                        if (lead.contactado_at && lead.created_at) {
                            const creado = new Date(lead.created_at);
                            const contactado = new Date(lead.contactado_at);
                            tiempoTotalMs += (contactado - creado);
                            leadsContactados++;
                        } else if (lead.estado === 'nuevo') {
                            leadsSinContacto++;
                        }
                    });

                    if (leadsContactados > 0) {
                        // Promedio en horas
                        crmData.tiempoRespuestaHoras = (tiempoTotalMs / leadsContactados) / (1000 * 60 * 60);
                    }
                }

                // 3. Obtener Presupuestos (Aceptados y Rechazados)
                let queryPresupuestos = window.midental.from('presupuestos_crm').select('estado, motivo_rechazo').eq('dentista_id', userId);
                const { data: presupuestos } = await queryPresupuestos;

                if (presupuestos) {
                    presupuestos.forEach(pres => {
                        if (pres.estado === 'aceptado') {
                            crmData.tratamientosAceptados++;
                        } else if (pres.estado === 'rechazado' && pres.motivo_rechazo) {
                            crmData.totalRechazos++;
                            crmData.motivosRechazo[pres.motivo_rechazo] = (crmData.motivosRechazo[pres.motivo_rechazo] || 0) + 1;
                        }
                    });
                }

                actualizarUI(leadsSinContacto);

            } catch (error) {
                console.error("Error cargando CRM:", error);
            }
        }

        function actualizarUI(leadsSinContacto) {
            // Actualizar KPIs Superiores
            const cpl = crmData.leads > 0 ? (crmData.inversion / crmData.leads) : 0;
            document.getElementById('statCPL').innerText = '$' + Math.round(cpl).toLocaleString('es-CL');
            document.getElementById('statInversion').innerText = '$' + crmData.inversion.toLocaleString('es-CL');
            document.getElementById('statTiempoRespuesta').innerText = crmData.tiempoRespuestaHoras.toFixed(1) + ' hrs';

            // Actualizar Embudo
            document.getElementById('funnelLeads').innerText = crmData.leads;
            document.getElementById('funnelCitas').innerText = crmData.citas;
            document.getElementById('funnelTratamientos').innerText = crmData.tratamientosAceptados;

            // Actualizar Eficiencia
            const tasaLeadCita = crmData.leads > 0 ? Math.round((crmData.citas / crmData.leads) * 100) : 0;
            const tasaCierre = crmData.citas > 0 ? Math.round((crmData.tratamientosAceptados / crmData.citas) * 100) : 0;
            
            document.getElementById('tasaLeadCita').innerText = `${tasaLeadCita}%`;
            document.getElementById('tasaCierre').innerText = `${tasaCierre}%`;
            document.getElementById('leadsSinContacto').innerText = leadsSinContacto;

            // Renderizar Rechazos
            const contenedorRechazos = document.getElementById('listaRechazos');
            contenedorRechazos.innerHTML = '';
            
            const motivosOrdenados = Object.entries(crmData.motivosRechazo).sort((a, b) => b[1] - a[1]);
            
            if (motivosOrdenados.length > 0) {
                motivosOrdenados.forEach(([motivo, cantidad]) => {
                    const porcentaje = Math.round((cantidad / crmData.totalRechazos) * 100);
                    // Normalizar el texto del motivo
                    const motivoLabel = motivo.charAt(0).toUpperCase() + motivo.slice(1);
                    
                    contenedorRechazos.innerHTML += `
                        <div class="rejection-item">
                            <span style="width: 80px; font-weight: bold; color: var(--text-dark); font-size: 0.9rem;">${motivoLabel}</span>
                            <div class="rejection-bar-container">
                                <div class="rejection-bar" style="width: ${porcentaje}%;"></div>
                            </div>
                            <span style="width: 40px; text-align: right; color: var(--text-light); font-size: 0.85rem;">${porcentaje}%</span>
                        </div>
                    `;
                });
            } else {
                contenedorRechazos.innerHTML = '<p style="color: #94a3b8; text-align: center; margin-top: 20px;">Sin presupuestos rechazados registrados.</p>';
            }

            document.getElementById('iaResultado').style.display = 'none';
        }

        function generarEstrategiaCRM_IA() {
            const panel = document.getElementById('iaResultado');
            panel.style.display = 'block';
            panel.innerHTML = '<span class="material-symbols-outlined spin-icon" style="vertical-align: middle;">sync</span> Evaluando embudo comercial...';
            
            setTimeout(() => {
                // Obtener el motivo de rechazo principal para personalizar el prompt
                const motivos = Object.entries(crmData.motivosRechazo).sort((a, b) => b[1] - a[1]);
                const principalObjecion = motivos.length > 0 ? motivos[0][0] : "indefinido";
                
                const cplFormat = Math.round(crmData.leads > 0 ? (crmData.inversion / crmData.leads) : 0).toLocaleString('es-CL');

                const promptGenerado = 
`--- DIAGNÓSTICO CRM Y ESTRATEGIA DE RETARGETING ---

📊 ANÁLISIS DE EFICIENCIA:
- Costo de Adquisición (CPL): $${cplFormat} CLP por prospecto.
- Velocidad de Contacto: ${crmData.tiempoRespuestaHoras.toFixed(1)} horas. 
  *(Tip IA: Bajar este tiempo a menos de 1 hora incrementa la tasa de agendamiento en un 40%).*
- Fuga de Embudo Principal: ${crmData.citas > 0 ? 'De Cita a Tratamiento' : 'De Lead a Cita'}.

🎯 ACCIONES AUTOMATIZADAS RECOMENDADAS:

1. RECUPERACIÓN DE PRESUPUESTOS (Retargeting):
La objeción principal detectada es "${principalObjecion}". 
Acción: Activa una campaña de WhatsApp/Emailing dirigida a los ${crmData.totalRechazos} pacientes que no cerraron, enviando el siguiente mensaje:
"Hola, sabemos que tu salud dental es importante. Si el [${principalObjecion}] fue un impedimento para tu tratamiento de rehabilitación, en MiDental hemos habilitado nuevas opciones de financiamiento hasta en 6 cuotas sin interés. ¿Te gustaría re-evaluarlo?"

2. OPTIMIZACIÓN DE CAMPAÑA:
Con una tasa de cierre de ${document.getElementById('tasaCierre').innerText}, la calidad clínica es excelente, pero la conversión inicial requiere ajustes. Reduce tu CPL actual segmentando tus anuncios hacia el "Paciente Ideal" calculado por el sistema (pacientes 35-50 años, interés en estética dental y tecnología).`;

                panel.innerHTML = promptGenerado;
            }, 1500);
        }
    </script>
