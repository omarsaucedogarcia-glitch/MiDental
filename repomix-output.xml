        async function guardarEdicionPagoAuditable() {
            const idPago = document.getElementById('editPagoId').value;
            const montoOriginal = parseFloat(document.getElementById('editPagoMontoOriginal').value);
            const nuevoMonto = parseFloat(document.getElementById('editPagoMonto').value);
            const nuevoMedio = document.getElementById('editPagoMedio').value;
            const motivoCambio = document.getElementById('editPagoNotas').value.trim();
            const notasPrevias = document.getElementById('modalEditarPagoFicha').dataset.notasPrevias || '';

            if (isNaN(nuevoMonto) || nuevoMonto < 0) return alert("Ingresa un monto válido.");
            if (!motivoCambio) return alert("Por favor, ingresa el motivo de la corrección para el registro de auditoría.");

            const btn = document.getElementById('btnGuardarEdicionPago');
            btn.disabled = true; 
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Guardando...';

            try {
                // Construcción de la nota de auditoría
                const fechaAuditoria = new Date().toLocaleDateString('es-CL');
                let notaAuditable = `[EDITADO ${fechaAuditoria}] Motivo: ${motivoCambio} (Monto previo: $${montoOriginal.toLocaleString('es-CL')})`;
                
                // Si el pago ya tenía notas antes, las concatenamos para no perder esa información
                if (notasPrevias && !notasPrevias.includes('[EDITADO')) {
                    notaAuditable += ` | Nota original: ${notasPrevias}`;
                } else if (notasPrevias && notasPrevias.includes('[EDITADO')) {
                    // Si ya había sido editado antes, mantenemos todo el historial de ediciones
                    notaAuditable += ` || ${notasPrevias}`; 
                }

                const { error } = await window.midental.from('pagos').update({
                    monto: nuevoMonto,
                    medio_pago: nuevoMedio,
                    notas: notaAuditable
                }).eq('id', idPago);

                if (error) throw error;

                document.getElementById('modalEditarPagoFicha').style.display = 'none';
                
                // Al recargar el control de presupuesto se dispara cargarHistorialPagos() 
                // y se actualiza la vista (statSaldoRestante, statTotalPagado)
                await cargarControlPresupuesto();
                
                // Disparamos un evento personalizado por si necesitas que el dashboard se actualice al volver
                document.dispatchEvent(new CustomEvent('pago:actualizado'));
                
                if (typeof mostrarToastFicha === 'function') {
                    mostrarToastFicha('✓ Corrección registrada con auditoría.');
                } else {
                    alert("✅ Corrección registrada exitosamente. El cambio ha quedado guardado en el historial.");
                }

            } catch (err) {
                alert("Error al actualizar el pago: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined" style="vertical-align: middle;">save_as</span> Registrar Corrección';
            }
        }

