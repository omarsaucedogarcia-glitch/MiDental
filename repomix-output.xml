    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        // ==========================================
        // 1. CONTROL DE SEGURIDAD Y ACCESO INTELIGENTE
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            // Verificamos si es la primera vez que se abre el navegador en esta jornada
            if (!sessionStorage.getItem('sesion_validada_hoy')) {
                
                // Limpieza profunda de seguridad: Borramos credenciales antiguas
                localStorage.removeItem('midental_user_id');
                localStorage.removeItem('midental_user_tipo');
                localStorage.removeItem('midental_user_name');
                localStorage.removeItem('midental_paciente_rut'); // Nos aseguramos de limpiar el RUT también
                if (window.midental) window.midental.auth.signOut(); // Cierra sesión en Supabase
                
                // Marcamos que esta pestaña ya fue higienizada
                sessionStorage.setItem('sesion_validada_hoy', 'true');
            }
            // Eliminamos la redirección forzada de esta sección para evitar el "Efecto Bucle" al presionar Atrás.
        });

        
        // ==========================================
        // 2. BUSCADOR INTELIGENTE EN EL HERO
        // ==========================================
        function ejecutarBusquedaInicial() {
            const especialidad = document.getElementById('searchEspecialidad').value.trim();
            const ubicacion = document.getElementById('searchUbicacion').value.trim();
            
            // Unimos los términos para enviarlos al mapa
            const query = `${especialidad} ${ubicacion}`.trim();
            
            if (query !== "") {
                window.location.href = `mapa-paciente.html?filtro=${encodeURIComponent(query)}`;
            } else {
                window.location.href = 'mapa-paciente.html';
            }
        }

        // ==========================================
        // 3. REGISTRO Y CREADOR DE PERFILES FAMILIARES (PACIENTE)
        // ==========================================
        async function procesarRegistroPaciente(e) {
            e.preventDefault();
            const form = document.getElementById('formRegistroPaciente');
            if(!form.checkValidity()) { form.reportValidity(); return; }

            const pwd1 = document.getElementById('regPacientePassword').value;
            const pwd2 = document.getElementById('regPacientePasswordConfirm').value;
            const emailOriginal = document.getElementById('regPacienteEmail').value.trim();
            const rutInput = document.getElementById('regPacienteRUT').value.trim();
            const nombreInput = document.getElementById('regPacienteNombre').value.trim();
            const telefonoInput = document.getElementById('regPacienteTelefono').value.trim();
            
            // NUEVO: Verificamos si es extranjero para no romper el formato del pasaporte
            const isExtranjero = document.getElementById('chkExtranjero').checked;
            const rutLimpio = isExtranjero ? rutInput : window.formatearRutEstricto(rutInput);

            if (pwd1 !== pwd2) return alert("Las contraseñas no coinciden.");

            const btn = document.querySelector('button[form="formRegistroPaciente"]');
            const textoBtn = btn.innerText;
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite; vertical-align: middle;">sync</span> Validando...';
            btn.disabled = true;

            let currentUserId = null;

            // FASE 1: Autenticación (Registro o Login Familiar)
            try {
                // Le devolvemos los metadatos al signUp para evitar el Error 500 del servidor
                const { data: authData, error: authError } = await window.midental.auth.signUp({
                    email: emailOriginal,
                    password: pwd1,
                    options: { 
                        data: { 
                            tipo_usuario: 'paciente', 
                            rut_usuario: rutLimpio, 
                            nombre_completo: nombreInput, 
                            telefono: telefonoInput.replace(/[^0-9]/g, '') 
                        } 
                    }
                });

                if (authError) throw authError;
                currentUserId = authData.user.id;
                
            } catch (error) {
                const msg = String(error.message || "").toLowerCase();
                const isAlreadyRegistered = error.status === 422 || msg.includes("already") || msg.includes("regist");

                if (isAlreadyRegistered) {
                    console.log("Correo existente detectado. Validando contraseña para anexar perfil familiar...");
                    
                    const { data: signData, error: signError } = await window.midental.auth.signInWithPassword({
                        email: emailOriginal,
                        password: pwd1
                    });

                    if (signError) {
                        alert("⚠️ Este correo ya pertenece a una cuenta de MiDental. Debes ingresar la misma contraseña original de esa cuenta para poder agregar esta nueva ficha de paciente.");
                        btn.innerHTML = textoBtn;
                        btn.disabled = false;
                        return; 
                    }
                    
                    currentUserId = signData.user.id;
                } else {
                    alert("Error de registro: " + (error.message || "Intenta nuevamente."));
                    btn.innerHTML = textoBtn;
                    btn.disabled = false;
                    return;
                }
            }

            // FASE 2: Creación/Actualización Segura de la Ficha Médica (Dos Pasos)
            try {
                btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite; vertical-align: middle;">sync</span> Creando Ficha...';
                
                // Paso 2A: Verificamos si el dentista ya le había creado una ficha a este RUT
                const { data: perfilExistente } = await window.midental
                    .from('perfiles_pacientes')
                    .select('id')
                    .eq('rut', rutLimpio)
                    .maybeSingle();

                if (perfilExistente) {
                    // Paso 2B (Actualizar): Si existe, lo actualizamos respetando su ID original
                    const { error: updateError } = await window.midental
                        .from('perfiles_pacientes')
                        .update({
                            user_id: currentUserId,
                            email: emailOriginal,
                            nombre_completo: nombreInput,
                            telefono: telefonoInput.replace(/[^0-9]/g, '')
                        })
                        .eq('id', perfilExistente.id);

                    if (updateError) throw updateError;
                } else {
                    // Paso 2B (Insertar): Si es un paciente 100% nuevo, lo creamos
                    const { error: insertError } = await window.midental
                        .from('perfiles_pacientes')
                        .insert([{
                            user_id: currentUserId,
                            rut: rutLimpio,
                            email: emailOriginal,
                            nombre_completo: nombreInput,
                            telefono: telefonoInput.replace(/[^0-9]/g, ''),
                            enfermedades_cronicas: 'Ninguna',
                            medicamentos: 'Ninguno',
                            alergias: 'Ninguna'
                        }]);

                    if (insertError) throw insertError;
                }

                // FASE 3: Éxito y Redirección
                localStorage.setItem('midental_user_id', currentUserId);
                localStorage.setItem('midental_user_tipo', 'paciente');
                localStorage.setItem('midental_user_name', nombreInput);
                localStorage.setItem('midental_paciente_rut', rutLimpio);

                alert("✅ ¡Perfil configurado con éxito! Bienvenido a MiDental.");
                window.location.href = 'dashboard-paciente.html';

            } catch (error) {
                console.error("Error en base de datos:", error);
                alert("Hubo un problema al guardar la ficha clínica: " + error.message);
                btn.innerHTML = textoBtn;
                btn.disabled = false;
            }
        }
        
        // ==========================================
        // 4. REGISTRO DENTISTAS (Conexión app.js)
        // ==========================================
        function procesarRegistroDentista(e) {
            e.preventDefault();
            const form = document.getElementById('formRegistroDentista');
            if(!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const pwd1 = document.getElementById('regDentistaPassword').value;
            const pwd2 = document.getElementById('regDentistaPasswordConfirm').value;

            if (pwd1 !== pwd2) {
                alert("Las contraseñas no coinciden. Por favor, verifícalas.");
                return;
            }

            if(typeof registrarUsuarioMidental === 'function') {
                registrarUsuarioMidental('dentista');
            } else {
                console.error("Falta enlazar la función registrarUsuarioMidental en app.js");
            }
        }

        // ==========================================
        // 5. FUNCIONES DE MODALES Y UI
        // ==========================================
        function abrirModal(idModal) {
            document.getElementById(idModal).style.display = 'flex';
        }
        function cerrarModal(idModal) {
            document.getElementById(idModal).style.display = 'none';
        }
        function cambiarModal(idCerrar, idAbrir) {
            document.getElementById(idCerrar).style.display = 'none';
            document.getElementById(idAbrir).style.display = 'flex';
        }
        
        function abrirRecuperarPassword() {
            cerrarModal('modalLoginPaciente');
            cerrarModal('modalLoginDentista');
            document.getElementById('recuperarEmail').value = '';
            abrirModal('modalRecuperarPassword');
        }

        async function enviarCorreoRecuperacion() {
            const email = document.getElementById('recuperarEmail').value.trim();
            if (!email) return alert("Por favor, ingresa el correo electrónico asociado a tu cuenta.");

            const btn = document.getElementById('btnEnviarRecuperacion');
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Enviando...'; 
            btn.disabled = true;

            try {
                const { data, error } = await window.midental.auth.resetPasswordForEmail(email, {
                    redirectTo: window.location.origin + '/index.html' 
                });

                if (error) throw error;

                alert("✅ Te hemos enviado un enlace seguro. Revisa tu bandeja de entrada o la carpeta de Spam.");
                cerrarModal('modalRecuperarPassword');

            } catch (error) {
                alert("Error al enviar: Verifica que el correo esté bien escrito y asociado a una cuenta activa.");
            } finally {
                btn.innerText = "Enviar Enlace Seguro"; 
                btn.disabled = false;
            }
        }
        
        // Solución UX: Cierra modales solo si el clic inicia y termina en el fondo oscuro
        let mouseDownTarget = null;
        window.addEventListener('mousedown', (e) => {
            mouseDownTarget = e.target;
        });
        window.addEventListener('mouseup', (e) => {
            if (e.target.classList.contains('modal-overlay') && mouseDownTarget === e.target) {
                e.target.style.display = 'none';
            }
        });

        // FAQ Toggle
        function toggleFAQ(element) {
            const allItems = document.querySelectorAll('.faq-item');
            allItems.forEach(item => {
                if (item !== element) {
                    item.classList.remove('active');
                }
            });
            element.classList.toggle('active');
        }
        // ==========================================
// CONTROL DE UX: CUENTAS FAMILIARES Y EXTRANJEROS
// ==========================================

// Alterna entre RUT chileno y Pasaporte extranjero
function toggleExtranjero() {
    const isExtranjero = document.getElementById('chkExtranjero').checked;
    const inputDoc = document.getElementById('regPacienteRUT');
    
    if (isExtranjero) {
        inputDoc.placeholder = "N° de Pasaporte o Documento de Identidad";
        // Al ser extranjero, limpiamos cualquier formato de RUT previo
        inputDoc.value = inputDoc.value.replace(/[^a-zA-Z0-9]/g, ''); 
    } else {
        inputDoc.placeholder = "RUT (ej: 12.345.678-9)";
        if(typeof formatearRutInput === 'function') formatearRutInput(inputDoc);
    }
}

// Decide si aplica el formateador de RUT según el checkbox
function manejarInputDocumento(input) {
    const isExtranjero = document.getElementById('chkExtranjero').checked;
    if (!isExtranjero && typeof formatearRutInput === 'function') {
        formatearRutInput(input);
    } else {
        // Para extranjeros, permitimos letras y números pero sin formato estricto
        input.value = input.value.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
    }
}

// Cambia los textos si se selecciona cuenta familiar
function toggleTipoCuenta() {
    const isFamiliar = document.querySelector('input[name="tipoCuenta"]:checked').value === 'familiar';
    const alertaFamiliar = document.getElementById('alertaFamiliar');
    const inputNombre = document.getElementById('regPacienteNombre');
    const inputDoc = document.getElementById('regPacienteRUT');

    if (isFamiliar) {
        alertaFamiliar.style.display = 'block';
        inputNombre.placeholder = "Nombre completo del familiar (Ej: Juan Pérez)";
        // Mantenemos el placeholder de RUT pero podemos darle contexto
        if(!document.getElementById('chkExtranjero').checked) {
            inputDoc.placeholder = "RUT del familiar";
        }
    } else {
        alertaFamiliar.style.display = 'none';
        inputNombre.placeholder = "Tu Nombre Completo";
        if(!document.getElementById('chkExtranjero').checked) {
            inputDoc.placeholder = "RUT (ej: 12.345.678-9)";
        }
    }
}
    </script>
</body>
</html>
