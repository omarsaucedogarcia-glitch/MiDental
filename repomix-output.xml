    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const userId = localStorage.getItem('midental_user_id');
            const userTipo = localStorage.getItem('midental_user_tipo');
            const rutActual = localStorage.getItem('midental_paciente_rut'); // 1. Recuperamos el RUT específico

            // Validamos que sea paciente y tenga sesión
            if (!userId || userTipo !== 'paciente' || !rutActual) {
                window.location.href = 'index.html';
                return;
            }

            try {
                // 2. Buscamos al paciente usando la Cuenta Maestra (user_id) + El Familiar (rut)
                const { data: pacienteData, error } = await window.midental
                    .from('perfiles_pacientes')
                    .select('*')
                    .eq('user_id', userId)
                    .eq('rut', rutActual) // Filtro crucial
                    .maybeSingle();       // 3. Evita que el sistema colapse al encontrar más familiares

                if (error || !pacienteData) {
                    console.warn("Ficha clínica no encontrada. Cerrando sesión...");
                    localStorage.clear();
                    window.location.href = 'index.html';
                    return;
                }

                // 4. CORRECCIÓN: Pintamos el nombre usando el ID exacto de tu HTML
                const primerNombre = pacienteData.nombre_completo.split(' ')[0];
                const elementoNombre = document.getElementById('nombrePacienteUi');
                if (elementoNombre) {
                    // Ponemos la primera letra en mayúscula por estética
                    elementoNombre.innerText = primerNombre.charAt(0).toUpperCase() + primerNombre.slice(1).toLowerCase();
                }

                // Aquí puedes continuar cargando el resto de funciones futuras (citas, documentos, etc.)

            } catch (err) {
                console.error("Error validando la sesión del paciente:", err);
            }
        });
    </script>
