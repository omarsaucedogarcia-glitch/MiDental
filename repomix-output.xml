        function abrirModalReceta() {
            document.getElementById('recetaNombrePaciente').innerText = pacienteActual.nombre;
            recetaMedicamentos = []; limpiarFormularioFarmaco(); renderizarListaReceta();
            document.getElementById('modalRecetaMedica').style.display = 'flex';
        }
        function limpiarFormularioFarmaco() {
            document.getElementById('buscadorFarmaco').value = ""; document.getElementById('posCantidad').value = ""; document.getElementById('posFormato').value = "Comprimido(s)";
            document.getElementById('posFrecuencia').value = ""; document.getElementById('posFrecUnidad').value = "Hora(s)"; document.getElementById('posVia').value = "Vía Oral";
            document.getElementById('posDuracion').value = ""; document.getElementById('posDurUnidad').value = "Día(s)"; document.getElementById('posIndicaciones').value = "";
            document.getElementById('listaResultadosFarmacos').style.display = 'none';
        }
        function filtrarVademecum() {
            const query = document.getElementById('buscadorFarmaco').value.toLowerCase();
            const caja = document.getElementById('listaResultadosFarmacos');
            if (query.length < 2) { caja.style.display = 'none'; return; }
            const resultados = vademecumDB.filter(f => f.nombre.toLowerCase().includes(query));
            caja.innerHTML = "";
            if (resultados.length > 0) {
                resultados.forEach(f => {
                    const div = document.createElement('div');
                    div.style.cssText = "padding: 10px 15px; border-bottom: 1px solid #f1f5f9; cursor: pointer; color: #334155; font-size: 0.9rem;";
                    div.innerText = f.nombre;
                    div.onmouseover = () => div.style.background = "#f8fafc"; div.onmouseout = () => div.style.background = "white";
                    div.onclick = () => autocompletarPosologia(f);
                    caja.appendChild(div);
                });
                caja.style.display = 'block';
            } else { caja.style.display = 'none'; }
        }
        function autocompletarPosologia(farmaco) {
            document.getElementById('buscadorFarmaco').value = farmaco.nombre; document.getElementById('posCantidad').value = farmaco.cant; document.getElementById('posFormato').value = farmaco.form;
            document.getElementById('posFrecuencia').value = farmaco.frec; document.getElementById('posFrecUnidad').value = farmaco.funid; document.getElementById('posVia').value = farmaco.via;
            document.getElementById('posDuracion').value = farmaco.dur; document.getElementById('posDurUnidad').value = farmaco.dunid; document.getElementById('posIndicaciones').value = farmaco.ind;
            document.getElementById('listaResultadosFarmacos').style.display = 'none';
        }
        function agregarFarmacoAReceta() {
            const nombre = document.getElementById('buscadorFarmaco').value.trim(); const cant = document.getElementById('posCantidad').value; const form = document.getElementById('posFormato').value;
            const frec = document.getElementById('posFrecuencia').value; const funid = document.getElementById('posFrecUnidad').value; const via = document.getElementById('posVia').value;
            const dur = document.getElementById('posDuracion').value; const dunid = document.getElementById('posDurUnidad').value; const ind = document.getElementById('posIndicaciones').value.trim();
            if (!nombre || !cant || !frec || !dur) return alert("Completa al menos el Fármaco, Cantidad, Frecuencia y Duración.");
            recetaMedicamentos.push({ nombre: nombre, posologia: `${cant} ${form} cada ${frec} ${funid} ${via} durante ${dur} ${dunid}`, indicaciones: ind, id: Date.now() });
            limpiarFormularioFarmaco(); renderizarListaReceta();
        }
        function eliminarFarmacoReceta(id) { recetaMedicamentos = recetaMedicamentos.filter(m => m.id !== id); renderizarListaReceta(); }
        function renderizarListaReceta() {
            const contenedor = document.getElementById('listaFármacosAgregados'); contenedor.innerHTML = "";
            if (recetaMedicamentos.length === 0) { contenedor.innerHTML = '<p style="color: #94a3b8; font-size: 0.9rem; text-align: center; margin-top: 20px;">No has agregado medicamentos a la receta.</p>'; return; }
            recetaMedicamentos.forEach((med, index) => {
                contenedor.innerHTML += `
                    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; margin-bottom: 10px; position: relative;">
                        <button onclick="eliminarFarmacoReceta(${med.id})" style="position: absolute; top: 15px; right: 15px; background: none; border: none; color: #ef4444; cursor: pointer;"><span class="material-symbols-outlined">delete</span></button>
                        <strong style="color: #0f172a; font-size: 1rem;">${index + 1}. ${med.nombre}</strong>
                        <ul style="margin: 5px 0 0 0; padding-left: 20px; color: #475569; font-size: 0.9rem;">
                            <li>${med.posologia}</li>${med.indicaciones ? `<li><em>Nota: ${med.indicaciones}</em></li>` : ''}
                        </ul>
                    </div>`;
            });
        }
        async function emitirYGuardarRecetaPDF() {
            if (recetaMedicamentos.length === 0) return alert("Debes agregar al menos un medicamento a la receta.");
            
            const dentistaId = localStorage.getItem('midental_user_id'); 
            const btn = document.getElementById('btnEmitirReceta');
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Generando...'; 
            btn.disabled = true;
            
            try {
                // 1. Consulta del perfil del profesional y la sede
                const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis, especialidad').eq('id', dentistaId).single();
                const { data: sedes } = await window.midental.from('sedes_dentistas').select('nombre_sede, direccion, comuna').eq('dentista_id', dentistaId).limit(1);
                
                // 2. Inicialización del motor de PDF
                const { jsPDF } = window.jspdf; 
                const doc = new jsPDF();
                
                // 3. Preparación de variables de texto
                const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo.toUpperCase()}` : '';
                const drInfo = dr ? `RUT: ${dr.rut}\nFecha receta: ${new Date().toLocaleDateString('es-CL')}` : '';
                const especialidadDentista = dr && dr.especialidad ? dr.especialidad : 'Odontología - General';

                let nombreCentro = 'Centro Odontológico';
                if (sedes && sedes.length > 0 && sedes[0].nombre_sede && sedes[0].nombre_sede.trim() !== '') {
                    nombreCentro = sedes[0].nombre_sede.trim().toUpperCase();
                }

                // ==========================================
                // 4. NUEVO DISEÑO DEL ENCABEZADO AUTOAJUSTABLE
                // ==========================================
                
                // Reducimos sutilmente el tamaño para soportar nombres largos
                doc.setFontSize(15); 
                doc.setTextColor(0, 180, 216); 
                
                // Límite de contención: Cortamos el texto si supera los 110mm de ancho
                const tituloDividido = doc.splitTextToSize(nombreCentro, 110);
                doc.text(tituloDividido, 14, 20);
                
                // Textos del profesional a la derecha (intactos)
                doc.setFontSize(8); doc.setTextColor(0, 0, 0); 
                doc.text(drName, 200, 16, { align: "right" }); 
                doc.text(drInfo, 200, 20, { align: "right" });
                
                // ==========================================

                // 5. Título Central del Documento
                doc.setFontSize(14); doc.setFont("helvetica", "bold"); 
                doc.text("Receta Médica", 105, 38, { align: "center" });

                // 6. Sección de Datos del Paciente
                doc.setFontSize(12); doc.text("Datos del paciente", 14, 52);
                doc.setFontSize(8); doc.setFont("helvetica", "normal");
                doc.text(`Nombre: ${pacienteActual.nombre.toUpperCase()}`, 14, 58); 
                doc.text(`RUT: ${pacienteActual.rut}`, 14, 63);

                // 7. Sección de Fármacos e Indicaciones (Rp.)
                doc.setFontSize(12); doc.setFont("helvetica", "bold"); doc.text("Rp.", 14, 80);
                let startY = 88; doc.setFontSize(9);
                
                recetaMedicamentos.forEach((med, i) => {
                    doc.setFont("helvetica", "bold"); 
                    doc.text(`${i + 1}. ${med.nombre.toUpperCase()}`, 14, startY);
                    
                    doc.setFont("helvetica", "normal");
                    let txtLine = `• ${med.posologia}`; 
                    if (med.indicaciones) txtLine += `\n• Nota: ${med.indicaciones}`;
                    
                    const splitText = doc.splitTextToSize(txtLine, 180);
                    doc.text(splitText, 18, startY + 5); 
                    startY += (splitText.length * 4) + 8;
                });

                // 8. Pie de página (Firmas)
                const finalPageY = doc.internal.pageSize.height;
                doc.setDrawColor(0, 0, 0); doc.line(75, finalPageY - 35, 135, finalPageY - 35);
                doc.setFontSize(8); doc.setFont("helvetica", "normal"); 
                doc.text(drName, 105, finalPageY - 30, { align: "center" });

                // 9. Generación, Guardado local y Respaldo en la Nube
                const nombreArchivo = `Receta_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}_${Date.now()}.pdf`;
                doc.save(nombreArchivo); 
                
                if (!isLocal) {
                    const pdfBlob = doc.output('blob');
                    const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });
                    
                    if (!uploadError) {
                        await window.midental.from('documentos_pacientes').insert([{ 
                            paciente_id: pacienteIdURL, 
                            dentista_id: dentistaId, 
                            nombre_archivo: `Receta Médica ${new Date().toLocaleDateString('es-CL')}.pdf`, 
                            tipo: 'pdf', 
                            archivo_url: nombreArchivo 
                        }]);
                        cargarDocumentosPaciente(); 
                    }
                }
                alert("✅ Receta emitida exitosamente."); 
                document.getElementById('modalRecetaMedica').style.display = 'none';
                
            } catch (err) { 
                alert("Error al emitir receta: " + err.message); 
            } finally { 
                btn.innerHTML = '<span class="material-symbols-outlined">print</span> Emitir Orden Médica'; 
                btn.disabled = false; 
            }
        }

