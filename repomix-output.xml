    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    <script>
        // ==========================================
        // VARIABLES GLOBALES DE TIEMPO Y ESTADO
        // ==========================================
        let isDragging = false;
        let selectionMode = true; 
        
        let telefonoContactoColega = "";
        let direccionMapsActual = "";
        
        let offsetSemanasCreacion = 0;
        let offsetSemanasArriendo = 0;

        let slotsSeleccionadosParaCrear = new Set();
        let slotsSeleccionadosParaArrendar = [];
        let boxSeleccionadoGlobal = null;

        document.addEventListener('DOMContentLoaded', () => { 
            window.addEventListener('mouseup', () => { isDragging = false; });
            cargarMercadoGlobal();
            cargarMisPublicaciones();
        });

        // ==========================================
        // 1. MANEJO DE INTERFAZ GENERAL
        // ==========================================
        function cambiarPestanaB2B(tab) {
            document.getElementById('btnTabExplorar').classList.toggle('active', tab === 'explorar');
            document.getElementById('btnTabMisBoxes').classList.toggle('active', tab === 'misboxes');
            document.getElementById('areaExplorar').style.display = tab === 'explorar' ? 'block' : 'none';
            document.getElementById('areaMisBoxes').style.display = tab === 'misboxes' ? 'block' : 'none';
        }
        
        function cerrarModal(id) { document.getElementById(id).style.display = 'none'; }
        
        function siPresionaEnterFiltra(e) {
            if(e.key === 'Enter') {
                const query = document.getElementById('inputFiltroComuna').value;
                cargarMercadoGlobal(query);
            }
        }

        function abrirRutaMapa() {
            if (!direccionMapsActual) return alert("Dirección no disponible.");
            const url = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccionMapsActual)}`;
            window.open(url, '_blank');
        }

        function createCell(t, c, extraStyles="") { 
            const d = document.createElement('div'); d.className = c; d.innerHTML = t; 
            if(extraStyles) d.style.cssText = extraStyles; return d; 
        }

        // ==========================================
        // 2. GRILLA: CREACIÓN DEL BOX (Propietario)
        // ==========================================
        function abrirModalNuevoBox() { 
            document.getElementById('formNuevoBox').reset();
            document.getElementById('chkAceptoComision').checked = false;
            
            offsetSemanasCreacion = 0;
            slotsSeleccionadosParaCrear.clear();
            
            renderizarGrillaCreacionBox();
            document.getElementById('modalNuevoBox').style.display = 'flex'; 
        }

        function cambiarSemanaCreacion(direccion) {
            offsetSemanasCreacion += direccion;
            renderizarGrillaCreacionBox();
        }

        function renderizarGrillaCreacionBox() {
            const grid = document.getElementById('gridSeleccionHorario');
            grid.innerHTML = '';
            
            const diasAbrev = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
            const mesesCortos = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            const lunes = new Date();
            const diaSemana = lunes.getDay() === 0 ? 7 : lunes.getDay();
            lunes.setDate(lunes.getDate() - diaSemana + 1 + (offsetSemanasCreacion * 7));

            let fechasSemana = [];
            grid.appendChild(createCell('Hora', 'embedded-cell embedded-header embedded-time'));
            
            for (let i = 0; i < 7; i++) {
                let f = new Date(lunes);
                f.setDate(lunes.getDate() + i);
                fechasSemana.push(f);
                let dTxt = `<span style="display:block;">${diasAbrev[i]}</span><small style="font-weight:normal; font-size:0.6rem;">${f.getDate()} ${mesesCortos[f.getMonth()]}</small>`;
                grid.appendChild(createCell(dTxt, 'embedded-cell embedded-header'));
            }

            const domingo = fechasSemana[6];
            document.getElementById('lblSemanaCreacion').innerText = `Semana del ${lunes.getDate()} ${mesesCortos[lunes.getMonth()]} al ${domingo.getDate()} ${mesesCortos[domingo.getMonth()]}`;

            for (let h = 8; h <= 20; h++) {
                let horaStr = `${h.toString().padStart(2, '0')}:00`;
                grid.appendChild(createCell(horaStr, 'embedded-cell embedded-time'));
                
                for (let d = 0; d < 7; d++) {
                    const cell = document.createElement('div');
                    cell.className = 'embedded-cell';
                    
                    let fCol = fechasSemana[d];
                    let dd = fCol.getDate().toString().padStart(2, '0');
                    let mm = (fCol.getMonth()+1).toString().padStart(2, '0');
                    let yyyy = fCol.getFullYear();
                    let exactId = `${dd}/${mm}/${yyyy}-${horaStr}`; 
                    
                    const inner = document.createElement('div');
                    inner.dataset.exactid = exactId;

                    if (slotsSeleccionadosParaCrear.has(exactId)) {
                        inner.className = 'slot-trabajando';
                        inner.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">check</span>';
                    } else {
                        inner.className = 'slot-vacio';
                        inner.innerText = '+';
                    }

                    inner.addEventListener('mousedown', () => { isDragging = true; selectionMode = inner.classList.contains('slot-vacio'); toggleSlotCreadorExacto(inner); });
                    inner.addEventListener('mouseenter', () => { if (isDragging) { if (selectionMode && inner.classList.contains('slot-vacio')) toggleSlotCreadorExacto(inner); if (!selectionMode && inner.classList.contains('slot-trabajando')) toggleSlotCreadorExacto(inner); } });

                    cell.appendChild(inner);
                    grid.appendChild(cell);
                }
            }
        }

        function toggleSlotCreadorExacto(el) {
            const exactId = el.dataset.exactid;
            if (el.classList.contains('slot-vacio')) {
                el.className = 'slot-trabajando'; 
                el.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">check</span>';
                slotsSeleccionadosParaCrear.add(exactId);
            } else {
                el.className = 'slot-vacio'; 
                el.innerText = '+';
                slotsSeleccionadosParaCrear.delete(exactId);
            }
        }

        // ==========================================
        // 3. GRILLA: ARRIENDO INTERACTIVO (Arrendatario)
        // ==========================================
        function abrirDetalleBox(box, drName, avatar, tel, hrFmt, jorFmt) {
            boxSeleccionadoGlobal = box; 
            slotsSeleccionadosParaArrendar = []; 
            offsetSemanasArriendo = 0;

            document.getElementById('resumenReserva').style.display = 'none'; 
            document.getElementById('detalleColegaNombre').innerText = drName;
            document.getElementById('detalleColegaAvatar').src = avatar || 'assets/avatar-default-doctor.png';
            document.getElementById('detalleBoxDireccion').innerText = box.direccion;
            document.getElementById('detallePrecioHr').innerText = `$${hrFmt}`;
            document.getElementById('detallePrecioJornada').innerText = `$${jorFmt}`;
            document.getElementById('detalleBoxInsumos').innerText = box.insumos_incluidos || 'Sin especificar';
            document.getElementById('chkAceptoContrato').checked = false;
            
            telefonoContactoColega = tel || "";
            direccionMapsActual = box.direccion || ""; 

            renderizarGrillaArriendoExacta(); 
            
            document.getElementById('modalDetalleBox').style.display = 'flex';
        }

        function cambiarSemanaArriendo(direccion) {
            offsetSemanasArriendo += direccion;
            renderizarGrillaArriendoExacta();
        }

        function renderizarGrillaArriendoExacta() {
            const grid = document.getElementById('gridHorarioArriendo');
            grid.innerHTML = '';
            const diasAbrev = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
            const mesesCortos = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

            const lunes = new Date();
            const diaSemana = lunes.getDay() === 0 ? 7 : lunes.getDay();
            lunes.setDate(lunes.getDate() - diaSemana + 1 + (offsetSemanasArriendo * 7));

            let fechasSemana = [];

            grid.appendChild(createCell('Hora', 'embedded-cell embedded-header embedded-time'));
            
            for (let i = 0; i < 7; i++) {
                let f = new Date(lunes);
                f.setDate(lunes.getDate() + i);
                fechasSemana.push(f);
                let dTxt = `<span style="display:block;">${diasAbrev[i]}</span><small style="font-weight:normal; font-size:0.6rem;">${f.getDate()} ${mesesCortos[f.getMonth()]}</small>`;
                grid.appendChild(createCell(dTxt, 'embedded-cell embedded-header'));
            }

            const domingo = fechasSemana[6];
            document.getElementById('lblSemanaArriendo').innerText = `Semana del ${lunes.getDate()} ${mesesCortos[lunes.getMonth()]} al ${domingo.getDate()} ${mesesCortos[domingo.getMonth()]}`;

            const arrHorariosExactosDB = boxSeleccionadoGlobal.disponibilidad_json || [];

            for (let h = 8; h <= 20; h++) {
                let horaStr = `${h.toString().padStart(2, '0')}:00`;
                grid.appendChild(createCell(horaStr, 'embedded-cell embedded-time'));
                
                for (let d = 0; d < 7; d++) {
                    const cell = document.createElement('div');
                    cell.className = 'embedded-cell';
                    
                    let fCol = fechasSemana[d];
                    let dd = fCol.getDate().toString().padStart(2, '0');
                    let mm = (fCol.getMonth()+1).toString().padStart(2, '0');
                    let yyyy = fCol.getFullYear();
                    
                    let exactId = `${dd}/${mm}/${yyyy}-${horaStr}`;
                    let fechaLegibleParaUI = `${diasAbrev[d]} ${dd} ${mesesCortos[fCol.getMonth()]}`;
                    
                    if (arrHorariosExactosDB.includes(exactId)) {
                        const inner = document.createElement('div');
                        inner.title = `Seleccionar ${fechaLegibleParaUI} a las ${horaStr}`;
                        inner.onclick = () => procesarClicArriendo(inner, exactId, fechaLegibleParaUI, horaStr);

                        const estaSeleccionado = slotsSeleccionadosParaArrendar.find(s => s.exactId === exactId);
                        if (estaSeleccionado) {
                            inner.className = 'slot-disponible-rent slot-seleccionado-rent';
                            inner.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">shopping_cart_checkout</span>';
                        } else {
                            inner.className = 'slot-disponible-rent';
                            inner.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">check</span>';
                        }
                        
                        cell.appendChild(inner);
                    } else {
                        const inner = document.createElement('div');
                        inner.className = 'slot-vacio';
                        inner.innerText = '-';
                        inner.style.cursor = 'not-allowed';
                        cell.appendChild(inner);
                    }
                    grid.appendChild(cell);
                }
            }
        }

        function procesarClicArriendo(elementoDOM, exactId, fechaStr, horaStr) {
            const index = slotsSeleccionadosParaArrendar.findIndex(s => s.exactId === exactId);
            
            if (index > -1) {
                slotsSeleccionadosParaArrendar.splice(index, 1);
                elementoDOM.classList.remove('slot-seleccionado-rent');
                elementoDOM.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">check</span>';
            } else {
                slotsSeleccionadosParaArrendar.push({ exactId, fecha: fechaStr, hora: horaStr });
                elementoDOM.classList.add('slot-seleccionado-rent');
                elementoDOM.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem;">shopping_cart_checkout</span>';
            }
            
            actualizarResumenCarrito();
        }

        function actualizarResumenCarrito() {
            const resumenDiv = document.getElementById('resumenReserva');
            const listaUI = document.getElementById('listaHorasSeleccionadas');
            
            if (slotsSeleccionadosParaArrendar.length === 0) {
                resumenDiv.style.display = 'none';
                return;
            }
            
            resumenDiv.style.display = 'block';
            listaUI.innerHTML = '';
            
            slotsSeleccionadosParaArrendar.sort((a,b) => a.exactId.localeCompare(b.exactId)).forEach(s => {
                listaUI.innerHTML += `<li>${s.fecha} a las <strong>${s.hora}</strong></li>`;
            });
            
            // CORRECCIÓN: LÓGICA DE PRECIOS AJUSTADA A 5 HORAS CONTINUAS
            const cantidadHoras = slotsSeleccionadosParaArrendar.length;
            const cantidadMediasJornadas = Math.floor(cantidadHoras / 5);
            const horasSueltasRestantes = cantidadHoras % 5;
            
            const subtotal = (cantidadMediasJornadas * boxSeleccionadoGlobal.precio_jornada) + (horasSueltasRestantes * boxSeleccionadoGlobal.precio_hora);
            
            // Comisión MiDental 8% + 19% IVA (aplicado de forma legal a la comisión)
            const comisionMidental = Math.round(subtotal * 0.08 * 1.19);
            
            document.getElementById('calcSubtotal').innerText = '$' + subtotal.toLocaleString('es-CL');
            document.getElementById('calcComision').innerText = '$' + comisionMidental.toLocaleString('es-CL');
            document.getElementById('calcPagarAhora').innerText = '$' + comisionMidental.toLocaleString('es-CL');
        }

        // ==========================================
        // 4. FLUJO DE PAGO MERCADO PAGO Y ACTUALIZACIÓN DB
        // ==========================================
        function iniciarPagoMercadoPago() {
            if (slotsSeleccionadosParaArrendar.length === 0) {
                return alert("⚠️ Selecciona al menos un bloque verde en el calendario para arrendar.");
            }

            const aceptoTerminos = document.getElementById('chkAceptoContrato').checked;
            if (!aceptoTerminos) {
                return alert("⚠️ ACCIÓN REQUERIDA: Debes aceptar los Términos y Condiciones de Arriendo antes de pagar.");
            }

            const btn = document.getElementById('btnPagarMP');
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Conectando con Mercado Pago...';
            btn.disabled = true;

            // CORRECCIÓN: Simulamos la pasarela, pero ACTUALIZAMOS SUPABASE REALMENTE
            setTimeout(async () => {
                try {
                    // 1. Extraemos los IDs exactos que el dentista acaba de arrendar
                    const slotsArrendadosExactos = slotsSeleccionadosParaArrendar.map(s => s.exactId);
                    
                    // 2. Traemos la disponibilidad más reciente desde Supabase (para evitar colisiones)
                    const { data: boxData, error: fetchError } = await window.midental
                        .from('arriendo_boxes')
                        .select('disponibilidad_json')
                        .eq('id', boxSeleccionadoGlobal.id)
                        .single();

                    if (fetchError) throw fetchError;

                    // 3. Eliminamos de la base de datos las horas que acabamos de arrendar
                    const nuevaDisponibilidad = boxData.disponibilidad_json.filter(
                        slot => !slotsArrendadosExactos.includes(slot)
                    );

                    // 4. Guardamos los cambios en Supabase para bloquear el horario a otros colegas
                    const { error: updateError } = await window.midental
                        .from('arriendo_boxes')
                        .update({ disponibilidad_json: nuevaDisponibilidad })
                        .eq('id', boxSeleccionadoGlobal.id);

                    if (updateError) throw updateError;

                    alert("✅ PAGO EXITOSO Y RESERVA CONFIRMADA\n\nEl pago de la comisión ($" + document.getElementById('calcPagarAhora').innerText + ") se ha procesado.\n\nLos bloques han sido removidos del mercado. Se abrirá WhatsApp para coordinar la entrega de llaves.");
                    
                    cerrarModal('modalDetalleBox');
                    cargarMercadoGlobal(); 
                    cargarMisPublicaciones();

                    // Abrimos WhatsApp con el propietario del Box
                    if (telefonoContactoColega) {
                        let telWA = telefonoContactoColega.replace(/[^0-9]/g, '');
                        let msg = `Hola colega, acabo de pagar y reservar tu box ubicado en ${direccionMapsActual} a través de MiDental. Te escribo para coordinar la entrega.`;
                        window.open(`https://wa.me/${telWA}?text=${encodeURIComponent(msg)}`, '_blank');
                    }

                } catch (err) {
                    alert("Hubo un error al procesar la reserva en la base de datos: " + err.message);
                } finally {
                    btn.innerHTML = '<span class="material-symbols-outlined">payments</span> Pagar Reserva con MercadoPago';
                    btn.disabled = false;
                }
            }, 1500);
        }

        // ==========================================
        // 5. CARGA DE LISTADOS Y DB
        // ==========================================
        async function guardarAvisoB2B() {
            const userId = localStorage.getItem('midental_user_id');
            const direccion = document.getElementById('newBoxDireccion').value.trim();
            const insumos = document.getElementById('newBoxInsumos').value.trim();
            const pHora = document.getElementById('newBoxPrecioHr').value;
            const pJornada = document.getElementById('newBoxPrecioJornada').value;
            const aceptaLegal = document.getElementById('chkAceptoComision').checked;
            
            const slotsExactos = Array.from(slotsSeleccionadosParaCrear);
            
            if (!aceptaLegal) return alert("Debes aceptar los términos (8% + IVA) y declarar que cumples las normas sanitarias para publicar tu box.");
            if (!direccion || !pHora || !pJornada || slotsExactos.length === 0) return alert("Datos incompletos. Llena la dirección, precios y pinta los horarios disponibles.");

            const btn = document.getElementById('btnPublicarAviso');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Publicando...';

            try {
                const { error: insertError } = await window.midental.from('arriendo_boxes').insert([{
                    propietario_id: userId,
                    direccion: direccion,
                    precio_hora: parseInt(pHora),
                    precio_jornada: parseInt(pJornada),
                    insumos_incluidos: insumos,
                    disponibilidad_json: slotsExactos,
                    esta_activo: true
                }]);

                if (insertError) throw insertError;

                alert("🏢 ¡Box publicado en el marketplace exitosamente! Estará disponible para que otros colegas lo reserven en las fechas indicadas.");
                cerrarModal('modalNuevoBox');
                cargarMercadoGlobal(); 
                cargarMisPublicaciones();

            } catch (err) {
                alert("Error al publicar: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined">publish</span> Publicar Aviso en la Red';
            }
        }

        async function cargarMisPublicaciones() {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('misPublicacionesContenedor');
            if(!userId) return;

            const { data: boxes, error } = await window.midental.from('arriendo_boxes')
                .select('*')
                .eq('propietario_id', userId)
                .order('id', { ascending: false });

            contenedor.innerHTML = "";
            if (error || !boxes || boxes.length === 0) {
                contenedor.innerHTML = '<div class="empty-state">No tienes espacios publicados actualmente.</div>';
                return;
            }

            boxes.forEach(box => {
                const hrFormat = box.precio_hora.toLocaleString('es-CL');
                const horasDisp = box.disponibilidad_json ? box.disponibilidad_json.length : 0;
                
                let btnEstadoHTML = box.esta_activo 
                    ? `<button onclick="cambiarEstadoMiAviso('${box.id}', false)" style="background:#ef4444; border:none; color:white; padding:8px 12px; border-radius:8px; font-weight: bold; cursor:pointer; font-size:0.85rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">Pausar Aviso</button>`
                    : `<button onclick="cambiarEstadoMiAviso('${box.id}', true)" style="background:#10b981; border:none; color:white; padding:8px 12px; border-radius:8px; font-weight: bold; cursor:pointer; font-size:0.85rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">Activar Aviso</button>`;

                contenedor.innerHTML += `
                    <div class="box-listing-card" style="opacity: ${box.esta_activo ? '1' : '0.6'}">
                        <div style="background:${box.esta_activo ? 'var(--blue-elegant)' : '#64748b'}; padding:12px 20px; display:flex; justify-content:space-between; align-items:center; color:white;">
                            <span style="font-weight:900; font-size: 1.1rem;">${box.esta_activo ? 'En el Mercado' : 'Aviso Pausado'}</span>
                            ${btnEstadoHTML}
                        </div>
                        <div class="box-listing-info">
                            <h4 style="color:var(--blue-elegant); margin:0 0 5px; font-size: 1.1rem;">${box.direccion}</h4>
                            <p style="color:#64748b; font-size:0.9rem; margin:0 0 15px;">${box.insumos_incluidos || 'Sin insumos detallados'}</p>
                            <div style="display:flex; justify-content:space-between; align-items:flex-end; border-top: 1px solid #e2e8f0; padding-top: 10px;">
                                <div><span class="hour-badge">${horasDisp} bloques</span></div>
                                <div class="box-listing-price">$${hrFormat}/hr</div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        async function cargarMercadoGlobal(filtroText = "") {
            const userId = localStorage.getItem('midental_user_id');
            const contenedor = document.getElementById('listaExplorarBoxes');

            let query = window.midental.from('arriendo_boxes')
                .select('*, perfiles_dentistas(nombre_completo, prefijo, avatar_url, telefono)')
                .neq('propietario_id', userId)
                .eq('esta_activo', true);
            
            if (filtroText) query = query.ilike('direccion', `%${filtroText}%`);

            const { data: boxes, error } = await query.order('id', { ascending: false });

            contenedor.innerHTML = "";
            if (error || !boxes || boxes.length === 0) {
                contenedor.innerHTML = `<div class="empty-state">${filtroText ? 'No hay resultados para "'+filtroText+'"' : 'No hay boxes de otros colegas disponibles.'}</div>`;
                return;
            }

            boxes.forEach(box => {
                const drInfo = box.perfiles_dentistas || {};
                const drName = `${drInfo.prefijo || 'Dr.'} ${drInfo.nombre_completo || 'Colega'}`;
                const hrFormat = box.precio_hora.toLocaleString('es-CL');
                const jorFormat = box.precio_jornada.toLocaleString('es-CL');
                
                const card = document.createElement('div');
                card.className = 'box-listing-card';
                card.onclick = () => abrirDetalleBox(box, drName, drInfo.avatar_url, drInfo.telefono, hrFormat, jorFormat);
                
                card.innerHTML = `
                    <div style="padding:20px; display:flex; gap:15px; align-items:center;">
                        <img src="${drInfo.avatar_url || 'assets/avatar-default-doctor.png'}" style="width:70px; height:70px; border-radius:50%; object-fit:cover; border: 2px solid var(--blue-elegant);">
                        <div style="flex:1;">
                            <h4 style="color:var(--blue-elegant); margin:0 0 5px; font-size: 1.1rem; font-weight: 900;">${drName}</h4>
                            <p style="color:#64748b; font-size:0.85rem; margin:0; font-weight: bold;"><span class="material-symbols-outlined" style="font-size:1.1rem; vertical-align:middle; color: var(--pixar-cyan);">location_on</span> ${box.direccion}</p>
                        </div>
                        <div style="text-align:right;">
                            <div class="box-listing-price">$${hrFormat}</div><small style="color:#94a3b8; font-weight: bold;">x hr</small>
                        </div>
                    </div>
                `;
                contenedor.appendChild(card);
            });
        }

        async function cambiarEstadoMiAviso(id, nuevoEstado) {
            const accionTxt = nuevoEstado ? "activar" : "pausar";
            if(!confirm(`¿Seguro que deseas ${accionTxt} este aviso en el mercado?`)) return;
            await window.midental.from('arriendo_boxes').update({ esta_activo: nuevoEstado }).eq('id', id);
            cargarMisPublicaciones();
        }
    </script>
</body>
</html>
</file>

<file path="ofertas-paciente.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Ofertas y Reels</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <style>
        /* Modo Oscuro Elegante */
        body { background-color: #0f172a; padding-bottom: 80px; color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; }
        
        .header-ofertas { padding: 25px 20px 0; text-align: center; border-bottom: 1px solid #1e293b; position: sticky; top: 0; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(10px); z-index: 100;}
        .header-ofertas h2 { margin: 0; color: white; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 1.6rem; }
        
        /* Selector de Pestañas (Tabs) */
        .tabs-container { display: flex; justify-content: center; margin-top: 20px; gap: 10px; }
        .tab-btn { background: transparent; border: none; color: #94a3b8; font-size: 1rem; font-weight: bold; padding: 10px 20px; cursor: pointer; border-bottom: 3px solid transparent; transition: 0.3s; display: flex; align-items: center; gap: 5px; }
        .tab-btn.active { color: var(--pixar-cyan); border-bottom-color: var(--pixar-cyan); }
        .tab-btn:hover { color: white; }

        .content-area { padding: 20px; max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
        
        /* Ajuste de barra inferior */
        .bottom-nav { background: white; border-top: none; }

        /* Animación Cronómetro Ofertas */
        @keyframes latido {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); opacity: 0.8; color: #ef4444; }
            100% { transform: scale(1); }
        }
        .reloj-urgencia { animation: latido 1.5s infinite; }

        /* Estilos Reels (Shorts) */
        .reel-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.2); margin-bottom: 20px; }
        .reel-video-container { width: 100%; aspect-ratio: 9/16; background: #000; position: relative; }
        .reel-video-container iframe { width: 100%; height: 100%; border: none; }
        .reel-info { padding: 15px; }
        .reel-dr { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
        .reel-dr img { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--pixar-cyan); object-fit: cover;}

        /* ============================================== */
        /* LIGHTBOX · Visor de imágenes                   */
        /* ============================================== */
        .lightbox-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
            animation: lbFade 0.18s ease-out;
        }
        .lightbox-overlay.is-open { display: flex; }
        @keyframes lbFade { from { opacity: 0; } to { opacity: 1; } }
        @keyframes lbZoom { from { transform: scale(0.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        .lightbox-stage {
            position: relative;
            max-width: 96vw;
            max-height: 92vh;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: lbZoom 0.22s ease-out;
        }
        .lightbox-image {
            max-width: 96vw;
            max-height: 92vh;
            border-radius: 14px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
            object-fit: contain;
            background: #0f172a;
            display: block;
        }
        .lightbox-close {
            position: absolute;
            top: -14px;
            right: -14px;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: white;
            color: #0f172a;
            font-size: 1.6rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.4);
            transition: transform 0.15s, background 0.15s;
            z-index: 2;
        }
        .lightbox-close:hover { transform: scale(1.08); background: #ef4444; color: white; }

        @media (max-width: 480px) {
            .lightbox-close { top: -8px; right: -8px; width: 38px; height: 38px; }
        }
    </style>
</head>
<body>

    <div class="header-ofertas">
        <h2>Explora MiDental</h2>
        
        <div class="tabs-container">
            <button class="tab-btn active" id="btnTabOfertas" onclick="cambiarPestana('ofertas')">
                <span class="material-symbols-outlined">bolt</span> Ofertas Flash
            </button>
            <button class="tab-btn" id="btnTabReels" onclick="cambiarPestana('reels')">
                <span class="material-symbols-outlined">play_circle</span> Reels Clínicos
            </button>
        </div>
    </div>

    <div class="content-area" id="areaOfertas">
        <div id="ofertasFlashContenedor">
            <div style="text-align:center; padding:40px; color:#64748b;">
                <span class="material-symbols-outlined" style="font-size: 3rem; animation: spin 2s linear infinite;">sync</span>
                <p>Buscando las mejores ofertas...</p>
            </div>
        </div>
    </div>

    <div class="content-area" id="areaReels" style="display: none;">
        <div id="reelsContenedor">
            <div style="text-align:center; padding:40px; color:#64748b;">
                <span class="material-symbols-outlined" style="font-size: 3rem; animation: spin 2s linear infinite;">sync</span>
                <p>Cargando videos educativos...</p>
            </div>
        </div>
    </div>

    <!-- LIGHTBOX · Visor de imágenes de ofertas -->
    <div class="lightbox-overlay" id="lightboxOverlay" onclick="cerrarLightbox(event)" role="dialog" aria-modal="true" aria-label="Vista ampliada de la oferta">
        <div class="lightbox-stage" onclick="event.stopPropagation()">
            <button type="button" class="lightbox-close" onclick="cerrarLightbox()" aria-label="Cerrar">&times;</button>
            <img src="" alt="Imagen de la oferta" class="lightbox-image" id="lightboxImage">
        </div>
    </div>

    <nav class="bottom-nav">
        <a href="dashboard-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">home</span>Inicio</a>
        <a href="mapa-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">search</span>Buscar</a>
        <a href="ofertas-paciente.html" class="nav-item-bottom active"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">description</span>Documentos</a>
        <a href="perfil-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">person</span>Perfil</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    
    <script>
        let cronometroGlobalInterval;

        // Registro global de ofertas renderizadas (id -> oferta enriquecida).
        // Evita inyectar JSON crudo en atributos onclick.
        window.__OFERTAS_RENDERIZADAS = window.__OFERTAS_RENDERIZADAS || {};

        document.addEventListener('DOMContentLoaded', () => {
            cargarOfertas();
            cargarReels();
            // Cerrar lightbox con tecla ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') cerrarLightbox();
            });
        });

        // 1. SISTEMA DE PESTAÑAS (TABS)
        function cambiarPestana(pestana) {
            document.getElementById('btnTabOfertas').classList.toggle('active', pestana === 'ofertas');
            document.getElementById('btnTabReels').classList.toggle('active', pestana === 'reels');

            document.getElementById('areaOfertas').style.display = pestana === 'ofertas' ? 'flex' : 'none';
            document.getElementById('areaReels').style.display = pestana === 'reels' ? 'flex' : 'none';
        }

        // ==========================================================
        // LIGHTBOX · Visor de imágenes
        // ==========================================================
        function abrirLightbox(url) {
            try {
                if (!url) return;
                const overlay = document.getElementById('lightboxOverlay');
                const img = document.getElementById('lightboxImage');
                img.src = url;
                overlay.classList.add('is-open');
                document.body.style.overflow = 'hidden';
            } catch (err) {
                console.error("[abrirLightbox] Error:", err);
            }
        }

        function cerrarLightbox(event) {
            try {
                // Si se invoca por clic en overlay, sólo cerrar si el target es el overlay
                if (event && event.type === 'click' && event.target.id !== 'lightboxOverlay') return;
                const overlay = document.getElementById('lightboxOverlay');
                overlay.classList.remove('is-open');
                document.getElementById('lightboxImage').src = '';
                document.body.style.overflow = '';
            } catch (err) {
                console.error("[cerrarLightbox] Error:", err);
            }
        }

        // ==========================================================
        // 2. CARGAR OFERTAS FLASH (con contexto profesional y sede)
        // ==========================================================
        async function cargarOfertas() {
            const contenedor = document.getElementById('ofertasFlashContenedor');
            try {
                const { data: ofertas, error } = await window.midental
                    .from('ofertas_flash')
                    .select(`
                        *,
                        perfiles_dentistas (
                            id,
                            prefijo,
                            nombre_completo,
                            telefono,
                            sedes_dentistas ( nombre_sede, direccion, comuna )
                        )
                    `)
                    .lte('inicio_at', new Date().toISOString())
                    .gte('expira_at', new Date().toISOString())
                    .eq('activa', true)
                    .order('created_at', { ascending: false });

                if (error) throw error;

                if (!ofertas || ofertas.length === 0) {
                    contenedor.innerHTML = `<div style="text-align:center; padding:30px; opacity:0.5; color:white;">No hay ofertas flash activas en este momento. Vuelve más tarde.</div>`;
                    return;
                }

                window.__OFERTAS_RENDERIZADAS = {};
                contenedor.innerHTML = "";

                ofertas.forEach(oferta => {
                    const dr = oferta.perfiles_dentistas || {};
                    const nombreBase = dr.nombre_completo || '';
                    if (!nombreBase) return; // Evita mostrar ofertas de doctores eliminados

                    const prefijo = dr.prefijo || 'Dr.';
                    const drName = `${prefijo} ${nombreBase}`;

                    // Resolver sede principal (puede venir como array por la relación 1:N)
                    let nombreCentro = 'su consulta';
                    const sedes = dr.sedes_dentistas;
                    if (Array.isArray(sedes) && sedes.length > 0 && sedes[0].nombre_sede) {
                        nombreCentro = sedes[0].nombre_sede;
                    } else if (sedes && typeof sedes === 'object' && sedes.nombre_sede) {
                        nombreCentro = sedes.nombre_sede;
                    }

                    // Persistimos el dataset enriquecido para que agendarOferta() lo reuse.
                    window.__OFERTAS_RENDERIZADAS[oferta.id] = {
                        id: oferta.id,
                        servicio_nombre: oferta.servicio_nombre,
                        precio_oferta: oferta.precio_oferta,
                        precio_real: oferta.precio_real,
                        nombre_centro: nombreCentro,
                        dentista_nombre: nombreBase,
                        dentista_prefijo: prefijo,
                        dentista_telefono: dr.telefono || ''
                    };

                    const imgUrl = oferta.imagen_url || 'https://via.placeholder.com/400x200/1e293b/00b4d8?text=Promo+Especial';
                    const imgUrlSafe = (imgUrl || '').replace(/'/g, "\\'");

                    let porcentajeDesc = 0;
                    if (oferta.precio_real > 0) {
                        porcentajeDesc = Math.round(((oferta.precio_real - oferta.precio_oferta) / oferta.precio_real) * 100);
                    }

                    contenedor.innerHTML += `
                        <div class="offer-card" style="position: relative; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:15px; overflow:hidden; margin-bottom:15px; box-shadow: 0 10px 20px rgba(0,0,0,0.2);">

                            <div style="position: absolute; top: 15px; right: 15px; background: #ef4444; color: white; padding: 8px 15px; border-radius: 20px; font-weight: 900; font-size: 1.2rem; box-shadow: 0 4px 10px rgba(0,0,0,0.5); z-index: 10;">
                                -${porcentajeDesc}%
                            </div>

                            <img src="${imgUrl}"
                                 style="width:100%; height:180px; object-fit:cover; cursor: pointer;"
                                 title="Toca para ampliar"
                                 onclick="abrirLightbox('${imgUrlSafe}')"
                                 onerror="this.src='https://via.placeholder.com/400x200/1e293b/00b4d8?text=Promo+Especial'">

                            <div style="padding:15px;">
                                <div style="display:flex; justify-content:space-between; align-items:center;">
                                    <span style="background:var(--pixar-orange); color:white; padding:3px 8px; border-radius:10px; font-size:0.7rem; font-weight:bold;">DESTACADO</span>

                                    <div class="timer-container" data-expira="${oferta.expira_at}" style="display:flex; align-items:center; gap:5px; color:var(--pixar-orange); font-size:0.85rem; font-weight:bold; background: rgba(255,255,255,0.1); padding: 4px 10px; border-radius: 12px;">
                                        <span class="material-symbols-outlined reloj-urgencia" style="font-size:1.1rem;">timer</span>
                                        <span class="tiempo-restante">Calculando...</span>
                                    </div>
                                </div>

                                <h3 style="margin:12px 0 5px 0; color:white; font-size:1.2rem;">${oferta.servicio_nombre}</h3>
                                <p style="margin:0 0 4px 0; color:#94a3b8; font-size:0.9rem;">Por ${drName}</p>
                                <p style="margin:0 0 15px 0; color:#64748b; font-size:0.8rem; display:flex; align-items:center; gap:4px;">
                                    <span class="material-symbols-outlined" style="font-size:1rem;">location_on</span> ${nombreCentro}
                                </p>

                                <div style="display:flex; justify-content:space-between; align-items:center; background: rgba(0,0,0,0.2); padding: 10px 15px; border-radius: 12px;">
                                    <div style="display:flex; flex-direction:column;">
                                        <span style="font-size:0.75rem; color:#888;">Precio Normal</span>
                                        <span style="text-decoration:line-through; color:#94a3b8; font-size:0.9rem;">$${(oferta.precio_real || 0).toLocaleString('es-CL')}</span>
                                    </div>
                                    <div style="display:flex; flex-direction:column; text-align:right;">
                                        <span style="font-size:0.75rem; color:var(--pixar-orange); font-weight:bold;">Precio Oferta</span>
                                        <span style="color:var(--pixar-orange); font-size:1.5rem; font-weight:900;">$${(oferta.precio_oferta || 0).toLocaleString('es-CL')}</span>
                                    </div>
                                </div>

                                <button class="btn-pixar btn-outline mt-15" style="width:100%; border-radius:12px; padding: 12px; font-size: 1rem; border-width: 2px;" onclick="agendarOferta('${oferta.id}')">
                                    Agendar con este precio
                                </button>
                            </div>
                        </div>
                    `;
                });

                // Iniciar el motor de tiempo real para todas las ofertas renderizadas
                iniciarCronometrosEnVivo();

            } catch (err) {
                console.error("Error al cargar ofertas:", err);
                contenedor.innerHTML = `<p style="color:red; text-align:center;">Ocurrió un error al cargar las promociones.</p>`;
            }
        }

        // ==========================================================
        // 3. AGENDAMIENTO DUAL · WhatsApp + redirección a la agenda
        // ==========================================================
        function formatearPrecioCLP(monto) {
            const n = Number(monto) || 0;
            try {
                return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
            } catch (_) {
                return `$${Math.round(n).toLocaleString('es-CL')}`;
            }
        }

        /**
         * Normaliza un número chileno a formato internacional 569XXXXXXXX.
         * - Quita espacios, guiones, puntos y paréntesis.
         * - Conserva el código de país si ya viene (56...).
         * - Agrega 56 cuando el número parte con 9 y tiene 9 dígitos (móvil CL).
         */
        function normalizarTelefonoCL(telefonoRaw) {
            if (!telefonoRaw) return '';
            let tel = String(telefonoRaw).replace(/[^\d+]/g, '').replace(/^\+/, '');
            if (!tel) return '';
            if (tel.startsWith('56')) return tel;
            if (tel.startsWith('9') && tel.length === 9) return `56${tel}`;
            if (tel.length === 8) return `569${tel}`; // móvil sin el 9 inicial
            return tel; // último recurso: lo dejamos como vino
        }

        function agendarOferta(ofertaId) {
            try {
                const oferta = window.__OFERTAS_RENDERIZADAS?.[ofertaId];
                if (!oferta) {
                    console.error("[agendarOferta] Oferta no encontrada en el registro:", ofertaId);
                    alert("No pudimos preparar el mensaje para esta oferta.");
                    return;
                }

                const servicio        = oferta.servicio_nombre || 'el servicio promocionado';
                const precioFormat    = formatearPrecioCLP(oferta.precio_oferta);
                const nombreCentro    = oferta.nombre_centro || 'su consulta';
                const prefijo         = oferta.dentista_prefijo || 'Dr.';
                const nombreCompleto  = oferta.dentista_nombre || '';
                const telefono        = normalizarTelefonoCL(oferta.dentista_telefono);

                const mensaje = `Hola, vi la oferta de ${servicio} al valor de ${precioFormat} y quiero agendar una hora en el centro ${nombreCentro} con el ${prefijo} ${nombreCompleto}.`;
                const mensajeEnc = encodeURIComponent(mensaje);

                // 1) Abrir WhatsApp en nueva pestaña (si hay teléfono válido)
                if (telefono) {
                    window.open(`https://wa.me/${telefono}?text=${mensajeEnc}`, '_blank', 'noopener,noreferrer');
                } else {
                    // Fallback: abrir WhatsApp sin número específico (selector de contacto)
                    window.open(`https://wa.me/?text=${mensajeEnc}`, '_blank', 'noopener,noreferrer');
                    console.warn("[agendarOferta] El profesional no tiene teléfono registrado.");
                }

                // 2) Redirigir la pestaña actual a la agenda/perfil del dentista
                window.location.href = `mapa-paciente.html?busqueda=${encodeURIComponent(nombreCompleto)}`;
            } catch (err) {
                console.error("[agendarOferta] Error:", err);
                alert("No pudimos iniciar el agendamiento. Intenta nuevamente.");
            }
        }

        // MOTOR DE CRONÓMETROS EN TIEMPO REAL
        function iniciarCronometrosEnVivo() {
            clearInterval(cronometroGlobalInterval);
            cronometroGlobalInterval = setInterval(() => {
                document.querySelectorAll('.timer-container').forEach(el => {
                    const expiraDate = new Date(el.dataset.expira).getTime();
                    const ahora = new Date().getTime();
                    const diffMs = expiraDate - ahora;

                    if (diffMs <= 0) {
                        el.querySelector('.tiempo-restante').innerText = "¡Finalizada!";
                        el.style.color = "#ef4444";
                        return;
                    }
                    
                    const horasTotales = Math.floor(diffMs / (1000 * 60 * 60));
                    const dias = Math.floor(horasTotales / 24);
                    const horasSueltas = horasTotales % 24;
                    const minutos = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((diffMs % (1000 * 60)) / 1000);

                    if (dias > 0) {
                        el.querySelector('.tiempo-restante').innerText = `Termina en ${dias}d y ${horasSueltas}h`;
                    } else {
                        el.querySelector('.tiempo-restante').innerText = `¡${horasTotales.toString().padStart(2,'0')}:${minutos.toString().padStart(2,'0')}:${segundos.toString().padStart(2,'0')}!`;
                    }
                });
            }, 1000);
        }

        // 3. CARGAR REELS (SHORTS) - VERSIÓN INTELIGENTE
        async function cargarReels() {
            const contenedor = document.getElementById('reelsContenedor');
            try {
                const { data: videos, error } = await window.midental
                    .from('shorts_videos')
                    .select('*, perfiles_dentistas(prefijo, nombre_completo, avatar_url)')
                    .order('created_at', { ascending: false });

                if (error) throw error;

                if (!videos || videos.length === 0) {
                    contenedor.innerHTML = `<div style="text-align:center; padding:30px; opacity:0.5; color:white;">No hay Reels clínicos disponibles aún.</div>`;
                    return;
                }

                contenedor.innerHTML = "";
                videos.forEach(vid => {
                    const dr = vid.perfiles_dentistas || {};
                    const nombreBase = dr.nombre_completo || '';
                    if (!nombreBase) return; // Validación de integridad

                    const drName = `${dr.prefijo || 'Dr.'} ${nombreBase}`;
                    const drAvatar = dr.avatar_url || 'assets/avatar-default-doctor.png';
                    
                    let embedUrl = "";
                    let urlOriginal = vid.video_url || "";
                    let videoId = "";

                    if (urlOriginal.includes('youtube.com/shorts/')) {
                        videoId = urlOriginal.split('shorts/')[1].split('?')[0];
                    } else if (urlOriginal.includes('youtu.be/')) {
                        videoId = urlOriginal.split('youtu.be/')[1].split('?')[0];
                    } else if (urlOriginal.includes('youtube.com/watch')) {
                        try { videoId = new URLSearchParams(urlOriginal.split('?')[1]).get('v'); } catch(e){}
                    }

                    if (videoId) {
                        embedUrl = `https://www.youtube.com/embed/${videoId}`;
                    }

                    contenedor.innerHTML += `
                        <div class="reel-card">
                            ${embedUrl ? `
                                <div class="reel-video-container">
                                    <iframe src="${embedUrl}" title="Video reproductor" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                                </div>
                            ` : `
                                <div style="padding: 40px 20px; text-align:center; background:#1e293b; color:#94a3b8; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                    <span class="material-symbols-outlined" style="font-size: 3.5rem; margin-bottom: 10px; color: #475569;">ondemand_video</span><br>
                                    <p style="margin-top:0; margin-bottom: 15px; font-size: 0.95rem;">El formato de este video requiere abrirse en su aplicación original.</p>
                                    <a href="${urlOriginal}" target="_blank" style="color: white; font-weight: bold; text-decoration: none; padding: 10px 20px; background: var(--pixar-cyan); border-radius: 8px; display: inline-flex; align-items: center; gap: 5px;">
                                        <span class="material-symbols-outlined" style="font-size: 1.1rem;">open_in_new</span> Ver video original
                                    </a>
                                </div>
                            `}
                            
                            <div class="reel-info">
                                <div class="reel-dr">
                                    <img src="${drAvatar}" alt="Doctor">
                                    <div>
                                        <h4 style="margin: 0; color: white; font-size: 1rem;">${drName}</h4>
                                        <span style="font-size: 0.75rem; color: #94a3b8;">${vid.cta_tipo === 'agendar' ? 'Disponible para Agendar' : 'Video Educativo'}</span>
                                    </div>
                                </div>
                                <p style="margin: 0 0 15px 0; color: #cbd5e1; font-size: 0.9rem; line-height: 1.4;">${vid.descripcion || 'Sin descripción.'}</p>
                                
                                <button class="btn-pixar" style="width: 100%; border-radius: 12px; padding: 12px; font-weight: bold;" onclick="window.location.href='mapa-paciente.html?doctor=${encodeURIComponent(nombreBase)}'">
                                    Agendar con ${dr.prefijo || 'Dr.'} ${nombreBase.split(' ')[0]}
                                </button>
                            </div>
                        </div>
                    `;
                });
            } catch (err) {
                console.error("Error al cargar Reels:", err);
                contenedor.innerHTML = `<p style="color:red; text-align:center;">Ocurrió un error al cargar los videos.</p>`;
            }
        }
    </script>
</body>
</html>
