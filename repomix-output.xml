            <div class="empty-state"><span class="material-symbols-outlined spin">sync</span><p>Cargando documentos...</p></div>
        </div>

    </div>

    <nav class="bottom-nav">
        <a href="dashboard-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">home</span>Inicio</a>
        <a href="mapa-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">search</span>Buscar</a>
        <a href="ofertas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom active"><span class="material-symbols-outlined">description</span>Documentos</a>
        <a href="perfil-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">person</span>Perfil</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    <script>
        // ==========================================================
        // BOOT · Identidad clínica
        // ==========================================================
        let PACIENTE_ID = null;
        const BUCKET = 'documentos_clinicos';

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                PACIENTE_ID = await resolverPacienteId();
                if (!PACIENTE_ID) {
                    alert("Debes iniciar sesión como paciente para ver tus documentos.");
                    window.location.href = 'index.html';
                    return;
                }
                await Promise.all([
                    cargarResumenFinanciero(PACIENTE_ID),
                    cargarDocumentos(PACIENTE_ID)
                ]);
            } catch (err) {
                console.error("[BOOT] Error inicializando portal de documentos:", err);
                alert("No pudimos cargar tu portal financiero. Intenta nuevamente.");
            }
        });

        async function resolverPacienteId() {
            try {
                let authUid = null;
                try {
                    const { data: sessionData } = await window.midental.auth.getUser();
                    authUid = sessionData?.user?.id || null;
                } catch (e) {
                    console.warn("[Auth] No se pudo obtener auth.getUser():", e);
                }
                if (!authUid) authUid = localStorage.getItem('midental_user_id');

                const tipoUser = localStorage.getItem('midental_user_tipo');
                if (!authUid || (tipoUser && tipoUser !== 'paciente')) return null;

                const { data, error } = await window.midental
                    .from('perfiles_pacientes')
                    .select('id, user_id')
                    .eq('user_id', authUid)
                    .maybeSingle();

                if (error) throw error;
                if (data?.id) return data.id;

                return authUid;
            } catch (err) {
                console.error("[resolverPacienteId] Error:", err);
                return localStorage.getItem('midental_user_id');
            }
        }

        // ==========================================================
        // RESUMEN FINANCIERO · vista_balance_paciente
        // ==========================================================
        async function cargarResumenFinanciero(pacienteId) {
            const grid = document.getElementById('financialGrid');
            const cta = document.getElementById('financeCta');

            try {
                const { data, error } = await window.midental
                    .from('vista_balance_paciente')
                    .select('presupuesto_integral, total_pagado, saldo_restante')
                    .eq('paciente_id', pacienteId)
                    .maybeSingle();

                if (error) throw error;

                const presupuesto = Number(data?.presupuesto_integral ?? 0);
                const pagado      = Number(data?.total_pagado ?? 0);
                const saldo       = Number(data?.saldo_restante ?? (presupuesto - pagado));

                const saldoEsAlerta = saldo > 0;
                const saldoEsExito  = saldo <= 0;

                grid.innerHTML = `
                    <div class="finance-card is-budget">
                        <div class="finance-icon"><span class="material-symbols-outlined">description</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Total Presupuestado</span>
                            <span class="finance-amount">${formatoCLP(presupuesto)}</span>
                        </div>
                    </div>
                    <div class="finance-card is-paid">
                        <div class="finance-icon"><span class="material-symbols-outlined">paid</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Total Pagado</span>
                            <span class="finance-amount">${formatoCLP(pagado)}</span>
                        </div>
                    </div>
                    <div class="finance-card ${saldoEsAlerta ? 'is-alert' : 'is-success'}">
                        <div class="finance-icon">
                            <span class="material-symbols-outlined">${saldoEsAlerta ? 'warning' : 'task_alt'}</span>
                        </div>
                        <div class="finance-body">
                            <span class="finance-label">Saldo Pendiente</span>
                            <span class="finance-amount">${formatoCLP(Math.max(saldo, 0))}</span>
                        </div>
                    </div>
                `;

                if (saldoEsExito) {
                    cta.innerHTML = `
                        <span class="material-symbols-outlined" style="color:#16a34a;">verified</span>
                        <span><strong style="color:#166534;">¡Estás al día!</strong> No registras saldo pendiente con tu especialista.</span>
                    `;
                } else {
                    cta.innerHTML = `
                        <span class="material-symbols-outlined" style="color:#ef4444;">priority_high</span>
                        <span>Tienes un saldo pendiente de <strong style="color:#b91c1c;">${formatoCLP(saldo)}</strong>. Coordina el pago con tu especialista.</span>
                    `;
                }
            } catch (err) {
                console.error("[cargarResumenFinanciero] Error:", err);
                grid.innerHTML = `
                    <div class="finance-card" style="grid-column: 1 / -1;">
                        <div class="finance-icon" style="background:#94a3b8;"><span class="material-symbols-outlined">error</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Resumen financiero</span>
                            <span class="finance-amount" style="font-size:1rem;">No disponible</span>
                            <span class="finance-foot">No pudimos cargar tu balance. Reintenta más tarde.</span>
                        </div>
                    </div>
                `;
                cta.style.display = 'none';
            }
        }

        function formatoCLP(monto) {
            try {
                return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(monto);
            } catch (_) {
                return `$${Math.round(monto).toLocaleString('es-CL')}`;
            }
        }

        // ==========================================================
        // REPOSITORIO DE DOCUMENTOS · Presupuestos vs Recetas
        // ==========================================================
        async function cargarDocumentos(pacienteId) {
            const contPresupuestos    = document.getElementById('listaPresupuestos');
            const contConsentimientos = document.getElementById('listaConsentimientos');
            const contRecetas         = document.getElementById('listaRecetas');

            try {
                const { data, error } = await window.midental
                    .from('documentos_pacientes')
                    .select('*, perfiles_dentistas(nombre_completo)')
                    .eq('paciente_id', pacienteId)
                    .order('created_at', { ascending: false });

                if (error) throw error;

                const docs = data || [];
                const presupuestos    = [];
                const consentimientos = [];
                const recetas         = [];

                docs.forEach(d => {
                    if (esConsentimiento(d))      consentimientos.push(d);
                    else if (esPresupuesto(d))    presupuestos.push(d);
                    else                          recetas.push(d);
                });

                contPresupuestos.innerHTML = presupuestos.length
                    ? presupuestos.map((d, i) => renderDocItem(d, `presu_${i}`, 'presupuesto')).join('')
                    : renderEmptyState('request_quote', 'Aún no hay presupuestos emitidos', 'Cuando tu especialista emita un presupuesto, aparecerá aquí.');

                contConsentimientos.innerHTML = consentimientos.length
                    ? consentimientos.map((d, i) => renderDocItem(d, `cons_${i}`, 'consentimiento')).join('')
                    : renderEmptyState('assignment_turned_in', 'Sin consentimientos informados', 'Cuando tu dentista emita un consentimiento informado, lo verás aquí.');

                contRecetas.innerHTML = recetas.length
                    ? recetas.map((d, i) => renderDocItem(d, `rec_${i}`, 'receta')).join('')
                    : renderEmptyState('prescriptions', 'Sin recetas ni exámenes', 'Sube tus radiografías, exámenes o recetas para mantenerlos a mano.');
            } catch (err) {
                console.error("[cargarDocumentos] Error:", err);
                contPresupuestos.innerHTML    = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tus presupuestos.');
                contConsentimientos.innerHTML = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tus consentimientos.');
                contRecetas.innerHTML         = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tus documentos.');
            }
        }

        function esPresupuesto(doc) {
            const nombre = (doc.nombre_archivo || '').toLowerCase();
            const tipo   = (doc.tipo || '').toLowerCase();
            return nombre.includes('presupuesto') || tipo.includes('presupuesto') || tipo === 'budget';
        }

        function esConsentimiento(doc) {
            const nombre = (doc.nombre_archivo || '').toLowerCase();
            const tipo   = (doc.tipo || '').toLowerCase();
            return nombre.includes('consentimiento') || tipo === 'consentimiento';
        }

        function renderDocItem(doc, refId, categoria) {
            const nombre   = doc.nombre_archivo || doc.titulo || 'Documento sin nombre';
            const esPDF    = nombre.toLowerCase().includes('.pdf') || (doc.tipo || '').toLowerCase().includes('pdf');
            const fecha    = doc.created_at ? new Date(doc.created_at).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
            const drNombre = doc.perfiles_dentistas?.nombre_completo ? `Dr/a. ${doc.perfiles_dentistas.nombre_completo}` : '';

            let iconClass = esPDF ? 'pdf' : 'img';
            let iconSymbol = esPDF ? 'picture_as_pdf' : 'image';
            if (categoria === 'presupuesto')        { iconClass = 'presupuesto';    iconSymbol = 'request_quote'; }
            else if (categoria === 'consentimiento'){ iconClass = 'consentimiento'; iconSymbol = 'assignment_turned_in'; }
            else if (categoria === 'receta')        { iconClass = 'receta';         iconSymbol = esPDF ? 'description' : 'prescriptions'; }

            const archivoRef = doc.archivo_url || doc.file_url || '';
            const refSafe = encodeURIComponent(archivoRef);

            return `
                <div class="doc-item">
                    <div class="doc-icon ${iconClass}">
                        <span class="material-symbols-outlined">${iconSymbol}</span>
                    </div>
                    <div class="doc-info">
                        <h4>${nombre}</h4>
                        <p>${drNombre ? drNombre + ' · ' : ''}${fecha}</p>
                    </div>
                    <button class="btn-pixar btn-ver-doc" id="btn-${refId}" onclick="verDocumentoSeguro('${refSafe}', '${refId}')">
                        <span class="material-symbols-outlined" style="font-size:1rem;">visibility</span> Ver Documento
                    </button>
                </div>
            `;
        }

        function renderEmptyState(icono, titulo, subtitulo) {
            return `
                <div class="empty-state">
                    <span class="material-symbols-outlined">${icono}</span>
                    <p>${titulo}</p>
                    <p class="empty-sub">${subtitulo}</p>
                </div>
            `;
        }

        // ==========================================================
        // SEGURIDAD · Signed URL bajo demanda (bucket privado)
        // ==========================================================
        async function verDocumentoSeguro(archivoRefEncoded, refId) {
            const btn = document.getElementById(`btn-${refId}`);
            const archivoRef = decodeURIComponent(archivoRefEncoded || '');
            if (!archivoRef) {
                console.error("[verDocumentoSeguro] archivo_url vacío");
                alert("Este documento no tiene un archivo asociado.");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="material-symbols-outlined spin" style="font-size:1rem;">sync</span> Abriendo...`;
            }

            try {
                // Si por compatibilidad fuese una URL pública absoluta, la abrimos directo.
                if (/^https?:\/\//i.test(archivoRef)) {
                    window.open(archivoRef, '_blank', 'noopener,noreferrer');
                    return;
                }

                const { data: signedData, error } = await window.midental
                    .storage
                    .from(BUCKET)
                    .createSignedUrl(archivoRef, 3600);

                if (error) throw error;
                if (!signedData?.signedUrl) throw new Error("No se generó la URL temporal.");

                window.open(signedData.signedUrl, '_blank', 'noopener,noreferrer');
            } catch (err) {
                console.error("[verDocumentoSeguro] Error generando Signed URL:", err);
                alert("No pudimos abrir el documento. Intenta nuevamente.");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<span class="material-symbols-outlined" style="font-size:1rem;">visibility</span> Ver Documento`;
                }
            }
        }

        // ==========================================================
        // SUBIDA DE DOCUMENTOS
        // ==========================================================
        async function procesarSubidaDocumento(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (!PACIENTE_ID) {
                alert("Sesión no válida. Vuelve a iniciar sesión.");
                return;
            }

            const botonTxt = document.getElementById('textoBotonSubida');
            const input    = document.getElementById('inputSubirDoc');

            if (file.size > 5 * 1024 * 1024) {
                alert("El archivo es muy pesado. Máximo 5MB.");
                input.value = "";
                return;
            }

            botonTxt.innerText = "Subiendo archivo... ⏳";
            input.disabled = true;

            try {
                const fileExt  = file.name.split('.').pop();
                const fileName = `Pct_${PACIENTE_ID}_${Date.now()}.${fileExt}`;

                const { error: uploadError } = await window.midental.storage
                    .from(BUCKET)
                    .upload(fileName, file);

                if (uploadError) throw uploadError;

                const { error: dbError } = await window.midental
                    .from('documentos_pacientes')
                    .insert([{
                        paciente_id: PACIENTE_ID,
                        nombre_archivo: file.name,
                        tipo: file.type.includes('pdf') ? 'pdf' : 'imagen',
                        archivo_url: fileName
                    }]);

                if (dbError) throw dbError;

                alert("✅ ¡Documento guardado de forma privada y segura!");
                cargarDocumentos(PACIENTE_ID);
            } catch (err) {
                console.error("[procesarSubidaDocumento] Error:", err);
                alert("Hubo un error al subir el documento. Intenta nuevamente.");
            } finally {
                botonTxt.innerText = "Seleccionar Archivo";
                input.disabled = false;
                input.value = "";
            }
        }
    </script>
</body>
</html>
