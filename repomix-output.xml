                            <button class="chip-template active" style="padding: 8px 15px; border-radius: 20px; border: 1px solid #ccc; cursor: pointer; background: var(--blue-elegant); color: white;" onclick="usarPlantilla('Limpieza Dental Profunda', 45000, 19990, this)">Limpieza</button>
                            <button class="chip-template" style="padding: 8px 15px; border-radius: 20px; border: 1px solid #ccc; cursor: pointer;" onclick="usarPlantilla('Blanqueamiento LED', 80000, 39990, this)">Blanqueamiento</button>
                            <button class="chip-template" style="padding: 8px 15px; border-radius: 20px; border: 1px solid #ccc; cursor: pointer;" onclick="limpiarPlantilla(this)">Personalizado</button>
                        </div>
                        <input type="text" id="inputNombrePrestacion" placeholder="Nombre del servicio (Ej: Evaluación de Ortodoncia)" class="apple-input-modal" value="Limpieza Dental Profunda">
                    </div>

                    <div class="pricing-section mt-20">
                        <p class="subtitle" style="font-weight: bold; margin-bottom: 10px;">2. Configura los Precios:</p>
                        <div class="pricing-inputs-grid" style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 15px; align-items: center;">
                            <div class="input-col">
                                <label style="font-size: 0.75rem; color: #888;">Precio Normal ($)</label>
                                <input type="number" id="inputPrecioReal" class="apple-input-modal" oninput="calcularDescuento()" value="45000">
                            </div>
                            <div class="input-col">
                                <label style="font-size: 0.75rem; color: var(--pixar-cyan); font-weight: bold;">Precio Oferta ($)</label>
                                <input type="number" id="inputPrecioOferta" class="apple-input-modal" oninput="calcularDescuento()" style="border-color: var(--pixar-cyan);" value="19990">
                            </div>
                            <div class="discount-badge active-discount" id="badgeDescuento" style="padding: 10px; border-radius: 12px; background: var(--pixar-orange); color: white; text-align: center; min-width: 80px;">
                                <strong id="textoDescuento">56% OFF</strong>
                            </div>
                        </div>
                    </div>

                    <div class="image-section mt-20">
                        <p class="subtitle" style="font-weight: bold; margin-bottom: 10px;">3. Imagen Promocional (Obligatoria):</p>
                        <div class="upload-promo-area" onclick="document.getElementById('inputFotoPromo').click()">
                            <div id="uploadPlaceholder">
                                <span class="material-symbols-outlined" style="font-size: 2.5rem; color: #cbd5e1;">add_photo_alternate</span>
                                <p style="margin: 5px 0 0 0; color: #64748b;">Sube una foto atractiva del tratamiento</p>
                            </div>
                            <img src="" id="promoPreview" class="promo-preview-img">
                        </div>
                        <input type="file" id="inputFotoPromo" accept="image/*" style="display: none;" onchange="mostrarPreviewPromocion(this)">
                    </div>

                    <div class="duration-section mt-20">
                        <p class="subtitle" style="font-weight: bold; margin-bottom: 10px;">4. Duración y Costo de la Campaña:</p>
                        <div class="duration-options" style="display: flex; gap: 10px;">
                            <div class="duration-card selected" data-dias="1" data-costo="1" onclick="seleccionarDuracion(this)">
                                <strong>1 Día (Destacado)</strong><br><span style="color: var(--dentist-purple); font-weight: bold;">1 Token</span>
                            </div>
                            <div class="duration-card" data-dias="7" data-costo="5" onclick="seleccionarDuracion(this)">
                                <strong>7 Días (Semana)</strong><br><span style="color: var(--dentist-purple); font-weight: bold;">5 Tokens</span>
                            </div>
                        </div>
                    </div>

                    <div class="schedule-section mt-20">
                        <p class="subtitle" style="font-weight: bold; margin-bottom: 10px;">5. ¿Cuándo quieres que inicie la campaña?</p>
                        <div style="display: flex; gap: 15px; align-items: center;">
                            <select id="tipoInicio" class="apple-input-modal" onchange="toggleProgramacion()" style="background: white; width: 250px;">
                                <option value="ahora">Empezar ahora mismo</option>
                                <option value="programado">Programar fecha y hora</option>
                            </select>
                            <input type="datetime-local" id="inputFechaInicio" class="apple-input-modal" style="display: none; width: 250px;">
                        </div>
                        <p style="font-size: 0.8rem; color: #888; margin-top: 5px;">El tiempo de la oferta comenzará a correr desde este momento exacto.</p>
                    </div>

                    <button class="btn-pixar btn-ofertas btn-full mt-20" id="btnPublicarOferta" onclick="publicarOfertaEnSupabase()" style="padding: 18px; font-size: 1.1rem; background: linear-gradient(135deg, #f39c12 0%, #d35400 100%);">
                        <span class="material-symbols-outlined">rocket_launch</span> Publicar en el Mapa (-1 Token)
                    </button>
                </div>

                <div class="token-info-sidebar">
                    <div class="wallet-summary-card" style="background: white; padding: 25px; border-radius: 20px; text-align: center; border: 1px solid #eee; position: sticky; top: 20px;">
                        <h3 style="color: var(--blue-elegant); margin-top: 0;">Tu Monedero</h3>
                        <div class="big-token-display" style="font-size: 3rem; color: var(--dentist-purple); margin: 15px 0; font-weight: 900; text-shadow: 0 4px 10px rgba(155, 89, 182, 0.2);">
                            <span class="material-symbols-outlined" style="font-size: 2.5rem; vertical-align: middle;">toll</span>
                            <span id="sidebarTokenBalance">--</span>
                        </div>
                        <p style="color: #888; font-size: 0.9rem; margin-bottom: 20px;">Utiliza tus tokens para posicionarte primero en el mapa de pacientes.</p>
                        <button class="btn-pixar btn-full" style="background: var(--blue-elegant);" onclick="window.location.href='monedero-dentista.html'">
                            <span class="material-symbols-outlined">add_shopping_cart</span> Comprar Tokens
                        </button>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>

    <script>
        let costoTokensActual = 1;
        let diasDuracionActual = 1;
        let archivoPromoSeleccionado = null;
        let cronometroFlashInterval; 

        document.addEventListener('DOMContentLoaded', () => {
            cargarOfertaActiva();
        });

        function toggleProgramacion() {
            const tipo = document.getElementById('tipoInicio').value;
            const inputFecha = document.getElementById('inputFechaInicio');
            if (tipo === 'programado') {
                inputFecha.style.display = 'block';
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                inputFecha.min = now.toISOString().slice(0, 16);
            } else {
                inputFecha.style.display = 'none';
                inputFecha.value = '';
            }
        }

        function usarPlantilla(n, pr, po, el) {
            document.querySelectorAll('.chip-template').forEach(b => { b.classList.remove('active'); b.style.background = 'transparent'; b.style.color = 'inherit'; });
            el.classList.add('active');
            el.style.background = 'var(--blue-elegant)';
            el.style.color = 'white';
            
            document.getElementById('inputNombrePrestacion').value = n;
            document.getElementById('inputPrecioReal').value = pr;
            document.getElementById('inputPrecioOferta').value = po;
            calcularDescuento();
        }

        function limpiarPlantilla(el) {
            document.querySelectorAll('.chip-template').forEach(b => { b.classList.remove('active'); b.style.background = 'transparent'; b.style.color = 'inherit'; });
            el.classList.add('active');
            el.style.background = 'var(--blue-elegant)';
            el.style.color = 'white';
            
            document.getElementById('inputNombrePrestacion').value = '';
            document.getElementById('inputPrecioReal').value = '';
            document.getElementById('inputPrecioOferta').value = '';
            calcularDescuento();
        }

        function calcularDescuento() {
            const r = parseFloat(document.getElementById('inputPrecioReal').value);
            const o = parseFloat(document.getElementById('inputPrecioOferta').value);
            const badge = document.getElementById('badgeDescuento');
            if (r > 0 && o > 0 && r > o) {
                const p = Math.round(100 - ((o / r) * 100));
                document.getElementById('textoDescuento').innerText = p + "% OFF";
                badge.classList.add('active-discount');
            } else {
                badge.classList.remove('active-discount');
                document.getElementById('textoDescuento').innerText = "0% OFF";
            }
        }

        function seleccionarDuracion(el) {
            document.querySelectorAll('.duration-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            costoTokensActual = parseInt(el.getAttribute('data-costo'));
            diasDuracionActual = parseInt(el.getAttribute('data-dias'));
            
            document.getElementById('btnPublicarOferta').innerHTML = `<span class="material-symbols-outlined">rocket_launch</span> Publicar en el Mapa (-${costoTokensActual} Tokens)`;
        }

        function mostrarPreviewPromocion(input) {
            if (input.files && input.files[0]) {
                archivoPromoSeleccionado = input.files[0];
                
                // Verificar que no sea excesivamente pesado (limitar a 3MB por salud de tu servidor)
                if (archivoPromoSeleccionado.size > 3 * 1024 * 1024) {
                    alert("La imagen es muy pesada. Por favor, sube una de menos de 3MB.");
                    input.value = "";
                    archivoPromoSeleccionado = null;
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('uploadPlaceholder').style.display = 'none';
                    const img = document.getElementById('promoPreview');
                    img.src = e.target.result;
                    img.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ==========================================
        // COMUNICACIÓN CON SUPABASE BLINDADA (BUCKET EN MINÚSCULAS)
        // ==========================================

        async function publicarOfertaEnSupabase() {
            const dentistaId = localStorage.getItem('midental_user_id');
            if (!dentistaId) return alert("Sesión inválida.");

            const nombre = document.getElementById('inputNombrePrestacion').value.trim();
            const pReal = document.getElementById('inputPrecioReal').value;
            const pOferta = document.getElementById('inputPrecioOferta').value;
            const btn = document.getElementById('btnPublicarOferta');

            if (!nombre || !pReal || !pOferta) return alert("Completa todos los datos de la oferta.");
            if (!archivoPromoSeleccionado) return alert("⚠️ Debes subir una imagen promocional obligatoriamente.");
            
            const tipoInicio = document.getElementById('tipoInicio').value;
            const inputFecha = document.getElementById('inputFechaInicio').value;
            
            let fechaInicio = new Date();
            if (tipoInicio === 'programado') {
                if (!inputFecha) return alert("Por favor selecciona la fecha y hora de inicio.");
                fechaInicio = new Date(inputFecha);
                if (fechaInicio < new Date()) return alert("La fecha programada no puede estar en el pasado.");
            }
            
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Verificando saldo...';

            try {
                // 1. Verificación segura de saldo en DB
                const { data: perfilData, error: perfilError } = await window.midental
                    .from('perfiles_dentistas')
                    .select('tokens_disponibles')
                    .eq('id', dentistaId)
                    .single();
                
                if(perfilError) throw new Error("Error al verificar el monedero con el servidor.");
                
                const saldoRealDB = perfilData.tokens_disponibles || 0;
                
                if (saldoRealDB < costoTokensActual) {
                    throw new Error(`Saldo insuficiente. La campaña cuesta ${costoTokensActual} tokens, pero tu monedero real tiene ${saldoRealDB}.`);
                }

                btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Subiendo imagen y publicando...';

                // 2. SUBIR IMAGEN A BUCKET "ofertas" EN MINÚSCULAS
                const fileExt = archivoPromoSeleccionado.name.split('.').pop();
                const fileName = `promo_${dentistaId}_${Date.now()}.${fileExt}`;
                
                const { error: uploadError } = await window.midental.storage
                    .from('ofertas')
                    .upload(fileName, archivoPromoSeleccionado);
                    
                if (uploadError) throw new Error("Error al subir la imagen a Storage: " + uploadError.message);
                
                const { data: urlData } = window.midental.storage
                    .from('ofertas')
                    .getPublicUrl(fileName);
                    
                const imagenPublicUrl = urlData.publicUrl;

                // 3. Calcular fechas
                const fechaExpiracion = new Date(fechaInicio.getTime());
                fechaExpiracion.setDate(fechaExpiracion.getDate() + diasDuracionActual);

                // 4. Guardar en BD Ofertas
                const { error: insertError } = await window.midental.from('ofertas_flash').insert([{
                    dentista_id: dentistaId,
                    servicio_nombre: nombre,
                    precio_real: parseInt(pReal),
                    precio_oferta: parseInt(pOferta),
                    inicio_at: fechaInicio.toISOString(),
                    expira_at: fechaExpiracion.toISOString(),
                    imagen_url: imagenPublicUrl,
                    tokens_costo: costoTokensActual,
                    activa: true
                }]);

                if (insertError) throw new Error("Error al guardar la oferta: " + insertError.message);

                // 5. Descontar Tokens
                const nuevoSaldo = saldoRealDB - costoTokensActual;
                const { error: tokenError } = await window.midental.from('perfiles_dentistas').update({ tokens_disponibles: nuevoSaldo }).eq('id', dentistaId);
                if (tokenError) throw new Error("Oferta publicada, pero hubo un error actualizando el monedero.");

                // Éxito
                if (tipoInicio === 'programado') {
                    alert(`✅ ¡Campaña programada con éxito! Iniciará automáticamente el ${fechaInicio.toLocaleString('es-CL')}.`);
                } else {
                    alert("🚀 ¡Campaña activa! Los pacientes de tu sector ya pueden verla y agendar.");
                }
                
                if (typeof window.sincronizarDatosGlobales === 'function') {
                    window.sincronizarDatosGlobales();
                }
                cargarOfertaActiva();

                // Limpiar formulario UI
                archivoPromoSeleccionado = null;
                document.getElementById('uploadPlaceholder').style.display = 'block';
                document.getElementById('promoPreview').style.display = 'none';
                document.getElementById('tipoInicio').value = 'ahora';
                toggleProgramacion();

            } catch (err) {
                alert(err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined">rocket_launch</span> Publicar en el Mapa (-${costoTokensActual} Tokens)`;
            }
        }

        async function cargarOfertaActiva() {
            const dentistaId = localStorage.getItem('midental_user_id');
            if (!dentistaId) return;

            const { data, error } = await window.midental
                .from('ofertas_flash')
                .select('*')
                .eq('dentista_id', dentistaId)
                .eq('activa', true)
                .gte('expira_at', new Date().toISOString())
                .order('created_at', { ascending: false })
                .limit(1)
                .single();

            if (data) {
                document.getElementById('monitorNombrePrestacion').innerText = data.servicio_nombre;
                const fechaExp = new Date(data.expira_at).getTime();
                
                let estado = "Activa en el muro";
                if(data.inicio_at && new Date(data.inicio_at) > new Date()) {
                    estado = "Programada (En Espera)";
                }
                document.getElementById('monitorEstadoPublicacion').innerText = estado;
                document.getElementById('monitorOfertaActiva').style.display = 'block';
                window.ofertaActivaId = data.id; 

                clearInterval(cronometroFlashInterval);
                cronometroFlashInterval = setInterval(function() {
                    const ahora = new Date().getTime();
                    const distancia = fechaExp - ahora;

                    if (distancia < 0) {
                        clearInterval(cronometroFlashInterval);
                        document.getElementById('monitorCronometro').innerText = "Finalizada";
                        document.getElementById('monitorCronometro').style.color = "var(--red-urgency)";
                        return;
                    }

                    const dias = Math.floor(distancia / (1000 * 60 * 60 * 24));
                    const horas = Math.floor((distancia % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutos = Math.floor((distancia % (1000 * 60 * 60)) / (1000 * 60));
                    const segundos = Math.floor((distancia % (1000 * 60)) / 1000);

                    let textoTiempo = "";
                    if (dias > 0) textoTiempo += `${dias}d `;
                    textoTiempo += `${horas.toString().padStart(2,'0')}:${minutos.toString().padStart(2,'0')}:${segundos.toString().padStart(2,'0')}`;
                    
                    document.getElementById('monitorCronometro').innerText = textoTiempo;
                }, 1000);

            } else {
                document.getElementById('monitorOfertaActiva').style.display = 'none';
                clearInterval(cronometroFlashInterval);
            }
        }

        async function detenerOferta() {
            if(!window.ofertaActivaId) return;
            if(confirm("¿Estás seguro de detener esta campaña? Los tokens descontados no se devuelven.")) {
                await window.midental.from('ofertas_flash').update({ activa: false }).eq('id', window.ofertaActivaId);
                alert("Campaña detenida.");
                cargarOfertaActiva();
            }
        }
    </script>
</body>
</html>
</file>

<file path="documentos-paciente.html">
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Finanzas y Documentos</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <style>
        body { background-color: #f8fafc; padding-bottom: 90px; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .docs-container { padding: 20px; max-width: 800px; margin: 0 auto; }
        .section-title { font-size: 1.1rem; color: var(--blue-elegant); margin: 25px 0 15px 0; font-weight: bold; display: flex; align-items: center; gap: 8px; }

        /* ============================================== */
        /* RESUMEN FINANCIERO · 3 TARJETAS                */
        /* ============================================== */
        .financial-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 10px;
        }
        .finance-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 16px 14px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
            display: flex;
            flex-direction: column;
            gap: 6px;
            position: relative;
            overflow: hidden;
            min-height: 110px;
        }
        .finance-card .finance-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 1rem;
            background: var(--pixar-cyan);
        }
        .finance-card .finance-label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
        }
        .finance-card .finance-amount {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--blue-elegant);
            line-height: 1.1;
            word-break: break-word;
        }
        .finance-card.is-budget   { background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%); border-color: #bfdbfe; }
        .finance-card.is-paid     { background: linear-gradient(135deg, #ffffff 0%, #ecfeff 100%); border-color: #a5f3fc; }
        .finance-card.is-paid .finance-icon { background: var(--pixar-cyan); }

        .finance-card.is-alert    { background: linear-gradient(135deg, #fff7ed 0%, #fee2e2 100%); border-color: #fca5a5; }
        .finance-card.is-alert .finance-icon { background: #ef4444; }
        .finance-card.is-alert .finance-amount { color: #b91c1c; }

        .finance-card.is-success  { background: linear-gradient(135deg, #ffffff 0%, #dcfce7 100%); border-color: #86efac; }
        .finance-card.is-success .finance-icon { background: #16a34a; }
        .finance-card.is-success .finance-amount { color: #166534; }

        .finance-foot {
            font-size: 0.75rem;
            color: #94a3b8;
            margin-top: 4px;
        }
        .finance-cta {
            background: white;
            border-radius: 14px;
            padding: 12px 16px;
            border: 1px dashed #cbd5e1;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            color: #475569;
            margin-bottom: 25px;
            margin-top: 12px;
        }
        .finance-cta .material-symbols-outlined { color: var(--pixar-cyan); }

        /* ============================================== */
        /* ZONA DE SUBIDA DE ARCHIVOS                     */
        /* ============================================== */
        .upload-zone { border: 2px dashed #cbd5e1; border-radius: 15px; padding: 26px 20px; text-align: center; background: white; cursor: pointer; transition: 0.3s; margin-bottom: 25px; position: relative; }
        .upload-zone:hover { border-color: var(--pixar-cyan); background: #f0fdfa; }
        .upload-zone input[type="file"] { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
        .upload-btn { background: var(--pixar-cyan); color: white; padding: 10px 20px; border-radius: 20px; font-weight: bold; display: inline-block; margin-top: 8px; pointer-events: none; }

        /* ============================================== */
        /* LISTADO DE DOCUMENTOS                          */
        /* ============================================== */
        .doc-item {
            background: white;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 10px;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
            transition: 0.2s;
        }
        .doc-item:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06); }
        .doc-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .doc-icon.pdf { background: #fee2e2; color: #ef4444; }
        .doc-icon.img { background: #e0f2fe; color: #0ea5e9; }
        .doc-icon.presupuesto { background: var(--pixar-cyan); color: white; }
        .doc-icon.receta { background: #ede9fe; color: #7c3aed; }

        .doc-info { flex: 1; min-width: 0; }
        .doc-info h4 { margin: 0 0 3px 0; font-size: 0.95rem; color: #334155; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .doc-info p { margin: 0; font-size: 0.78rem; color: #94a3b8; }

        .btn-pixar.btn-ver-doc {
            background: var(--pixar-cyan);
            box-shadow: 0 4px 0 var(--pixar-cyan-shadow, #0086CC);
            padding: 8px 14px;
            font-size: 0.8rem;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            white-space: nowrap;
        }
        .btn-pixar.btn-ver-doc:active { transform: translateY(4px); box-shadow: 0 0 0 transparent !important; }
        .btn-pixar.btn-ver-doc[disabled] { opacity: 0.6; cursor: not-allowed; }

        /* ============================================== */
        /* EMPTY STATE                                    */
        /* ============================================== */
        .empty-state {
            text-align: center;
            padding: 30px 20px;
            color: #64748b;
            background: white;
            border-radius: 15px;
            border: 1px dashed #cbd5e1;
        }
        .empty-state span.material-symbols-outlined { font-size: 2.6rem; color: #94a3b8; display: block; margin-bottom: 6px; }
        .empty-state p { margin: 3px 0; font-size: 0.9rem; }
        .empty-state .empty-sub { font-size: 0.78rem; color: #94a3b8; }

        .bottom-nav { background: white; border-top: none; }

        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .spin { animation: spin 1.2s linear infinite; display: inline-block; }

        /* RESPONSIVE */
        @media (max-width: 600px) {
            .financial-grid { grid-template-columns: 1fr; }
            .finance-card { min-height: auto; flex-direction: row; align-items: center; gap: 14px; }
            .finance-card .finance-icon { width: 42px; height: 42px; }
            .finance-card > div.finance-body { display: flex; flex-direction: column; flex: 1; }
            .finance-card .finance-amount { font-size: 1.4rem; }
            .docs-container { padding: 14px; }
        }
    </style>
</head>
<body>

    <header style="padding: 20px; background: white; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 100; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.02);">
        <h2 style="margin: 0; font-size: 1.3rem; color: var(--blue-elegant);">Finanzas y Documentos</h2>
    </header>

    <div class="docs-container">

        <!-- RESUMEN FINANCIERO -->
        <div class="section-title">
            <span class="material-symbols-outlined" style="color: var(--pixar-cyan);">payments</span>
            Resumen Financiero
        </div>
        <div class="financial-grid" id="financialGrid">
            <div class="finance-card is-budget">
                <div class="finance-icon"><span class="material-symbols-outlined spin">sync</span></div>
                <div class="finance-body">
                    <span class="finance-label">Total Presupuestado</span>
                    <span class="finance-amount">—</span>
                </div>
            </div>
            <div class="finance-card is-paid">
                <div class="finance-icon"><span class="material-symbols-outlined spin">sync</span></div>
                <div class="finance-body">
                    <span class="finance-label">Total Pagado</span>
                    <span class="finance-amount">—</span>
                </div>
            </div>
            <div class="finance-card">
                <div class="finance-icon"><span class="material-symbols-outlined spin">sync</span></div>
                <div class="finance-body">
                    <span class="finance-label">Saldo Pendiente</span>
                    <span class="finance-amount">—</span>
                </div>
            </div>
        </div>
        <div class="finance-cta" id="financeCta">
            <span class="material-symbols-outlined">info</span>
            <span>Tu balance financiero se actualiza en tiempo real con tus pagos y presupuestos.</span>
        </div>

        <!-- ZONA DE SUBIDA -->
        <div class="section-title">
            <span class="material-symbols-outlined" style="color: var(--blue-elegant);">upload_file</span>
            Subir Exámenes o Radiografías
        </div>
        <div class="upload-zone" id="zonaSubida">
            <span class="material-symbols-outlined" style="font-size: 2.8rem; color: #94a3b8;">cloud_upload</span>
            <p style="color: #64748b; margin: 8px 0;">Toca aquí para subir fotos o PDFs<br><small>(Máx. 5MB)</small></p>
            <div class="upload-btn" id="textoBotonSubida">Seleccionar Archivo</div>
            <input type="file" id="inputSubirDoc" accept="image/*,.pdf" onchange="procesarSubidaDocumento(event)">
        </div>

        <!-- PRESUPUESTOS EMITIDOS -->
        <div class="section-title">
            <span class="material-symbols-outlined" style="color: var(--pixar-cyan);">request_quote</span>
            Presupuestos Emitidos
        </div>
        <div id="listaPresupuestos">
            <div class="empty-state"><span class="material-symbols-outlined spin">sync</span><p>Cargando presupuestos...</p></div>
        </div>

        <!-- RECETAS Y EXÁMENES -->
        <div class="section-title">
            <span class="material-symbols-outlined" style="color: #7c3aed;">prescriptions</span>
            Recetas Médicas / Exámenes
        </div>
        <div id="listaRecetas">
            <div class="empty-state"><span class="material-symbols-outlined spin">sync</span><p>Cargando documentos...</p></div>
        </div>

    </div>

    <nav class="bottom-nav">
        <a href="dashboard-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">home</span>Inicio</a>
        <a href="mapa-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">search</span>Buscar</a>
        <a href="ofertas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom active"><span class="material-symbols-outlined">description</span>Documentos</a>
        <a href="perfil-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">person</span>Perfil</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    <script>
        // ==========================================================
        // BOOT · Identidad clínica
        // ==========================================================
        let PACIENTE_ID = null;
        const BUCKET = 'documentos_clinicos';

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                PACIENTE_ID = await resolverPacienteId();
                if (!PACIENTE_ID) {
                    alert("Debes iniciar sesión como paciente para ver tus documentos.");
                    window.location.href = 'index.html';
                    return;
                }
                await Promise.all([
                    cargarResumenFinanciero(PACIENTE_ID),
                    cargarDocumentos(PACIENTE_ID)
                ]);
            } catch (err) {
                console.error("[BOOT] Error inicializando portal de documentos:", err);
                alert("No pudimos cargar tu portal financiero. Intenta nuevamente.");
            }
        });

        async function resolverPacienteId() {
            try {
                let authUid = null;
                try {
                    const { data: sessionData } = await window.midental.auth.getUser();
                    authUid = sessionData?.user?.id || null;
                } catch (e) {
                    console.warn("[Auth] No se pudo obtener auth.getUser():", e);
                }
                if (!authUid) authUid = localStorage.getItem('midental_user_id');

                const tipoUser = localStorage.getItem('midental_user_tipo');
                if (!authUid || (tipoUser && tipoUser !== 'paciente')) return null;

                const { data, error } = await window.midental
                    .from('perfiles_pacientes')
                    .select('id, user_id')
                    .eq('user_id', authUid)
                    .maybeSingle();

                if (error) throw error;
                if (data?.id) return data.id;

                return authUid;
            } catch (err) {
                console.error("[resolverPacienteId] Error:", err);
                return localStorage.getItem('midental_user_id');
            }
        }

        // ==========================================================
        // RESUMEN FINANCIERO · vista_balance_paciente
        // ==========================================================
        async function cargarResumenFinanciero(pacienteId) {
            const grid = document.getElementById('financialGrid');
            const cta = document.getElementById('financeCta');

            try {
                const { data, error } = await window.midental
                    .from('vista_balance_paciente')
                    .select('presupuesto_integral, total_pagado, saldo_restante')
                    .eq('paciente_id', pacienteId)
                    .maybeSingle();

                if (error) throw error;

                const presupuesto = Number(data?.presupuesto_integral ?? 0);
                const pagado      = Number(data?.total_pagado ?? 0);
                const saldo       = Number(data?.saldo_restante ?? (presupuesto - pagado));

                const saldoEsAlerta = saldo > 0;
                const saldoEsExito  = saldo <= 0;

                grid.innerHTML = `
                    <div class="finance-card is-budget">
                        <div class="finance-icon"><span class="material-symbols-outlined">description</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Total Presupuestado</span>
                            <span class="finance-amount">${formatoCLP(presupuesto)}</span>
                        </div>
                    </div>
                    <div class="finance-card is-paid">
                        <div class="finance-icon"><span class="material-symbols-outlined">paid</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Total Pagado</span>
                            <span class="finance-amount">${formatoCLP(pagado)}</span>
                        </div>
                    </div>
                    <div class="finance-card ${saldoEsAlerta ? 'is-alert' : 'is-success'}">
                        <div class="finance-icon">
                            <span class="material-symbols-outlined">${saldoEsAlerta ? 'warning' : 'task_alt'}</span>
                        </div>
                        <div class="finance-body">
                            <span class="finance-label">Saldo Pendiente</span>
                            <span class="finance-amount">${formatoCLP(Math.max(saldo, 0))}</span>
                        </div>
                    </div>
                `;

                if (saldoEsExito) {
                    cta.innerHTML = `
                        <span class="material-symbols-outlined" style="color:#16a34a;">verified</span>
                        <span><strong style="color:#166534;">¡Estás al día!</strong> No registras saldo pendiente con tu especialista.</span>
                    `;
                } else {
                    cta.innerHTML = `
                        <span class="material-symbols-outlined" style="color:#ef4444;">priority_high</span>
                        <span>Tienes un saldo pendiente de <strong style="color:#b91c1c;">${formatoCLP(saldo)}</strong>. Coordina el pago con tu especialista.</span>
                    `;
                }
            } catch (err) {
                console.error("[cargarResumenFinanciero] Error:", err);
                grid.innerHTML = `
                    <div class="finance-card" style="grid-column: 1 / -1;">
                        <div class="finance-icon" style="background:#94a3b8;"><span class="material-symbols-outlined">error</span></div>
                        <div class="finance-body">
                            <span class="finance-label">Resumen financiero</span>
                            <span class="finance-amount" style="font-size:1rem;">No disponible</span>
                            <span class="finance-foot">No pudimos cargar tu balance. Reintenta más tarde.</span>
                        </div>
                    </div>
                `;
                cta.style.display = 'none';
            }
        }

        function formatoCLP(monto) {
            try {
                return new Intl.NumberFormat('es-CL', { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(monto);
            } catch (_) {
                return `$${Math.round(monto).toLocaleString('es-CL')}`;
            }
        }

        // ==========================================================
        // REPOSITORIO DE DOCUMENTOS · Presupuestos vs Recetas
        // ==========================================================
        async function cargarDocumentos(pacienteId) {
            const contPresupuestos = document.getElementById('listaPresupuestos');
            const contRecetas      = document.getElementById('listaRecetas');

            try {
                const { data, error } = await window.midental
                    .from('documentos_pacientes')
                    .select('*, perfiles_dentistas(nombre_completo)')
                    .eq('paciente_id', pacienteId)
                    .order('created_at', { ascending: false });

                if (error) throw error;

                const docs = data || [];
                const presupuestos = [];
                const recetas      = [];

                docs.forEach(d => {
                    if (esPresupuesto(d)) presupuestos.push(d);
                    else recetas.push(d);
                });

                contPresupuestos.innerHTML = presupuestos.length
                    ? presupuestos.map((d, i) => renderDocItem(d, `presu_${i}`, 'presupuesto')).join('')
                    : renderEmptyState('request_quote', 'Aún no hay presupuestos emitidos', 'Cuando tu especialista emita un presupuesto, aparecerá aquí.');

                contRecetas.innerHTML = recetas.length
                    ? recetas.map((d, i) => renderDocItem(d, `rec_${i}`, 'receta')).join('')
                    : renderEmptyState('prescriptions', 'Sin recetas ni exámenes', 'Sube tus radiografías, exámenes o recetas para mantenerlos a mano.');
            } catch (err) {
                console.error("[cargarDocumentos] Error:", err);
                contPresupuestos.innerHTML = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tus presupuestos.');
                contRecetas.innerHTML = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tus documentos.');
            }
        }

        function esPresupuesto(doc) {
            const nombre = (doc.nombre_archivo || '').toLowerCase();
            const tipo   = (doc.tipo || '').toLowerCase();
            return nombre.includes('presupuesto') || tipo.includes('presupuesto') || tipo === 'budget';
        }

        function renderDocItem(doc, refId, categoria) {
            const nombre   = doc.nombre_archivo || doc.titulo || 'Documento sin nombre';
            const esPDF    = nombre.toLowerCase().includes('.pdf') || (doc.tipo || '').toLowerCase().includes('pdf');
            const fecha    = doc.created_at ? new Date(doc.created_at).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
            const drNombre = doc.perfiles_dentistas?.nombre_completo ? `Dr/a. ${doc.perfiles_dentistas.nombre_completo}` : '';

            let iconClass = esPDF ? 'pdf' : 'img';
            let iconSymbol = esPDF ? 'picture_as_pdf' : 'image';
            if (categoria === 'presupuesto') { iconClass = 'presupuesto'; iconSymbol = 'request_quote'; }
            else if (categoria === 'receta') { iconClass = 'receta'; iconSymbol = esPDF ? 'description' : 'prescriptions'; }

            const archivoRef = doc.archivo_url || doc.file_url || '';
            const refSafe = encodeURIComponent(archivoRef);

            return `
                <div class="doc-item">
                    <div class="doc-icon ${iconClass}">
                        <span class="material-symbols-outlined">${iconSymbol}</span>
                    </div>
                    <div class="doc-info">
                        <h4>${nombre}</h4>
                        <p>${drNombre ? drNombre + ' · ' : ''}${fecha}</p>
                    </div>
                    <button class="btn-pixar btn-ver-doc" id="btn-${refId}" onclick="verDocumentoSeguro('${refSafe}', '${refId}')">
                        <span class="material-symbols-outlined" style="font-size:1rem;">visibility</span> Ver Documento
                    </button>
                </div>
            `;
        }

        function renderEmptyState(icono, titulo, subtitulo) {
            return `
                <div class="empty-state">
                    <span class="material-symbols-outlined">${icono}</span>
                    <p>${titulo}</p>
                    <p class="empty-sub">${subtitulo}</p>
                </div>
            `;
        }

        // ==========================================================
        // SEGURIDAD · Signed URL bajo demanda (bucket privado)
        // ==========================================================
        async function verDocumentoSeguro(archivoRefEncoded, refId) {
            const btn = document.getElementById(`btn-${refId}`);
            const archivoRef = decodeURIComponent(archivoRefEncoded || '');
            if (!archivoRef) {
                console.error("[verDocumentoSeguro] archivo_url vacío");
                alert("Este documento no tiene un archivo asociado.");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="material-symbols-outlined spin" style="font-size:1rem;">sync</span> Abriendo...`;
            }

            try {
                // Si por compatibilidad fuese una URL pública absoluta, la abrimos directo.
                if (/^https?:\/\//i.test(archivoRef)) {
                    window.open(archivoRef, '_blank', 'noopener,noreferrer');
                    return;
                }

                const { data: signedData, error } = await window.midental
                    .storage
                    .from(BUCKET)
                    .createSignedUrl(archivoRef, 3600);

                if (error) throw error;
                if (!signedData?.signedUrl) throw new Error("No se generó la URL temporal.");

                window.open(signedData.signedUrl, '_blank', 'noopener,noreferrer');
            } catch (err) {
                console.error("[verDocumentoSeguro] Error generando Signed URL:", err);
                alert("No pudimos abrir el documento. Intenta nuevamente.");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `<span class="material-symbols-outlined" style="font-size:1rem;">visibility</span> Ver Documento`;
                }
            }
        }

        // ==========================================================
        // SUBIDA DE DOCUMENTOS
        // ==========================================================
        async function procesarSubidaDocumento(event) {
            const file = event.target.files[0];
            if (!file) return;
            if (!PACIENTE_ID) {
                alert("Sesión no válida. Vuelve a iniciar sesión.");
                return;
            }

            const botonTxt = document.getElementById('textoBotonSubida');
            const input    = document.getElementById('inputSubirDoc');

            if (file.size > 5 * 1024 * 1024) {
                alert("El archivo es muy pesado. Máximo 5MB.");
                input.value = "";
                return;
            }

            botonTxt.innerText = "Subiendo archivo... ⏳";
            input.disabled = true;

            try {
                const fileExt  = file.name.split('.').pop();
                const fileName = `Pct_${PACIENTE_ID}_${Date.now()}.${fileExt}`;

                const { error: uploadError } = await window.midental.storage
                    .from(BUCKET)
                    .upload(fileName, file);

                if (uploadError) throw uploadError;

                const { error: dbError } = await window.midental
                    .from('documentos_pacientes')
                    .insert([{
                        paciente_id: PACIENTE_ID,
                        nombre_archivo: file.name,
                        tipo: file.type.includes('pdf') ? 'pdf' : 'imagen',
                        archivo_url: fileName
                    }]);

                if (dbError) throw dbError;

                alert("✅ ¡Documento guardado de forma privada y segura!");
                cargarDocumentos(PACIENTE_ID);
            } catch (err) {
                console.error("[procesarSubidaDocumento] Error:", err);
                alert("Hubo un error al subir el documento. Intenta nuevamente.");
            } finally {
                botonTxt.innerText = "Seleccionar Archivo";
                input.disabled = false;
                input.value = "";
            }
        }
    </script>
</body>
</html>
