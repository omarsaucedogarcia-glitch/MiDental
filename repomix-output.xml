let mesesOffset = 0;
let cacheFinanzasMesActivo = { brutos: 0, lab: 0, conv: 0, neto: 0 };

function getRangoMesOffset(n) {
    const hoy = new Date();
    const targetMonth = hoy.getMonth() + n;
    const ini = new Date(hoy.getFullYear(), targetMonth, 1);
    const fin = new Date(hoy.getFullYear(), targetMonth + 1, 1);
    // finDate es un milisegundo antes del primer día del próximo mes (para mostrar el rótulo correcto)
    return { inicio: ini.toISOString(), fin: fin.toISOString(), iniDate: ini, finDate: new Date(fin.getTime() - 1) };
}

async function abrirModalFinanzasMes() {
    mesesOffset = 0; 
    document.getElementById('modalFinanzasMes').style.display = 'flex';
    await refrescarPanelFinanzasMes();
}

function cerrarModalFinanzasMes() {
    document.getElementById('modalFinanzasMes').style.display = 'none';
}

function navMes(delta) {
    if (mesesOffset + delta > 0) return; // No permitir meses futuros
    mesesOffset += delta;
    refrescarPanelFinanzasMes();
}

function actualizarBarraNavMes(rm) {
    const nombresMeses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
    const lblRango = document.getElementById('lblMesActualFinanzas');
    const lblOff = document.getElementById('lblMesOffset');
    
    if (lblRango) lblRango.innerText = `${nombresMeses[rm.iniDate.getMonth()]} ${rm.iniDate.getFullYear()}`;
    
    if (lblOff) {
        if (mesesOffset === 0) lblOff.innerText = 'Mes actual';
        else if (mesesOffset === -1) lblOff.innerText = 'Mes pasado';
        else lblOff.innerText = `${Math.abs(mesesOffset)} meses atrás`;
    }

    const btnNext = document.getElementById('btnMesNext');
    if (btnNext) {
        const yaEsActual = mesesOffset >= 0;
        btnNext.disabled = yaEsActual;
        btnNext.style.cursor = yaEsActual ? 'not-allowed' : 'pointer';
        btnNext.style.opacity = yaEsActual ? '0.4' : '1';
    }
}

async function refrescarPanelFinanzasMes() {
    const userId = localStorage.getItem('midental_user_id');
    const rm = getRangoMesOffset(mesesOffset);

    actualizarBarraNavMes(rm);

    const labCont = document.getElementById('listaLaboratorioMes');
    const convCont = document.getElementById('listaConveniosMes');
    if (labCont) labCont.innerHTML = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:15px;">Cargando…</p>';
    if (convCont) convCont.innerHTML = '<p style="color:#94a3b8;font-size:0.85rem;text-align:center;padding:15px;">Cargando…</p>';
    ['finMesBrutos','finMesLabTotal','finMesConvTotal','finMesNetoTotal'].forEach(id => {
        if (document.getElementById(id)) document.getElementById(id).innerText = '…';
    });

    if (userId) {
        try {
            // Reutilizamos tu función perfecta calcularFinanzasRango
            const mesData = await calcularFinanzasRango(userId, rm.inicio, rm.fin);
            cacheFinanzasMesActivo = mesData;
            
            document.getElementById('finMesBrutos').innerText = '$' + mesData.brutos.toLocaleString('es-CL');
            document.getElementById('finMesLabTotal').innerText = '$' + mesData.lab.toLocaleString('es-CL');
            document.getElementById('finMesConvTotal').innerText = '$' + Math.round(mesData.conv).toLocaleString('es-CL');
            document.getElementById('finMesNetoTotal').innerText = '$' + Math.round(mesData.neto).toLocaleString('es-CL');
            
            await Promise.all([
                cargarListaLaboratorioMes(rm, userId),
                cargarListaConveniosMes(userId)
            ]);
        } catch (err) {
            console.error('Error agregando finanzas del mes:', err);
        }
    }
}

async function cargarListaLaboratorioMes(rm, userId) {
    const cont = document.getElementById('listaLaboratorioMes');
    try {
        const { data, error } = await window.midental.from('pagos_laboratorio')
            .select('*').eq('dentista_id', userId)
            .gte('fecha_gasto', rm.inicio).lt('fecha_gasto', rm.fin)
            .order('fecha_gasto', { ascending: false });
            
        if (error) throw error;

        if (!data || data.length === 0) {
            cont.innerHTML = `<p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin gastos de laboratorio en este mes.</p>`;
            return;
        }

        cont.innerHTML = data.map(g => `
            <div style="display: flex; justify-content: space-between; align-items: center; background: #fff7ed; border: 1px solid #fde68a; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px;">
                <div>
                    <strong style="color: var(--pixar-orange); font-size: 0.9rem;">${g.descripcion}</strong>
                    <small style="display: block; color: #92400e; font-size: 0.75rem;">${new Date(g.fecha_gasto).toLocaleDateString('es-CL')}</small>
                </div>
                <strong style="color: var(--pixar-orange); font-size: 1rem;">$${parseFloat(g.monto).toLocaleString('es-CL')}</strong>
            </div>
        `).join('');
    } catch (err) {
        console.error("Error cargando gastos de lab mensuales:", err);
    }
}

async function cargarListaConveniosMes(userId) {
    const cont = document.getElementById('listaConveniosMes');
    try {
        const { data, error } = await window.midental.from('convenios_centros_medicos')
            .select('*').eq('dentista_id', userId).eq('activo', true)
            .order('created_at', { ascending: false });
            
        if (error) throw error;

        if (!data || data.length === 0) {
            cont.innerHTML = '<p style="color: #94a3b8; font-size: 0.85rem; text-align: center; padding: 15px;">Sin convenios configurados.</p>';
            return;
        }

        const postLab = Math.max(0, cacheFinanzasMesActivo.brutos - cacheFinanzasMesActivo.lab);
        cont.innerHTML = data.map(c => {
            const comision = postLab * (parseFloat(c.porcentaje) / 100);
            return `
                <div style="display: flex; justify-content: space-between; align-items: center; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px;">
                    <div>
                        <strong style="color: var(--red-urgency); font-size: 0.9rem;">${c.nombre_centro}</strong>
                        <small style="display: block; color: #991b1b; font-size: 0.75rem;">Cobra ${c.porcentaje}% sobre ingresos del mes post laboratorio</small>
                    </div>
                    <strong style="color: var(--red-urgency); font-size: 1rem;">$${Math.round(comision).toLocaleString('es-CL')}</strong>
                </div>
            `;
        }).join('');
    } catch (err) {
        console.error("Error cargando convenios mensuales:", err);
    }
}
