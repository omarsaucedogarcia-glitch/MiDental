            <button class="btn-close" onclick="document.getElementById('modalRecetaMedica').style.display='none'" style="z-index: 2010;"><span class="material-symbols-outlined">close</span></button>
            
            <div class="modal-body-scroll" style="padding: 30px;">
                <div style="border-bottom: 3px solid var(--pixar-cyan); padding-bottom: 15px; margin-bottom: 25px;">
                    <h2 style="margin:0; color: var(--blue-elegant); font-size: 1.6rem; display: flex; align-items: center; gap: 10px;">
                        <span class="material-symbols-outlined" style="font-size: 2rem;">prescriptions</span> Vademécum y Receta
                    </h2>
                    <p style="margin: 5px 0 0 0; color: #64748b; font-size: 1rem;">Paciente: <strong id="recetaNombrePaciente">--</strong></p>
                </div>
                
                <!-- Buscador Inteligente -->
                <div style="position: relative; margin-bottom: 20px;">
                    <label class="input-label" style="font-weight: bold;">Buscar Fármaco (Odontológico)</label>
                    <div class="input-group-modal">
                        <span class="material-symbols-outlined">search</span>
                        <input type="text" id="buscadorFarmaco" class="apple-input-modal" placeholder="Ej: Amoxicilina 500mg, Ketorolaco, Clorhexidina..." oninput="filtrarVademecum()" autocomplete="off">
                    </div>
                    <div id="listaResultadosFarmacos" style="position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 10px 15px rgba(0,0,0,0.1); z-index: 100; max-height: 200px; overflow-y: auto; display: none;"></div>
                </div>

                <!-- Cajas de Posología -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 25px;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 15px; margin-bottom: 15px;">
                        <div>
                            <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Cantidad</label>
                            <input type="number" id="posCantidad" class="apple-input-modal" placeholder="Ej: 1" style="padding: 8px;">
                        </div>
                        <div>
                            <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Formato</label>
                            <select id="posFormato" class="apple-input-modal" style="padding: 8px; background: white;">
                                <option value="Comprimido(s)">Comprimido(s)</option>
                                <option value="Cápsula(s)">Cápsula(s)</option>
                                <option value="ml">ml</option>
                                <option value="Gotas">Gotas</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Cada</label>
                            <div style="display: flex; gap: 5px;">
                                <input type="number" id="posFrecuencia" class="apple-input-modal" placeholder="8" style="padding: 8px; width: 50%;">
                                <select id="posFrecUnidad" class="apple-input-modal" style="padding: 8px; width: 50%; background: white;">
                                    <option value="Hora(s)">Hora(s)</option>
                                    <option value="Día(s)">Día(s)</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Vía</label>
                            <select id="posVia" class="apple-input-modal" style="padding: 8px; background: white;">
                                <option value="Vía Oral">Vía Oral</option>
                                <option value="Tópica">Tópica</option>
                                <option value="Sublingual">Sublingual</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Durante</label>
                            <div style="display: flex; gap: 5px;">
                                <input type="number" id="posDuracion" class="apple-input-modal" placeholder="7" style="padding: 8px; width: 50%;">
                                <select id="posDurUnidad" class="apple-input-modal" style="padding: 8px; width: 50%; background: white;">
                                    <option value="Día(s)">Día(s)</option>
                                    <option value="Semana(s)">Semana(s)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label style="font-size: 0.8rem; color: #64748b; font-weight: bold;">Indicaciones Adicionales</label>
                        <textarea id="posIndicaciones" class="apple-input-modal" placeholder="Ej: Tomar junto con los alimentos..." rows="2" style="border-radius: 8px; resize: vertical; padding: 10px;"></textarea>
                    </div>
                    <div style="text-align: right; margin-top: 15px;">
                        <button type="button" class="btn-pixar btn-small" onclick="agregarFarmacoAReceta()" style="padding: 8px 20px; font-weight: bold; border-radius: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 1.2rem; vertical-align: bottom;">add_circle</span> Agregar a la lista
                        </button>
                    </div>
