                const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis').eq('id', dentistaId).single();
                const { data: sedes } = await window.midental.from('sedes_dentistas').select('direccion, comuna, nombre_sede').eq('dentista_id', dentistaId).limit(1);

                const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo.toUpperCase()}` : 'Profesional Tratante';
                const nombreCentro = (sedes && sedes.length > 0 && sedes[0].nombre_sede) ? sedes[0].nombre_sede : 'Centro Odontológico Privado';

                doc.setFontSize(22); doc.setTextColor(139, 92, 246); doc.text("MiDental", 14, 20);
                doc.setFontSize(10); doc.setTextColor(100, 116, 139); doc.text("Sistema de Gestión Legal Clínica", 14, 26);
                
                doc.setFontSize(12); doc.setTextColor(30, 58, 138); doc.text(nombreCentro, 200, 20, { align: "right" });
                doc.setFontSize(9); doc.setTextColor(85, 85, 85); doc.text(`Fecha Emisión: ${new Date().toLocaleDateString('es-CL')}`, 200, 26, { align: "right" });

                doc.setDrawColor(200, 200, 200); doc.line(14, 30, 200, 30);

                doc.setFontSize(12); doc.setFont("helvetica", "bold"); doc.setTextColor(30, 58, 138);
                doc.text(dataCons.titulo, 105, 40, { align: "center" });

                doc.setFontSize(9); doc.setFont("helvetica", "normal"); doc.setTextColor(30, 30, 30);
                const declaracion = `Yo, ${pacienteActual.nombre.toUpperCase()}, RUT: ${pacienteActual.rut}, en pleno uso de mis facultades mentales, declaro haber sido informado(a) de manera clara y comprensible por el/la profesional ${drName} acerca de mi diagnóstico y del plan de tratamiento propuesto.`;
                const splitDecl = doc.splitTextToSize(declaracion, 180);
                doc.text(splitDecl, 14, 50);

                let startY = 50 + (splitDecl.length * 5) + 5;

                doc.setFontSize(10); doc.setFont("helvetica", "bold");
                doc.text("1. RIESGOS Y COMPLICACIONES POSIBLES:", 14, startY);
                doc.setFontSize(9); doc.setFont("helvetica", "normal");
                startY += 6;
                
                if (dataCons.riesgos.length > 0) {
                    dataCons.riesgos.forEach(r => { const splitR = doc.splitTextToSize(`• ${r}`, 175); doc.text(splitR, 18, startY); startY += (splitR.length * 4) + 2; });
                } else { doc.text("• [Texto de riesgos en construcción]", 18, startY); startY += 8; }

                startY += 5;
                doc.setFontSize(10); doc.setFont("helvetica", "bold");
                doc.text("2. OBLIGACIONES DEL PACIENTE PARA EL CONTROL:", 14, startY);
                doc.setFontSize(9); doc.setFont("helvetica", "normal");
                startY += 6;

                const obligacionesControl = [
                    "Asistir de forma obligatoria y puntual a todos los controles programados para supervisar la evolución clínica.",
                    "Notificar de inmediato a la clínica o profesional tratante ante la presencia de dolor persistente, sangrado o inflamación inusual.",
                    "Mantener rigurosamente la higiene oral e indicaciones específicas dadas para el período de recuperación.",
                    "Seguir estrictamente el tratamiento farmacológico indicado, respetando dosis, frecuencia y duración prescrita."
                ];
                obligacionesControl.forEach(o => { const splitO = doc.splitTextToSize(`• ${o}`, 175); doc.text(splitO, 18, startY); startY += (splitO.length * 4) + 2; });

                startY += 5;
                doc.setFontSize(10); doc.setFont("helvetica", "bold");
                doc.text("3. INDICACIONES Y CUIDADOS POST-OPERATORIOS OBLIGATORIOS:", 14, startY);
                doc.setFontSize(9); doc.setFont("helvetica", "normal");
                startY += 6;

                if (dataCons.cuidados.length > 0) {
                    dataCons.cuidados.forEach(c => { const splitC = doc.splitTextToSize(`• ${c}`, 175); doc.text(splitC, 18, startY); startY += (splitC.length * 4) + 2; });
                } else { doc.text("• [Texto de cuidados en construcción]", 18, startY); startY += 8; }

                // Obtener información adicional / tiempo de control
                const infoAdic = document.getElementById('inputInfoAdicionalConsentimiento').value.trim();
                if (infoAdic) {
                    startY += 5;
                    doc.setFontSize(10); doc.setFont("helvetica", "bold");
                    doc.text("4. INFORMACIÓN ADICIONAL Y TIEMPO DE CONTROL:", 14, startY);
                    doc.setFontSize(9); doc.setFont("helvetica", "normal");
                    startY += 6;
                    const splitAdic = doc.splitTextToSize(infoAdic, 175);
                    doc.text(splitAdic, 18, startY);
                    startY += (splitAdic.length * 4) + 2;
                }

                startY += 10;
                doc.setFillColor(248, 250, 252); doc.setDrawColor(139, 92, 246); doc.rect(14, startY, 180, 25, 'FD');
                doc.setFontSize(8); doc.setFont("helvetica", "italic"); doc.setTextColor(50, 50, 50);
                const legalText = "Cláusula Legal de Aceptación: Al recibir este documento y ser emitido mediante la plataforma clínica, este consentimiento se anexará permanentemente a su Historial Médico Digital. El inicio del tratamiento clínico constituye la aceptación íntegra de las condiciones, riesgos y cuidados aquí descritos, a menos que el paciente rechace expresamente y por escrito este documento previo a la intervención.";
                const splitLegal = doc.splitTextToSize(legalText, 170);
                doc.text(splitLegal, 19, startY + 6);

                const finalPageY = doc.internal.pageSize.height;
                doc.setFontSize(9); doc.setFont("helvetica", "normal"); doc.setTextColor(0, 0, 0);
                doc.line(30, finalPageY - 30, 90, finalPageY - 30); doc.text("Firma Paciente", 45, finalPageY - 25);
                doc.line(120, finalPageY - 30, 180, finalPageY - 30); doc.text("Firma Profesional", 135, finalPageY - 25);

                const nombreArchivo = `Consentimiento_${tipoSel}_${pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_')}.pdf`;
                doc.save(nombreArchivo);

                const pdfBlob = doc.output('blob');
                const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });
                
                if (!uploadError) {
                    await window.midental.from('documentos_pacientes').insert([{
                        paciente_id: pacienteIdURL, dentista_id: dentistaId,
                        nombre_archivo: `Consentimiento: ${dataCons.titulo} (${new Date().toLocaleDateString('es-CL')})`,
                        tipo: 'pdf', archivo_url: nombreArchivo 
                    }]);
                    cargarDocumentosPaciente();
                }

                alert("✅ Consentimiento Informado generado y resguardado en la ficha del paciente.");
                document.getElementById('inputInfoAdicionalConsentimiento').value = '';
                document.getElementById('modalConsentimiento').style.display = 'none';

            } catch (err) { alert("Error al emitir el consentimiento: " + err.message); console.error(err); } 
            finally { btn.innerHTML = '<span class="material-symbols-outlined">picture_as_pdf</span> Generar y Guardar Documento'; btn.disabled = false; }
        }
