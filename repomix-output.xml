        function agregarFila() { 
            const tbody = document.getElementById('tbodyPresupuesto');
            tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td><input type="text" class="input-diente" placeholder="Ej: 1.4"></td>
                    <td><input type="text" class="input-diag" placeholder="Caries"></td>
                    <td><input type="text" class="input-tratamiento" placeholder="Restauración"></td>
                    <td><input type="number" class="input-ref" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                    <td><input type="text" class="ref-val input-total input-readonly" placeholder="0" readonly></td>
                </tr>
            `); 
        }

        function calcularFila(element) {
            const row = element.closest('tr');
            const refVal = parseFloat(row.querySelector('.input-ref').value) || 0;
            const desc = parseFloat(row.querySelector('.input-desc').value) || 0;
            const totalInput = row.querySelector('.input-total');
            
            let finalVal = 0;
            if (desc <= 100) {
                finalVal = refVal - (refVal * (desc / 100));
            } else {
                finalVal = refVal - desc;
            }
            
            totalInput.value = Math.max(0, finalVal); 
            totalInput.dataset.valorReal = Math.max(0, finalVal); 
            calcularGranTotal();
        }
        
        function calcularGranTotal() {
            let total = 0;
            document.querySelectorAll('.input-total').forEach(i => {
                total += (parseFloat(i.dataset.valorReal) || 0);
            });
            document.getElementById('granTotalPagar').innerText = total.toLocaleString('es-CL');
            return total;
        }

