        <a href="mapa-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">search</span>Buscar</a>
        <a href="ofertas-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">play_circle</span>Ofertas/Reels</a>
        <a href="citas-paciente.html" class="nav-item-bottom active"><span class="material-symbols-outlined">calendar_month</span>Citas</a>
        <a href="documentos-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">description</span>Documentos</a>
        <a href="perfil-paciente.html" class="nav-item-bottom"><span class="material-symbols-outlined">person</span>Perfil</a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="js/supabase-config.js"></script>
    <script src="js/app.js"></script>
    <script>
        // ==========================================================
        // BOOT · Resolución de identidad clínica del paciente
        // ==========================================================
        let PACIENTE_ID = null;

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                PACIENTE_ID = await resolverPacienteId();
                if (!PACIENTE_ID) {
                    alert("Debes iniciar sesión como paciente para ver tus citas.");
                    window.location.href = 'index.html';
                    return;
                }
                await Promise.all([
                    cargarAnalisisRiesgo(PACIENTE_ID),
                    cargarMisCitas(PACIENTE_ID)
                ]);
            } catch (err) {
                console.error("[BOOT] Error inicializando portal del paciente:", err);
                alert("No pudimos cargar tu portal clínico. Intenta nuevamente.");
            }
        });

        /**
         * Resuelve el paciente_id REAL consultando perfiles_pacientes
         * a partir del auth.uid() de la cuenta maestra + el RUT del familiar.
         */
        async function resolverPacienteId() {
            try {
                let authUid = null;
                try {
                    const { data: sessionData } = await window.midental.auth.getUser();
                    authUid = sessionData?.user?.id || null;
                } catch (e) {
                    console.warn("[Auth] No se pudo obtener auth.getUser():", e);
                }

                // Fallback al user_id almacenado
                if (!authUid) authUid = localStorage.getItem('midental_user_id');

                const tipoUser = localStorage.getItem('midental_user_tipo');
                const rutActual = localStorage.getItem('midental_paciente_rut'); // EL DATO CLAVE

                if (!authUid || (tipoUser && tipoUser !== 'paciente') || !rutActual) return null;

                // Buscamos la ficha clínica EXACTA del familiar usando el RUT
                const { data, error } = await window.midental
                    .from('perfiles_pacientes')
                    .select('id, user_id')
                    .eq('user_id', authUid)
                    .eq('rut', rutActual) // Puente biométrico
                    .single(); // Cambiamos a single() porque RUT + Cuenta es una combinación única

                if (error) throw error;
                if (data?.id) return data.id;

                return null;
            } catch (err) {
                console.error("[resolverPacienteId] Error:", err);
                return null; 
            }
        }

        // ==========================================================
        // ANÁLISIS DE RIESGO INTEGRAL (PREMIUM)
        // ------------------------------------------------------------
        // Fuente primaria: columnas discretas en perfiles_pacientes
        // (nivel_riesgo, control_meses, proximo_control_fecha,
        //  riesgo_integral). Fallback compatibilidad: historial_json
        // de la última ficha_clinica para instalaciones sin la
        // migración 06_perfiles_pacientes_riesgo.sql aplicada.
        // El motor de inferencia vive en el lado del dentista — acá
        // sólo se renderiza lo que el dentista cerró/validó.
        // ==========================================================
        async function cargarAnalisisRiesgo(pacienteId) {
            const badge      = document.getElementById('riskBadge');
            const diagEl     = document.getElementById('riskDiagnostico');
            const nextCtrlEl = document.getElementById('riskNextControl');

            try {
                // 1) Fuente primaria: columnas discretas en perfiles_pacientes.
                let nivel = null, controlMeses = null, proxFechaIso = null, riesgo = null, fechaBase = null;
                const { data: perfil, error: perfilErr } = await window.midental
                    .from('perfiles_pacientes')
                    .select('nivel_riesgo, control_meses, proximo_control_fecha, riesgo_integral, riesgo_calculado_en')
                    .eq('id', pacienteId)
                    .maybeSingle();

                if (!perfilErr && perfil && perfil.nivel_riesgo) {
                    nivel         = perfil.nivel_riesgo;
                    controlMeses  = perfil.control_meses;
                    proxFechaIso  = perfil.proximo_control_fecha;
                    riesgo        = perfil.riesgo_integral || null;
                    fechaBase     = perfil.riesgo_calculado_en;
                } else {
                    // 2) Fallback legacy: última fichas_clinicas con historial_json.riesgo_integral.
                    const { data: ficha, error } = await window.midental
                        .from('fichas_clinicas')
                        .select('historial_json, created_at')
                        .eq('paciente_id', pacienteId)
                        .order('created_at', { ascending: false })
                        .limit(10);            // miramos las 10 últimas y elegimos la que TENGA riesgo
                    if (error) throw error;
                    if (!ficha || ficha.length === 0) {
                        setBadge(badge, 'sin_datos', 'shield_person', 'Sin datos');
                        diagEl.textContent     = 'Aún no tienes una ficha clínica registrada. Tu Análisis de Riesgo se activará tras tu primera atención.';
                        nextCtrlEl.textContent = 'Agenda una evaluación inicial con un especialista.';
                        return;
                    }
                    for (const row of ficha) {
                        let historial = row.historial_json;
                        if (typeof historial === 'string') {
                            try { historial = JSON.parse(historial); }
                            catch (e) { historial = null; }
                        }
                        if (historial && typeof historial === 'object' && historial.riesgo_integral && historial.riesgo_integral.nivel) {
                            riesgo       = historial.riesgo_integral;
                            nivel        = riesgo.nivel;
                            controlMeses = riesgo.control_meses;
                            fechaBase    = riesgo.fecha_calculo || row.created_at;
                            break;
                        }
                    }
                }

                if (!nivel) {
                    setBadge(badge, 'sin_datos', 'shield_person', 'Evaluación pendiente');
                    diagEl.textContent     = 'Tu doctor aún no ha cerrado tu análisis de riesgo integral. Esta sección se activará una vez validado.';
                    nextCtrlEl.textContent = 'Te avisaremos cuando esté disponible.';
                    return;
                }

                // Render directo del análisis VALIDADO por el dentista.
                const META = {
                    'alto':  { ui: 'alto',     icono: 'warning',       label: 'Alto Riesgo' },
                    'medio': { ui: 'moderado', icono: 'monitor_heart', label: 'Riesgo Moderado' },
                    'bajo':  { ui: 'bajo',     icono: 'verified_user', label: 'Bajo Riesgo / Preventivo' }
                };
                const meta = META[nivel] || META.bajo;
                setBadge(badge, meta.ui, meta.icono, meta.label);

                diagEl.textContent = (riesgo && riesgo.recomendaciones) ||
                    'Tu doctor ha validado tu análisis clínico. Consulta los detalles en tu próxima cita.';

                // Si tenemos la fecha precalculada en la BD, la priorizamos
                // sobre el cálculo local (evita drift por zonas horarias).
                const fechaControl = proxFechaIso
                    ? new Date(proxFechaIso + 'T00:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })
                    : calcularProximoControl(fechaBase, controlMeses || 6);
                const meses = controlMeses || 6;
                const msgControl = (meses === 1) ? 'Control clínico en 1 mes' : `Control clínico en ${meses} meses`;
                nextCtrlEl.innerHTML = `${msgControl} · <strong style="color:var(--blue-elegant);">${fechaControl}</strong>`;
            } catch (err) {
                console.error("[cargarAnalisisRiesgo] Error:", err);
                setBadge(badge, 'sin_datos', 'error', 'No disponible');
                diagEl.textContent     = 'No pudimos cargar tu análisis clínico en este momento.';
                nextCtrlEl.textContent = '—';
            }
        }

        function setBadge(el, nivel, icono, etiqueta) {
            el.className = `ai-risk-badge ${nivel}`;
            el.innerHTML = `<span class="material-symbols-outlined" style="font-size:1rem;">${icono}</span> ${etiqueta}`;
        }

        function calcularProximoControl(fechaBaseIso, mesesControl) {
            const base = fechaBaseIso ? new Date(fechaBaseIso) : new Date();
            const destino = new Date(base.getTime());
            destino.setMonth(destino.getMonth() + (mesesControl || 6));
            return destino.toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
        }

        // ==========================================================
        // CITAS · PRÓXIMAS Y HISTORIAL (CORREGIDO)
        // ==========================================================
        async function cargarMisCitas(pacienteId) {
            const proximasCont = document.getElementById('listaProximas');
            const historialCont = document.getElementById('listaHistorial');

            // Blindaje: Si no hay ID válido, abortamos antes de hacer enojar a Supabase
            if (!pacienteId) return; 

            try {
                // SOLUCIÓN AL ERROR 400: Retiramos la búsqueda profunda de sedes_dentistas
                // para evitar el choque de llaves foráneas en PostgREST.
                const { data: citas, error } = await window.midental
                    .from('citas_agenda')
                    .select('*, perfiles_dentistas(nombre_completo, especialidad, avatar_url, telefono)')
                    .eq('paciente_id', pacienteId)
                    .order('created_at', { ascending: false });

                if (error) throw error;

                proximasCont.innerHTML = '';
                historialCont.innerHTML = '';

                const estadosFuturos = ['pendiente', 'confirmado', 'confirmada', 'en_atencion'];
                const estadosPasados = ['completada', 'cancelada'];

                let hayProximas = false;
                let hayHistorial = false;

                (citas || []).forEach(cita => {
                    const estadoOriginal = (cita.estado || 'pendiente').toString();
                    const estadoLimpio = estadoOriginal.toLowerCase().replace(/\s+/g, '_');

                    if (estadosFuturos.includes(estadoLimpio)) {
                        proximasCont.innerHTML += renderCitaCard(cita, estadoOriginal, estadoLimpio, true);
                        hayProximas = true;
                    } else if (estadosPasados.includes(estadoLimpio)) {
                        historialCont.innerHTML += renderCitaCard(cita, estadoOriginal, estadoLimpio, false);
                        hayHistorial = true;
                    }
                });

                if (!hayProximas) {
                    proximasCont.innerHTML = renderEmptyState(
                        'event_busy',
                        'No tienes citas futuras agendadas',
                        'Cuando agendes una hora con un especialista aparecerá aquí.'
                    );
                }
                if (!hayHistorial) {
                    historialCont.innerHTML = renderEmptyState(
                        'history_toggle_off',
                        'Sin atenciones registradas',
                        'Tus atenciones completadas y canceladas se mostrarán en este historial.'
                    );
                }
            } catch (err) {
                console.error("[cargarMisCitas] Error cargando agenda:", err);
                proximasCont.innerHTML = renderEmptyState('error', 'Error de conexión', 'No pudimos cargar tu agenda. Reintenta en unos segundos.');
                historialCont.innerHTML = '';
            }
        }

        function renderCitaCard(cita, estadoOriginal, estadoLimpio, esFutura) {
            const dr = cita.perfiles_dentistas || {};
            const drNombre = dr.nombre_completo || 'Especialista';
            const drEspecialidad = dr.especialidad || 'Odontología General';
            const drAvatar = dr.avatar_url || 'assets/avatar-default-doctor.png';
            const drTelefono = dr.telefono ? dr.telefono.replace(/\D/g, '') : '';
            
            // Como retiramos la sede de la consulta para evitar el Error 400, 
            // usamos un texto genérico y limpio.
            const nombreCentro = 'Consulta Dental';

            const slot = cita.fecha_hora_formato_slot || (cita.fecha_hora ? new Date(cita.fecha_hora).toLocaleString('es-CL') : 'Horario por confirmar');
            const motivo = cita.motivo || 'Evaluación clínica';

            const puedeCancelar = esFutura && (estadoLimpio === 'pendiente' || estadoLimpio === 'confirmada' || estadoLimpio === 'confirmado');
            const btnCancelar = puedeCancelar ? `
                <button class="btn-cancelar-cita" onclick="cancelarMiCita(${cita.id})">
                    <span class="material-symbols-outlined" style="font-size: 1rem;">cancel</span> Cancelar Hora
                </button>` : '';

            const whatsappBtn = (esFutura && drTelefono) ? `
                <a href="https://wa.me/${drTelefono}" target="_blank" class="btn-whatsapp-small" title="Hablar con la clínica">
                    <span class="material-symbols-outlined">chat</span>
                </a>` : '';

            return `
                <div class="appointment-card card-${estadoLimpio}">
                    <img src="${drAvatar}" class="doc-avatar-mini" alt="Avatar" onerror="this.src='assets/avatar-default-doctor.png'">
                    <div class="appt-info">
                        <span class="status-pill status-${estadoLimpio}">${estadoOriginal.toUpperCase()}</span>
                        <h4>Dr/a. ${drNombre}</h4>
                        <div class="especialidad">${drEspecialidad}</div>
                        <p style="font-weight:bold; color:var(--blue-elegant);"><span class="material-symbols-outlined icon-small">calendar_month</span> ${slot}</p>
                        <p><span class="material-symbols-outlined icon-small">location_on</span> ${nombreCentro}</p>
                        <p><span class="material-symbols-outlined icon-small">medical_services</span> ${motivo}</p>
                        ${btnCancelar}
                    </div>
                    ${whatsappBtn}
                </div>
            `;
        }

        function renderEmptyState(icono, titulo, subtitulo) {
            return `
                <div class="empty-state">
                    <span class="material-symbols-outlined">${icono}</span>
                    <p>${titulo}</p>
                    <p class="empty-sub">${subtitulo}</p>
                </div>
            `;
        }

        // ==========================================================
        // CANCELAR CITA
        // ==========================================================
        async function cancelarMiCita(citaId) {
            if (!confirm("¿Estás seguro que deseas cancelar esta hora? El dentista será notificado.")) return;

            try {
                const { error } = await window.midental
                    .from('citas_agenda')
                    .update({ estado: 'cancelada' })
                    .eq('id', citaId);

                if (error) throw error;

                alert("La cita ha sido cancelada correctamente.");
                if (PACIENTE_ID) cargarMisCitas(PACIENTE_ID);
            } catch (err) {
                console.error("[cancelarMiCita] Error:", err);
                alert("Error al intentar cancelar la cita. Intenta nuevamente.");
            }
        }
    </script>
</body>
