<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiDental - Publicar Shorts</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <style>
        .dashboard-layout { display: flex; height: 100vh; overflow: hidden; background: #f4f7f6; }
        .shorts-creator-container { display: grid; grid-template-columns: 1fr 350px; gap: 25px; height: calc(100vh - 120px); }
        .creator-main { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border: 1px solid #f0f0f0; overflow-y: auto; }
        .creator-sidebar { display: flex; flex-direction: column; gap: 20px; overflow-y: auto; padding-right: 10px; }

        /* Medidor de Cuota Freemium */
        .quota-box { background: linear-gradient(135deg, #fdf5ff, #f0f8ff); border: 2px dashed var(--pixar-cyan); border-radius: 18px; padding: 20px; text-align: center; }
        .quota-title { color: var(--blue-elegant); font-weight: bold; margin-bottom: 10px; font-size: 1.1rem; }
        .quota-counter { font-size: 3rem; font-weight: 900; color: var(--pixar-cyan); display: flex; align-items: center; justify-content: center; gap: 5px; line-height: 1; }
        .quota-counter span { font-size: 1.5rem; color: #aaa; font-weight: normal; }

        /* Zona de subida */
        .video-upload-zone { border: 2px dashed #ccc; border-radius: 15px; height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fafafa; cursor: pointer; transition: 0.2s; margin-bottom: 20px; position: relative; }
        .video-upload-zone:hover { border-color: var(--dentist-purple); background: #fdf5ff; color: var(--dentist-purple); }
        
