        <main class="dashboard-content">
            <header class="topbar" style="margin-bottom: 15px; padding: 10px 25px;">
                <div class="welcome-text">
                    <h1 style="margin:0; font-size:1.5rem; color:var(--blue-elegant);">MiDental Shorts 🎬</h1>
                    <p style="margin:5px 0 0; font-size:0.9rem; color:var(--text-light);">Conecta con nuevos pacientes a través de videos cortos.</p>
                </div>
