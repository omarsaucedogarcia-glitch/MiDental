  // 1. Función central que maneja la comunicación con Mercado Pago
  async function procesarSuscripcionPro(botonElemento) {
    // Guardamos el contenido original del botón por si necesitamos restaurarlo tras un error
    const contenidoOriginal = botonElemento.innerHTML;
    
    // Cambiamos el diseño a "Cargando" para evitar que el usuario haga doble clic
    botonElemento.innerHTML = '<span class="material-symbols-outlined" style="font-size: 1rem; animation: spin 1s linear infinite;">sync</span> Procesando...';
    botonElemento.disabled = true;

    try {
      // 2. Simulamos los datos del usuario (Más adelante conectaremos esto con Supabase Auth)
      const datosPrueba = {
        dentista_id: "ID_PRUEBA_MIDENTAL_001", 
        email_dentista: "usuario_fantasma_999@gmail.com" 
      };

      // 3. Llamamos a nuestra Edge Function local
      const respuesta = await fetch('http://127.0.0.1:54321/functions/v1/crear-checkout-suscripcion', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(datosPrueba)
      });

      const resultado = await respuesta.json();

      // 4. Evaluamos la respuesta
      if (resultado.init_point) {
        // ¡Éxito! Redirigimos al usuario a la página segura de Mercado Pago
        window.location.href = resultado.init_point;
      } else {
        // Falló la generación del link desde el servidor
        console.error("Error desde Edge Function:", resultado);
        alert("Hubo un problema al generar el enlace de pago. Revisa la consola.");
        botonElemento.innerHTML = contenidoOriginal;
        botonElemento.disabled = false;
      }

    } catch (error) {
      // Falló la red o el servidor local no está encendido
      console.error("Error de red o servidor local:", error);
      alert("Error de conexión. Asegúrate de que Docker y 'supabase start' sigan corriendo en tu terminal.");
      botonElemento.innerHTML = contenidoOriginal;
      botonElemento.disabled = false;
    }
  }

