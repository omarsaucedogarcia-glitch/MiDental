        function toggleEdicionPaciente() {
            const vista = document.getElementById('vistaDatosPaciente');
            const edicion = document.getElementById('edicionDatosPaciente');
            
            if (edicion.style.display === 'none') {
                vista.style.display = 'none';
                edicion.style.display = 'block';
            } else {
                vista.style.display = 'block';
                edicion.style.display = 'none';
                // Resetear campos si cancela
                document.getElementById('editNombrePaciente').value = pacienteActual.nombre;
                document.getElementById('editRutPaciente').value = pacienteActual.rut !== "No registrado" ? pacienteActual.rut : "";
                document.getElementById('editTelefonoPaciente').value = pacienteActual.telefono;
                document.getElementById('editNacimientoPaciente').value = pacienteActual.fecha_nacimiento;
            }
        }

        async function guardarDatosPaciente() {
            const nuevoNombre = document.getElementById('editNombrePaciente').value.trim();
            const nuevoRut = document.getElementById('editRutPaciente').value.trim();
            const nuevoTelefono = document.getElementById('editTelefonoPaciente').value.trim();
            const nuevoNacimiento = document.getElementById('editNacimientoPaciente').value;

            if (!nuevoNombre) return alert("El nombre del paciente no puede estar vacío.");

            const btn = document.getElementById('btnGuardarEdicionPaciente');
            btn.innerText = "Guardando...";
            btn.disabled = true;

            try {
                // Actualizamos Supabase
                const { error } = await window.midental.from('perfiles_pacientes')
                    .update({
                        nombre_completo: nuevoNombre,
                        rut: nuevoRut || null,
                        telefono: nuevoTelefono || null,
                        fecha_nacimiento: nuevoNacimiento || null
                    })
                    .eq('id', pacienteIdURL);

                if (error) throw error;

                // Actualizamos la variable global
                pacienteActual.nombre = nuevoNombre;
                pacienteActual.rut = nuevoRut || "No registrado";
                pacienteActual.telefono = nuevoTelefono;
                pacienteActual.fecha_nacimiento = nuevoNacimiento;

                // Actualizamos la vista visualmente
                document.getElementById('headerNombrePaciente').innerText = nuevoNombre;
                document.getElementById('panelNombrePaciente').innerText = nuevoNombre;
                document.getElementById('panelRutPaciente').innerText = `RUT: ${pacienteActual.rut}`;
                document.getElementById('panelTelefonoPaciente').innerHTML = `<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">call</span> ${pacienteActual.telefono || 'Sin teléfono'}`;
                document.getElementById('derivarPcteNombre').innerText = nuevoNombre;
                
                if (nuevoNacimiento) {
                    const [year, month, day] = nuevoNacimiento.split('-');
                    document.getElementById('panelNacimientoPaciente').innerText = `Nacimiento: ${day}/${month}/${year}`;
                } else {
                    document.getElementById('panelNacimientoPaciente').innerText = `Nacimiento: No registrado`;
                }

                // Cambiamos la letra del Avatar en caso de que hayan corregido la inicial del nombre
                const txtEl = document.getElementById('panelAvatarText');
                if (txtEl.style.display !== 'none') {
                    txtEl.innerText = nuevoNombre.charAt(0).toUpperCase();
                }

                // Cerramos el modo edición
                toggleEdicionPaciente();

            } catch (err) {
                alert("Error al actualizar los datos: " + err.message);
            } finally {
                btn.innerText = "Guardar";
                btn.disabled = false;
            }
        }

        // ==========================================
        // CONTROL DE PRESUPUESTO INTEGRAL + PAGOS
        // ==========================================
        async function cargarControlPresupuesto() {
            if (isLocal || !pacienteIdURL) {
                const cont = document.getElementById('controlPresupuestoContainer');
                const hist = document.getElementById('historialPagosContainer');
                if (cont) cont.style.display = 'none';
                if (hist) hist.style.display = 'none';
                return;
            }

            try {
                const { data: balance, error: errBalance } = await window.midental.from('vista_balance_paciente').select('*').eq('paciente_id', pacienteIdURL).maybeSingle();
                if (errBalance) throw errBalance;

                const presup = balance ? parseFloat(balance.presupuesto_integral || 0) : 0;
                const pagado = balance ? parseFloat(balance.total_pagado || 0) : 0;
                const saldo  = presup - pagado;

                document.getElementById('statPresupuestoTotal').innerText = '$' + presup.toLocaleString('es-CL');
                document.getElementById('statTotalPagado').innerText      = '$' + pagado.toLocaleString('es-CL');
                document.getElementById('statSaldoRestante').innerText    = '$' + saldo.toLocaleString('es-CL');
                document.getElementById('inputPresupuesto').value         = presup || '';

                await cargarHistorialPagos();
            } catch (err) {
                console.error("Error cargando control de presupuesto:", err);
            }
