        async function guardarFichaYPresupuestoOficial() {
            const dentistaId = localStorage.getItem('midental_user_id');
            const motivo = document.getElementById('fichaMotivo').value.trim();
            const diagnostico = document.getElementById('fichaDiagnostico').value.trim();
            const accion = document.getElementById('fichaAccion').value.trim();
            
            if (!motivo || !diagnostico || !accion) return alert("⚠️ Debes ingresar Motivo, Diagnóstico y Procedimiento para guardar la ficha.");

            const btn = document.getElementById('btnGuardarFicha');
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Guardando en la nube...';
            btn.disabled = true;

            try {
                let hayPresupuesto = false;
                document.querySelectorAll('#tbodyPresupuesto tr').forEach(tr => { const ref = parseFloat(tr.querySelector('.input-ref').value) || 0; if (ref > 0) hayPresupuesto = true; });

                if (hayPresupuesto) {
                    const docPDF = await generarDocumentoJSPDF(dentistaId, motivo, diagnostico, accion);
                    const nombrePuro = pacienteActual.nombre.replace(/[^a-zA-Z0-9]/g, '_');
                    const nombreArchivo = `Presupuesto_Oficial_${nombrePuro}_${Date.now()}.pdf`;
                    const pdfBlob = docPDF.output('blob');
                    docPDF.save(nombreArchivo); 

                    if (!isLocal) {
                        const { error: uploadError } = await window.midental.storage.from('documentos_clinicos').upload(nombreArchivo, pdfBlob, { contentType: 'application/pdf' });
                        if (!uploadError) {
                            await window.midental.from('documentos_pacientes').insert([{ paciente_id: pacienteIdURL, dentista_id: dentistaId, nombre_archivo: `Presupuesto Oficial ${new Date().toLocaleDateString('es-CL')}.pdf`, tipo: 'pdf', archivo_url: nombreArchivo }]);
                        }
                    }
                }

                const totalPresupuestoCalculado = calcularGranTotal();
                const { error: fichaError } = await window.midental.from('fichas_clinicas').insert([{
                    dentista_id: dentistaId, paciente_id: isLocal ? null : pacienteIdURL, paciente_nombre: pacienteActual.nombre,
                    paciente_rut: pacienteActual.rut !== "" && pacienteActual.rut !== "No registrado" ? pacienteActual.rut : null,
                    motivo_consulta: `${motivo} | ${diagnostico}`, accion_realizada: accion, presupuesto_total: totalPresupuestoCalculado,
                    ultima_atencion: new Date().toISOString(), historial_json: { motivo: motivo, diagnostico: diagnostico, tratamiento: accion, fecha: new Date().toLocaleDateString('es-CL') }
                }]);

                if (fichaError) throw fichaError;
                if (isLocal && citaId) await window.midental.from('citas_agenda').update({ estado: 'completada' }).eq('id', citaId);

                document.getElementById('fichaMotivo').value = ''; document.getElementById('fichaDiagnostico').value = ''; document.getElementById('fichaAccion').value = '';
                document.getElementById('tbodyPresupuesto').innerHTML = `
                    <tr>
                        <td><input type="text" class="input-diente" placeholder="Ej: 1.4"></td>
                        <td><input type="text" class="input-diag" placeholder="Caries"></td>
                        <td><input type="text" class="input-tratamiento" placeholder="Restauración"></td>
                        <td><input type="number" class="input-ref" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="number" class="input-desc" placeholder="0" oninput="calcularFila(this)"></td>
                        <td><input type="text" class="ref-val input-total input-readonly" placeholder="0" readonly></td>
                    </tr>`;
                document.getElementById('granTotalPagar').innerText = '0';
                alert(isLocal ? "✅ Ficha Local Guardada. Historial protegido." : "✅ Ficha Oficial guardada y presupuesto asegurado.");
                cargarHistorialPaciente(); 
                if(!isLocal) cargarDocumentosPaciente(); 
            } catch (err) { alert("Hubo un error técnico: " + err.message); } 
            finally { btn.innerHTML = '<span class="material-symbols-outlined">save</span> Firmar y Guardar Ficha Oficial'; btn.disabled = false; }
        }

        async function emitirPresupuestoPDF() {
    const dentistaId = localStorage.getItem('midental_user_id');
    if (!dentistaId) return alert("Error de sesión.");

    let hayPresupuesto = false;
    document.querySelectorAll('#tbodyPresupuesto tr').forEach(tr => {
        const ref = parseFloat(tr.querySelector('.input-ref').value) || 0;
        if (ref > 0) hayPresupuesto = true;
    });

    if (!hayPresupuesto) return alert("Debes agregar al menos una prestación con valor al presupuesto.");

    // SOLUCIÓN 1: Captura el botón mediante su atributo onclick sin requerir ID en el HTML
    const btn = document.querySelector('button[onclick="emitirPresupuestoPDF()"]');
    const textoOriginal = btn ? btn.innerHTML : '<span class="material-symbols-outlined" style="font-size: 1.1rem; vertical-align: middle;">request_quote</span> PDF Ppto.';
    
    if (btn) {
        btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Generando Documento...';
        btn.disabled = true;
    }

    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const { data: dr } = await window.midental.from('perfiles_dentistas').select('prefijo, nombre_completo, rut, registro_sis').eq('id', dentistaId).single();
        
        // SOLUCIÓN 2: Corregido 'nombre' por 'nombre_sede' para mantener la consistencia con la tabla
        const { data: sedes } = await window.midental.from('sedes_dentistas').select('nombre_sede, direccion, comuna').eq('dentista_id', dentistaId).limit(1);
        
        const drName = dr ? `${dr.prefijo || 'Dr.'} ${dr.nombre_completo}` : '';
        const nombreCentro = (sedes && sedes.length > 0 && sedes[0].nombre_sede) ? sedes[0].nombre_sede : 'Presupuesto Dental';
        
        doc.setFontSize(22); doc.setTextColor(0, 180, 216); doc.text("MiDental", 14, 20);
        doc.setFontSize(10); doc.setTextColor(100, 116, 139); doc.text("Red de Salud Digital", 14, 26);
        
